  </rdf:Description>
  <rdf:Description rdf:nodeID="n58fae4a1c5b44443b6c5d44ff93bf5bcb4">
    <rdf:first rdf:resource="http://example.org/seer#Nature"/>
    <rdf:rest rdf:nodeID="n58fae4a1c5b44443b6c5d44ff93bf5bcb5"/>
