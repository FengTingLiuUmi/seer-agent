  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/seer/pve#usesGear">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/seer/pve#Step"/>
    <rdfs:range rdf:nodeID="n58fae4a1c5b44443b6c5d44ff93bf5bcb1"/>
    <rdfs:label xml:lang="zh">宠物配装（装备/道具/性格/刻印/宝石/能量珠）</rdfs:label>
  </rdf:Description>
