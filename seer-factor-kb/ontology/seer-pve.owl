  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/seer/pve#usesSkill">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/seer/pve#Step"/>
    <rdfs:range rdf:resource="http://example.org/seer#Skill"/>
