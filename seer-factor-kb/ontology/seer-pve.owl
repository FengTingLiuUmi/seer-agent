  </rdf:Description>
  <rdf:Description rdf:nodeID="n58fae4a1c5b44443b6c5d44ff93bf5bcb7">
    <rdf:first rdf:resource="http://example.org/seer#EnergyBead"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/seer/pve#stepIndex">
