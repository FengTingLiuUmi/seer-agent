  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/seer/pve#Enemy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/seer#Pet"/>
