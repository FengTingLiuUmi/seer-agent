  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/seer/pve#precedes">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/seer/pve#Step"/>
    <rdfs:range rdf:resource="http://example.org/seer/pve#Step"/>
    <rdfs:label xml:lang="zh">紧接在前</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n58fae4a1c5b44443b6c5d44ff93bf5bcb6">
