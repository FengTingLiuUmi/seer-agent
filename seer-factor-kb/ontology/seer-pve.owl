  <rdf:Description rdf:about="http://example.org/seer/pve#recommendedStrategy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="http://example.org/seer/pve#BattlePlan"/>
    <rdfs:label xml:lang="zh">推荐打法</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/seer/pve#recommendedPet">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="http://example.org/seer#Pet"/>
    <rdfs:label xml:lang="zh">推荐打手</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/seer/pve">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <owl:imports rdf:resource="http://example.org/seer"/>
    <rdfs:label xml:lang="zh">赛尔号 PVE 打法层</rdfs:label>
    <rdfs:comment xml:lang="zh">在赛尔号游戏本体之上描述打法/方案/定位与推荐关系；规则见 seer-rules.swrl。</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/seer/pve#attacker">
    <rdf:type rdf:resource="http://example.org/seer/pve#Role"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="zh">强攻（秒杀）</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/seer/pve#hasRole">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/seer#Pet"/>
    <rdfs:range rdf:resource="http://example.org/seer/pve#Role"/>
    <rdfs:label xml:lang="zh">定位</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/seer/pve#substitutesFor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <rdfs:domain rdf:resource="http://example.org/seer#Pet"/>
    <rdfs:range rdf:resource="http://example.org/seer#Pet"/>
    <rdfs:label xml:lang="zh">可替代</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n58fae4a1c5b44443b6c5d44ff93bf5bcb1">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:unionOf rdf:nodeID="n58fae4a1c5b44443b6c5d44ff93bf5bcb2"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/seer/pve#planFor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/seer/pve#BattlePlan"/>
    <rdfs:range rdf:resource="http://example.org/seer#FactorStage"/>
    <rdfs:label xml:lang="zh">针对关卡</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/seer/pve#usesPet">
