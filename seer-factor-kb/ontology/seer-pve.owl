    <rdfs:range rdf:resource="http://example.org/seer/pve#Step"/>
    <rdfs:label xml:lang="zh">含步骤</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/seer/pve#Role">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
