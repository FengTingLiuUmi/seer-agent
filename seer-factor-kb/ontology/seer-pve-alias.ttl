# ---- 幻境 / 草王 / 村长 / 眠酱（2026-11-22 用户给定案）------------------
seer:pet_3460 a seer:Pet ; seer:seerapiId "3460" ;
    rdfs:label "幻境界皇（PVE 简称：幻境 / 界皇）"@zh ;
    skos:altLabel "幻境"@zh, "界皇"@zh, "幻境界皇"@zh ;
    rdfs:comment "PVE「幻境/界皇」= 幻境界皇(3460)。幻境链：幻境界王(3026)→幻境界皇(3460)→幻境界神(4048)。"@zh .

# 「草王」线：小草王 = 茉蕊儿（基础），草王/大草王 = 芳馨·茉蕊儿（进化）。
# 两者核心都是套盾（主要靠魂印送头盾），但「切精灵」结算方式相反。
seer:pet_3322 a seer:Pet ; seer:seerapiId "3322" ;
    rdfs:label "茉蕊儿（小草王，PVE 套盾·魂印送头盾·可叠）"@zh ;
    skos:altLabel "小草王"@zh, "草王"@zh, "茉蕊儿"@zh ;
    rdfs:comment "PVE「小草王」= 茉蕊儿(3322)。盾主要靠魂印647：自身死亡给下只精灵500点护盾+免1次异常；关键是「切精灵后该盾仍保留」，可循环「小草王送死→切精灵→切小草王送死→切精灵」叠盾。"@zh .

seer:pet_3613 a seer:Pet ; seer:seerapiId "3613" ;
    rdfs:label "芳馨·茉蕊儿（草王/大草王，PVE 套盾·魂印送头盾·切人清空）"@zh ;
    skos:altLabel "草王"@zh, "大草王"@zh, "芳馨茉蕊儿"@zh, "芳馨·茉蕊儿"@zh, "草王进化"@zh ;
    rdfs:comment "PVE「草王/大草王」= 芳馨·茉蕊儿(3613)。盾靠魂印909/1825：被击败给下只精灵500点护盾+护罩+免1次异常，数值更高；但「切精灵会清空」，不能像小草王(茉蕊儿3322)那样叠盾。"@zh .

seer:pet_4487 a seer:Pet ; seer:seerapiId "4487" ;
    rdfs:label "希可洛（PVE 简称：村长）"@zh ;
    skos:altLabel "村长"@zh, "希可洛"@zh ;
    rdfs:comment "PVE「村长」= 希可洛(4487)。关键技能「奇镰解放」(36481)：消除对手回合类效果(boss有效)+消强+解除自身能力下降+回满自身体力+回满PP。"@zh .

seer:pet_4442 a seer:Pet ; seer:seerapiId "4442" ;
    rdfs:label "眠降·玛缇娜（PVE 简称：眠酱 / 眠降）"@zh ;
    skos:altLabel "眠酱"@zh, "眠降"@zh, "眠降玛缇娜"@zh, "眠降·玛缇娜"@zh ;
    rdfs:comment "PVE「眠酱/眠降」= 眠降·玛缇娜(4442)。"@zh .

