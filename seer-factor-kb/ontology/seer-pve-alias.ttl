@prefix seer: <http://example.org/seer#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# =====================================================================
# PVE 昵称 → 规范实体（消歧表，手工维护）
# 目的：让后续任何 agent 查本体时，不再把「潘」「鲁斯王」「猩猩」等简称
#       映射到错误实体。skos:altLabel 记简称，rdfs:comment 记为什么。
# 注意：本文件与 ingest.py 生成的 seer-game-abox.ttl 分属两层；
#       这里是“社区简称/形态纠错”，那里是“游戏原始数据”。
# 潘家族已全部定案：火潘=潘克多斯(4344) / 草潘=加尔鲁特(4606) / 冰潘=斯克鲁恩(4463)。
# =====================================================================

# ---- 潘家族（火/草/冰 三元素：给自己上元素 debuff、给后续强攻铺垫）--------
# 社区叫「X潘」，但真名都不含「潘」！火潘=潘克多斯、草潘=加尔鲁特、冰潘=斯克鲁恩。
# PVE 中的「潘」「火潘」 = 潘克多斯（不是潘多拉/灾厄潘多拉！）
seer:pet_4344 a seer:Pet ;
    seer:seerapiId "4344" ;
    rdfs:label "潘克多斯（PVE 简称：潘 / 火潘）"@zh ;
    skos:altLabel "潘"@zh, "火潘"@zh, "潘克多斯"@zh ;
    rdfs:comment "PVE 打法里的「潘」「火潘」指潘克多斯(4344)，机制=阵亡后给敌方鬼火缠绕易伤(魂印1569)；绝非潘多拉(2518)/灾厄潘多拉(2965,3396)。"@zh .

seer:pet_4606 a seer:Pet ;
    seer:seerapiId "4606" ;
    rdfs:label "加尔鲁特（PVE 简称：草潘）"@zh ;
    skos:altLabel "草潘"@zh, "加尔鲁特"@zh ;
    rdfs:comment "PVE「草潘」= 加尔鲁特(4606)，草系。魂印1811：受攻击给对手叠「碧叶猛毒」，自身每损25%最大体力额外+2层；每层使对手攻击伤害-6%且用技能后受100固伤，最高12层，持续3回合(boss有效)。"@zh .

# ---- 星光三主宠（PVE 简称用星光形态，不是旧基础形态）------------------
seer:pet_4647 a seer:Pet ;
    seer:seerapiId "4647" ;
    rdfs:label "星光·丽莎布布（PVE 简称：丽莎）"@zh ;
    skos:altLabel "丽莎"@zh, "星光丽莎"@zh ;
    rdfs:comment "PVE 里的「丽莎」默认指星光·丽莎布布(4647)，非旧形态。"@zh .

seer:pet_4648 a seer:Pet ;
    seer:seerapiId "4648" ;
    rdfs:label "星光·鲁斯王（PVE 简称：鲁斯王）"@zh ;
    skos:altLabel "鲁斯王"@zh, "星光鲁斯王"@zh ;
    rdfs:comment "PVE 里的「鲁斯王」默认指星光·鲁斯王(4648)，非旧鲁斯王(306)。"@zh .

seer:pet_4649 a seer:Pet ;
    seer:seerapiId "4649" ;
    rdfs:label "星光·魔焰猩猩（PVE 简称：猩猩 / 魔焰）"@zh ;
    skos:altLabel "猩猩"@zh, "魔焰猩猩"@zh, "星光魔焰"@zh ;
    rdfs:comment "PVE 里的「猩猩」「魔焰」默认指星光·魔焰猩猩(4649)，非旧魔焰猩猩(309)。"@zh .

# PVE「艾欧」是老形态，专门做 PVE 强攻的，不是星光形态！
seer:pet_3437 a seer:Pet ;
    seer:seerapiId "3437" ;
    rdfs:label "艾欧丽娅（PVE 简称：艾欧，老形态 / PVE 专用）"@zh ;
    skos:altLabel "艾欧"@zh, "老艾欧"@zh ;
    rdfs:comment "PVE 里的「艾欧」= 老形态艾欧丽娅(3437)，PVE 专用强攻(低血增伤+吸血)；星光·艾欧丽娅(4911) 是另一形态，不是 PVE 默认简称所指。"@zh .

seer:pet_4911 a seer:Pet ;
    seer:seerapiId "4911" ;
    rdfs:label "星光·艾欧丽娅"@zh ;
    skos:altLabel "星光艾欧"@zh ;
    rdfs:comment "星光形态艾欧丽娅(4911)；与 PVE 简称「艾欧」(老形态 3437) 不是同一只。"@zh .

# ---- 其他核心 PVE 辅助（已核 id，补简称）------------------------------
seer:pet_3512 a seer:Pet ; seer:seerapiId "3512" ;
    skos:altLabel "表姐"@zh ;
    rdfs:comment "帝皇之御(3512)，PVE 里叫「表姐」：免异+锁血+死后减伤(魂印821)；守御八方(31505)自爆——攻击技不吃封属，整队后2次技能必先必暴(跨换宠，谁用谁扣)。"@zh .

seer:pet_3329 a seer:Pet ; seer:seerapiId "3329" ;
    skos:altLabel "六界"@zh, "六界帝神"@zh ;
    rdfs:comment "六界帝神(3329)=弹伤本体：先放「剑挥四方」，使下次受到的攻击伤害于对手出手流程结束100%反馈（出手后反馈，不是先手反馈）；魂印653在阶段结束体力低于对手时→全属性+1、下回合全技能先制+2。弹伤与自身面板/等级无关，配队用 1 级/压血，保证体力远低于Boss稳触发魂印先制；别当满级站场手用。"@zh .

seer:pet_3463 a seer:Pet ; seer:seerapiId "3463" ;
    skos:altLabel "时空"@zh, "时空界皇"@zh .

seer:pet_4377 a seer:Pet ; seer:seerapiId "4377" ;
    skos:altLabel "蒂朵"@zh .

