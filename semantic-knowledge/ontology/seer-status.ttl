@prefix seer: <http://example.org/seer#> .
@prefix pve:  <http://example.org/seer/pve#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# =====================================================================
# 赛尔号「异常状态」子本体（status 层）
# 依赖：seer-game.ttl（owl:imports）。seer:StatusAilment 是 seer:BattleEffect 的子类，
#       沿用 DESIGN.md 里「battle_effect → seer:BattleEffect」的映射，不另起一棵树。
#
# 权威来源（按可信度分级，详见 docs/异常状态本体.md）：
#   [A] SeerAPI battle_effect / battle_effect_type / resistance_category
#       —— 43 个状态的中文名、官方效果描述、官方类别、抗性分组；个体主键 = battle_effect.id
#   [A] SeerAPI skill_effect_type.skill[] —— 可施加该状态的技能（appliedBySkill）
#   [A] SeerAPI buff.desc —— 天生免疫条目、少数持续时间（immuneRule / duration）
#   [B] kb/docs/*/*.json stages[].traits —— Boss 关卡施加关系（由 ingest_status.py 生成到
#       seer-status-abox.ttl，本文件不写）
#   [C] 社区俗称 —— 仅进 statusAlias 与文档，不进任何数值字段
#
# 本文件是「定义层」：手工维护。改定义请直接改这里（不要靠 ingest_status.py 覆盖）。
# 派生关系（Boss 关卡/物种、命中关数）由 ingest_status.py 写入 seer-status-abox.ttl。
# =====================================================================

<http://example.org/seer/status> a owl:Ontology ;
    owl:imports <http://example.org/seer> ;
    rdfs:label "赛尔号异常状态子本体"@zh ;
    rdfs:comment "赛尔号异常状态（睡眠/害怕/麻痹/烧伤/中毒/冰封…）的类层次、属性与 43 个官方个体。定义层来自 SeerAPI battle_effect；Boss 侧施加关系由 ingest_status.py 派生到 seer-status-abox.ttl。"@zh .

# ---------------------------------------------------------------------
# 类层次（6 类）
# StatusAilment ⊂ BattleEffect（已存在的游戏本体类）
# 官方 5 类：0 控制类 / 1 弱化类 / 2 附属类 / 3 限制类 / 4 衍化类
# DamageOverTimeStatus 是横切类（每回合掉血），靠多重 rdf:type 表达，不破坏官方分类。
# ---------------------------------------------------------------------
seer:StatusAilment a owl:Class ;
    rdfs:subClassOf seer:BattleEffect ;
    rdfs:label "异常状态"@zh ;
    rdfs:comment "赛尔号战斗中的异常状态（官方 battle_effect）。一等公民是「这个状态会对我做什么」：能否让我无法行动、是否持续掉血、是否削弱能力。主键对齐 SeerAPI seer:battle_effect.id（seer:seerapiId）。"@zh .

seer:ControlStatus a owl:Class ;
    rdfs:subClassOf seer:StatusAilment ;
    rdfs:label "控场类异常状态"@zh ;
    rdfs:comment "对应 SeerAPI battle_effect_type#0 控制类：精灵无法行动（睡眠/害怕/麻痹/石化/疲惫/冰封/焚烬/诅咒/感染/瘫痪/神游/空定/狂信）。回挂 pve:mech_control。"@zh .

seer:WeakenStatus a owl:Class ;
    rdfs:subClassOf seer:StatusAilment ;
    rdfs:label "削弱类异常状态"@zh ;
    rdfs:comment "对应 SeerAPI battle_effect_type#1 弱化类：不锁行动，但降命中/降威力/降能力或持续掉血（中毒/烧伤/冻伤/混乱/失明/束缚…）。可被「弱化类抗性」抵抗。"@zh .

seer:AuxiliaryStatus a owl:Class ;
    rdfs:subClassOf seer:StatusAilment ;
    rdfs:label "附属类异常状态"@zh ;
    rdfs:comment "对应 SeerAPI battle_effect_type#2 附属类：伴随主状态出现的附加标记（星赐/星哲/狂暴/雷解/诅咒三态…）。PVE 关联极弱，seer:pveRelevant 标 false。"@zh .

seer:RestrictStatus a owl:Class ;
    rdfs:subClassOf seer:StatusAilment ;
    rdfs:label "限制类异常状态"@zh ;
    rdfs:comment "对应 SeerAPI battle_effect_type#3 限制类：限制切换/行动（瘫痪、凝滞、魇昧，均为与其它类别的双属，无独占个体）。"@zh .

seer:DamageOverTimeStatus a owl:Class ;
    rdfs:subClassOf seer:StatusAilment ;
    rdfs:label "持续伤害类异常状态"@zh ;
    rdfs:comment "横切分类：每回合/每回合结束按体力比例或固定值掉血（中毒/烧伤/寄生/冻伤/流血/烈焰诅咒/沉默）。这些个体同时保有官方类别（弱化类或附属类）的 rdf:type，故一个状态可属多类。"@zh .

# ---------------------------------------------------------------------
# 数据属性（16）
# ---------------------------------------------------------------------
seer:statusName a owl:DatatypeProperty ;
    rdfs:domain seer:StatusAilment ;
    rdfs:range xsd:string ;
    rdfs:label "状态名（官方中文名）"@zh ;
    rdfs:comment "必填。取自 SeerAPI battle_effect.name，与 rdfs:label 一致。"@zh .

seer:statusAlias a owl:DatatypeProperty ;
    rdfs:domain seer:StatusAilment ;
    rdfs:range xsd:string ;
    rdfs:label "俗称/同义写法"@zh ;
    rdfs:comment "可选，可多值。来自 kb/docs 的写法变体（如「睡眠控」「受击害怕」）、技能名用字（昏睡/沉睡）与社区俗称（冰冻→冰封、毒→中毒）。属 C 级来源，只做检索用，不作为数值依据。"@zh .

seer:statusCategory a owl:DatatypeProperty ;
    rdfs:domain seer:StatusAilment ;
    rdfs:range xsd:string ;
    rdfs:label "类目（枚举）"@zh ;
    rdfs:comment "必填，可多值。枚举：控制 / 持续伤害 / 削弱 / 附属 / 限制。与 rdf:type 断言的类别类一一对应（控制→ControlStatus、持续伤害→DamageOverTimeStatus、削弱→WeakenStatus、附属→AuxiliaryStatus、限制→RestrictStatus）。"@zh .

seer:isControl a owl:DatatypeProperty ;
    rdfs:domain seer:StatusAilment ;
    rdfs:range xsd:boolean ;
    rdfs:label "是否控场"@zh ;
    rdfs:comment "必填。true 当且仅当 SeerAPI battle_effect.type 含 0（控制类）。用于把细粒度状态回挂到 pve:mech_control，不采用社区「X控」的宽泛说法。"@zh .

seer:duration a owl:DatatypeProperty ;
    rdfs:domain seer:StatusAilment ;
    rdfs:range xsd:string ;
    rdfs:label "持续回合"@zh ;
    rdfs:comment "可选。只在有出处时写（官方描述/技能参数/社区实测）；无出处一律留空，不推算。睡眠即因官方只给「被攻击命中即解除」而无回合数，故意留空。"@zh .

seer:effect a owl:DatatypeProperty ;
    rdfs:domain seer:StatusAilment ;
    rdfs:range xsd:string ;
    rdfs:label "生效效果"@zh ;
    rdfs:comment "必填。SeerAPI battle_effect.desc 原文，不改写、不折算。"@zh .

seer:applyCondition a owl:DatatypeProperty ;
    rdfs:domain seer:StatusAilment ;
    rdfs:range xsd:string ;
    rdfs:label "施加条件/概率"@zh ;
    rdfs:comment "可选。取自 skill_effect_type.info 模板（含 {0} 占位符与固定概率），或 kb/docs 的 Boss 写法（受击/主动/先手/低级/高级）。"@zh .

seer:cureMethod a owl:DatatypeProperty ;
    rdfs:domain seer:StatusAilment ;
    rdfs:range xsd:string ;
    rdfs:label "解除方式"@zh ;
    rdfs:comment "可选。只在官方描述写了移除/转化条款时填（如睡眠「对手使用攻击技能且未miss时解除」、冰封「结束后转化为冻伤」）。"@zh .

seer:immuneRule a owl:DatatypeProperty ;
    rdfs:domain seer:StatusAilment ;
    rdfs:range xsd:string ;
    rdfs:label "免疫/抵抗规则"@zh ;
    rdfs:comment "可选。来源：SeerAPI buff.desc 的「天生免疫X状态」条目，或 resistance_category 抗性分组（控制类/弱化类/无）。"@zh .

seer:stackable a owl:DatatypeProperty ;
    rdfs:domain seer:StatusAilment ;
    rdfs:range xsd:boolean ;
    rdfs:label "是否可叠加"@zh ;
    rdfs:comment "可选。官方无此字段，只在描述明确隐含互斥时才断言（如 buff「若对手不处于冰封状态」）；其余留空，不做统一填 false 的伪精确。"@zh .

seer:appliedBySkill a owl:DatatypeProperty ;
    rdfs:domain seer:StatusAilment ;
    rdfs:range xsd:string ;
    rdfs:label "施加技能（示例集）"@zh ;
    rdfs:comment "可选，可多值，格式「技能名(seerapiId)」。来源 SeerAPI skill_effect_type.skill[] 经 scrape/skills-index.json 反查技能名；每状态最多 6 条示例，全集数目写进 applyCondition，不谎称完整。"@zh .

seer:counterAdvice a owl:DatatypeProperty ;
    rdfs:domain seer:StatusAilment ;
    rdfs:range xsd:string ;
    rdfs:label "反制建议"@zh ;
    rdfs:comment "可选，可多值。来源 scrape/counter_rules.md 的机制行与 kb/docs 的 why 文本。"@zh .

seer:dataSource a owl:DatatypeProperty ;
    rdfs:domain seer:StatusAilment ;
    rdfs:range xsd:string ;
    rdfs:label "数据出处"@zh ;
    rdfs:comment "可选，可多值。逐条列出该个体每个字段的来源（SeerAPI 资源名+id / kb/docs / 社区），便于回溯。"@zh .

seer:officialCategory a owl:DatatypeProperty ;
    rdfs:domain seer:StatusAilment ;
    rdfs:range xsd:string ;
    rdfs:label "官方类别原文"@zh ;
    rdfs:comment "可选。SeerAPI battle_effect_type 的中文名，保留双属（如「控制类,衍化类」）。是 statusCategory 的出处。"@zh .

seer:bossStageCount a owl:DatatypeProperty ;
    rdfs:domain seer:StatusAilment ;
    rdfs:range xsd:integer ;
    rdfs:label "Boss 关卡命中数"@zh ;
    rdfs:comment "派生字段，由 ingest_status.py 从 kb/docs 重算写入 seer-status-abox.ttl：trait 文本命中该状态名的关卡数。"@zh .

seer:pveRelevant a owl:DatatypeProperty ;
    rdfs:domain seer:StatusAilment ;
    rdfs:range xsd:boolean ;
    rdfs:label "PVE 是否相关"@zh ;
    rdfs:comment "派生字段。true = 在 kb/docs 的 Boss 关里有命中，或存在可施加它的技能；附属类一律 false（当前 PVE 关卡数据里不出现）。"@zh .

# ---------------------------------------------------------------------
# 对象属性（2）
# ---------------------------------------------------------------------
seer:inflictedByEnemy a owl:ObjectProperty ;
    rdfs:domain seer:StatusAilment ;
    rdfs:range pve:Enemy ;
    rdfs:label "被该关卡 Boss 施加"@zh ;
    rdfs:comment "派生关系，由 ingest_status.py 写入 seer-status-abox.ttl：kb/docs 里 trait 命中该状态名 → 对应 pve:Enemy。用于 boss 工具的 statusDetail 与 status 工具的关卡反查。"@zh .

seer:inflictedByPet a owl:ObjectProperty ;
    rdfs:domain seer:StatusAilment ;
    rdfs:range seer:Pet ;
    rdfs:label "施加者精灵（Boss 物种）"@zh ;
    rdfs:comment "派生关系，由 ingest_status.py 写入 abox：经 pve:Enemy pve:bossSpecies 反查。技能侧的「技能→精灵」因 SeerAPI learned_by_pet 返回空而无法建立，是已知缺口。"@zh .

#=====================================================================
# 个体（43）—— 1:1 对齐 SeerAPI battle_effect；seerapiId = battle_effect.id
# 官方名/desc/类别/抗性分组 = [A] SeerAPI；技能侧 = [A] skill_effect_type；
# 俗称 = [C] 社区（仅检索用，不作数值依据）。
#=====================================================================

seer:status_paralysis a seer:StatusAilment, seer:ControlStatus ;
    rdfs:label "麻痹"@zh ;
    seer:statusName "麻痹" ;
    seer:seerapiId "0" ;
    seer:statusAlias "麻痹控", "麻" ;
    seer:statusCategory "控制" ;
    seer:isControl true ;
    seer:officialCategory "控制类" ;
    seer:effect "控制类异常状态，该状态下精灵无法行动" ;
    seer:immuneRule "buff#4030「回合开始时若自身持有回能标记，则当回合自身免疫受到的麻痹、害怕、疲惫异常状态」。可被控制类抗性抵抗（resistance_category#0）。" ;
    seer:applyCondition "skill_effect_type#75「命中时有30%概率令对手麻痹、睡眠或害怕」；skill_effect_type#10「命中后{0}%令对方麻痹」；skill_effect_type#163「{0}回合内若对手使用属性技能则随机附加烧伤、冻伤、中毒、麻痹、害怕、睡眠中的一种异常状态」（此类模板共覆盖 172 个技能，此处列 3 条）" ;
    seer:appliedBySkill "七色光芒(11138)" ;
    seer:appliedBySkill "混沌声波(12932)" ;
    seer:appliedBySkill "战羊气刃(13060)" ;
    seer:appliedBySkill "扰乱侵袭(15480)" ;
    seer:appliedBySkill "放电(10010)" ;
    seer:appliedBySkill "雷之牙(10041)" ;
    seer:counterAdvice "免疫异常状态（skill_effect_type#48「{0}回合内免疫所有受到的异常状态」、#191「免疫并反弹所有受到的异常状态」、#802「免疫控制类异常状态」）；堆控制类抗性（resistance_category#0）；先手秒杀（scrape/counter_rules.md「控场」行）" ;
    seer:dataSource "SeerAPI battle_effect#0（name/desc/type/resistance）" ;
    seer:dataSource "SeerAPI skill_effect_type#75,10,163（applyCondition/appliedBySkill）" ;
    seer:dataSource "SeerAPI resistance_category#0（immuneRule）" ;
    seer:dataSource "C 级：社区/文档俗称（仅 statusAlias，不作数值依据）" ;
    seer:dataSource "kb/docs 命中关数与关卡/物种关系见 seer-status-abox.ttl（seer:bossStageCount / seer:inflictedByEnemy）" ;
    seer:pveRelevant true .

seer:status_poison a seer:StatusAilment, seer:WeakenStatus, seer:DamageOverTimeStatus ;
    rdfs:label "中毒"@zh ;
    seer:statusName "中毒" ;
    seer:seerapiId "1" ;
    seer:statusAlias "毒" ;
    seer:statusCategory "削弱", "持续伤害" ;
    seer:isControl false ;
    seer:officialCategory "弱化类" ;
    seer:effect "弱化类异常状态，该状态下每回合对手行动开始时都会扣除最大体力的1/8" ;
    seer:immuneRule "buff#224「{0}回合内免疫控制类异常状态（烧伤、冻伤、中毒、流血、失明无法免疫）」→ 无法用「免疫控制类异常状态」挡住；可被弱化类抗性抵抗（resistance_category#1）。" ;
    seer:applyCondition "skill_effect_type#74「命中时有30%概率令对手中毒、烧伤或冻伤」；skill_effect_type#1364「随机附加烧伤、冻伤、中毒、焚烬、冰封、感染中的2种异常状态，未触发控制类异常状态则2回合内令对手使用的属性技能无效」；skill_effect_type#2123「消除对手回合类效果，消除成功令对手感染且自身每有1点灵茉之芯额外附加中毒、睡眠、 寄生中的前1种异常状态，未触发则吸取对手最大体力的1/{0}」（此类模板共覆盖 128 个技能，此处列 3 条）" ;
    seer:appliedBySkill "奇幻光芒(11140)" ;
    seer:appliedBySkill "迷幻之翼(12169)" ;
    seer:appliedBySkill "混沌魔光(12474)" ;
    seer:appliedBySkill "神奇射线(12643)" ;
    seer:appliedBySkill "幻之圣印(12905)" ;
    seer:appliedBySkill "扰乱侵袭(15480)" ;
    seer:counterAdvice "持续掉血：减伤珠/吸血/回复或速杀（scrape/counter_rules.md「每回合固伤N」行）；kb/docs 实战多用续航站场硬扛" ;
    seer:dataSource "SeerAPI battle_effect#1（name/desc/type/resistance）" ;
    seer:dataSource "SeerAPI skill_effect_type#74,1364,2123（applyCondition/appliedBySkill）" ;
    seer:dataSource "SeerAPI resistance_category#1（immuneRule）" ;
    seer:dataSource "C 级：社区/文档俗称（仅 statusAlias，不作数值依据）" ;
    seer:dataSource "kb/docs 命中关数与关卡/物种关系见 seer-status-abox.ttl（seer:bossStageCount / seer:inflictedByEnemy）" ;
    seer:pveRelevant true .

seer:status_burn a seer:StatusAilment, seer:WeakenStatus, seer:DamageOverTimeStatus ;
    rdfs:label "烧伤"@zh ;
    seer:statusName "烧伤" ;
    seer:seerapiId "2" ;
    seer:statusAlias "烧伤控", "烧" ;
    seer:statusCategory "削弱", "持续伤害" ;
    seer:isControl false ;
    seer:officialCategory "弱化类" ;
    seer:effect "弱化类异常状态，该状态下攻击技能的威力会减少50%且每回合对手行动开始时都会扣除最大体力的1/8" ;
    seer:immuneRule "buff#224「{0}回合内免疫控制类异常状态（烧伤、冻伤、中毒、流血、失明无法免疫）」→ 无法用「免疫控制类异常状态」挡住；可被弱化类抗性抵抗（resistance_category#1）。" ;
    seer:applyCondition "skill_effect_type#74「命中时有30%概率令对手中毒、烧伤或冻伤」；skill_effect_type#464「遇到天敌时{0}%令对手烧伤」；skill_effect_type#1364「随机附加烧伤、冻伤、中毒、焚烬、冰封、感染中的2种异常状态，未触发控制类异常状态则2回合内令对手使用的属性技能无效」（此类模板共覆盖 248 个技能，此处列 3 条）" ;
    seer:appliedBySkill "奇幻光芒(11140)" ;
    seer:appliedBySkill "迷幻之翼(12169)" ;
    seer:appliedBySkill "混沌魔光(12474)" ;
    seer:appliedBySkill "神奇射线(12643)" ;
    seer:appliedBySkill "幻之圣印(12905)" ;
    seer:appliedBySkill "扰乱侵袭(15480)" ;
    seer:counterAdvice "持续掉血：减伤珠/吸血/回复或速杀（scrape/counter_rules.md「每回合固伤N」行）；kb/docs 实战多用续航站场硬扛" ;
    seer:dataSource "SeerAPI battle_effect#2（name/desc/type/resistance）" ;
    seer:dataSource "SeerAPI skill_effect_type#74,464,1364（applyCondition/appliedBySkill）" ;
    seer:dataSource "SeerAPI resistance_category#1（immuneRule）" ;
    seer:dataSource "C 级：社区/文档俗称（仅 statusAlias，不作数值依据）" ;
    seer:dataSource "kb/docs 命中关数与关卡/物种关系见 seer-status-abox.ttl（seer:bossStageCount / seer:inflictedByEnemy）" ;
    seer:pveRelevant true .

seer:status_parasite_foe a seer:StatusAilment, seer:WeakenStatus ;
    rdfs:label "寄生对手"@zh ;
    seer:statusName "寄生对手" ;
    seer:seerapiId "3" ;
    seer:statusCategory "削弱" ;
    seer:isControl false ;
    seer:officialCategory "（官方 type 为空）" ;
    seer:effect "弱化类异常状态，该状态下精灵每回合对手行动开始时扣除最大体力的1/8，同时对手会恢复等量的体力" ;
    seer:immuneRule "resistance_category#2（无抗性分组），既不吃控制类抗性也不吃弱化类抗性。" ;
    seer:dataSource "SeerAPI battle_effect#3（name/desc/type/resistance）" ;
    seer:dataSource "官方 type 为空 → statusCategory 取自 desc 首句「desc 首句「弱化类」」" ;
    seer:dataSource "SeerAPI resistance_category#2（immuneRule）" ;
    seer:dataSource "kb/docs 命中关数与关卡/物种关系见 seer-status-abox.ttl（seer:bossStageCount / seer:inflictedByEnemy）" ;
    seer:pveRelevant false .

seer:status_parasite a seer:StatusAilment, seer:WeakenStatus, seer:DamageOverTimeStatus ;
    rdfs:label "寄生"@zh ;
    seer:statusName "寄生" ;
    seer:seerapiId "4" ;
    seer:statusCategory "削弱", "持续伤害" ;
