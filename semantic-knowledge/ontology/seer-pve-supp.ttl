# --- 嘲风 魂印 2058：整条 PVE 无效（2026-11-25，单独处理）---------------
# 依据：原文按 | 分三段，三段自身都没有标记，末尾单独一段是「（boss无效）」。
# 位置规则：标记单独成段且位于末尾 → 作用于整条，不是只作用于最后一段。
# 结论：嘲风在 PVE 里不能用这个魂印（风龙结/反转强化/焚烬全失效）；
#       它在这类关里的价值来自技能「天叩·千钧一发」的额外 1000 固伤。
seer:soulmark_2058
    seer:pveEffective false ;
    rdfs:comment "PVE 整条无效。原文末尾单独一段「（boss无效）」作用于整条（标记单独成段且位于末尾＝整条级），不是分段标记；风龙结计数/反转强化/焚烬在 PVE 全部不生效。嘲风在 PVE 靠技能「天叩·千钧一发」的额外 1000 固伤，不靠魂印。"@zh .

@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pve: <http://example.org/seer/pve#> .

# --- 站场技：精灵靠哪个技能站住（2026-11-25，用户：希可洛靠奇镰解放站场）----
# 现状问题：本体能说「希可洛会哪些技能」，但说不出「站场按哪个」。
# 技能够多不代表 AI 知道该按哪一个；所以给精灵加一个明确的站场技 + 用法说明。
seer:sustainSkill a owl:ObjectProperty ;
    rdfs:label "站场技（这一关/这套打法靠它站住）"@zh ;
    rdfs:domain seer:Pet ;
    rdfs:range seer:Skill .

seer:sustainNote a owl:DatatypeProperty ;
    rdfs:label "站场用法说明"@zh ;
    rdfs:domain seer:Pet ;
    rdfs:range xsd:string .

seer:pet_4487 pve:hasRole pve:磨血站场 ;
    seer:sustainSkill seer:skill_36481 ;
    seer:sustainNote "就一个动作：一直按奇镰解放(36481，PP3，200威力，必中)。输出与续航是同一个技能——消除对手回合类效果+消除对手能力提升+解除自身能力下降+回满自身体力+回满全部PP，五条全 boss有效；PP 只有 3 但每次命中就回满，所以站着一直按即可。唯一例外是关卡带「免疫威力高于100」时它的红伤被免，那种关才另配输出。"@zh .

# --- 同样会奇镰解放的：卡莎 / 小镰（2026-11-25，用户：同样拥有奇镰解放的也是）----
# 奇镰解放把输出与续航合在一个技能里（回满体力+回满全部PP），所以凡是会它的精灵，
# PVE 里的站场方式就是「一直按它磨」，不需要另编技能循环。
seer:pet_4484 seer:sustainSkill seer:skill_36481 ;
    seer:sustainNote "一样靠奇镰解放一直磨：回满体力+回满全部PP+消回合+消强+解自身下降，输出与续航同一技能；卡莎的特防体配置就是把这份回满撑得更久。"@zh .
seer:pet_4488 seer:sustainSkill seer:skill_36481 ;
    seer:sustainNote "一样靠奇镰解放一直磨：200威力必中，打完回满体力并回满全部PP，所以能一直站；不需要别的技能循环。"@zh .

# --- 阵容（Lineup）：社区有固定叫法的一组精灵（2026-11-25，用户：星巴克是一个阵容）----
# 为什么需要：本体原来只有 Pet/Skill/Soulmark/Factor，没有「组合」这一层。
# 「星巴克」这类名字既不是精灵也不是技能，硬塞进 pets 数组就解析不了。
# 定位：阵容 = 一组会一起上阵的精灵 + 一句怎么用；成员顺序用 lineupNote 写清。
seer:Lineup a owl:Class ;
    rdfs:label "阵容（固定搭配/组合）"@zh ;
    rdfs:comment "社区有固定叫法的精灵组合。用于解析「星巴克」这类阵容简称；成员用 seer:lineupMember 挂。与 Pet 的区别：阵容不是单只，不能上阵，只是配方。"@zh .

seer:lineupMember a owl:ObjectProperty ;
    rdfs:label "阵容成员"@zh ;
    rdfs:domain seer:Lineup ;
    rdfs:range seer:Pet .

seer:lineupNote a owl:DatatypeProperty ;
    rdfs:label "阵容用法说明"@zh ;
    rdfs:domain seer:Lineup ;
    rdfs:range xsd:string .

seer:lineupVariantOf a owl:ObjectProperty ;
    rdfs:label "阵容的变体/改版"@zh ;
    rdfs:domain seer:Lineup ;
    rdfs:range seer:Lineup .

# --- 阵容实例（2026-11-25，用户给的定义与用法）----------------------------------
seer:lineup_xingbake a seer:Lineup ;
    rdfs:label "星巴克"@zh ;
    skos:altLabel "星巴克公式"@zh ;
    seer:lineupMember seer:pet_4649, seer:pet_4648 ;
    seer:lineupNote "核心是让星光·魔焰猩猩能出手，对 BOSS 上魂印固伤；再由星光·鲁斯王吃到第二命时用「克制」把 BOSS 的伤害反弹回去打死 BOSS。克罗（大克罗 3443 / 小克罗 2977）给猩猩上减伤只是为了让它活到出手，非必须。常见配银翼套。"@zh .

seer:lineup_sanxiongdi a seer:Lineup ;
    rdfs:label "三兄弟"@zh ;
    skos:altLabel "刘关张"@zh ;
    seer:lineupMember seer:pet_3074, seer:pet_3087, seer:pet_3060 ;
    seer:lineupNote "刘备+关羽+张飞（仁天之君·刘备 3074 / 圣武天尊·关羽 3087 / 盖世张飞 3060），走的是三人组自带的联动加成。本体另有基础形态 2512 昭烈帝刘备 / 2520 武圣·关羽 / 2530 万人敌张飞，没有强化形态时用它们。"@zh .

seer:lineup_xiyou a seer:Lineup ;
    rdfs:label "西游"@zh ;
    seer:lineupMember seer:pet_2727, seer:pet_3519, seer:pet_3409, seer:pet_2735 ;
    seer:lineupNote "蒙奇多克 2727 + 沙悟净 3519 + 三藏 3409 + 天河神将 2735，西游系列的组合加成。"@zh .

# --- 八戒 = 天河神将（及其小形态）；魂印消强（2026-11-25，用户说明）------------
# 冲突处理：魂印 135 原文「受到攻击将消除对手能力提升状态」没有 boss 标记，
# 但 API 的 pve_effective 是 false。用户实测这条就是用来消强的 → 判定为 PVE 有效。
# 做法：pveEffective 保留 API 原值（溯源），另设 pveVerdict 记人工判定，工具优先读它。
seer:pveVerdict a owl:DatatypeProperty ;
    rdfs:label "PVE 人工判定（有效/无效/未知）"@zh ;
    rdfs:comment "与 seer:pveEffective（API 原值）并存：冲突时以免人工判定为准，pveEffective 仅溯源。"@zh ;
    rdfs:domain seer:Soulmark ;
    rdfs:range xsd:string .

seer:soulmark_135 seer:pveVerdict "有效" ;
    rdfs:comment "PVE 有效：原文无 boss 标记，API 记为 false，但用户实测「八戒/天河神将」就是靠这条受击消强。冲突按人工判定为准。"@zh .

seer:pet_2735 rdfs:comment "PVE 里「八戒」＝天河神将（2735）及它的小形态；作用是魂印 135「受到攻击将消除对手能力提升状态」——受击即消掉 Boss 强化，本身不用出手。西游阵容成员之一。"@zh .

# --- 哈迪斯定位修正（2026-11-25，用户指出定位有问题）---------------------------
# 原标注：attacker + firstStrike（错）。它不负责把血打下去，是收尾的那一刀：
#   魂印 480/611：登场首回合受致命伤害残留1点血，下回合攻击技能先制+2/+3 且附加对手最大体力1/3固伤；
#   技能 破寂同灾(85/先3) 附加对手已损失体力35%百分比。
# 另：魂印 480 原文只在「使对手害怕」处标了 boss无效，留1血/先制/固伤部分没标记 → 部分有效。
seer:pet_3141 pve:hasRole pve:finisher ;
    rdfs:comment "PVE 定位＝补刀。魂印 480/611：登场首回合受致命伤害残留1点血，下回合攻击技能先制+2/+3 并附加对手最大体力1/3的固伤；技能破寂同灾(85/先制+3) 附加对手已损体力35%百分比。所以它只上最后一刀，不承担前段输出——原标注的「强攻/必先」是错的。"@zh .

seer:soulmark_480 seer:pveVerdict "部分有效" ;
    rdfs:comment "原文只在「使对手害怕」处标了 boss 无效；「首回合受致命留1点血＋下回合先制+2＋附加对手最大体力1/3固伤」没有标记，PVE 实测可用（哈迪斯就是靠这段补刀）。API pve_effective=false 只作溯源。"@zh .
