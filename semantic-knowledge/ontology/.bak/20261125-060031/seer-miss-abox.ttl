seer:skillfx_25294_0 a seer:SkillEffect ;
    seer:bossEffective true ;
    seer:effectInfo "3回合内若对手使用属性技能则命中前令对手所有技能随机降低1-3点PP值；3回合内若对手使用攻击技能则使用后受到对手最大体力1/3的百分比伤害；己方免疫下2次受到的异常状态;技能结束后对手体力值高于0，则50%进行一次额外行动以触发星皇之怒（星皇之怒：令自身2回合内回合类效果无法被消除（后出手则延续至下2回合）；下2回合自身所有技能先制+2）" ;
    seer:effectTypeOf seer:setype_1095 .

seer:skillfx_25295_0 a seer:SkillEffect ;
    seer:bossEffective true ;
