sf:sm_821 a sf:Soulmark,
        owl:NamedIndividual ;
    rdfs:label "帝皇之御魂印（免异+锁血+反弹+死后减伤）"@zh ;
    sf:grantsBuff sf:buf先制,
        sf:buf免疫异常,
