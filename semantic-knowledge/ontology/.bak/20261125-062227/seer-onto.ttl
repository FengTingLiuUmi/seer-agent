        owl:NamedIndividual ;
    rdfs:label "六界帝神（六界）"@zh ;
    sf:hasSoulmark sf:sm_653 ;
    sf:seerapiId "3329" ;
    sf:substitutesFor sf:pet_whm .

sf:pet_3396 a sf:Pet,
        owl:NamedIndividual ;
    rdfs:label "灾厄女神潘多拉（潘）"@zh ;
    sf:hasSoulmark sf:sm_2170,
        sf:sm_709 ;
    sf:seerapiId "3396" .

sf:pet_3437 a sf:Pet,
        owl:NamedIndividual ;
    rdfs:label "艾欧丽娅（艾欧）"@zh ;
    sf:hasSoulmark sf:sm_1209,
        sf:sm_752 ;
    sf:seerapiId "3437" ;
    sf:substitutesFor sf:pet_whm .

sf:pet_3463 a sf:Pet,
        owl:NamedIndividual ;
    rdfs:label "时空界皇（时空）"@zh ;
    sf:hasSoulmark sf:sm_776 ;
    sf:seerapiId "3463" .

sf:pet_3512 a sf:Pet,
        owl:NamedIndividual ;
    rdfs:label "帝皇之御（表姐）"@zh ;
    sf:hasSoulmark sf:sm_821 ;
    sf:seerapiId "3512" .

sf:pet_4377 a sf:Pet,
        owl:NamedIndividual ;
    rdfs:label "蒂朵"@zh ;
    sf:hasSoulmark sf:sm_1601 ;
    sf:seerapiId "4377" .

sf:pet_sp a sf:Pet,
        owl:NamedIndividual ;
    rdfs:label "圣灵谱尼（圣普/圣谱）"@zh ;
    rdfs:comment "免费顶级强攻；SeerAPI id 待锁定"@zh .

sf:playsRole a owl:ObjectProperty ;
    rdfs:label "扮演定位（已废弃，改用 pve:hasRole）"@zh ;
    rdfs:comment "2026-11-25 迁移：数据已并入 seer-pve-roles.ttl 的 pve:hasRole，实体统一到 seer:pet_*；新数据不要再写本谓词。"@zh ;
    rdfs:domain sf:Pet ;
    rdfs:range sf:Role ;
    owl:deprecated true .

sf:power a owl:DatatypeProperty ;
    rdfs:label "威力"@zh ;
    rdfs:domain sf:Skill ;
    rdfs:range xsd:integer .

sf:precedes a owl:ObjectProperty ;
    rdfs:label "紧接在前"@zh ;
    rdfs:domain sf:Step ;
    rdfs:range sf:Step .

sf:priority a owl:DatatypeProperty ;
    rdfs:label "先制值"@zh ;
    rdfs:domain sf:Skill ;
    rdfs:range xsd:integer .

sf:recommendedConfig a owl:ObjectProperty ;
    rdfs:label "推荐配置"@zh ;
    rdfs:domain sf:Boss ;
    rdfs:range sf:Config .

sf:recommendedPet a owl:ObjectProperty ;
    rdfs:label "推荐打手"@zh ;
    rdfs:domain sf:Boss ;
    rdfs:range sf:Pet .

sf:recommendedPetForStage a owl:ObjectProperty ;
    rdfs:label "推荐关卡打手"@zh ;
    rdfs:domain sf:Stage ;
    rdfs:range sf:Pet .

sf:recommendedStrategy a owl:ObjectProperty ;
    rdfs:label "推荐打法（机制→打法 与 Boss→打法 复用）"@zh ;
    rdfs:range sf:Strategy .

sf:recommendedStrategyForPet a owl:ObjectProperty ;
    rdfs:label "精灵适合的打法"@zh ;
    rdfs:domain sf:Pet ;
    rdfs:range sf:Strategy .

sf:rewardPet a owl:ObjectProperty ;
    rdfs:label "产出精灵"@zh ;
    rdfs:domain sf:Reward ;
    rdfs:range sf:Pet .

sf:rewards a owl:ObjectProperty ;
    rdfs:label "产出"@zh ;
    rdfs:domain sf:Stage ;
    rdfs:range sf:Reward .

sf:ruleArgs a owl:DatatypeProperty ;
    rdfs:label "规则参数（rules[].args，JSON 数组，如 [6] 表示 6 回合）"@zh ;
    rdfs:domain sf:FactorRule ;
    rdfs:range xsd:string .

sf:ruleFailTips a owl:DatatypeProperty ;
    rdfs:label "违反规则时的结算提示（rules[].fail_tips）"@zh ;
    rdfs:domain sf:FactorRule ;
    rdfs:range xsd:string .

sf:ruleId a owl:DatatypeProperty ;
    rdfs:label "规则编号（SeerAPI rules[].id，关卡内规则ID）"@zh ;
    rdfs:domain sf:FactorRule ;
    rdfs:range xsd:integer .

sf:ruleTips a owl:DatatypeProperty ;
    rdfs:label "规则提示（rules[].tips）"@zh ;
    rdfs:domain sf:FactorRule ;
    rdfs:range xsd:string .

sf:ruleUserInfo a owl:DatatypeProperty ;
    rdfs:label "规则状态查询键（rules[].user_info，JSON 数组）"@zh ;
    rdfs:domain sf:FactorRule ;
    rdfs:range xsd:string .

sf:seerapiId a owl:DatatypeProperty ;
    rdfs:label "SeerAPI id"@zh ;
    rdfs:range xsd:string .

sf:skillCategory a owl:DatatypeProperty ;
    rdfs:label "技能类别(物理攻击/特殊攻击/属性技能)"@zh ;
    rdfs:domain sf:Skill ;
    rdfs:range xsd:string .

sf:stageRule a owl:ObjectProperty ;
    rdfs:label "受限规则（该难度下每关都受此规则约束）"@zh ;
    rdfs:domain sf:Stage ;
    rdfs:range sf:FactorRule .

sf:stage_yita_1 a sf:Stage,
        owl:NamedIndividual ;
    rdfs:label "伊塔回溯型·第1关"@zh ;
    sf:bannedPet sf:pet_dianwei,
        sf:pet_sike,
        sf:pet_whm ;
    sf:hasBoss sf:boss_yita_1 ;
    sf:inDifficulty sf:地狱 ;
    sf:usesStrategy sf:strat_yita_1a,
        sf:strat_yita_1b .

sf:stage_yita_2 a sf:Stage,
        owl:NamedIndividual ;
    rdfs:label "伊塔回溯型·第2关"@zh ;
    sf:hasBoss sf:boss_yita_2 ;
    sf:inDifficulty sf:地狱 ;
    sf:usesStrategy sf:strat_yita_2a,
        sf:strat_yita_2b .

sf:stage_yita_3 a sf:Stage,
        owl:NamedIndividual ;
    rdfs:label "伊塔回溯型·第3关"@zh ;
    sf:hasBoss sf:boss_yita_3 ;
    sf:inDifficulty sf:地狱 ;
    sf:usesStrategy sf:strat_yita_3a,
        sf:strat_yita_3b .

sf:stage_yita_4 a sf:Stage,
        owl:NamedIndividual ;
    rdfs:label "伊塔回溯型·第4关"@zh ;
    sf:hasBoss sf:boss_yita_4 ;
    sf:inDifficulty sf:地狱 ;
    sf:usesStrategy sf:strat_yita_4a,
        sf:strat_yita_4b .

sf:stage_yita_5 a sf:Stage,
        owl:NamedIndividual ;
    rdfs:label "伊塔回溯型·第5关"@zh ;
    sf:hasBoss sf:boss_yita_5 ;
    sf:inDifficulty sf:地狱 ;
    sf:rewards sf:reward_yita ;
    sf:usesStrategy sf:strat_yita_5a,
        sf:strat_yita_5b .

sf:stepIndex a owl:DatatypeProperty ;
    rdfs:label "步骤序号"@zh ;
    rdfs:domain sf:Step ;
    rdfs:range xsd:integer .

sf:substitutesFor a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "可替代"@zh ;
    rdfs:domain sf:Pet ;
    rdfs:range sf:Pet .

sf:threshold a owl:DatatypeProperty ;
    rdfs:label "阈值"@zh ;
    rdfs:domain sf:Mechanism ;
    rdfs:range xsd:integer .

sf:traitName a owl:DatatypeProperty ;
    rdfs:label "特性大类名（神话/迅捷/疾行/进化/腐化/物攻格挡/特攻格挡/硬化/戒备/复苏/致盲/锁定…）"@zh ;
    rdfs:domain sf:BossTrait ;
    rdfs:range xsd:string .

sf:traitNo a owl:DatatypeProperty ;
    rdfs:label "特性大类序号（百科：共29大类88小类；复苏=9、要害探寻=10、驱散=11、致盲=12）"@zh ;
    rdfs:domain sf:BossTrait ;
    rdfs:range xsd:integer .

sf:traitSource a owl:DatatypeProperty ;
    rdfs:label "特性证据来源（seerapi_desc=SeerAPI tasks[].desc／icon=战斗图标实测／kb=攻略反推）"@zh ;
    rdfs:domain sf:BossTrait ;
    rdfs:range xsd:string .

sf:traitVariant a owl:DatatypeProperty ;
    rdfs:label "特性小类描述（如 复苏：首次死亡后恢复全部体力／一局可触发2次）"@zh ;
    rdfs:domain sf:BossTrait ;
    rdfs:range xsd:string .

sf:usesConfig a owl:ObjectProperty ;
    rdfs:label "采用配置"@zh ;
    rdfs:range sf:Config .

sf:usesPet a owl:ObjectProperty ;
    rdfs:label "出场精灵"@zh ;
    rdfs:domain sf:Step ;
    rdfs:range sf:Pet .

sf:usesStrategy a owl:ObjectProperty ;
    rdfs:label "采用打法"@zh ;
    rdfs:domain sf:Stage ;
    rdfs:range sf:Strategy .

