# 由 seer-all.owl(2026-11-25 02:12 有效快照) 重建；行内说明性注释已丢失，rdfs:comment 保留。
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix seer: <http://example.org/seer#> .
@prefix sf: <http://example.org/seer-factor#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

sf:accuracy a owl:DatatypeProperty ;
    rdfs:label "命中率"@zh ;
    rdfs:domain sf:Skill ;
    rdfs:range xsd:integer .

sf:atkNum a owl:DatatypeProperty ;
    rdfs:label "连击数"@zh ;
    rdfs:domain sf:Skill ;
    rdfs:range xsd:integer .

sf:bannedPet a owl:ObjectProperty ;
    rdfs:label "禁用精灵"@zh ;
    rdfs:domain sf:Stage ;
    rdfs:range sf:Pet .

sf:bossTraitDesc a owl:DatatypeProperty ;
    rdfs:label "Boss特性原文（SeerAPI tasks[].desc，如「先制+3，每回合必定打出致命一击」）"@zh ;
    rdfs:domain sf:Boss ;
    rdfs:range xsd:string .

sf:cfg_弹伤套 a sf:Config,
        owl:NamedIndividual ;
    rdfs:label "弹伤配置(银翼套+假面+洛林卡之星)"@zh ;
    sf:hasEquipment sf:假面,
        sf:洛林卡之星,
        sf:银翼套 .

sf:cfg_强攻套 a sf:Config,
        owl:NamedIndividual ;
    rdfs:label "强攻配置(漆黑+假面+洛林卡之星)"@zh ;
    sf:hasEquipment sf:假面,
        sf:洛林卡之星,
        sf:漆黑 .

sf:cfg_站场套 a sf:Config,
        owl:NamedIndividual ;
    rdfs:label "站场配置(耀世+假面+神话)"@zh ;
    sf:hasEquipment sf:假面,
        sf:神话,
        sf:耀世 .

sf:configAtk a owl:DatatypeProperty ;
    rdfs:label "攻击配置（爆攻/压血…）"@zh ;
    rdfs:range xsd:string .

sf:configDef a owl:DatatypeProperty ;
    rdfs:label "防御定格"@zh ;
    rdfs:range xsd:integer .

sf:configMaxHp a owl:DatatypeProperty ;
    rdfs:label "体力上限"@zh ;
    rdfs:range xsd:integer .

sf:configMinHp a owl:DatatypeProperty ;
    rdfs:label "体力下限"@zh ;
    rdfs:range xsd:integer .

sf:counterStrategy a owl:ObjectProperty ;
    rdfs:label "反制打法"@zh ;
    rdfs:domain sf:Mechanism ;
    rdfs:range sf:Strategy .

sf:counters a owl:ObjectProperty ;
    rdfs:label "克制"@zh ;
    rdfs:domain sf:ElementType ;
    rdfs:range sf:ElementType .

sf:countersBuff a owl:ObjectProperty ;
    rdfs:label "克制效果"@zh ;
    rdfs:domain sf:Strategy ;
    rdfs:range sf:Buff .

sf:factorDesignId a owl:DatatypeProperty ;
    rdfs:label "SeerAPI factor_design id（同一个因子关卡设计覆盖 easy/normal/hard）"@zh ;
    rdfs:range xsd:integer .

sf:grantsBuff a owl:ObjectProperty ;
    rdfs:label "赋予效果（魂印/技能）"@zh ;
    rdfs:range sf:Buff .

sf:hasBoss a owl:ObjectProperty ;
    rdfs:label "关卡对应Boss"@zh ;
    rdfs:domain sf:Stage ;
    rdfs:range sf:Boss .

sf:hasBossTrait a owl:ObjectProperty ;
    rdfs:label "具有Boss特性（战斗状态图标）"@zh ;
    rdfs:domain sf:Boss ;
    rdfs:range sf:BossTrait .

sf:hasBuff a owl:ObjectProperty ;
    rdfs:label "施加效果"@zh ;
    rdfs:domain sf:Mechanism ;
    rdfs:range sf:Buff .

sf:hasElement a owl:ObjectProperty ;
    rdfs:label "所属属性"@zh ;
    rdfs:range sf:ElementType .

sf:hasEquipment a owl:ObjectProperty ;
    rdfs:label "采用装备"@zh ;
    rdfs:domain sf:Config ;
    rdfs:range sf:Equipment .

sf:hasMechanism a owl:ObjectProperty ;
    rdfs:label "具有机制"@zh ;
    rdfs:domain sf:Boss ;
    rdfs:range sf:Mechanism .

sf:hasSkill a owl:ObjectProperty ;
    rdfs:label "拥有技能"@zh ;
    rdfs:domain sf:Pet ;
    rdfs:range sf:Skill .

sf:hasSoulmark a owl:ObjectProperty ;
    rdfs:label "拥有魂印"@zh ;
    rdfs:domain sf:Pet ;
    rdfs:range sf:Soulmark .

sf:hasStep a owl:ObjectProperty ;
    rdfs:label "含步骤"@zh ;
    rdfs:domain sf:Strategy ;
    rdfs:range sf:Step .

sf:hp a owl:DatatypeProperty ;
    rdfs:label "血量"@zh ;
    rdfs:domain sf:Boss ;
    rdfs:range xsd:integer .

sf:inDifficulty a owl:ObjectProperty ;
    rdfs:label "属于难度"@zh ;
    rdfs:domain sf:Stage ;
    rdfs:range sf:Difficulty .

sf:isSinglePetBattle a owl:DatatypeProperty ;
    rdfs:label "是否单精灵关（SeerAPI tasks[].is_single_pet）"@zh ;
    rdfs:domain sf:Stage ;
    rdfs:range xsd:boolean .

sf:maxPP a owl:DatatypeProperty ;
    rdfs:label "最大PP"@zh ;
    rdfs:domain sf:Skill ;
    rdfs:range xsd:integer .

sf:mustHit a owl:DatatypeProperty ;
    rdfs:label "必中"@zh ;
    rdfs:domain sf:Skill ;
    rdfs:range xsd:boolean .

sf:pet_2965 a sf:Pet,
        owl:NamedIndividual ;
    rdfs:label "灾厄王妃潘多拉"@zh ;
    sf:seerapiId "2965" .

