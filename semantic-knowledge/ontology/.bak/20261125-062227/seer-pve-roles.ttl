@prefix pve: <http://example.org/seer/pve#> .
@prefix seer: <http://example.org/seer#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# ---- 站场的细分机制（子类；一个精灵可挂多个）----
# 「站场」回答阵营层面的"能不能扛"，子类回答"靠什么扛"，这样机制差异不会退化成一个笼统标签。
pve:免伤站场 a owl:Class ; rdfs:subClassOf pve:tank ;
    rdfs:label "站场·免伤循环"@zh ;
    rdfs:comment "靠每回合可用技能给出「免疫下1次攻击」把 Boss 的一回合输出吃掉，形成 1 换 1 的免伤循环。"@zh .
pve:护盾站场 a owl:Class ; rdfs:subClassOf pve:tank ;
    rdfs:label "站场·护盾循环"@zh ;
    rdfs:comment "靠每回合/登场刷新护盾（固定数值或按体力）吸收伤害。"@zh .
pve:高防站场 a owl:Class ; rdfs:subClassOf pve:tank ;
    rdfs:label "站场·高防吸血"@zh ;
    rdfs:comment "靠高双防与阶段吸血/回血硬扛，不吃免伤与护盾。"@zh .
pve:磨血站场 a owl:Class ; rdfs:subClassOf pve:tank ;
    rdfs:label "站场·百分比磨血"@zh ;
    rdfs:comment "输出靠百分比/固定伤害，伤害与自身攻击面板无关，因此不怕吸强、封属、全属性-1。"@zh .

seer:pet_3522 pve:hasRole pve:免伤站场,
        pve:磨血站场 ;
    rdfs:comment "次元。PVE 真实定位是「免伤站场」而非「百分比输出」：靠 闪光次元击/暴政统治者 每回合给出「免疫下1次攻击」，吃掉 Boss 的出手来站场；魂印 831 的 1/3 体力回血与等量百分比，在高数值 Boss（地狱常 1.2万~1.8万血）面前只占 2%~3%，输出仍需靠攻击技。结论依据：用户实战口径 2026-11-25。"@zh ;
    skos:altLabel "史莱姆" .

