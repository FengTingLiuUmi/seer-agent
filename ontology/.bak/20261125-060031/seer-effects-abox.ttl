seer:soulmark_1637 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4420 ;
    seer:desc "自身攻击技能命中时令对手所有技能PP值-1，若此时自身体力低于对手则效果翻倍且80%令对手害怕；战斗阶段结束时，对手每有1个技能PP值为0则{吸取}对手150点{体力}，若自身体力低于对手则吸取效果翻倍（boss无效）"@zh ;
