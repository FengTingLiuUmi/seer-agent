seer:soulmark_1394 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4169 ;
    seer:analyzeDesc "[sprite name=dot4][color=#52a5f2]首次[/color][color=#57c975]登场时[/color]，弑序神罗为[color=#52a5f2]对方[/color]存活精灵的技能随机散布5枚[color=#f35555]致命印记[/color]，[color=#52a5f2]对方[/color]存活精灵数高于3时改为15枚|[sprite name=dot4]弑序神罗位于出战背包时，[color=#52a5f2]对方[/color][color=#57c975]击败[/color]我方其他精灵时，为[color=#52a5f2]对方[/color]在场精灵附加1层[color=#f35555]致命裂痕[/color]|[sprite name=dot4]弑序神罗[color=#57c975]登场时[/color]，[color=#52a5f2]当回合[/color]弑序神罗[color=#57c975]免疫[/color][color=#52a5f2]异常状态[/color]和[color=#52a5f2]能力下降状态[/color]，[color=#52a5f2]然后[/color]根据[color=#52a5f2]对手[/color][color=#f35555]致命裂痕[/color][color=#52a5f2]达到[/color]的层数依次触发以下效果|[sprite name=dot5]1层：[color=#52a5f2]当回合[/color]额外[color=#57c975]免疫[/color][color=#52a5f2]致命一击[/color]伤害|[sprite name=dot5]2层：[color=#52a5f2]当回合[/color]额外[color=#57c975]免疫[/color]受到的[color=#52a5f2]攻击伤害[/color]|[sprite name=dot5]3层：[color=#52a5f2]当回合[/color]额外无效[color=#52a5f2]对手[/color]的攻击技能|[sprite name=dot4][color=#57c975]战斗阶段结束时[/color]，若自身体力高于回合开始则2回合内自身[color=#52a5f2]回合类效果[/color]无法被消除，若自身体力低于[color=#57c975]回合开始时[/color]则下回合所有[color=#52a5f2]技能先制[/color]+1，若自身体力低于最大体力的1/2则下回合[color=#57c975]免疫[/color][color=#52a5f2]固定伤害[/color]和[color=#52a5f2]百分比伤害[/color]"@zh ;
    seer:desc "首次登场时，弑序神罗为对方存活精灵的技能随机散布5枚致命印记，对方存活精灵数高于3时改为15枚|弑序神罗位于出战背包时，对方击败我方其他精灵时，为对方在场精灵附加1层致命裂痕|弑序神罗登场时，当回合弑序神罗免疫异常状态和能力下降状态，然后根据对手致命裂痕达到的层数依次触发以下效果|1层：当回合额外免疫致命一击伤害|2层：当回合额外免疫受到的攻击伤害|3层：当回合额外无效对手的攻击技能|战斗阶段结束时，若自身体力高于回合开始则2回合内自身回合类效果无法被消除，若自身体力低于回合开始时则下回合所有技能先制+1，若自身体力低于最大体力的1/2则下回合免疫固定伤害和百分比伤害|（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>登场效果：\r
<indent=16><sprite=3><indent=32>首次登场时，弑序神罗根据对方当前存活的精灵数量随机散布<color=#FFF779>致命印记</color>，存活精灵＞3个则散落15枚，存活精灵≤3个则散落5枚\r
<indent=32><sprite=4><indent=48>每个精灵最多存在5枚致命印记，每个技能最多存在3枚致命印记\r
<indent=32><sprite=4><indent=48>精灵被击败后移除其附着的致命印记，使用致命印记附着的技能后移除致命印记并触发<b>对应</b>的效果\r
<indent=32><sprite=4><sprite=4><indent=64>技能附着1枚致命印记时，使用后受到自身最大体力1/6的<b>真实伤害</b>\r
<indent=32><sprite=4><sprite=4><indent=64>技能附着2枚致命印记时，使用后受到自身最大体力1/5的<b>真实伤害</b>且该技能<b>PP值</b>额外-1\r
<indent=32><sprite=4><sprite=4><indent=64>技能附着3枚致命印记时，使用后受到自身最大体力1/4的<b>真实伤害</b>且<color=#64F9FA>命中效果失效</color>\r
\r
<indent=0><sprite=0><indent=16>常驻效果：\r
<indent=16><sprite=3><indent=32>弑序神罗在出战背包时，对手每次击败我方一只弑序神罗以外的精灵都会被附加1层<color=#FFF779>致命裂痕</color>\r
\r
<indent=0><sprite=0><indent=16>登场效果：\r
<indent=16><sprite=3><indent=32>每次登场首回合<color=#64F9FA>免疫</color><b>异常状态</b>和<b>能力下降状态</b>\r
<indent=32><sprite=4><indent=48>若对手存在1层致命裂痕则额外<color=#64F9FA>抵挡</color>对手的<b>致命一击</b>\r
<indent=32><sprite=4><indent=48>若对手存在2层致命裂痕则额外<color=#64F9FA>抵挡</color>对手的<b>攻击</b>\r
<indent=32><sprite=4><indent=48>若对手存在3层致命裂痕则额外<color=#64F9FA>无效</color>对手的<b>攻击</b>\r
\r
<indent=0><sprite=0><indent=16>战阶结束效果：\r
<indent=16><sprite=6><indent=32>战斗阶段结束时：\r
<indent=32><sprite=4><indent=48>若自身体力高于回合开始时则下回合自身<color=#64F9FA>回合类效果无法被消除</color>\r
<indent=32><sprite=4><indent=48>若自身体力低于回合开始时则下回合所有技能<b>先制</b>+1\r
<indent=32><sprite=4><indent=48>若自身体力低于最大体力的1/2则下回合<color=#64F9FA>免疫</color><b>固定伤害</b>和<b>百分比伤害</b>\r
\r
<indent=0><sprite=5><indent=15>致命裂痕（上限3层，下场保留）：\r
<indent=16><sprite=6><indent=32>持有精灵被击败时清空\r
<indent=16><sprite=6><indent=32>持有精灵依照层数受到<b>累计</b>的影响：\r
<indent=32><sprite=4><indent=48>1层：受到的<b>攻击伤害、固定伤害、百分比伤害</b><color=#64F9FA>提升</color>25%\r
<indent=32><sprite=4><indent=48>2层：造成的<b>攻击伤害、固定伤害、百分比伤害</b><color=#64F9FA>减少</color>25%\r
<indent=32><sprite=4><indent=48>3层：所有技能<b>先制</b>-1"""@zh ;
    seer:effectAlias "alias_1746_1_2" ;
    seer:intensified false ;
    seer:isAdv false ;
    seer:pveEffective false ;
    seer:seerapiId "1394" ;
    seer:soulmarkEffect "{\"effect\": {\"id\": 1746, \"url\": \"https://api.seerapi.com/v1/eid_effect/1746\"}, \"effect_args\": [1, 2]}" ;
    seer:soulmarkTag seer:soulmark_tag_13,
        seer:soulmark_tag_19,
        seer:soulmark_tag_7 ;
