seer:soulmark_1844 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4643 ;
    seer:analyzeDesc "[sprite name=dot4]战斗开始时[color=#52a5f2]己方[/color]获得[color=#f35555]星执[/color]|[sprite name=dot4]蓓丽安特[color=#57c975]被击败[/color]时解放[color=#f35555]星执[/color]，[color=#57c975]消逝[/color]自身并转化为[color=#f35555]星执者[/color]，[color=#f35555]星执者[/color]的初始拥有等同于蓓丽安特本次[color=#57c975]登场时[/color]最大体力的能量，[color=#52a5f2]己方[/color]其他精灵[color=#57c975]被击败[/color]时，[color=#f35555]星执者[/color]额外获得300点能量，失去所有能量后[color=#f35555]星执者[/color]消失"@zh ;
    seer:desc "战斗开始时己方获得星执|蓓丽安特被击败时解放星执，消逝自身并转化为星执者，星执者的初始拥有等同于蓓丽安特本次登场时最大体力的能量，己方其他精灵被击败时，星执者额外获得300点能量，失去所有能量后星执者消失|（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>战斗开始效果：\r
<indent=16><sprite=3><indent=32>战斗开始时己方获得<color=#FFF779>星执</color>\r
\r
<indent=0><sprite=0><indent=16>被击败效果：\r
<indent=16><sprite=3><indent=32>蓓丽安特被击败时：\r
<indent=32><sprite=4><indent=48>解放星执，<color=#64F9FA>消逝</color><b>自身</b>并化身为<color=#FFF779>星执者</color>，星执者初始存有蓓丽安特本次登场时最大体力100%的<b>能量</b>\r
<indent=16><sprite=3><indent=32>己方其他精灵被击败时，星执者获得300点能量\r
\r
<indent=0><sprite=5><indent=15>星执：\r
<indent=16><sprite=6><indent=32>记录蓓丽安特<b>异常抗性</b>的<b>唯一最高项</b>，星执存在期间己方精灵进入此记录的<b>异常状态</b>时将其<color=#64F9FA>转化</color>为3回合星赐\r
\r
<indent=0><sprite=5><indent=15>星执者：\r
<indent=16><sprite=6><indent=32>将己方在场精灵进入的所有<b>异常状态</b><color=#64F9FA>转化</color>为星赐\r
<indent=16><sprite=6><indent=32>己方在场精灵满足以下条件时将<color=#64F9FA>消耗</color>星执者存有的<b>能量</b>以触发对应效果，每次消耗的能量至少为150点\r
<indent=32><sprite=4><indent=48>使用技能后星执者消耗15%的能量并<color=#64F9FA>造成</color>等量<b>真实伤害</b>\r
<indent=32><sprite=4><indent=48>回合结束后星执者消耗15%的能量并为己方在场精灵<color=#64F9FA>恢复</color>等量<b>体力</b>\r
<indent=16><sprite=6><indent=32>能量归0时星执者效果结束"""@zh ;
    seer:effectAlias "alias_2234_1_0" ;
    seer:intensified false ;
    seer:isAdv false ;
    seer:pveEffective false ;
    seer:seerapiId "1844" ;
    seer:soulmarkEffect "{\"effect\": {\"id\": 2234, \"url\": \"https://api.seerapi.com/v1/eid_effect/2234\"}, \"effect_args\": [1, 0]}" ;
