seer:soulmark_1248 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_3988 ;
    seer:desc "回合开始时，若自身体力高于最大体力的1/2时则当回合自身造成的攻击伤害提升50%，若自身体力低于最大体力的1/2时则当回合自身造成攻击伤害的50%恢复自身体力（boss有效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时：\r
<indent=32><sprite=4><indent=48>若对手体力低于最大体力的1/2时则当回合自身造成的<b>攻击伤害</b><color=#64F9FA>提升</color>50%\r
<indent=32><sprite=4><indent=48>若自身体力低于最大体力的1/2时则当回合自身造成的攻击伤害50%额外<color=#64F9FA>恢复</color>至自身体力"""@zh ;
