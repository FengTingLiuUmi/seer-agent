        seer:soulmark_tag_19 ;
    seer:sourceUrl "https://api.seerapi.com/v1/soulmark/1826" .

seer:soulmark_1827 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4619 ;
    seer:desc "回合开始时令对手全属性-1；|战斗阶段结束时，若对手处于能力下降状态则60%令对手害怕，若对手不处于能力下降状态则下回合受到的攻击伤害减少50%（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时<color=#64F9FA>令对手全属性-1</color>\r
\r
<indent=0><sprite=0><indent=16>战阶结束效果：\r
<indent=16><sprite=3><indent=32>战斗阶段结束时：\r
<indent=32><sprite=4><indent=48>若对手处于能力下降状态则60%<color=#64F9FA>令对手害怕</color>\r
<indent=32><sprite=4><indent=48>若对手不处于能力下降状态则下回合受到的<b>攻击伤害<color=#64F9FA></b>减少</color>50%"""@zh ;
