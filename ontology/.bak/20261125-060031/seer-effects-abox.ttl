seer:soulmark_618 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_3289 ;
    seer:desc "首次登场当回合自身无效对手的攻击技能，那之后每次登场后对手当前在场精灵2回合内属性技能失效；|对手使用攻击技能后若自身体力低于对手则附加自身最大体力1/3的百分比伤害并恢复等量体力，若自身体力高于对手则附加自身当前体力1/2的百分比伤害（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>登场效果：\r
<indent=16><sprite=3><indent=32>首次登场后当回合自身<color=#64F9FA>免疫</color>对手的<b>攻击技能</b>，\r
<indent=16><sprite=3><indent=32>非首次登场后对手当前在场精灵2回合内<b>属性技能</b><color=#64F9FA>无效</color>\r
\r
<indent=0><sprite=0><indent=16>触发效果：\r
<indent=16><sprite=3><indent=32>对手使用攻击技能后：\r
<indent=32><sprite=4><indent=48>若自身体力低于对手则<color=#64F9FA>附加</color>自身最大体力1/3的<b>百分比伤害</b>并恢复等量体力\r
<indent=32><sprite=4><indent=48>若自身体力高于对手则<color=#64F9FA>附加</color>自身当前体力1/2的<b>百分比伤害"""@zh ;
    seer:effectAlias "alias_902_1_2_3_2_1" ;
