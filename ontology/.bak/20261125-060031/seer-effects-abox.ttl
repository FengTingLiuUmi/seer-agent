seer:soulmark_2090 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4903 ;
    seer:analyzeDesc "[sprite name=dot4]自身[color=#57c975]登场时[/color]，根据本场战斗自身的[color=#52a5f2]出战[/color]次数，依次触发等量的下列效果：|[sprite name=dot5]    2回合内自身受到的技能伤害不超过自身最大体力的25%|[sprite name=dot5]    2回合内自身造成的攻击[color=#52a5f2]伤害提升[/color]100%|[sprite name=dot5]    2回合内自身抵挡受到的[color=#52a5f2]致命一击[/color]|[sprite name=dot5]    2回合内令[color=#52a5f2]对手[/color]体力恢复效果减少50%|[sprite name=dot5]    2回合内每回合结束[color=#52a5f2]吸取[/color][color=#52a5f2]对手[/color]所有技能1点PP值|[sprite name=dot5]    2回合内自身造成的[color=#52a5f2]固定伤害[/color]、百分比[color=#52a5f2]伤害提升[/color]30%|[sprite name=dot4]若触发次数为6次，则[color=#57c975]登场时[/color]无法触发上述效果|[sprite name=dot4]自身体力高于最大体力的1/2时，[color=#57c975]回合开始时[/color]令[color=#52a5f2]对手[/color]攻击、特攻、速度-1，[color=#52a5f2]未触发[/color]则重新触发自身的[color=#57c975]登场[/color]效果并解除自身所处的[color=#52a5f2]异常状态[/color]；自身体力低于最大体力的1/2时，自身所有[color=#52a5f2]技能先制[/color]+1，攻击技能威力提升100%且造成的[color=#52a5f2]攻击伤害[/color]为0时[color=#52a5f2]吸取[/color][color=#52a5f2]对手[/color]100%的体力|[sprite name=dot4]自身造成的[color=#52a5f2]攻击伤害[/color]高于300时，[color=#52a5f2]吸取[/color][color=#52a5f2]对手[/color]最大体力的1/3，自身未造成高于300的[color=#52a5f2]攻击伤害[/color]的回合，[color=#57c975]战斗阶段结束时[/color]自身特攻、速度+1"@zh ;
    seer:desc "自身登场时，根据本场战斗自身的出战次数，依次触发等量的下列效果：|    2回合内自身受到的技能伤害不超过自身最大体力的25%|    2回合内自身造成的攻击伤害提升100%|    2回合内自身抵挡受到的致命一击|    2回合内令对手体力恢复效果减少50%|    2回合内每回合结束吸取对手所有技能1点PP值|    2回合内自身造成的固定伤害、百分比伤害提升30%|若触发次数为6次，则登场时无法触发上述效果|自身体力高于最大体力的1/2时，回合开始时令对手攻击、特攻、速度-1，未触发则重新触发自身的登场效果并解除自身所处的异常状态；自身体力低于最大体力的1/2时，自身所有技能先制+1，攻击技能威力提升100%且造成的攻击伤害为0时吸取对手100%的体力|自身造成的攻击伤害高于300时，吸取对手最大体力的1/3，自身未造成高于300的攻击伤害的回合，战斗阶段结束时自身特攻、速度+1|（boss无效）"@zh ;
    seer:effectAlias "alias_2509_1_0" ;
    seer:intensified false ;
    seer:isAdv false ;
    seer:pveEffective true ;
