        seer:soulmark_tag_6 ;
    seer:sourceUrl "https://api.seerapi.com/v1/soulmark/1976" .

seer:soulmark_1977 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4780 ;
    seer:desc "回合开始时若自身处于疲惫状态则当回合抵挡受到的攻击且对手的属性技能无效；自身使用攻击技能时，若对手不处于异常状态则当回合造成的攻击伤害提升50%，若对手处于异常状态则吸取对手最大体力的1/3并令对手疲惫（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时若自身处于疲惫状态则当回合<color=#64F9FA>抵挡</color>受到的<b>攻击</b>且对手的<b>属性技能</b><color=#64F9FA>无效</color>\r
\r
<indent=0><sprite=0><indent=16>攻击技能额外效果：\r
<indent=16><sprite=3><indent=32>自身使用攻击技能时：\r
<indent=32><sprite=4><indent=48>若对手不处于异常状态则当回合造成的<b>攻击伤害</b><color=#64F9FA>提升</color>50%\r
<indent=32><sprite=4><indent=48>若对手处于异常状态则<color=#64F9FA>吸取</color>对手最大体力的1/3并<color=#64F9FA>令对手疲惫</color>"""@zh ;
    seer:effectAlias "alias_2403_50_3_1" ;
    seer:intensified false ;
    seer:isAdv false ;
    seer:pveEffective false ;
    seer:seerapiId "1977" ;
    seer:soulmarkEffect "{\"effect\": {\"id\": 2403, \"url\": \"https://api.seerapi.com/v1/eid_effect/2403\"}, \"effect_args\": [50, 3, 1]}" ;
    seer:soulmarkTag seer:soulmark_tag_11,
        seer:soulmark_tag_15 ;
    seer:sourceUrl "https://api.seerapi.com/v1/soulmark/1977" .

seer:soulmark_1978 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4781 ;
    seer:desc "对手使用技能时，若对手不处于记忆破碎触发记忆破碎：该技能PP值归0，每因此损失5点PP值对手1回合内受到的攻击伤害额外提升三分之一且回合结束时100%失神；记忆破碎结束时对手恢复因此损失的所有PP值（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>触发效果：\r
<indent=16><sprite=3><indent=32>对手使用技能时触发记忆破碎：\r
<indent=32><sprite=4><indent=48>该技能<b>PP值</b><color=#64F9FA>归0</color>\r
<indent=32><sprite=4><indent=48>每因此损失5点PP值对手1回合内受到的<b>攻击伤害</b><color=#64F9FA>额外提升</color>三分之一且回合结束时100%<color=#64F9FA>受到</color>失神\r
<indent=32><sprite=4><indent=48>效果持续时无法重复触发\r
<indent=32><sprite=4><indent=48>效果结束时对手<color=#64F9FA>恢复</color>因此损失的所有<b>PP值</b>"""@zh ;
    seer:effectAlias "alias_2404_0_5_1_100_1" ;
