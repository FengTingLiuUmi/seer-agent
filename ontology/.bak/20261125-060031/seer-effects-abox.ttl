seer:soulmark_1640 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4423 ;
    seer:desc "自身技能命中时50%令对手烧伤，未触发则50%令对手失明，若均未触发则当回合战斗阶段结束时恢复自身最大体力的1/3；回合开始时若对手处于异常状态，则当回合自身造成的攻击伤害提升50%且使用技能后50%令对手焚烬（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>技能额外效果：\r
<indent=16><sprite=3><indent=32>自身所有技能命中时50%<color=#64F9FA>令对手烧伤</color>\r
<indent=32><sprite=4><indent=48>未触发则50%<color=#64F9FA>令对手失明</color>\r
<indent=32><sprite=4><indent=48>未触发则当回合战斗阶段结束时<color=#64F9FA>恢复</color>自身最大体力的1/3\r
\r
<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时若对手处于异常状态，则当回合自身造成的<b>攻击伤害</b><color=#64F9FA>提升</color>50%且使用攻击技能后50%<color=#64F9FA>令对手焚烬</color>"""@zh ;
