seer:soulmark_1853 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4651 ;
    seer:desc "自身每次受到异常状态时，消耗自身PP值不为0的首位技能全部PP值，消耗成功则免疫本次异常状态|回合开始时，自身每有1个技能PP值为0随机1项能力等级+2，若自身能力等级高于对手，则额外消除对手能力提升状态与回合类效果，且当回合使用技能时吸取对手最大体力的1/3|（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>触发效果：\r
<indent=16><sprite=3><indent=32>自身每次受到异常状态时，<color=#64F9FA>消耗</color>自身首个PP值不为0的技能的全部<b>PP值</b>以<color=#64F9FA>免疫</color>本次<b>异常状态</b>\r
\r
