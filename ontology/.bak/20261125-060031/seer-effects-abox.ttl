seer:soulmark_2036 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4845 ;
    seer:desc "回合开始时，若对手不处于异常状态，则当回合受到攻击伤害后令对手失明、失神|回合结束时若自身当回合未受到攻击伤害，下回合自身攻击技能命中时吸取对手最大体力的1/3、属性技能命中时吸取对手所有技能1点pp|（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时，若对手不处于异常状态，则当回合受到攻击伤害后<color=#64F9FA>令对手失明、失神</color>\r
\r
<indent=0><sprite=0><indent=16>回合结束效果：\r
