seer:soulmark_1962 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_3893 ;
    seer:derivedFrom seer:soulmark_1162 ;
    seer:desc "受到攻击时有50%的几率免疫当回合受到的攻击伤害，未触发则战斗阶段结束时附加自身攻击值70%的百分比伤害；当回合自身受到的攻击伤害则战斗阶段结束时令对手全属性-1，当回合自身未受到的攻击伤害则战斗阶段结束时令自身全属性+1（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>触发效果：\r
<indent=16><sprite=3><indent=32>受到攻击时50%<color=#64F9FA>免疫</color>当回合受到的<b>攻击伤害</b>\r
<indent=32><sprite=4><indent=48>未触发则战斗阶段结束时<color=#64F9FA>附加</color>自身攻击值70%的<b>百分比伤害</b>\r
\r
<indent=0><sprite=0><indent=16>战阶结束效果：\r
<indent=16><sprite=3><indent=32>战斗阶段结束时：\r
<indent=32><sprite=4><indent=48>若当回合自身受到了攻击伤害则令对手<color=#64F9FA>全属性-1</color>\r
<indent=32><sprite=4><indent=48>若当回合自身未受到攻击伤害则令自身<color=#64F9FA>全属性+1</color>"""@zh ;
