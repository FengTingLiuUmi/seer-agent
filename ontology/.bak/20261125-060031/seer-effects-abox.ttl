        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4392 ;
    seer:desc "自身每次登场后首次使用攻击技能则100%令对手诅咒，未触发则令对手下1次属性技能失效，之后每次使用攻击技能则效果转变为100%令对手束缚，未触发则附加对手最大体力1/3的百分比伤害，若对手当回合使用攻击技能则此效果重置且下回合自身所有技能先制+1；|回合开始时若自身体力高于最大体力的1/2则当回合受到的攻击伤害降低25%，若自身体力低于最大体力的1/2则当回合受到的固定伤害和百分比伤害降低50%（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>登场效果：\r
<indent=16><sprite=3><indent=32>自身每次登场后首次使用攻击技能时100%<color=#64F9FA>令对手诅咒</color>\r
<indent=32><sprite=4><indent=48>未触发则令对手下1次<b>属性技能<color=#64F9FA></b>失效</color>\r
<indent=32><sprite=4><indent=48>之后每次使用攻击技能时效果转变为100%<color=#64F9FA>令对手束缚</color>\r
<indent=32><sprite=4><sprite=4><indent=64>未触发则<color=#64F9FA>附加</color>对手最大体力1/3的<b>百分比伤害</b>\r
\r
<indent=0><sprite=0><indent=16>触发效果：\r
<indent=16><sprite=3><indent=32>对手使用攻击技能时重置自身的登场效果且下回合自身所有技能<b>先制</b>+1\r
\r
<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时：\r
<indent=32><sprite=4><indent=48>若自身体力高于最大体力的1/2则当回合受到的<b>攻击伤害<color=#64F9FA></b>降低</color>25%\r
<indent=32><sprite=4><indent=48>若自身体力低于最大体力的1/2则当回合受到的<b>固定伤害</b>和<b>百分比伤害<color=#64F9FA></b>降低</color>50%"""@zh ;
