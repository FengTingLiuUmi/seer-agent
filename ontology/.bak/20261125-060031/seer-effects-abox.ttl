seer:soulmark_1510 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4289 ;
    seer:desc "对手每次主动切换精灵则令登场精灵随机1个技能PP值归零且自身下2次攻击必定打出致命一击；|自身攻击技能打出致命一击则令对手随机1个技能PP值归零，自身攻击技能未打出致命一击则附加对手最大体力1/3的固定伤害，对手处于异常状态时恢复等量体力值（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>触发效果：\r
