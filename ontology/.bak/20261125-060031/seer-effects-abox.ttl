seer:soulmark_1979 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4782 ;
    seer:desc "自身受到攻击伤害后，下1回合造成的攻击伤害提升50%，自身受到的攻击伤害高于自身最大体力的1/2时每高出2点下回合造成的攻击伤害额外提升1%；自身打出致命一击后，吸取对手伤害值70%的体力|（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>触发效果：\r
<indent=16><sprite=3><indent=32>自身受到攻击伤害后下1回合造成的<b>攻击伤害</b><color=#64F9FA>提升</color>50%\r
<indent=32><sprite=4><indent=48>受到的攻击伤害高于自身最大体力的1/2时每高出2点再提升1%\r
\r
<indent=0><sprite=0><indent=16>触发效果：\r
<indent=16><sprite=3><indent=32>自身打出致命一击后，<color=#64F9FA>吸取</color>对手伤害值70%的<b>体力</b>"""@zh ;
