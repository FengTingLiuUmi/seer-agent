seer:soulmark_2033 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4840 ;
    seer:desc "自身造成的攻击伤害提升15%，受到的攻击伤害减少15%，战斗阶段结束时恢复自身15%的最大体力，双方任意一方存在技能PP值不高于1时效果翻倍且额外免疫受到的异常状态|回合开始时若自身不处于全能力提升状态则令自身全属性+1且当回合战斗阶段结束时所有技能恢复1点PP值，若自身处于全能力提升状态则当回合自身能力提升状态无法被消除，且自身攻击时消除对手回合类效果并吸取对手能力提升（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>常驻效果：\r
<indent=16><sprite=3><indent=32>自身造成的<b>攻击伤害</b><color=#64F9FA>提升</color>15%，受到的<b>攻击伤害</b><color=#64F9FA>减少</color>15%，战斗阶段结束时<color=#64F9FA>恢复</color>自身15%的最大体力\r
<indent=32><sprite=4><indent=48>双方任意一方存在技能PP值不高于1时上述所有效果翻倍且额外<color=#64F9FA>免疫</color>受到的<b>异常状态</b>\r
\r
<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时：\r
<indent=32><sprite=4><indent=48>若自身不处于全能力提升状态则令自身<color=#64F9FA>全属性+1</color>且当回合战斗阶段结束时所有技能<color=#64F9FA>恢复</color>1点<b>PP值</b>\r
<indent=32><sprite=4><indent=48>若自身处于全能力提升状态则当回合自身<color=#64F9FA>能力提升状态无法被消除</color>，且自身攻击时<color=#64F9FA>消除</color>对手<b>回合类效果</b>并<color=#64F9FA>吸取</color>对手<b>能力提升状态</b>"""@zh ;
