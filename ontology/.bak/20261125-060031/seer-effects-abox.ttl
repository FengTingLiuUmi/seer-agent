seer:soulmark_1876 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4674 ;
    seer:desc "自身登场首回合令对手的攻击技能附加效果失效|回合开始时，若自身为满体力则当回合自身所有技能先制+1，若自身不为满体力则当回合受到的攻击伤害额外减少50%，每减少1点攻击伤害，自身下次攻击附加1点固定伤害|（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>登场效果：\r
<indent=16><sprite=3><indent=32>自身登场首回合令对手的<b>攻击技能<color=#64F9FA></b>命中效果失效</color>\r
\r
<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时，若自身为满体力则当回合自身所有技能<b>先制</b>+1；若自身不为满体力则当回合受到的<b>攻击伤害<color=#64F9FA></b>减少</color>50%，每减少1点，自身下次攻击<color=#64F9FA>附加</color>1点<b>固定伤害</b>"""@zh ;
