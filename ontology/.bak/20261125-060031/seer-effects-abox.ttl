seer:soulmark_1406 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4182 ;
    seer:desc "堕魂·格特鲁德登场后造成的伤害提升25%，背包内每阵亡一只精灵则造成的伤害提升10%，若背包内精灵全部阵亡则自身攻击命中后额外附加自身最大体力25%的真实伤害；|回合开始时，若对手处于异常状态则当回合造成的攻击克制倍数最低为1倍，若对手不处于异常状态则当回合自身攻击命中后50%令对手害怕，未触发则随机忽略对手15%-30%的双防值且令自身下回合攻击技能先制+1（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>登场效果：\r
<indent=16><sprite=3><indent=32>登场后造成的<b>攻击伤害</b><color=#64F9FA>提升</color>25%，背包内每阵亡一只精灵则再提升10%\r
<indent=32><sprite=4><indent=48>若背包内精灵全部阵亡则自身攻击额外<color=#64F9FA>附加</color>自身最大体力25%的<b>真实伤害</b>\r
\r
<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时：\r
<indent=32><sprite=4><indent=48>若对手处于异常状态则当回合造成的攻击<b>克制倍数</b>最低为1\r
<indent=32><sprite=4><indent=48>若对手不处于异常状态则当回合自身攻击命中后50%<color=#64F9FA>令对手害怕</color>\r
<indent=32><sprite=4><sprite=4><indent=64>未触发则随机<color=#64F9FA>忽略</color>对手10%-30%的<b>双防值</b>且令自身下回合攻击技能<b>先制</b>+1"""@zh ;
