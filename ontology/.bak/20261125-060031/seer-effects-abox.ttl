seer:soulmark_1764 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4554 ;
    seer:analyzeDesc "[sprite name=dot4]自身拥有[color=#f35555]圣谕形态[/color]、[color=#f35555]邪魇形态[/color]两种形态，战斗开始时，自身进入[color=#f35555]圣谕形态[/color]|[sprite name=dot4]每次[color=#57c975]登场[/color]或切换形态时，下次[color=#52a5f2]攻击先制[/color]+1、[color=#52a5f2]必定命中[/color]且无视攻击[color=#57c975]免疫[/color]效果|[sprite name=dot4][color=#57c975]登场[/color][color=#52a5f2]之后[/color]，自身选择技能的回合攻击命中时附加1层自身形态相应的[color=#f35555]圣诰[/color]/[color=#f35555]邪诲[/color]，[color=#52a5f2]对手[/color]未选择技能的回合自身[color=#57c975]免疫[/color]对[color=#52a5f2]能力提升状态[/color]、[color=#52a5f2]回合类效果[/color]的消除、[color=#52a5f2]吸取[/color]，[color=#57c975]免疫[/color]成功附加1层与自身形态相反的[color=#f35555]圣诰[/color]/[color=#f35555]邪诲[/color]"@zh ;
    seer:desc "自身拥有圣谕形态、邪魇形态两种形态，战斗开始时，自身进入圣谕形态|每次登场或切换形态时，下次攻击先制+1、必定命中且无视攻击免疫效果|登场之后，自身选择技能的回合攻击命中时附加1层自身形态相应的圣诰/邪诲，对手未选择技能的回合自身免疫对能力提升状态、回合类效果的消除、吸取，免疫成功附加1层与自身形态相反的圣诰/邪诲|（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>战斗开始效果：\r
<indent=16><sprite=3><indent=32>战斗开始时进入圣谕形态，可以特定技能切换\r
<indent=16><sprite=3><indent=32>自身在圣谕形态下<color=#64F9FA>免疫<b></color>异常状态</b>、<b>固定伤害</b>\r
<indent=16><sprite=3><indent=32>自身在邪魇形态下<color=#64F9FA>免疫<b></color>能力下降状态</b>、<b>百分比伤害</b>\r
\r
<indent=0><sprite=0><indent=16>登场效果：\r
<indent=16><sprite=3><indent=32>登场后或切换形态后下次攻击技能<b>先制</b>+1、<color=#64F9FA>必定命中</color>且<color=#64F9FA>无视</color><b>攻击免疫效果</b>\r
<indent=16><sprite=3><indent=32>登场后：\r
<indent=32><sprite=4><indent=48>自身选择技能的回合攻击命中时<color=#64F9FA>附加</color>给对手1层自身形态相应的<color=#FFF779>圣告</color>/<color=#FFF779>邪诲</color>\r
<indent=32><sprite=4><indent=48>对手未选择技能的回合自身<color=#64F9FA>免疫</color>对能力提升状态、回合类效果的<b>消除、吸取</b>\r
<indent=32><sprite=4><sprite=4><indent=64>免疫成功为对手<color=#64F9FA>附加</color>1层自身形态相反的圣告/邪诲\r
\r
<indent=0><sprite=5><indent=15>圣告（上限3层，下场保留）：\r
<indent=16><sprite=6><indent=32>受到攻击后70%疲惫，每层生效1次 \r
<indent=16><sprite=6><indent=32>受到攻击伤害后，若伤害高于该技能的威力值则减少1层\r
\r
<indent=0><sprite=5><indent=15>邪诲（上限3层，下场保留）：\r
<indent=16><sprite=6><indent=32>受到攻击后<color=#64F9FA>被对手吸取</color>伤害值70%的<b>体力</b>，每层生效1次 \r
<indent=16><sprite=6><indent=32>受到攻击伤害后，若伤害高于该技能的威力值则减少1层\r
\r
<indent=0><sprite=5><indent=15>湮灭：\r
<indent=16><sprite=6><indent=32>对手拥有圣告、邪诲至少各1层时以特定技能触发\r
<indent=16><sprite=6><indent=32>触发成功时对手<color=#64F9FA>受到</color>238点<b>真实伤害</b>且当回合<color=#64F9FA>无法行动与恢复体力</color>\r
<indent=16><sprite=6><indent=32>效果结束后圣告、邪诲减少1层 ，每层圣告、邪诲只会响应1次湮灭"""@zh ;
