seer:soulmark_1221 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_3958 ;
    seer:desc "回合开始时，若自身处于能力提升状态则当回合自身攻击技能先制+1且造成的伤害提升100%，若对手处于能力下降状态则当回合自身攻击50%令对手睡眠；战斗阶段结束时，若自身不处于能力提升状态则吸取并反转对手能力提升状态，吸取成功则恢复自身最大体力的1/3（boss无效）"@zh ;
