seer:soulmark_1695 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4483 ;
    seer:desc "自身技能命中前100%令对手冻伤，若未触发冻伤且本次使用的技能为攻击技能则造成伤害前100%令对手害怕，未触发害怕则当次攻击造成的伤害提升80%；|战斗阶段结束时若自身处于冻伤状态则恢复己方所有存活精灵80点体力，若己方所有存活精灵均为满体力则100%令自身冰封；|战斗阶段结束时若对手不处于冻伤状态则下回合自身100%闪避对手的攻击|（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>技能额外效果：\r
<indent=16><sprite=3><indent=32>自身技能命中前100%<color=#64F9FA>令对手冻伤</color>\r
<indent=32><sprite=4><indent=48>若未触发冻伤且本次使用的技能为攻击技能则造成伤害前100%<color=#64F9FA>令对手害怕</color>\r
<indent=32><sprite=4><indent=48>若未触发害怕则当次攻击造成的<b>攻击伤害</b><color=#64F9FA>提升</color>80%\r
\r
<indent=0><sprite=0><indent=16>战阶结束效果：\r
<indent=16><sprite=3><indent=32>战斗阶段结束时若自身处于冻伤状态则<color=#64F9FA>恢复</color>己方所有存活精灵80点<b>体力</b>\r
<indent=32><sprite=4><indent=48>若己方所有存活精灵均为满体力则100%<color=#64F9FA>令自身冰封</color>\r
<indent=16><sprite=3><indent=32>战斗阶段结束时若对手不处于冻伤状态则下回合自身100%<color=#64F9FA>闪避</color>对手的<b>攻击技能</b>"""@zh ;
