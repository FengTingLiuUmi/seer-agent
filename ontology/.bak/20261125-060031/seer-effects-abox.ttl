seer:soulmark_2120 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4925 ;
    seer:analyzeDesc "[sprite name=dot4]自身[color=#57c975]登场时[/color]，消除对手能力提升状态，消除成功后100%令对手[color=#57c975]睡眠[/color]3回合，触发成功则本场战斗上述[color=#57c975]睡眠[/color]附加的回合数-1，最多减少至1；自身位于[color=#52a5f2]出战[/color]背包时，双方精灵每次触发复活效果后，自身重置前述效果|[sprite name=dot4][color=#52a5f2]回合开始时[/color]，若自身处于异常状态，则[color=#52a5f2]当回合[/color][color=#57c975]战斗阶段结束时[/color]附加自身所处的异常状态各2回合，若自身不处于异常状态，则下回合所有[color=#52a5f2]技能先制[/color]+1"@zh ;
    seer:desc "自身登场时，消除对手能力提升状态，消除成功后100%令对手睡眠3回合，触发成功则本场战斗上述睡眠附加的回合数-1，最多减少至1；自身位于出战背包时，双方精灵每次触发复活效果后，自身重置前述效果|回合开始时，若自身处于异常状态，则当回合战斗阶段结束时附加自身所处的异常状态各2回合，若自身不处于异常状态，则下回合所有技能先制+1|（boss无效）"@zh ;
