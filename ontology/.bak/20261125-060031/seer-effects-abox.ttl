seer:soulmark_1578 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4354 ;
    seer:analyzeDesc "[sprite name=dot4][color=#57c975]回合开始时[/color]若自身体力高于最大体力的1/2，则[color=#52a5f2]当回合[/color]自身受到的[color=#52a5f2]攻击伤害[/color]不超过自身最大体力的1/2，[color=#57c975]战斗阶段结束时[/color]若自身体力低于最大体力的1/2，则下回合自身所有[color=#52a5f2]技能先制[/color]+2|[sprite name=dot4]对手[color=#57c975]使用技能后[/color]，下次[color=#57c975]使用技能时[/color]若类型与本次相同则自身免疫下1次受到的异常状态，若类型与本次不同则下回合攻击技能获得[color=#f35555]黯天之尘[/color]且[color=#57c975]战斗阶段结束时[/color]若自身体力低于最大体力的1/2则消除对手[color=#52a5f2]回合类效果[/color]"@zh ;
    seer:desc "回合开始时若自身体力高于最大体力的1/2，则当回合自身受到的攻击伤害不超过自身最大体力的1/2，战斗阶段结束时若自身体力低于最大体力的1/2，则下回合自身所有技能先制+2|对手使用技能后，下次使用技能时若类型与本次相同则自身免疫下1次受到的异常状态，若类型与本次不同则下回合攻击技能获得黯天之尘且战斗阶段结束时若自身体力低于最大体力的1/2则消除对手回合类效果|（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时若自身体力高于最大体力的1/2，则当回合自身受到的<b>攻击伤害</b><color=#64F9FA>无法超过</color>自身最大体力的1/2\r
\r
<indent=0><sprite=0><indent=16>战阶结束效果：\r
<indent=16><sprite=3><indent=32>战斗阶段结束时若自身体力低于最大体力的1/2，则下回合自身所有技能<b>先制</b>+2\r
\r
<indent=0><sprite=0><indent=16>触发效果：\r
<indent=16><sprite=3><indent=32>对手当回合使用的技能类型与上次相同则自身<color=#64F9FA>免疫</color>下1次受到的<b>异常状态</b>\r
<indent=16><sprite=3><indent=32>对手当回合使用的技能类型与上次不同则：\r
<indent=32><sprite=4><indent=48>自身下回合攻击技能获得<color=#FFF779>黯天之尘</color>效果\r
<indent=32><sprite=4><indent=48>战斗阶段结束时若自身体力低于最大体力的1/2则<color=#64F9FA>消除</color>对手<b>回合类效果</b>\r
\r
<indent=0><sprite=5><indent=15>黯天之尘：\r
<indent=16><sprite=6><indent=32><b>先制</b>+1\r
<indent=16><sprite=6><indent=32>造成的<b>攻击伤害</b><color=#64F9FA>提升</color>80%\r
<indent=16><sprite=6><indent=32><color=#64F9FA>恢复</color>自身所有技能2点<b>PP值</b>"""@zh ;
