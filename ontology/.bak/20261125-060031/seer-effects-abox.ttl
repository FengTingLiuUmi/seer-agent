        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4777 ;
    seer:desc "对手使用技能时若对手不存在勘定中的技能，则TOH勘定该技能|自身使用技能时若双方不存在勘定中的技能或勘定中的技能PP值合计为0，则TOH勘定对手当回合选择的技能，对手当回合未选择技能则改为勘定自身当回合使用的技能；自身使用技能时若勘定中的技能PP值合计不为0，则每剩余1点吸取对手最大体力的1%，然后令所有勘定中的技能PP值归0，合计不足20点时吸取效果翻倍|TOH最多同时勘定3个技能，勘定中的技能不存在于场上时重置对应的勘定；勘定中的技能合计每有1点PP值TOH受到的百分比伤害减少2%且造成的百分比伤害提升2%，勘定中的技能每次被使用后，TOH所处的异常状态转化为超频|（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>触发效果：\r
<indent=16><sprite=3><indent=32>对手使用技能时若对手不存在勘定中的技能，则TOH<color=#FFF779>勘定</color>该技能\r
<indent=16><sprite=3><indent=32>自身使用技能时：\r
<indent=32><sprite=4><indent=48>若双方不存在勘定中的技能或勘定中的技能PP值合计为0，则TOH勘定对手当回合选择的技能\r
<indent=32><sprite=4><sprite=4><indent=64>对手当回合未选择技能则改为勘定自身当回合使用的技能\r
<indent=32><sprite=4><indent=48>若勘定中的技能PP值合计不为0，则每剩余1点<color=#64F9FA>吸取</color>对手最大体力的1%\r
<indent=32><sprite=4><sprite=4><indent=64>然后令所有勘定中的技能<b>PP值</b><color=#64F9FA>归0</color>，合计不足20点时吸取效果翻倍\r
\r
<indent=0><sprite=5><indent=15>勘定：\r
<indent=16><sprite=6><indent=32>TOH最多同时勘定3个技能，勘定中的技能不存在于场上时重置对应的勘定\r
<indent=16><sprite=6><indent=32>勘定中的技能合计每有1点PP值TOH受到的<b>百分比伤害</b><color=#64F9FA>减少</color>2%且造成的<b>百分比伤害</b><color=#64F9FA>提升</color>2%\r
<indent=16><sprite=6><indent=32>勘定中的技能每次被使用后，TOH所处的<b>异常状态</b><color=#64F9FA>转化</color>为超频"""@zh ;
    seer:effectAlias "alias_2382_1_0" ;
    seer:intensified false ;
    seer:isAdv false ;
    seer:pveEffective false ;
    seer:seerapiId "1976" ;
    seer:soulmarkEffect "{\"effect\": {\"id\": 2382, \"url\": \"https://api.seerapi.com/v1/eid_effect/2382\"}, \"effect_args\": [1, 0]}" ;
