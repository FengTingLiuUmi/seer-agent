seer:soulmark_2083 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4897 ;
    seer:analyzeDesc "[sprite name=dot4]自身使用攻击技能时，为[color=#52a5f2]对手[/color]附加[color=#57c975]烧伤[/color]、[color=#57c975]易燃[/color]、[color=#57c975]焚烬[/color]、[color=#57c975]麻痹[/color]中[color=#52a5f2]对手[/color]不处于的1种[color=#52a5f2]异常状态[/color]|[sprite name=dot4][color=#57c975]战斗阶段结束时[/color]，若本场战斗自身对同一精灵以上述效果附加过4种[color=#52a5f2]异常状态[/color]，则本场战斗上述效果中[color=#52a5f2]异常状态[/color]的附加种数+1，每场战斗限1次"@zh ;
    seer:desc "自身使用攻击技能时，为对手附加烧伤、易燃、焚烬、麻痹中对手不处于的1种异常状态|战斗阶段结束时，若本场战斗自身对同一精灵以上述效果附加过4种异常状态，则本场战斗上述效果中异常状态的附加种数+1，每场战斗限1次|（boss无效）"@zh ;
    seer:effectAlias "alias_2503_1_0" ;
