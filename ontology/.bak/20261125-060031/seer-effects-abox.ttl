seer:soulmark_1750 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4540 ;
    seer:desc "回合开始时自身根据双方特防值之差n触发如下效果：|①.当回合造成的攻击伤害提升n%；|②.恢复n点体力；|③.若n≥200则当回合免疫受到的异常状态|（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时自身根据双方特防值之差n触发如下效果：\r
<indent=32><sprite=4><indent=48>当回合造成的<b>攻击伤害<color=#64F9FA></b>提升</color>n%\r
<indent=32><sprite=4><indent=48><color=#64F9FA>恢复</color>n点<b>体力</b>\r
<indent=32><sprite=4><indent=48>若n≥200则当回合<color=#64F9FA>免疫</color>受到的<b>异常状态</b>"""@zh ;
