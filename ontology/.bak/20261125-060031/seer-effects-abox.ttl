seer:soulmark_1409 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4186 ;
    seer:analyzeDesc "[sprite name=dot4]自身[color=#52a5f2]登场时[/color]获得250点[color=#57c975]护盾[/color]，[color=#52a5f2]己方[/color]背包内每存活1只其他精灵增加100点，若背包内其他精灵全部阵亡则本场战斗自身受到的[color=#52a5f2]固定伤害[/color]和[color=#57c975]百分比伤害[/color][color=#57c975]额外减少(332)[/color]25%|[sprite name=dot4][color=#57c975]回合开始时[/color]，若自身处于异常状态则[color=#52a5f2]当回合[/color]受到的攻击克制倍数最高为2且[color=#57c975]战斗阶段结束时[/color]恢复自身最大体力的1/3，若自身不处于异常状态则[color=#52a5f2]当回合[/color][color=#57c975]受到攻击后[/color]50%随机附加150-300点[color=#52a5f2]固定伤害[/color]，[color=#52a5f2]未触发[/color]则随机减少对手所有技能1-2点PP值"@zh ;
    seer:desc "自身登场时获得250点护盾，己方背包内每存活1只其他精灵增加100点，若背包内其他精灵全部阵亡则本场战斗自身受到的固定伤害和百分比伤害额外减少25%|回合开始时，若自身处于异常状态则当回合受到的攻击克制倍数最高为2且战斗阶段结束时恢复自身最大体力的1/3，若自身不处于异常状态则当回合受到攻击后50%随机附加150-300点固定伤害，未触发则随机减少对手所有技能1-2点PP值（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>登场效果：\r
<indent=16><sprite=3><indent=32>登场后：\r
<indent=32><sprite=4><indent=48><color=#64F9FA>获得</color>250点护盾，背包内每存活1只精灵则效果提升100点\r
<indent=32><sprite=4><indent=48>若背包内存在阵亡精灵且无其他存活精灵则本次在场自身受到的<b>固定伤害</b>和<b>百分比伤害</b><color=#64F9FA>额外减少</color>25%\r
\r
<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时：\r
<indent=32><sprite=4><indent=48>若自身处于异常状态则当回合受到的攻击克制倍数最高为2倍且战斗阶段结束时<color=#64F9FA>恢复</color>自身最大体力的1/3\r
<indent=32><sprite=4><indent=48>若自身不处于异常状态则当回合受到攻击50%<color=#64F9FA>附加</color>150-300点<b>固定伤害</b>，未触发则随机<color=#64F9FA>减少</color>对手所有技能1-2点<b>PP值</b>"""@zh ;
    seer:effectAlias "alias_1778_250_100_25_50_150_300_1_2" ;
