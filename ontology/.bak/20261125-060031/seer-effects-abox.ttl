seer:soulmark_2130 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4935 ;
    seer:analyzeDesc "[sprite name=dot4][color=#57c975]回合开始时[/color]，使自身防御+6、特防+0，[color=#52a5f2]然后[/color]自身每有1级防御能力等级，[color=#52a5f2]当回合[/color]使用攻击技能后附加自身防御值10%的[color=#52a5f2]百分比伤害[/color]并使本场战斗此效果获得的防御能力提升等级-1，特防能力等级提升+1|[sprite name=dot4][color=#57c975]战斗阶段结束时[/color]，若自身上述效果中的防御能力提升的等级已为+0，则自身专属特性中的“防御”、“特防”交换"@zh ;
    seer:desc "回合开始时，使自身防御+6、特防+0，然后自身每有1级防御能力等级，当回合使用攻击技能后附加自身防御值10%的百分比伤害并使本场战斗此效果获得的防御能力提升等级-1，特防能力等级提升+1|战斗阶段结束时，若自身上述效果中的防御能力提升的等级已为+0，则自身专属特性中的“防御”、“特防”交换|（boss无效）"@zh ;
