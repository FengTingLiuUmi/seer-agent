seer:soulmark_1403 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4178 ;
    seer:analyzeDesc "[sprite name=dot4][color=#57c975]回合开始时[/color]为对手附加一层[color=#f35555]暮月玄音[/color]，最高5层|[sprite name=dot4]自身[color=#57c975]攻击技能命中后[/color]，若[color=#52a5f2]当回合[/color]自身为先手方则攻击命中后100%附加[color=#57c975]烧伤[/color]、[color=#57c975]冻伤[/color]、[color=#57c975]中毒[/color]、[color=#57c975]麻痹[/color]、[color=#57c975]害怕[/color]、[color=#57c975]睡眠[/color]中的1种异常状态，[color=#52a5f2]未触发[/color]则令自身[color=#52a5f2]全属性[/color]+1，若[color=#52a5f2]当回合[/color]自身为后手方则令对手[color=#52a5f2]全属性[/color]-1"@zh ;
    seer:desc "回合开始时为对手附加一层暮月玄音，最高5层|自身攻击技能命中后，若当回合自身为先手方则攻击命中后100%附加烧伤、冻伤、中毒、麻痹、害怕、睡眠中的1种异常状态，未触发则令自身全属性+1，若当回合自身为后手方则令对手全属性-1|（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>常驻效果：\r
<indent=16><sprite=3><indent=32>暮月之弦每持续战斗1回合都叠加一层<color=#FFF779>暮月玄音</color>\r
\r
<indent=0><sprite=0><indent=16>触发效果：\r
<indent=16><sprite=3><indent=32>若自身先出手则攻击命中后100%令对手受到烧伤、冻伤、中毒、麻痹、害怕、睡眠中的随机1种<b>异常状态</b>\r
<indent=32><sprite=4><indent=48>未触发则令自身<color=#64F9FA>全属性+1</color>\r
<indent=16><sprite=3><indent=32>若自身后出手则攻击命中后令对手<color=#64F9FA>全属性-1 </color>\r
\r
<indent=0><sprite=5><indent=15>暮月玄音（上限5层）：\r
<indent=16><sprite=6><indent=32>每有1层，都令对手：\r
<indent=32><sprite=4><indent=48><b>命中率</b><color=#64F9FA>降低</color>10%\r
<indent=32><sprite=4><indent=48><b>攻击技能</b>5%<color=#64F9FA>失效</color>"""@zh ;
