seer:soulmark_1942 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4739 ;
    seer:desc "自身使用技能后80%令对手冰封，每次触发后，将下列条件中首个未加入过的条件加入到触发条件中：打出致命一击、造成的伤害高于300、所使用技能PP值为1|回合开始时，自身的上述效果每有一个追加触发条件，自身造成的攻击伤害提升25%，使用技能后吸取对手200点体力（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>技能额外效果：\r
<indent=16><sprite=3><indent=32>自身使用技能后80%<color=#64F9FA>令对手冰封</color>，每次触发后，将下列条件中首个未加入过的条件加入到触发条件中：\r
<indent=32><sprite=4><indent=48>打出致命一击\r
<indent=32><sprite=4><indent=48>造成的伤害高于300\r
<indent=32><sprite=4><indent=48>所使用技能PP值为1\r
\r
<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时，自身的技能额外效果每有一个追加触发条件，自身：\r
<indent=32><sprite=4><indent=48>造成的攻击伤害<color=#64F9FA>提升</color>25%\r
<indent=32><sprite=4><indent=48>使用技能后<color=#64F9FA>吸取</color>对手200点<b>体力</b>"""@zh ;
    seer:effectAlias "alias_2356_80_300_1_25_200_1" ;
    seer:intensified false ;
    seer:isAdv false ;
    seer:pveEffective false ;
    seer:seerapiId "1942" ;
    seer:soulmarkEffect "{\"effect\": {\"id\": 2356, \"url\": \"https://api.seerapi.com/v1/eid_effect/2356\"}, \"effect_args\": [80, 300, 1, 25, 200, 1]}" ;
