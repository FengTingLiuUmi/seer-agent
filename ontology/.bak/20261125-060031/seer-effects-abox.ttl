seer:soulmark_1019 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_3742 ;
    seer:desc "自身攻击50%的概率打出致命一击，未触发则下1次攻击100%的概率打出致命一击；每次登场后造成的攻击伤害提升100%且受到的攻击伤害减少50%，之后每回合造成的攻击伤害减少20%且受到的攻击伤害减少10%，最多减少到0%（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>攻击技能额外效果：\r
<indent=16><sprite=3><indent=32>自身攻击50%<color=#64F9FA>打出致命一击</color>\r
<indent=32><sprite=4><indent=48>未触发则下1次攻击100%<color=#64F9FA>打出致命一击</color>\r
\r
<indent=0><sprite=0><indent=16>登场效果：\r
<indent=16><sprite=3><indent=32>每次登场后，自身造成的<b>攻击伤害</b><color=#64F9FA>提升</color>100%且受到的<b>攻击伤害</b><color=#64F9FA>减少</color>50%\r
<indent=16><sprite=3><indent=32>每回合上述增伤效果降低20%且上述减伤效果减少10%，直至效果归0"""@zh ;
    seer:effectAlias "alias_1318_50_1_100_100_50_20_10_1" ;
    seer:intensified false ;
    seer:isAdv false ;
    seer:pveEffective false ;
    seer:seerapiId "1019" ;
    seer:soulmarkEffect "{\"effect\": {\"id\": 1318, \"url\": \"https://api.seerapi.com/v1/eid_effect/1318\"}, \"effect_args\": [50, 1, 100, 100, 50, 20, 10, 1]}" ;
