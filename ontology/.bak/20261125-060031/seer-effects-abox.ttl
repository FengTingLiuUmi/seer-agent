seer:soulmark_1586 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4361 ;
    seer:analyzeDesc "[sprite name=dot4]自身存活于场下时，[color=#52a5f2]对方[/color]在场精灵每次攻击结束后，洛基获得1层[color=#f35555]堕恶神祇[/color][color=#52a5f2]以[/color]触发[color=#f35555]诡计神罚[/color]|[sprite name=dot4]自身[color=#52a5f2]登场时[/color]，若[color=#f35555]堕恶神祇[/color]达到3层，则2回合内[color=#57c975]回合开始时[/color]、[color=#57c975]战斗阶段结束时[/color]，若自身通过[color=#f35555]堕恶神祇[/color]获得的[color=#57c975]护盾[/color]或[color=#57c975]护罩[/color]消失则[color=#52a5f2]对手[/color]下1次攻击[color=#52a5f2]技能无效[/color]、下次下场后本场战斗自身失去本条效果|[sprite name=dot4]自身[color=#57c975]下场时[/color]，若自身通过[color=#f35555]堕恶神祇[/color]获得的[color=#57c975]护盾[/color]与[color=#57c975]护罩[/color]均已消失，则重置[color=#f35555]堕恶神祇[/color]"@zh ;
    seer:desc "自身存活于场下时，对方在场精灵每次攻击结束后，洛基获得1层堕恶神祇以触发诡计神罚|自身登场时，若堕恶神祇达到3层，则2回合内回合开始时、战斗阶段结束时，若自身通过堕恶神祇获得的护盾或护罩消失则对手下1次攻击技能无效、下次下场后本场战斗自身失去本条效果|自身下场时，若自身通过堕恶神祇获得的护盾与护罩均已消失，则重置堕恶神祇|（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>常驻效果：\r
<indent=16><sprite=3><indent=32>洛基存活于场下时，对方使用攻击技能则洛基获得1层<color=#FFF779>堕恶神祇</color>以对对方在场精灵发动1次诡计神罚：\r
<indent=32><sprite=4><indent=48><color=#64F9FA>附加</color>等同于洛基特攻值20%的<b>真实伤害</b>\r
<indent=32><sprite=4><sprite=4><indent=64>若对手当前体力低于最大体力的1/5则效果转化为令对手该攻击技能<b>PP值</b><color=#64F9FA>归零</color>\r
\r
<indent=0><sprite=0><indent=16>登场效果： \r
<indent=16><sprite=3><indent=32>洛基登场时，根据堕恶神祇的层数触发累计的效果：\r
<indent=32><sprite=4><indent=48>达到1层：<color=#64F9FA>获得</color>堕恶神祇层数*100的<b>护盾</b>与<b>护罩</b>；若二者均存在则每回合开始使自身当回合受到的异常状态<color=#64F9FA>转化</color>为流血，若二者均消失则洛基离场后堕恶神祇层数重置\r
<indent=32><sprite=4><indent=48>达到3层：登场之后2回合内，每个回合开始时与战斗阶段结束时若自身未拥有上述效果中的护盾或护罩其一，则触发以下效果： \r
<indent=32><sprite=4><sprite=4><indent=64>对手的下1次<b>攻击技能</b><color=#64F9FA>无效</color>\r
<indent=32><sprite=4><sprite=4><indent=64>本场战斗不再触发上述判定 \r
\r
<indent=0><sprite=5><indent=15>堕恶神祇（上限3层，下场保留）：\r
<indent=16><sprite=6><indent=32>洛基用以触发部分效果的判定依据"""@zh ;
    seer:effectAlias "alias_1944_100_2_1_2_2_2_3_1" ;
