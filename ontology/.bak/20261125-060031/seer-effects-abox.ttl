seer:soulmark_2030 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_3983 ;
    seer:analyzeDesc "[sprite name=dot4][color=#57c975]登场时[/color]，自身获得最大体力1/3的[color=#57c975]护盾[/color]，此[color=#57c975]护盾[/color]消失时[color=#52a5f2]当回合[/color][color=#57c975]战斗阶段结束时[/color]自身恢复全部PP值，此[color=#57c975]护盾[/color]存在时每[color=#57c975]回合开始时[/color]令于[color=#52a5f2]当回合[/color][color=#52a5f2]登场[/color]的[color=#52a5f2]对手[/color][color=#57c975]星赎[/color]3回合，每次受到[color=#52a5f2]致死伤害[/color]时消耗自身所有能力值的50%[color=#52a5f2]以[/color]重生，[color=#57c975]星赎[/color][color=#52a5f2]未触发[/color]时令自身[color=#57c975]砥砺[/color]3回合，重生触发[color=#52a5f2]之后[/color]本场战斗自身失去本条效果且下述效果触发条件中的“自身”改为“双方任意一方”、所有数字改为一半（向上取整）|[sprite name=dot4][color=#57c975]回合开始时[/color]，若自身处于[color=#52a5f2]异常状态[/color]则[color=#52a5f2]当回合[/color]受到的[color=#52a5f2]攻击伤害[/color]减少(自身双防值*5)/(自身最大体力*10)、受到的其他非[color=#52a5f2]真实伤害[/color]减少(自身最大体力*5)/(自身双防值*10)，[color=#52a5f2]当回合[/color][color=#57c975]战斗阶段结束时[/color]令[color=#52a5f2]对手[/color][color=#57c975]星赎[/color]，[color=#52a5f2]未触发[/color]自身下次攻击后令[color=#52a5f2]对手[/color][color=#57c975]石化[/color]，若自身不处于[color=#52a5f2]异常状态[/color]则获得([color=#52a5f2]对手[/color]已损失PP值*[color=#52a5f2]对手[/color]最大体力/100)+自身最大体力1/3的[color=#57c975]护罩[/color]，[color=#52a5f2]当回合[/color]自身受到非致死[color=#52a5f2]真实伤害[/color]时，恢复此[color=#57c975]护罩[/color]的体力且[color=#52a5f2]反转[/color][color=#52a5f2]对手[/color][color=#52a5f2]能力提升状态[/color]，[color=#52a5f2]反转[/color]成功令[color=#52a5f2]对手[/color][color=#57c975]砥砺[/color]"@zh ;
    seer:derivedFrom seer:soulmark_1245 ;
    seer:desc "登场时，自身获得最大体力1/3的护盾，此护盾消失时当回合战斗阶段结束时自身恢复全部PP值，此护盾存在时每回合开始时令于当回合登场的对手星赎3回合，每次受到致死伤害时消耗自身所有能力值的50%以重生，星赎未触发时令自身砥砺3回合，重生触发之后本场战斗自身失去本条效果且下述效果触发条件中的“自身”改为“双方任意一方”、所有数字改为一半（向上取整）|回合开始时，若自身处于异常状态则当回合受到的攻击伤害减少(自身双防值*5)/(自身最大体力*10)、受到的其他非真实伤害减少(自身最大体力*5)/(自身双防值*10)，当回合战斗阶段结束时令对手星赎，未触发自身下次攻击后令对手石化，若自身不处于异常状态则获得(对手已损失PP值*对手最大体力/100)+自身最大体力1/3的护罩，当回合自身受到非致死真实伤害时，恢复此护罩的体力且反转对手能力提升状态，反转成功令对手砥砺|（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>登场效果：\r
<indent=16><sprite=3><indent=32>辰坤星魂每次登场时激发辰星石：自身<color=#64F9FA>获得</color>最大体力1/3的<b>护盾</b>\r
<indent=32><sprite=4><indent=48>此护盾消失时当回合战斗阶段结束时自身<color=#64F9FA>恢复</color>全部<b>PP值</b>\r
<indent=32><sprite=4><indent=48>此护盾存在时：\r
<indent=32><sprite=4><sprite=4><indent=64>若对方精灵于本回合登场回合开始时则<color=#64F9FA>令对手星赎</color>3回合\r
<indent=32><sprite=4><sprite=4><sprite=4><indent=80>未触发则<color=#64F9FA>令自身砥砺</color>3回合\r
<indent=32><sprite=4><sprite=4><indent=64>若自身受到致死伤害则<color=#64F9FA>消耗</color>自身所有<b>能力值</b>的50%以<color=#64F9FA>重生</color>，重生触发之后自身本场战斗：\r
<indent=32><sprite=4><sprite=4><sprite=4><indent=80>下述回合开始效果触发条件中的“自身”改为“双方任意一方”、所有数字改为一半且向上取整\r
<indent=32><sprite=4><sprite=4><sprite=4><indent=80>无法再激发辰星石\r
\r
<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时：\r
<indent=32><sprite=4><indent=48>若<color=#64F9FA>自身</color>处于异常状态则当回合：\r
<indent=32><sprite=4><sprite=4><indent=64>受到的<b>攻击伤害</b><color=#64F9FA>减少</color>(自身双防值*<color=#64F9FA>5</color>)/(自身最大体力*<color=#64F9FA>10</color>)\r
<indent=32><sprite=4><sprite=4><indent=64>受到的<b>其他非真实伤害</b><color=#64F9FA>减少</color>(自身最大体力*<color=#64F9FA>5</color>)/(自身双防值*<color=#64F9FA>10</color>)\r
<indent=32><sprite=4><sprite=4><indent=64>战斗阶段结束时<color=#64F9FA>令对手星赎</color>\r
<indent=32><sprite=4><sprite=4><sprite=4><indent=80>未触发则自身下次攻击后<color=#64F9FA>令对手石化</color>\r
<indent=32><sprite=4><indent=48>若<color=#64F9FA>自身</color>不处于异常状态则：\r
<indent=32><sprite=4><sprite=4><indent=64><color=#64F9FA>获得</color>(对手已损失PP值*对手最大体力/<color=#64F9FA>100</color>)+自身最大体力<color=#64F9FA>1</color>/<color=#64F9FA>3</color>的<b>护罩</b>\r
<indent=32><sprite=4><sprite=4><indent=64>当回合自身受到非致死真实伤害时，<color=#64F9FA>恢复</color>此护罩的<b>体力</b>且<color=#64F9FA>反转</color>对手的<b>能力提升状态</b>\r
<indent=32><sprite=4><sprite=4><sprite=4><indent=80>反转成功则<color=#64F9FA>令对手砥砺</color>\r
\r
<indent=0><sprite=5><indent=15>星赎：\r
<indent=16><sprite=6><indent=32>附属类异常状态，该状态下的精灵<b>体力恢复效果</b><color=#64F9FA>提升</color>30%，每回合结束时所有非限制类异常状态的回合数+1"""@zh ;
    seer:effectAlias "alias_2451_1_0" ;
