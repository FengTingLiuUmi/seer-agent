seer:soulmark_817 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_3507 ;
    seer:analyzeDesc "[sprite name=dot4][color=#57c975]回合开始时[/color]，若[color=#52a5f2]对手[/color]不处于[color=#57c975]冰封[/color]状态则[color=#52a5f2]当回合[/color]自身所有技能[color=#52a5f2]先制[/color]+1|[sprite name=dot4]自身命中的技能额外50%令[color=#52a5f2]对手[/color][color=#57c975]冰封[/color]，[color=#52a5f2]未触发[/color]则消除[color=#52a5f2]对手[/color][color=#52a5f2]回合类效果[/color]，[color=#52a5f2]然后[/color]若本次技能为攻击技能且[color=#52a5f2]对手[/color]处于[color=#57c975]冰封[/color]状态则附加[color=#52a5f2]对手[/color]最大体力1/3的[color=#52a5f2]百分比伤害[/color]"@zh ;
