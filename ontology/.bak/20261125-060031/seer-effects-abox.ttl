seer:soulmark_2075 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4888 ;
    seer:analyzeDesc "[sprite name=dot4][color=#57c975]回合开始时[/color]，若自身不处于[color=#52a5f2]异常状态[/color]则[color=#52a5f2]当回合[/color]自身受到的[color=#52a5f2]攻击伤害[/color]减少30%，[color=#52a5f2]对手[/color]使用的攻击技能微弱自身时改为受到的[color=#52a5f2]固定伤害[/color]、[color=#52a5f2]百分比伤害[/color]减少30%，若自身处于[color=#52a5f2]异常状态[/color]则消除[color=#52a5f2]对手[/color][color=#52a5f2]能力提升状态[/color]，消除成功时令[color=#52a5f2]对手[/color][color=#57c975]疲惫[/color]|[sprite name=dot4][color=#57c975]战斗阶段结束时[/color]，若[color=#52a5f2]当回合[/color]自身[color=#52a5f2]先制[/color]等级与上回合不相等则下回合[color=#52a5f2]技能先制[/color]+1，高于上回合时恢复自身最大体力的30%，低于上回合时额外解除自身所处的[color=#52a5f2]异常状态[/color]，与自身本次在场的所有回合均不同时每有1回合不同下回合造成的[color=#52a5f2]攻击伤害[/color]提升30%|[sprite name=dot4]自身位于出战背包时，[color=#52a5f2]对方[/color]进入附属类[color=#52a5f2]异常状态[/color]时，[color=#52a5f2]己方[/color]打开[color=#f35555]天之门[/color]、[color=#f35555]地之门[/color]、[color=#f35555]神之门[/color]中首个未打开的[color=#f35555]神域之门[/color]，[color=#57c975]回合结束后[/color]，若[color=#52a5f2]己方[/color]其他精灵处于附属类[color=#52a5f2]异常状态[/color]，则关闭首个未关闭的[color=#f35555]神域之门[/color]"@zh ;
    seer:desc "回合开始时，若自身不处于异常状态则当回合自身受到的攻击伤害减少30%，对手使用的攻击技能微弱自身时改为受到的固定伤害、百分比伤害减少30%，若自身处于异常状态则消除对手能力提升状态，消除成功时令对手疲惫|战斗阶段结束时，若当回合自身先制等级与上回合不相等则下回合技能先制+1，高于上回合时恢复自身最大体力的30%，低于上回合时额外解除自身所处的异常状态，与自身本次在场的所有回合均不同时每有1回合不同下回合造成的攻击伤害提升30%|自身位于出战背包时，对方进入附属类异常状态时，己方打开天之门、地之门、神之门中首个未打开的神域之门，回合结束后，若己方其他精灵处于附属类异常状态，则关闭首个未关闭的神域之门|（boss无效）"@zh ;
    seer:effectAlias "alias_2495_1_0" ;
