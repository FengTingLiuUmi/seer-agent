seer:soulmark_1694 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4482 ;
    seer:desc "回合开始时若对手处于能力提升或自身处于能力下降，则当回合自身免疫并反弹受到的异常状态且使用技能无视对手能力提升状态、无视自身能力下降状态；|战斗阶段结束时若双方共计处于5种或以上的能力提升与5种或以上的能力下降，则令双方所处的能力提升与能力下降等级翻倍，且下回合对手无法主动切换精灵|（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时若对手处于能力提升或自身处于能力下降，则当回合自身<color=#64F9FA>无视</color>对手<b>能力提升</b>与自身<b>能力下降</b>且<color=#64F9FA>免疫并反弹</color>受到的<b>异常状态</b>\r
\r
<indent=0><sprite=0><indent=16>战阶结束效果：\r
<indent=16><sprite=3><indent=32>战斗阶段结束时若双方共计处于5种或以上的能力提升与5种或以上的能力下降，则令该能力提升与能力下降翻倍，且下回合对手<color=#64F9FA>无法主动切换精灵</color>"""@zh ;
    seer:effectAlias "alias_2079_5_5_1" ;
