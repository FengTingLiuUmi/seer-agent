seer:soulmark_1457 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4238 ;
    seer:desc "回合开始时，自身能力提升等级总和≥12则当回合攻击技能先制+1；|回合开始时，自身每有1项能力提升等级≥对手则当回合造成的攻击伤害提升15%，若＞3项则使用攻击技能每1项附加80点固定伤害，若≤3项则使用攻击技能每1项附加160点固定伤害且战斗阶段结束时令自身全属性+1（boss无效）"@zh ;
