seer:soulmark_1636 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4419 ;
    seer:desc "回合开始时若双方任意一方处于能力下降状态则当回合自身100%闪避对手的攻击；战斗阶段结束时若当回合自身未受到攻击伤害则下回合自身所有技能先制+1且造成的攻击伤害提升50%（boss无效）"@zh ;
