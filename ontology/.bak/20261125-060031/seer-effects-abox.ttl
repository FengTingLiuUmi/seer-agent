seer:soulmark_1250 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_3990 ;
    seer:desc "自身使用攻击技能有50%的概率造成的伤害翻倍，未触发则自身下次使用技能先制+2；对手使用攻击技能有50%的概率进入焚烬状态，未触发则附加对手最大体力1/3的固定伤害（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>触发效果：\r
<indent=16><sprite=3><indent=32>自身使用攻击技能有50%的概率造成的<b>攻击伤害</b><color=#64F9FA>翻倍</color>\r
