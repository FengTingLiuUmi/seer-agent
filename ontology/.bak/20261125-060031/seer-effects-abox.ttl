seer:soulmark_1052 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_3774 ;
    seer:desc "回合开始时，自身每处于一级速度能力提升状态则当回合攻击技能附加对手最大体力1/6的固定伤害；自身使用攻击技能时若对手处于流血状态，则50%令对手害怕，未触发害怕则100%令对手麻痹（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时，自身每处于一级速度能力提升状态则当回合攻击技能<color=#64F9FA>附加</color>对手最大体力1/6的<b>百分比伤害</b>\r
\r
<indent=0><sprite=0><indent=16>攻击技能额外效果：\r
<indent=16><sprite=3><indent=32>自身使用攻击技能时若对手处于流血状态则50%<color=#64F9FA>令对手害怕</color>\r
<indent=32><sprite=4><indent=48>未触发则100%<color=#64F9FA>令对手麻痹</color>"""@zh ;
    seer:effectAlias "alias_1351_6_50_100_1" ;
    seer:intensified false ;
    seer:isAdv false ;
    seer:pveEffective false ;
    seer:seerapiId "1052" ;
    seer:soulmarkEffect "{\"effect\": {\"id\": 1351, \"url\": \"https://api.seerapi.com/v1/eid_effect/1351\"}, \"effect_args\": [6, 50, 100, 1]}" ;
    seer:sourceUrl "https://api.seerapi.com/v1/soulmark/1052" .

