seer:soulmark_1573 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4349 ;
    seer:desc "回合开始时若对手不处于异常状态则令对手随机2项能力值-1，战斗阶段结束时若对手处于异常状态则令自身全属性+1；|自身技能命中后若对手有2项以上能力值处于下降状态则100%令对手麻痹，未触发则附加对手最大体力1/3的百分比伤害（boss无效）"@zh ;
