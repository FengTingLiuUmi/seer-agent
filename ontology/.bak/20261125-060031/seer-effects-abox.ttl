seer:soulmark_1881 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4682 ;
    seer:desc "回合开始时，若自身体力值为奇数，当回合造成的攻击伤害提升50%，若自身体力值为偶数，当回合对手攻击技能附加效果失效|自身使用技能后若未造成攻击伤害则附加对手最大体力1/3的百分比伤害，对手使用技能后若未造成攻击伤害则随机1个技能PP值归0|（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时：\r
<indent=32><sprite=4><indent=48>若自身体力值为奇数，当回合造成的<b>攻击伤害<color=#64F9FA></b>提升</color>50%\r
<indent=32><sprite=4><indent=48>若自身体力值为偶数，当回合对手<b>攻击技能</b><color=#64F9FA>命中效果失效</color>\r
\r
<indent=0><sprite=0><indent=16>技能额外效果：\r
<indent=16><sprite=3><indent=32>自身使用技能后若未造成攻击伤害则<color=#64F9FA>附加</color>对手最大体力1/3的<b>百分比伤害</b>\r
<indent=16><sprite=3><indent=32>对手使用技能后若未造成攻击伤害则随机1个技能<b>PP值<color=#64F9FA></b>归0</color>"""@zh ;
    seer:effectAlias "alias_2279_50_3_1_1" ;
    seer:intensified false ;
    seer:isAdv false ;
    seer:pveEffective false ;
    seer:seerapiId "1881" ;
    seer:soulmarkEffect "{\"effect\": {\"id\": 2279, \"url\": \"https://api.seerapi.com/v1/eid_effect/2279\"}, \"effect_args\": [50, 3, 1, 1]}" ;
