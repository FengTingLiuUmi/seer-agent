seer:soulmark_1583 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4358 ;
    seer:desc "自身为对手天敌时，自身受到的伤害除以m（m＝自身对对手的克制倍数，最高不超过2），对手为自身天敌时，自身造成的伤害乘n（n＝对手对自身的克制倍数，最高不超过2）；|回合开始时，若自身体力值与速度值之和低于对手则令对手速度、命中-1，若自身攻击值与特攻值之和低于对手则令对手攻击、特攻-1，若自身防御值与特防值之和低于对手则令对手防御、特防-1；以上效果若至少1项未满足条件或未触发则当回合战斗阶段结束时恢复自身最大体力的1/3，若至少2项未满足条件或未触发则当回合自身所有技能先制+1，若3项均未满足条件或未触发则消除对手回合类效果（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>常驻效果：\r
<indent=16><sprite=3><indent=32>自身为对手天敌时，自身受到的<b>攻击伤害</b>除以m，m＝自身对对手的克制倍数，最高不超过2\r
<indent=16><sprite=3><indent=32>对手为自身天敌时，自身造成的<b>攻击伤害</b>乘n，n＝对手对自身的克制倍数，最高不超过2\r
\r
<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时：\r
<indent=32><sprite=4><indent=48>根据比较双方的部分数值，触发以下效果：\r
<indent=32><sprite=4><sprite=4><indent=64>若自身体力值与速度值之和低于对手则令对手速度、命中-1\r
<indent=32><sprite=4><sprite=4><indent=64>若自身攻击值与特攻值之和低于对手则令对手攻击、特攻-1\r
<indent=32><sprite=4><sprite=4><indent=64>若自身防御值与特防值之和低于对手则令对手防御、特防-1\r
<indent=32><sprite=4><indent=48>根据以上效果的触发情况，触发以下效果：\r
<indent=32><sprite=4><sprite=4><indent=64>有至少1项未满足条件或未触发则当回合战斗阶段结束时<color=#64F9FA>恢复</color>自身1/3最大体力\r
<indent=32><sprite=4><sprite=4><indent=64>有至少2项未满足条件或未触发则当回合自身<b>先制</b>+1\r
<indent=32><sprite=4><sprite=4><indent=64>若3项未满足条件或未触发则<color=#64F9FA>消除</color>对手<b>回合类效果</b>"""@zh ;
    seer:effectAlias "alias_1942_1_3_2_1_3_1" ;
    seer:intensified false ;
    seer:intensifiedTo seer:soulmark_1905 ;
    seer:isAdv false ;
    seer:pveEffective false ;
    seer:seerapiId "1583" ;
    seer:soulmarkEffect "{\"effect\": {\"id\": 1942, \"url\": \"https://api.seerapi.com/v1/eid_effect/1942\"}, \"effect_args\": [1, 3, 2, 1, 3, 1]}" ;
