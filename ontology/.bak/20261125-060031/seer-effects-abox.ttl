seer:soulmark_1609 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4390 ;
    seer:desc "回合开始时若自身体力低于最大体力的1/2则当回合免疫对手的先手攻击伤害，若自身仍受到攻击伤害则令对手下回合受到的固定伤害和百分比伤害提升30%；|自身每次使用攻击技能附加自身上回合受到攻击伤害数值50%的百分比伤害，若自身上回合未受到攻击伤害则吸取对手300点体力（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时若自身体力低于最大体力的1/2则当回合：\r
<indent=32><sprite=4><indent=48>若对手先出手，则<color=#64F9FA>抵挡</color>对手的<b>攻击</b>\r
<indent=32><sprite=4><indent=48>若自身受到攻击伤害，则令对手下回合受到的<b>固定伤害</b>和<b>百分比伤害<color=#64F9FA></b>提升</color>30%\r
\r
<indent=0><sprite=0><indent=16>攻击技能额外效果：\r
<indent=16><sprite=3><indent=32>自身每次使用攻击技能<color=#64F9FA>附加</color>等同于自身上回合受到攻击伤害数值50%的<b>百分比伤害</b>\r
<indent=32><sprite=4><indent=48>若自身上回合未受到攻击伤害则<color=#64F9FA>吸取</color>对手300点<b>体力</b>"""@zh ;
