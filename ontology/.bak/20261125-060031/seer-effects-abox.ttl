seer:soulmark_1702 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4491 ;
    seer:desc "对手攻击技能命中前100%令对手命中-1，然后若对手不处于能力下降状态则2回合内自身攻击必定打出致命一击；自身打出致命一击时无视对手的特攻格挡效果（boss有效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>触发效果：\r
<indent=16><sprite=3><indent=32>对手攻击技能命中前100%令对手命中-1\r
<indent=32><sprite=4><indent=48>然后若对手不处于能力下降状态则2回合内自身攻击必定<color=#64F9FA>打出致命一击</color>\r
\r
<indent=0><sprite=0><indent=16>常驻效果：\r
<indent=16><sprite=3><indent=32>自身打出致命一击时<color=#64F9FA>无视</color>对手的<b>特攻格挡</b>效果"""@zh ;
    seer:effectAlias "alias_2091_100_1_2" ;
    seer:intensified false ;
    seer:isAdv false ;
    seer:pveEffective true ;
    seer:seerapiId "1702" ;
