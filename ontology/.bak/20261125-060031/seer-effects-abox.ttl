seer:soulmark_1654 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4435 ;
    seer:desc "自身使用攻击技能若连续次数≥2次则造成的攻击伤害提升50%，若连续次数≥3次则无视攻击免疫效果，若连续次数≥4次则造成伤害前附加对手防御值和特防值总和40%的百分比伤害，若连续次数≥n次则使用后额外消耗对手全部体力（n=自身携带技能中PP值上限最高技能的PP值上限）（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>触发效果：\r
<indent=16><sprite=3><indent=32>自身连续使用攻击技能时：\r
<indent=32><sprite=4><indent=48>若连续次数≥2次则造成的<b>攻击伤害</b><color=#64F9FA>提升</color>50%\r
<indent=32><sprite=4><indent=48>若连续次数≥3次则<color=#64F9FA>无视</color>对手<b>攻击免疫效果</b>\r
<indent=32><sprite=4><indent=48>若连续次数≥4次则额外<color=#64F9FA>附加</color>对手双防总和40%的<b>百分比伤害</b>\r
<indent=32><sprite=4><indent=48>若连续次数≥n次则额外消耗对手全部体力（n=自身携带技能中PP值上限最高技能的PP值上限）"""@zh ;
