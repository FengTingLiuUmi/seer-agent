seer:soulmark_1204 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_3941 ;
    seer:analyzeDesc "[sprite name=dot4]战斗阶段结束或战斗阶段中断时，若自身体力低于最大体力的1/2则100%令[color=#52a5f2]对手[/color][color=#57c975]害怕[/color]，[color=#52a5f2]未触发[/color]则[color=#52a5f2]吸取[/color][color=#52a5f2]对手[/color]最大体力的1/3，若自身体力高于最大体力的1/2则2回合内[color=#57c975]免疫[/color]并[color=#57c975]反弹[/color]受到的[color=#52a5f2]异常状态[/color]|[sprite name=dot4]自身[color=#57c975]击败[/color]存在[color=#f35555]黑暗之种[/color]的[color=#52a5f2]对手[/color]时令[color=#52a5f2]对方[/color]下只出战精灵随机2个技能PP值归0，自身[color=#57c975]被[/color]拥有[color=#f35555]黑暗之种[/color]的[color=#52a5f2]对手[/color][color=#57c975]击败时[/color]，令[color=#52a5f2]对手[/color][color=#57c975]害怕[/color]"@zh ;
    seer:desc "战斗阶段结束或战斗阶段中断时，若自身体力低于最大体力的1/2则100%令对手害怕，未触发则吸取对手最大体力的1/3，若自身体力高于最大体力的1/2则2回合内免疫并反弹受到的异常状态|自身击败存在黑暗之种的对手时令对方下只出战精灵随机2个技能PP值归0，自身被拥有黑暗之种的对手击败时，令对手害怕|（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>战阶结束效果：\r
<indent=16><sprite=3><indent=32>战斗阶段结束时：\r
<indent=32><sprite=4><indent=48>若自身体力低于最大体力的1/2则100%<color=#64F9FA>令对手害怕</color>\r
<indent=32><sprite=4><sprite=4><indent=64>未触发害怕则<color=#64F9FA>吸取</color>对手最大体力的1/3\r
<indent=32><sprite=4><indent=48>若自身体力高于最大体力的1/2则2回合内<color=#64F9FA>免疫并反弹</color>异常状态\r
<indent=32><sprite=4><indent=48>若当回合战斗阶段被中断，则于回合结束后判定上述效果\r
\r
<indent=0><sprite=0><indent=16>触发效果：\r
<indent=16><sprite=3><indent=32>对手处于黑暗之种影响时：\r
<indent=32><sprite=4><indent=48>若对手被自身击败则下只精灵登场后随机2个技能PP值<color=#64F9FA>归零</color>\r
<indent=32><sprite=4><indent=48>若自身被对手击败则100%<color=#64F9FA>令对手害怕</color>\r
\r
<indent=0><sprite=5><indent=15>黑暗之种（上限4级）：\r
<indent=16><sprite=6><indent=32>黑暗之种从被附加的次回合起，每回合结束后成长1级，达到4级时成熟\r
<indent=16><sprite=6><indent=32>成长期时，黑暗之种每回合使拥有者随机1个技能PP值-1\r
<indent=16><sprite=6><indent=32>成熟后，黑暗之种每回合使拥有者所有技能PP值-1"""@zh ;
    seer:effectAlias "alias_1539_2_100_3_2_2_100_1" ;
