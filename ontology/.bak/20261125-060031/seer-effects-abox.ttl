seer:soulmark_1860 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4658 ;
    seer:desc "自身登场后的3回合内每次进入异常状态时将之转化为3回合的沉默并记录这些异常状态（最多记录4次）；自身登场的3回合后，每次使用攻击技能后清除首个异常状态的记录以吸取对手最大体力的1/3|自身在场时每持有1个异常状态的记录，造成的伤害提高30%且回合结束后恢复自身最大体力的15%；自身下场时清除所有异常状态的记录并依次附加给己方下只出战精灵（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>登场效果：\r
<indent=16><sprite=3><indent=32>自身登场后的3回合内，每次进入异常状态时将之<color=#64F9FA>转化</color>为3回合的沉默并记录这些<b>异常状态</b>，最多记录4个\r
<indent=16><sprite=3><indent=32>自身登场的3回合后，每次使用攻击技能后清除首个异常状态的记录以<color=#64F9FA>吸取</color>对手最大体力的1/3\r
\r
<indent=0><sprite=0><indent=16>常驻效果：\r
<indent=16><sprite=3><indent=32>自身在场时每持有1个异常状态的记录，造成的<b>攻击伤害</b><color=#64F9FA>提升</color>30%且回合结束后<color=#64F9FA>恢复</color>自身最大体力的15%\r
\r
<indent=0><sprite=0><indent=16>下场效果：\r
<indent=16><sprite=3><indent=32>自身下场时清除上述记录内的所有异常状态并依次附加给己方下只出战精灵"""@zh ;
    seer:effectAlias "alias_2255_3_3_3_1_30_30_1" ;
    seer:intensified false ;
    seer:isAdv false ;
    seer:pveEffective false ;
    seer:seerapiId "1860" ;
    seer:soulmarkEffect "{\"effect\": {\"id\": 2255, \"url\": \"https://api.seerapi.com/v1/eid_effect/2255\"}, \"effect_args\": [3, 3, 3, 1, 30, 30, 1]}" ;
    seer:soulmarkTag seer:soulmark_tag_2,
        seer:soulmark_tag_8 ;
    seer:sourceUrl "https://api.seerapi.com/v1/soulmark/1860" .

seer:soulmark_1861 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4659 ;
    seer:desc "自身先出手时100%令对手烧伤，触发成功自身全属性+1，触发失败下回合所有技能先制+1|回合开始时，若对手处于异常状态则当回合攻击技能必定打出致命一击，若对手不处于异常状态则当回合受到的攻击伤害减少30%（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>触发效果：\r
<indent=16><sprite=3><indent=32>自身先出手时100%<color=#64F9FA>令对手烧伤</color>\r
<indent=32><sprite=4><indent=48>触发成功自身<color=#64F9FA>全属性+1</color>\r
<indent=32><sprite=4><indent=48>触发失败下回合所有技能<b>先制</b>+1\r
\r
<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时：\r
<indent=32><sprite=4><indent=48>若对手处于异常状态则当回合<b>攻击技能<color=#64F9FA></b>必定打出致命一击</color>\r
<indent=32><sprite=4><indent=48>若对手不处于异常状态则当回合受到的<b>攻击伤害<color=#64F9FA></b>减少</color>30%"""@zh ;
    seer:effectAlias "alias_2256_100_1_1_30_1" ;
    seer:intensified false ;
    seer:isAdv false ;
    seer:pveEffective false ;
    seer:seerapiId "1861" ;
