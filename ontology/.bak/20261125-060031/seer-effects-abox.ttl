seer:soulmark_574 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_2987 ;
    seer:analyzeDesc "[sprite name=dot1]自身[color=#57c975]被击败后[/color]，[color=#52a5f2]复活[/color]出战背包内的1只阵亡且专属特性中没有此效果的精灵|[sprite name=dot1]自身可以拥有最多6层[color=#f35555]神耀能量[/color]并根据[color=#f35555]神耀能量[/color]所[color=#52a5f2]达到[/color]的层数获得以下效果：|[sprite name=dot1]1层：每有1层[color=#f35555]神耀能量[/color]自身受到的攻击[color=#52a5f2]伤害额外减少[/color]8%|[sprite name=dot1]2层：[color=#57c975]免疫[/color]受到的[color=#52a5f2]异常状态[/color]与[color=#52a5f2]能力下降状态[/color]|[sprite name=dot1]3层：自身使用技能[color=#52a5f2]之后[/color]每[color=#57c975]回合结束后[/color]恢复自身最大体力的1/3|[sprite name=dot1]4层：[color=#57c975]免疫[/color]并[color=#52a5f2]反弹[/color]自身受到的[color=#52a5f2]固定伤害[/color]|[sprite name=dot1]5层:攻击[color=#52a5f2]技能先制[/color]+1|[sprite name=dot1]6层:自身造成的[color=#52a5f2]攻击伤害[/color]提升60%且第五技能[color=#52a5f2]威力[/color]提升不再消耗[color=#f35555]神耀能量[/color]，非PVE对战中[color=#57c975]击败[/color][color=#52a5f2]对手[/color]后自身[color=#f35555]神耀能量[/color]层数归0且下回合[color=#52a5f2]技能先制[/color]+3，PVE对战中4回合后自身[color=#f35555]神耀能量[/color]层数归0且下回合[color=#52a5f2]技能先制[/color]+3"@zh ;
    seer:derivedFrom seer:soulmark_372 ;
    seer:desc "自身被击败后，复活出战背包内的1只阵亡且专属特性中没有此效果的精灵|自身可以拥有最多6层神耀能量并根据神耀能量所达到的层数获得以下效果：|1层：每有1层神耀能量自身受到的攻击伤害额外减少8%|2层：免疫受到的异常状态与能力下降状态|3层：自身使用技能之后每回合结束后恢复自身最大体力的1/3|4层：免疫并反弹自身受到的固定伤害|5层:攻击技能先制+1|6层:自身造成的攻击伤害提升60%且第五技能威力提升不再消耗神耀能量，非PVE对战中击败对手后自身神耀能量层数归0且下回合技能先制+3，PVE对战中4回合后自身神耀能量层数归0且下回合技能先制+3|（boss有效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>被击败效果：\r
<indent=16><sprite=3><indent=32>自身被击败后100%随机<color=#64F9FA>复活</color>出战背包内已<b>被击败</b>的1只精灵，无法复活重生之翼\r
\r
<indent=0><sprite=0><indent=16>神耀能量（上限6层，下场保留）：\r
<indent=16><sprite=3><indent=32>重生之翼依照神耀能量层数获得<b>累计</b>的效果:\r
<indent=32><sprite=4><indent=48>1层：<color=#64F9FA>额外减少</color>自身受到伤害的8%，每增加1层额外获得8%的减伤\r
<indent=32><sprite=4><indent=48>2层：<color=#64F9FA>免疫</color>所有<b>异常状态</b>、<color=#64F9FA>免疫</color>所有<b>能力下降状态</b>\r
<indent=32><sprite=4><indent=48>3层：自身出手后，当次在场每回合结束后<color=#64F9FA>恢复</color>自身最大体力的1/3\r
<indent=32><sprite=4><indent=48>4层：<color=#64F9FA>免疫并反弹</color>自身受到的<b>固定伤害</b>\r
<indent=32><sprite=4><indent=48>5层：所有攻击技能<b>先制</b>额外+1\r
<indent=32><sprite=4><indent=48>6层：\r
<indent=32><sprite=4><sprite=4><indent=64>造成的<b>攻击伤害</b><color=#64F9FA>提升</color>60%且第五技能威力提升不再消耗神耀能量\r
<indent=32><sprite=4><sprite=4><indent=64>赛尔对战中击败对手后自身神耀能量清零且下回合<b>先制</b>+3，非赛尔对战中4回合后自身神耀能量清零且下回合<b>先制</b>+3"""@zh ;
    seer:effectAlias "alias_866_100_1_8_8_3_1_60_3" ;
    seer:intensified true ;
    seer:isAdv false ;
    seer:pveEffective true ;
    seer:seerapiId "574" ;
    seer:soulmarkEffect "{\"effect\": {\"id\": 866, \"url\": \"https://api.seerapi.com/v1/eid_effect/866\"}, \"effect_args\": [100, 1, 8, 8, 3, 1, 60, 3]}" ;
