seer:soulmark_2117 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4921 ;
    seer:analyzeDesc "[sprite name=dot4]战斗开始时，自身消耗20%的体力上限并提升自身的其他能力值等量的数值，[color=#52a5f2]然后[/color]自身记录自身的体力上限，[color=#52a5f2]之后[/color]本场战斗自身[color=#57c975]登场[/color]时，若[color=#52a5f2]对手[/color]的体力上限低于此记录值，令[color=#52a5f2]对手[/color]的体力上限增加20%并减少其他能力值等量的数值|[sprite name=dot4]自身进入[color=#52a5f2]异常状态[/color]时，若此[color=#52a5f2]异常状态[/color]位于自身[color=#52a5f2]异常状态[/color]抗性的1号位，则自身恢复所有技能PP值，若此[color=#52a5f2]异常状态[/color]位于自身[color=#52a5f2]异常状态[/color]抗性的2号位，则[color=#52a5f2]对手[/color]下回合属性[color=#52a5f2]技能无效[/color]，若此[color=#52a5f2]异常状态[/color]位于自身[color=#52a5f2]异常状态[/color]的3号位，则[color=#52a5f2]对手[/color]下回合攻击[color=#52a5f2]技能无效[/color]|[sprite name=dot4][color=#57c975]战斗阶段结束时[/color]，自身恢复最大体力的1/4，上述效果每满足过1次效果提升1/4，溢出的恢复量转化为等量的临时体力上限，最高叠加至自身战斗开始时所记录数值，未溢出时下回合自身以[color=#57c975]最优系别[/color]计算受到的[color=#52a5f2]攻击伤害[/color]与造成的[color=#52a5f2]攻击伤害[/color]"@zh ;
    seer:desc "战斗开始时，自身消耗20%的体力上限并提升自身的其他能力值等量的数值，然后自身记录自身的体力上限，之后本场战斗自身登场时，若对手的体力上限低于此记录值，令对手的体力上限增加20%并减少其他能力值等量的数值|自身进入异常状态时，若此异常状态位于自身异常状态抗性的1号位，则自身恢复所有技能PP值，若此异常状态位于自身异常状态抗性的2号位，则对手下回合属性技能无效，若此异常状态位于自身异常状态的3号位，则对手下回合攻击技能无效|战斗阶段结束时，自身恢复最大体力的1/4，上述效果每满足过1次效果提升1/4，溢出的恢复量转化为等量的[color=#57c975]临时体力上限[/color]，最高不超过自身战斗开始时所记录数值，未溢出时下回合自身以最优系别计算受到的攻击伤害与造成的攻击伤害|（boss无效）"@zh ;
    seer:effectAlias "alias_2527_1_0" ;
    seer:intensified false ;
    seer:isAdv false ;
    seer:pveEffective false ;
