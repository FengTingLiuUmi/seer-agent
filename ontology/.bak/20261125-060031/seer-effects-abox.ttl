seer:soulmark_1708 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4494 ;
    seer:desc "回合开始时若对手的最大体力值高于自身，则当回合自身造成的攻击伤害提升50%，受到的攻击伤害减少25%；|回合开始时若对手的速度值高于自身，则令对手防御、速度等级-1；|自身被击败时，己方每阵亡一只精灵附加给对手500点固定伤害，造成致死伤害时消除对手回合类效果|（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时：\r
<indent=32><sprite=4><indent=48>若对手的最大体力值高于自身，则当回合自身造成的<b>攻击伤害</b><color=#64F9FA>提升</color>50%，受到的<b>攻击伤害</b><color=#64F9FA>减少</color>25%\r
<indent=32><sprite=4><indent=48>若对手的速度值高于自身，则令对手防御、速度等级-1\r
\r
<indent=0><sprite=0><indent=16>被击败效果：\r
<indent=16><sprite=3><indent=32>自身被击败时己方当前每阵亡一只精灵<color=#64F9FA>附加</color>给对手500点<b>固定伤害</b>\r
<indent=32><sprite=4><indent=48>造成致死伤害时额外<color=#64F9FA>消除</color>对手<b>回合类效果</b>"""@zh ;
    seer:effectAlias "alias_2094_50_25_1_500_1_1" ;
    seer:intensified false ;
    seer:isAdv false ;
    seer:pveEffective false ;
    seer:seerapiId "1708" ;
    seer:soulmarkEffect "{\"effect\": {\"id\": 2094, \"url\": \"https://api.seerapi.com/v1/eid_effect/2094\"}, \"effect_args\": [50, 25, 1, 500, 1, 1]}" ;
