seer:soulmark_878 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_3580 ;
    seer:desc "回合开始时，若自身体力低于对手，则当回合受到攻击时消除对手回合类效果，若自身体力高于对手，则当回合自身属性技能消除对手回合类效果；战斗阶段结束时，若自身不处于能力提升状态则下回合自身攻击技能60%使对手进入诅咒，未触发则自身下2次技能先制+1，若自身处于能力提升状态则下回合对手使用属性技能则进入诅咒状态（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时：\r
<indent=32><sprite=4><indent=48>若自身体力低于对手，则当回合自身受到攻击时<color=#64F9FA>消除</color>对手<b>回合类效果</b>\r
<indent=32><sprite=4><indent=48>若自身体力高于对手，则当回合自身使用<b>属性技能</b><color=#64F9FA>消除</color>对手<b>回合类效果</b>\r
\r
<indent=0><sprite=0><indent=16>战阶结束效果：\r
<indent=16><sprite=3><indent=32>战斗阶段结束时：\r
<indent=32><sprite=4><indent=48>若自身不处于能力提升状态则下回合自身<b>攻击技能</b>60%<color=#64F9FA>令对手诅咒</color>\r
<indent=32><sprite=4><sprite=4><indent=64>未触发则自身下2次技能<b>先制</b>+1\r
<indent=32><sprite=4><indent=48>若自身处于能力提升状态则下回合对手使用<b>属性技能</b>100%<color=#64F9FA>受到</color>诅咒"""@zh ;
