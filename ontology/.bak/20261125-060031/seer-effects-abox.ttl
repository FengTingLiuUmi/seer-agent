seer:soulmark_1746 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4534 ;
    seer:desc "每次登场时100%令对手沉默，未触发则当回合战斗阶段结束时反转对手能力提升状态|回合开始时若对手处于沉默状态则当回合自身攻击技能必定打出致命一击，且免疫对手造成的致命一击伤害；|对手攻击技能打出致命一击后令对手麻痹|（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>登场效果：\r
<indent=16><sprite=3><indent=32>每次登场时100%<color=#64F9FA>令对手沉默</color>\r
<indent=32><sprite=4><indent=48>未触发则当回合战斗阶段结束时<color=#64F9FA>反转</color>对手<b>能力提升状态</b>\r
\r
<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时若对手处于沉默状态则当回合自身攻击技能必定<color=#64F9FA>打出致命一击</color>，且<color=#64F9FA>免疫</color>对手造成的<b>致命一击伤害</b>\r
\r
<indent=0><sprite=0><indent=16>触发效果：\r
<indent=16><sprite=3><indent=32>对手攻击技能打出致命一击后令对手麻痹"""@zh ;
