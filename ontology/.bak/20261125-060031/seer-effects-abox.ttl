seer:soulmark_1305 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4058 ;
    seer:desc "回合开始时若自身处于异常状态状态则触发孤梦噬魂：对手使用攻击则战斗阶段结束时10%的概率直接死亡（处于睡眠状态下概率翻倍），未触发则令对手全属性-1；|自身受到攻击时50%使对手造成的伤害减半且使对手下回合先制-1，未触发减伤则战斗阶段结束时恢复自身最大体力的1/3且下回合触发概率提升20%；|自身攻击命中时50%使自身造成的伤害翻倍且使自身下回合先制+1，未触发增伤则战斗阶段结束时对手减少最大体力的1/3且下回合触发概率提升20%（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时若自身处于异常状态状态则触发孤梦噬魂：\r
<indent=32><sprite=4><indent=48>对手使用攻击技能则战斗阶段结束时10%的概率死亡\r
