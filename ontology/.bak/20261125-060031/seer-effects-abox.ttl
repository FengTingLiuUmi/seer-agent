seer:soulmark_1245 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_3983 ;
    seer:desc "登场首回合为自身附加一个自身最大体力值1/3的护盾（每场战斗仅触发2次）；回合开始时，若自身处于异常状态则当回合受到的攻击伤害降低(40*双防值/体力值)%、固定伤害降低(40*体力值/双防值)%，若自身不处于异常状态则为自身附加一个自身最大体力值1/3的护罩，回合结束若护罩消失则恢复自身最大体力的1/3（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>限定效果（每场战斗限2次）：\r
