seer:soulmark_1981 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4784 ;
    seer:desc "自身受到攻击伤害后附加自身攻击值25%的百分比伤害并令对手流血|回合开始时，若对手的体力值低于最大体力的50%，则当回合对手无法通过技能恢复体力且自身所有攻击吸取对手自身攻击值25%的体力（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>触发效果：\r
<indent=16><sprite=3><indent=32>自身受到攻击伤害后<color=#64F9FA>附加</color>自身攻击值25%的<b>百分比伤害</b>并<color=#64F9FA>令对手流血</color>\r
\r
<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时，若对手的体力值低于最大体力的50%，则当回合对手<color=#64F9FA>无法通过技能恢复体力</color>且自身所有攻击<color=#64F9FA>吸取</color>对手自身攻击值25%的<b>体力</b>"""@zh ;
