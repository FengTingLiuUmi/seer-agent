seer:soulmark_1798 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4590 ;
    seer:desc "回合开始时自身根据双方体力上限值之差n触发如下效果：|①.当回合受到的攻击伤害减少n点；|②.恢复n点体力；|③.若n≥200则当回合攻击必定打出致命一击（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>回合开始效果：\r
