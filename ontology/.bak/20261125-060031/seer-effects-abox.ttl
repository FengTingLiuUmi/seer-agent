seer:soulmark_1887 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4684 ;
    seer:desc "自身免疫对手的火系攻击，每次免疫成功后，自身下次攻击时附加300点固定伤害，对手使用其他系别的攻击技能时，自身减少所有技能2点PP以消除对手的回合类效果|回合开始时，若对手处于能力下降状态则当回合对手属性技能无效，若对手不处于能力下降状态则当回合自身使用技能后100%令对手烧伤|（boss无效）"@zh ;
