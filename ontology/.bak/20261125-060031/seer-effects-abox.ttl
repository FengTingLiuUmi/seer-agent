seer:soulmark_1896 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4695 ;
    seer:desc "战斗开始时，自身增加400点体力上限，之后本场战斗限4次，自身每次受到高于300的攻击伤害时，双方受到300点固定伤害且自身减少100点体力上限|回合开始时，若自身最大体力高于对手则自身当回合受到的固定伤害、百分比伤害减少60%，若自身最大体力低于对手则自身当回合使用攻击技能时消耗自身全部体力并附加等量的固定伤害|（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>战斗开始效果：\r
<indent=16><sprite=3><indent=32>战斗开始时，自身增加400点临时体力上限\r
<indent=32><sprite=4><indent=48>之后本场战斗限4次，自身每次受到高于300的攻击伤害时，双方<color=#64F9FA>受到</color>300点<b>固定伤害</b>且自身<color=#64F9FA>减少</color>100点<b>体力上限</b>\r
\r
<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时：\r
<indent=32><sprite=4><indent=48>若自身最大体力高于对手则自身当回合受到的<b>固定伤害、百分比伤害</b><color=#64F9FA>减少</color>60%\r
<indent=32><sprite=4><indent=48>若自身最大体力低于对手则自身当回合使用攻击技能时<color=#64F9FA>消耗</color>自身<b>全部体力</b>并<color=#64F9FA>附加</color>等量的<b>固定伤害</b>"""@zh ;
