seer:soulmark_1214 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_3950 ;
    seer:desc "战斗阶段结束时，当回合若自身未受到攻击伤害则降低对手所有技能PP值1点且恢复自身所有技能PP值1点；战斗阶段结束时，当回合若自身受到攻击伤害则恢复自身最大体力的1/3且下次攻击技能造成的伤害提升100%，若战斗阶段结束时自身体力低于对手则转变为{吸取}对手最大{体力}的1/3且下次攻击技能造成的伤害提升150%（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>战阶结束效果：\r
