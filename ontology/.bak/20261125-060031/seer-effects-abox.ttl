seer:soulmark_1256 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_3999 ;
    seer:desc "自身使用攻击技能时50%令对手麻痹，未触发麻痹则消除对手回合类效果且50%令对手害怕；自身受到攻击伤害时，若伤害低于自身最大体力的1/2则战斗阶段结束时恢复自身最大体力的1/3并造成等量百分比伤害，若伤害高于自身最大体力的1/2则下回合100%触发孤雷风暴效果（boss无效）|孤雷风暴buff说明：自身使用攻击技能必定命中且先制+1、自身使用属性技能附加对手上次使用攻击技能所造成攻击伤害值50%的固定伤害"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>攻击技能额外效果：\r
<indent=16><sprite=3><indent=32>自身使用攻击技能则50%<color=#64F9FA>令对手麻痹</color>\r
<indent=32><sprite=4><indent=48>未触发麻痹则<color=#64F9FA>消除</color>对手<b>回合类效果</b>且50%<color=#64F9FA>令对手害怕</color>\r
\r
<indent=0><sprite=0><indent=16>触发效果：\r
<indent=16><sprite=3><indent=32>自身受到攻击伤害时：\r
<indent=32><sprite=4><indent=48>若伤害低于自身体力最大的1/2则战斗阶段结束时<color=#64F9FA>恢复</color>自身最大体力的1/3并<color=#64F9FA>附加</color>等量<b>百分比伤害</b>\r
<indent=32><sprite=4><indent=48>若伤害高于自身体力最大的1/2则下回合100%触发<color=#FFF779>孤雷风暴</color>\r
\r
<indent=0><sprite=5><indent=15>孤雷风暴：\r
<indent=16><sprite=6><indent=32>自身<b>攻击技能</b><color=#64F9FA>必定命中</color>且<b>先制</b>+1\r
<indent=16><sprite=6><indent=32>自身<b>属性技能</b><color=#64F9FA>附加</color>对手上次造成攻击伤害值50%的<b>固定伤害</b>"""@zh ;
