seer:soulmark_1016 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_3741 ;
    seer:desc "回合开始时若自身处于异常状态，则当回合自身死亡时残留1点体力并立即解除自身异常状态（boss无效）；|回合开始时，若自身体力高于对手则当回合自身造成的攻击伤害提升50%且使用技能时随机附加对手已损失体力20%-40%的百分比伤害，若自身体力低于对手则当回合自身受到的攻击伤害减少50%且战斗阶段结束时随机恢复自身200-400点体力（boss有效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时若自身处于异常状态，则当回合受到致死攻击时<color=#64F9FA>保留</color>1点<b>体力</b>并<color=#64F9FA>解除</color>自身所处的<b>异常状态</b>\r
\r
<indent=0><sprite=0><indent=16>回合开始效果（boss有效）：\r
<indent=16><sprite=3><indent=32>回合开始时：\r
<indent=32><sprite=4><indent=48>若自身体力高于对手则当回合自身造成的<b>攻击伤害</b><color=#64F9FA>提升</color>50%且随机<color=#64F9FA>附加</color>对手已损失体力20%-40%的<b>百分比伤害</b>\r
<indent=32><sprite=4><indent=48>若自身体力低于对手则当回合自身受到的<b>攻击伤害</b><color=#64F9FA>减少</color>50%且战斗阶段结束时随机<color=#64F9FA>恢复</color>自身200-400点<b>体力</b>"""@zh ;
