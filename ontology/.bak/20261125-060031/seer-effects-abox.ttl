seer:battle_effect_12 a seer:BattleEffect,
        owl:NamedIndividual ;
    rdfs:label "山神守护"@zh ;
    seer:desc "附属类异常状态，该状态下每回合对手受到的攻击伤害减少80%"@zh ;
    seer:name "山神守护"@zh ;
    seer:resistance seer:resistance_category_2 ;
    seer:seerapiId "12" ;
    seer:sourceUrl "https://api.seerapi.com/v1/battle_effect/12" .

seer:battle_effect_3 a seer:BattleEffect,
        owl:NamedIndividual ;
    rdfs:label "寄生对手"@zh ;
    seer:desc "弱化类异常状态，该状态下精灵每回合对手行动开始时扣除最大体力的1/8，同时对手会恢复等量的体力"@zh ;
    seer:name "寄生对手"@zh ;
    seer:resistance seer:resistance_category_2 ;
    seer:seerapiId "3" ;
    seer:sourceUrl "https://api.seerapi.com/v1/battle_effect/3" .

