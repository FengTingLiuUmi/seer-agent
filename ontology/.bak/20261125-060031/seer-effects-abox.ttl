seer:soulmark_1751 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4541 ;
    seer:desc "登场时获得300点护罩，回合开始时若此护罩存在则当回合自身免疫异常状态且对手攻击后速度-2，若对手不处于回合类效果则额外进入束缚，若对手处于回合类效果则自身全属性+1；|当回合未击败对手时若对手处于能力下降则令对手害怕，击败对手时重新触发自身登场时效果并抵挡下次受到的攻击|（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>登场效果：\r
<indent=16><sprite=3><indent=32>登场时<color=#64F9FA>获得</color>300点<b>护罩</b>\r
\r
<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时若上述护罩存在则当回合自身<color=#64F9FA>免疫<b></color>异常状态</b>且对手攻击后速度-2，然后：\r
<indent=32><sprite=4><indent=48>若对手不处于回合类效果则额外<color=#64F9FA>令对手束缚</color>\r
<indent=32><sprite=4><indent=48>若对手处于回合类效果则额外令自身<color=#64F9FA>全属性+1</color>\r
\r
<indent=0><sprite=0><indent=16>常驻效果：\r
<indent=16><sprite=3><indent=32>当回合未击败对手时若对手处于能力下降则<color=#64F9FA>令对手害怕</color>\r
<indent=16><sprite=3><indent=32>当回合击败对手时重新触发自身登场时效果并<color=#64F9FA>抵挡</color>下次受到的<b>攻击</b>"""@zh ;
