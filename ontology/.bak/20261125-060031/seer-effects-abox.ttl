seer:soulmark_1710 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:advanceOf seer:pet_advance_2 ;
    seer:affectsPet seer:pet_3670 ;
    seer:analyzeDesc "[sprite name=dot4]自身[color=#57c975]未被击败时[/color]，若[color=#52a5f2]对手[/color]任意一项能力等级高于回合开始则自身获得1回合[color=#f35555]圣辉之羽[/color]，否则获得1回合[color=#f35555]圣雷华冠[/color]|[sprite name=dot4][color=#57c975]回合开始时[/color]，若自身不处于[color=#52a5f2]能力提升状态[/color]则自身[color=#52a5f2]全属性[/color]+1且[color=#52a5f2]当回合[/color]攻击后附加自身最大体力1/3的[color=#52a5f2]百分比伤害[/color]，若自身处于[color=#52a5f2]能力提升状态[/color]则令[color=#52a5f2]对手[/color][color=#52a5f2]全属性[/color]-1且[color=#52a5f2]当回合[/color]自身攻击必定打出[color=#52a5f2]致命一击[/color]"@zh ;
    seer:derivedFrom seer:soulmark_956 ;
    seer:desc "自身未被击败时，若对手任意一项能力等级高于回合开始则自身获得1回合圣辉之羽，否则获得1回合圣雷华冠|回合开始时，若自身不处于能力提升状态则自身全属性+1且当回合攻击后附加自身最大体力1/3的百分比伤害，若自身处于能力提升状态则令对手全属性-1且当回合自身攻击必定打出致命一击|（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>常驻效果：\r
<indent=16><sprite=3><indent=32>未被击败时，若对手任意一项能力等级高于回合开始时则召唤持续1回合的<color=#FFF779>圣辉之羽</color>庇护自身\r
<indent=16><sprite=3><indent=32>未被击败时，若对手所有能力等级均未高于回合开始则召唤持续1回合的<color=#FFF779>圣雷华冠</color>强化自身\r
\r
<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时若自身不处于能力提升状态则：\r
<indent=32><sprite=4><indent=48>100%令自身<color=#64F9FA>全属性+1</color>\r
<indent=32><sprite=4><indent=48>当回合使用攻击技能后<color=#64F9FA>附加</color>自身最大体力1/3的<b>百分比伤害</b>\r
<indent=16><sprite=3><indent=32>回合开始时若自身处于能力提升状态：\r
<indent=32><sprite=4><indent=48>100%令对手<color=#64F9FA>全属性-1</color>\r
<indent=32><sprite=4><indent=48>当回合自身攻击技能必定<color=#64F9FA>打出致命一击</color>\r
\r
<indent=0><sprite=5><indent=15>圣辉之羽：\r
<indent=16><sprite=6><indent=32>圣耀之光·黄金天马持有时：\r
<indent=32><sprite=4><indent=48><color=#64F9FA>免疫</color>受到的<b>异常状态</b>和<b>能力下降状态</b>\r
<indent=32><sprite=4><indent=48>将受到的<b>攻击伤害</b><color=#64F9FA>转化</color>为体力恢复\r
\r
<indent=0><sprite=5><indent=15>圣雷华冠：\r
<indent=16><sprite=6><indent=32>圣耀之光·黄金天马持有时：\r
<indent=32><sprite=4><indent=48>攻击技能<b>先制</b>+1\r
<indent=32><sprite=4><indent=48>攻击技能命中前若对手处于异常状态则造成的<b>攻击伤害</b><color=#64F9FA>提升</color>50%"""@zh ;
