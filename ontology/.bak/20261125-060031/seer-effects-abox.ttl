seer:soulmark_1757 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4547 ;
    seer:desc "自身攻击技能命中时吸取对手4项能力1级，自身属性技能命中时吸取对手第五技能2点PP值；|战斗阶段结束时，若本回合自身未受到攻击伤害则下回合所有技能先制+1，若自身受到了攻击伤害则下回合使用技能后附加300点固定伤害（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>攻击技能额外效果：\r
<indent=16><sprite=3><indent=32>攻击技能命中对手时，<color=#64F9FA>吸取</color>对手4项能力各1级\r
\r
<indent=0><sprite=0><indent=16>属性技能额外效果：\r
<indent=16><sprite=3><indent=32>属性技能命中对手时，<color=#64F9FA>吸取</color>对手<b>第五技能</b>2点<b>PP值</b>\r
\r
<indent=0><sprite=0><indent=16>战阶结束效果：\r
<indent=16><sprite=6><indent=32>战斗阶段结束时：\r
<indent=32><sprite=4><indent=48>若本回合自身未受到<b>攻击伤害</b>，下回合所有技能的<b>先制</b>+1\r
<indent=32><sprite=4><indent=48>若本回合自身受到了<b>攻击伤害</b>，下回合使用技能后<color=#64F9FA>附加</color>300点<b>固定伤害</b>"""@zh ;
