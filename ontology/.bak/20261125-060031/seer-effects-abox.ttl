seer:soulmark_2062 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4875 ;
    seer:analyzeDesc "[sprite name=dot4][color=#57c975]战斗阶段结束时[/color]，若对手处于[color=#57c975]烧伤[/color]状态则获得3回合的[color=#f35555]神惧劫炎[/color]，自身已处于[color=#f35555]神惧劫炎[/color]时改为令其回合数+1，若对手不处于[color=#57c975]烧伤[/color]状态则恢复自身最大体力的1/3并附加恢复量的[color=#52a5f2]百分比伤害[/color]，[color=#52a5f2]然后[/color]若此伤害未减少对手体力则自身额外获得最大体力1/3的[color=#57c975]护盾[/color]|[sprite name=dot4]对手使用攻击技能时令对手[color=#57c975]烧伤[/color]，[color=#52a5f2]未触发[/color]则消除对手[color=#52a5f2]回合类效果[/color]，[color=#52a5f2]然后[/color]若自身不处于[color=#57c975]烧伤[/color]则自身下1次进入的异常状态[color=#52a5f2]转化[/color]为2回合的[color=#57c975]烧伤[/color]|[sprite name=dot4]自身存活于出战背包时，对手免疫能力下降状态时视为处于[color=#57c975]烧伤[/color]状态"@zh ;
    seer:desc "战斗阶段结束时，若对手处于烧伤状态则获得3回合的神惧劫炎，自身已处于神惧劫炎时改为令其回合数+1，若对手不处于烧伤状态则恢复自身最大体力的1/3并附加恢复量的百分比伤害，然后若此伤害未减少对手体力则自身额外获得最大体力1/3的护盾|对手使用攻击技能时令对手烧伤，未触发则消除对手回合类效果，然后若自身不处于烧伤则自身下1次进入的异常状态转化为2回合的烧伤|自身存活于出战背包时，对手免疫能力下降状态时视为处于烧伤状态|（boss无效）"@zh ;
