seer:soulmark_1734 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4522 ;
    seer:desc "战斗阶段结束时若对手处于冻伤状态则将其剩余回合数延长2回合（最多9回合）；|自身攻击技能命中时对手当前每处于1回合冻伤状态，则当回合自身造成的攻击伤害提升25%且附加100点固定伤害，最高可叠加9次|（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>战阶结束效果：\r
