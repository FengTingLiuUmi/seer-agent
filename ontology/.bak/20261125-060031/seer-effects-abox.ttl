seer:soulmark_1229 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_3964 ;
    seer:desc "首次登场当回合使用技能削减对手本场战斗中100点体力上限，之后每次登场当回合使用技能削减对手本场战斗中80点体力上限；回合开始时，若自身体力高于对手则当回合受到攻击100%令对手害怕，若自身体力低于对手则当回合所有技能先制+1且当回合触发削减对手体力上限的效果提升25%（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>登场效果：\r
<indent=16><sprite=3><indent=32>首次登场当回合使用技能<color=#64F9FA>减少</color>对手100点<b>体力上限</b>\r
<indent=32><sprite=4><indent=48>之后每次登场效果改为80点\r
\r
<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时：\r
<indent=32><sprite=4><indent=48>若自身体力高于对手则当回合对手攻击命中后100%<color=#64F9FA>令对手害怕</color>\r
<indent=32><sprite=4><indent=48>若自身体力低于对手则当回合：\r
<indent=32><sprite=4><sprite=4><indent=64>所有技能<b>先制</b>+1\r
<indent=32><sprite=4><sprite=4><indent=64>自身触发的减少对手体力上限的效果提升25%\r
\r
<indent=0><sprite=5><indent=15>八荒之力：\r
<indent=16><sprite=6><indent=32>自身的攻击技能：\r
<indent=32><sprite=4><indent=48><b>先制</b>+1\r
<indent=32><sprite=4><indent=48>造成的攻击伤害<color=#64F9FA>提升</color>50%\r
<indent=32><sprite=4><indent=48>命中后<color=#64F9FA>减少</color>对手20点<b>体力上限</b>"""@zh ;
