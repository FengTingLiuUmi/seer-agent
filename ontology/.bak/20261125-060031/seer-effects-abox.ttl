seer:soulmark_1133 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_3860 ;
    seer:desc "回合开始时，若自身体力高于对手则当回合造成的攻击伤害随机提升40%-60%，若自身体力低于对手则当回合受到的攻击伤害随机减少40%-60%；战斗阶段结束时恢复自身最大体力的10%并造成等量固伤，每回合增加10%，最高30%（boss有效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>回合开始效果：\r
