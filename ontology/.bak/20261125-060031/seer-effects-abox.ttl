seer:soulmark_1589 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_3950 ;
    seer:derivedFrom seer:soulmark_1214 ;
    seer:desc "战斗阶段结束时，当回合若自身未受到攻击伤害则降低对手所有技能PP值2点且恢复自身所有技能PP值2点；战斗阶段结束时，当回合若自身受到攻击伤害则恢复自身最大体力的1/3且下次攻击技能造成的伤害提升100%，若战斗阶段结束时自身体力低于对手则转变为{吸取}对手最大{体力}的1/3且下次使用技能先制+1且造成的伤害提升150%（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>战阶结束效果：\r
<indent=16><sprite=3><indent=32>战斗阶段结束时：\r
<indent=32><sprite=4><indent=48>当回合自身未受到攻击则<color=#64F9FA>降低</color>对手所有<b>PP值</b>2点且<color=#64F9FA>恢复</color>自身所有<b>PP值</b>2点\r
<indent=32><sprite=4><indent=48>当回合自身受到攻击则<color=#64F9FA>恢复</color>自身最大体力的1/3且下次攻击技能造成的<b>攻击伤害</b><color=#64F9FA>提升</color>100%\r
<indent=32><sprite=4><sprite=4><indent=64>若当前体力低于对手则效果转变为<color=#64F9FA>吸取</color>对手最大体力的1/3且下次技能<b>先制</b>+1、造成的<b>攻击伤害</b><color=#64F9FA>提升</color>150%"""@zh ;
