    seer:affectsPet seer:pet_4732 ;
    seer:analyzeDesc "[sprite name=dot1]pve对战中自身拥有神话|[sprite name=dot1][color=#52a5f2]己方[/color]每有一只其他存活精灵受到的攻击[color=#57c975]伤害额外减少[/color]5%，造成的攻击[color=#52a5f2]伤害额外提升[/color]5%，造成伤害的5%恢复至自身体力，若存活的精灵为皮皮、比波、波克尔则上述效果中的百分比分别提升为10%、11%、12%|[sprite name=dot4]战斗开始时，[color=#52a5f2]己方[/color]获得7片[color=#f35555]神羽[/color]，[color=#52a5f2]之后[/color][color=#52a5f2]己方[/color]其他精灵的[color=#57c975]回合结束后[/color]，若其体力低于最大体力的1/2且低于自身，则消耗一片[color=#f35555]神羽[/color][color=#52a5f2]以[/color]令其体力值增加至与自身相等"@zh ;
    seer:desc "pve对战中自身拥有神话（boss有效）|己方每有一只其他存活精灵受到的攻击伤害额外减少5%，造成的攻击伤害额外提升5%，造成伤害的5%恢复至自身体力，若存活的精灵为皮皮、比波、波克尔则上述效果中的百分比分别提升为10%、11%、12%（boss有效）|战斗开始时，己方获得7片神羽，之后己方其他精灵的回合结束后，若其体力低于最大体力的1/2且低于自身，则消耗一片神羽以令其体力值增加至与自身相等|（标注部分boss有效，其余无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>常驻效果（boss有效）：\r
<indent=16><sprite=3><indent=32>Boss对战中自身拥有神话\r
<indent=16><sprite=3><indent=32>己方每有一只其他存活精灵受到的<b>攻击伤害</b><color=#64F9FA>额外减少</color>5%，造成的<b>攻击伤害</b><color=#64F9FA>额外提升</color>5%，造成的攻击伤害5%额外<color=#64F9FA>恢复</color>至自身体力\r
<indent=32><sprite=4><indent=48>若存活的精灵为皮皮、比波、波克尔则上述所有效果中的百分比分别提升为10%、11%、12%\r
\r
<indent=0><sprite=0><indent=16>战斗开始效果：\r
<indent=16><sprite=3><indent=32>战斗开始时：\r
<indent=32><sprite=4><indent=48>自身获得7片神羽\r
<indent=32><sprite=4><indent=48>之后己方其他精灵的回合结束后，若其体力值低于最大体力的1/2且低于自身则消耗一片神羽以令其体力值增加至与自身相等\r
\r
<indent=0><sprite=5><indent=16>神羽（上限7片，下场保留）\r
<indent=16><sprite=6><indent=32>每拥有1片神羽回合结束时恢复50点体力\r
<indent=16><sprite=6><indent=32>失去所有神羽之后，每次使用攻击技能后令对手睡眠"""@zh ;
    seer:effectAlias "alias_2346_5_5_5_7" ;
    seer:intensified false ;
    seer:isAdv false ;
    seer:pveEffective true ;
    seer:seerapiId "1930" ;
    seer:soulmarkEffect "{\"effect\": {\"id\": 2346, \"url\": \"https://api.seerapi.com/v1/eid_effect/2346\"}, \"effect_args\": [5, 5, 5, 7]}" ;
    seer:soulmarkTag seer:soulmark_tag_1,
        seer:soulmark_tag_4,
        seer:soulmark_tag_6 ;
    seer:sourceUrl "https://api.seerapi.com/v1/soulmark/1930" .

seer:soulmark_1938 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4736 ;
    seer:desc "自身使用攻击技能后60%令对手麻痹，未触发则此效果改为回合开始时触发，触发成功则重置此效果且自身下次攻击必定打出致命一击；战斗阶段结束时，若对手的体力值高于自身则下回合所有技能先制+1，若对手的体力值低于自身则消除对手回合类效果（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>触发效果：\r
<indent=16><sprite=3><indent=32>自身使用攻击技能后60%<color=#64F9FA>令对手麻痹</color>\r
<indent=32><sprite=4><indent=48>未触发则此效果改为回合开始时触发\r
<indent=32><sprite=4><indent=48>触发成功则重置此效果且自身下次攻击必定<color=#64F9FA>打出致命一击</color>\r
\r
<indent=0><sprite=0><indent=16>战阶结束效果：\r
<indent=16><sprite=3><indent=32>战斗阶段结束时：\r
<indent=32><sprite=4><indent=48>若对手的体力值高于自身则下回合所有技能<b>先制</b>+1\r
<indent=32><sprite=4><indent=48>若对手的体力值低于自身则<color=#64F9FA>消除</color>对手<b>回合类效果</b>"""@zh ;
    seer:effectAlias "alias_2352_60_1_1" ;
