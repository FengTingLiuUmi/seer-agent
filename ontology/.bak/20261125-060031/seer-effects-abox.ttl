seer:soulmark_1756 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:advanceOf seer:pet_advance_12 ;
    seer:affectsPet seer:pet_3724 ;
    seer:analyzeDesc "[sprite name=dot4][color=#52a5f2]首次[/color]出战[color=#57c975]登场时[/color][color=#52a5f2]对方[/color]出战背包中每有1只系别中带龙系的精灵获得10层[color=#f35555]黯龙余恨[/color]，若其中存在龙神哈莫则获得层数翻倍|[sprite name=dot4][color=#57c975]回合开始时[/color]，使自身的[color=#f35555]堕龙残怨[/color]等于本场战斗的回合数|[sprite name=dot4][color=#57c975]战斗阶段结束时[/color],若[color=#52a5f2]对手[/color]体力高于自身则恢复自身最大体力的1/3并附加等量[color=#52a5f2]百分比伤害[/color]，恢复量与伤害量最高为自身[color=#52a5f2]已损失体力[/color]，[color=#f35555]黯龙余恨[/color]和[color=#f35555]堕龙残怨[/color]总层数＞30时取消触发条件，若[color=#52a5f2]对手[/color]体力低于自身则下回合自身所有[color=#52a5f2]技能先制[/color]+1，[color=#f35555]黯龙余恨[/color]和[color=#f35555]堕龙残怨[/color]总层数＞30时效果提升至+2"@zh ;
    seer:derivedFrom seer:soulmark_999 ;
    seer:desc "首次出战登场时对方出战背包中每有1只系别中带龙系的精灵获得10层黯龙余恨，若其中存在龙神哈莫则获得层数翻倍|回合开始时，使自身的堕龙残怨等于本场战斗的回合数|战斗阶段结束时,若对手体力高于自身则恢复自身最大体力的1/3并附加等量百分比伤害，恢复量与伤害量最高为自身已损失体力，黯龙余恨和堕龙残怨总层数＞30时取消触发条件，若对手体力低于自身则下回合自身所有技能先制+1，黯龙余恨和堕龙残怨总层数＞30时效果提升至+2|（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>登场效果：\r
<indent=16><sprite=3><indent=32>首次登场时，对方出战背包中每有1只系别中带龙系的精灵获得10层<color=#FFF779>黯龙余恨</color>\r
<indent=32><sprite=4><indent=48>若其中存在龙神哈莫则获得层数翻倍\r
\r
<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>每回合开始时会根据本场战斗当前总回合数刷新并获得相应层数的<color=#FFF779>堕龙残怨</color>\r
\r
<indent=0><sprite=0><indent=16>战阶结束效果：\r
<indent=16><sprite=3><indent=32>战斗阶段结束时：\r
<indent=32><sprite=4><indent=48>若对手体力高于自身则<color=#64F9FA>恢复</color>自身最大体力的1/3并<color=#64F9FA>附加</color>等量<b>百分比伤害</b>\r
<indent=32><sprite=4><sprite=4><indent=64>当前黯龙余恨和堕龙残怨总层数＞30时取消触发条件\r
<indent=32><sprite=4><indent=48>若对手体力低于自身则下回合自身所有技能<b>先制</b>+1\r
<indent=32><sprite=4><sprite=4><indent=64>当前黯龙余恨和堕龙残怨总层数＞30时效果提升至+2\r
\r
<indent=0><sprite=5><indent=15>黯龙余恨\r
<indent=16><sprite=6><indent=32>每有1层，自身造成的<b>攻击伤害</b><color=#64F9FA>提升</color>2%\r
<indent=16><sprite=6><indent=32>上限为50-堕龙残怨的层数，下场保留\r
\r
<indent=0><sprite=5><indent=15>堕龙残怨\r
<indent=16><sprite=6><indent=32>每有1层，自身使用攻击技能时<color=#64F9FA>附加</color>20点<b>固定伤害</b>\r
<indent=16><sprite=6><indent=32>上限为50-黯龙余恨的层数，下场保留"""@zh ;
