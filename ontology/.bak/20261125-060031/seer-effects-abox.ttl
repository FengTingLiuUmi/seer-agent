seer:soulmark_1829 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4622 ;
    seer:analyzeDesc "[sprite name=dot4][color=#57c975]回合开始时[/color]100%令[color=#52a5f2]对手[/color][color=#57c975]烧伤[/color]|[sprite name=dot4][color=#52a5f2]对手[/color]处于[color=#57c975]烧伤[/color]状态时无法恢复体力且每[color=#57c975]回合结束后[/color]自身每有1层[color=#f35555]战意[/color]附加10点[color=#52a5f2]真实伤害[/color]|[sprite name=dot4][color=#57c975]回合结束后[/color]，自身获得2层[color=#f35555]战意[/color]，[color=#52a5f2]己方[/color]场下每有1只系别中带有火系的精灵获得层数+1，[color=#f35555]战意[/color][color=#52a5f2]达到[/color]10层时额外获得[color=#f35555]命运庇护[/color]效果"@zh ;
    seer:desc "回合开始时100%令对手烧伤|对手处于烧伤状态时无法恢复体力且每回合结束后自身每有1层战意附加10点真实伤害|回合结束后，自身获得2层战意，己方场下每有1只系别中带有火系的精灵获得层数+1，战意达到10层时额外获得命运庇护效果|（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>常驻效果：\r
<indent=16><sprite=3><indent=32>对手处于烧伤状态时<color=#64F9FA>无法恢复体力</color>\r
\r
<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时100%<color=#64F9FA>令对手烧伤</color>\r
\r
<indent=0><sprite=0><indent=16>回合结束效果：\r
<indent=16><sprite=3><indent=32>回合结束后：\r
<indent=32><sprite=4><indent=48>若对手处于烧伤则<color=#64F9FA>受到</color>战意层数*10的<b>真实伤害</b>\r
<indent=32><sprite=4><indent=48>获得2层<color=#FFF779>战意</color>\r
<indent=32><sprite=4><indent=48>己方场下每有1只火属性衍生系精灵层数+1，战意达到10层时额外获得<color=#FFF779>命运庇护</color>效果\r
\r
<indent=0><sprite=5><indent=15>战意（限20层，下场保留）：\r
<indent=16><sprite=6><indent=32>每持有一层则：\r
<indent=32><sprite=4><indent=48>受到的<b>固定伤害</b>、<b>百分比伤害<color=#64F9FA></b>减少</color>4%\r
<indent=32><sprite=4><indent=48>造成的<b>攻击伤害<color=#64F9FA></b>提升</color>5%；\r
\r
<indent=0><sprite=5><indent=15>命运庇护（下场保留）：\r
<indent=16><sprite=6><indent=32>所有<b>异常抗性<color=#64F9FA></b>必定触发</color>\r
<indent=16><sprite=6><indent=32>失去<b>全免抗性</b>"""@zh ;
    seer:effectAlias "alias_2217_1_0" ;
    seer:intensified false ;
    seer:isAdv false ;
    seer:pveEffective false ;
    seer:seerapiId "1829" ;
    seer:soulmarkEffect "{\"effect\": {\"id\": 2217, \"url\": \"https://api.seerapi.com/v1/eid_effect/2217\"}, \"effect_args\": [1, 0]}" ;
