seer:soulmark_2055 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4361 ;
    seer:analyzeDesc "[sprite name=dot4]自身存活于场下时，对方在场精灵每次攻击结束后，洛基获得1层[color=#f35555]堕恶神祇[/color][color=#52a5f2]以[/color]触发[color=#f35555]神诗叙诡[/color]|[sprite name=dot4]自身[color=#57c975]登场时[/color]，若[color=#f35555]堕恶神祇[/color][color=#52a5f2]达到[/color]3层，则2回合内[color=#57c975]战斗阶段结束时[/color]，若自身通过[color=#f35555]堕恶神祇[/color]获得的[color=#57c975]护盾[/color]或[color=#57c975]护罩[/color]消失则使[color=#52a5f2]己方[/color]下1回合[color=#52a5f2]免疫对手的攻击[/color]，免疫成功时重置[color=#52a5f2]对方[/color]的[color=#f35555]虚饰弧光[/color]，自身不在场时额外重置自身的[color=#f35555]堕恶神祇[/color]层数"@zh ;
    seer:derivedFrom seer:soulmark_1586 ;
    seer:desc "自身存活于场下时，对方在场精灵每次攻击结束后，洛基获得1层堕恶神祇以触发神诗叙诡|自身登场时，若堕恶神祇达到3层，则2回合内战斗阶段结束时，若自身通过堕恶神祇获得的护盾或护罩消失则使己方下1回合免疫对手的攻击，免疫成功时重置对方的虚饰弧光，自身不在场时额外重置自身的堕恶神祇层数|（boss无效）"@zh ;
    seer:effectAlias "alias_2476_1_0" ;
    seer:intensified false ;
    seer:isAdv false ;
