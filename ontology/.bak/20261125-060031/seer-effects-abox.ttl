seer:soulmark_2085 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4444 ;
    seer:analyzeDesc "[sprite name=dot4]自身[color=#52a5f2]登场时[/color]，若对手处于异常状态则将对手所处的有效果的附属类异常状态[color=#52a5f2]转化[/color]为4回合[color=#57c975]诅咒[/color]，若对手不处于异常状态则自身第五技能每有1点PP自身获得1种[color=#f35555]鬼祰[/color]、对手第五技能每有1点PP值自身失去1种[color=#f35555]鬼祰[/color]，[color=#52a5f2]然后[/color]若对手处于[color=#57c975]诅咒[/color]状态，本次在场自身无视对手伤害减少效果且其无法触发[color=#57c975]被击败[/color]效果|[sprite name=dot4]对手使用攻击技能后，若本次攻击造成的技能伤害低于300则自身获得[color=#f35555]鬼祰·魑[/color]，高于200则自身获得[color=#f35555]鬼祰·魅[/color]；自身使用攻击技能后，若本次攻击造成的技能伤害低于300则自身获得[color=#f35555]鬼祰·魍[/color]，高于200则自身获得[color=#f35555]鬼祰·魉[/color]"@zh ;
    seer:desc "自身登场时，若对手处于异常状态则将对手所处的有效果的附属类异常状态转化为4回合诅咒，若对手不处于异常状态则自身第五技能每有1点PP自身获得1种鬼祰、对手第五技能每有1点PP值自身失去1种鬼祰，然后若对手处于诅咒状态，本次在场自身无视对手伤害减少效果且其无法触发被击败效果|对手使用攻击技能后，若本次攻击造成的技能伤害低于300则自身获得鬼祰·魑，高于200则自身获得鬼祰·魅；自身使用攻击技能后，若本次攻击造成的技能伤害低于300则自身获得鬼祰·魍，高于200则自身获得鬼祰·魉|（boss无效）"@zh ;
    seer:effectAlias "alias_2507_1_0" ;
    seer:intensified false ;
    seer:isAdv false ;
    seer:pveEffective true ;
    seer:seerapiId "2085" ;
