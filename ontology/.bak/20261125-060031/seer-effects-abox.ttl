seer:soulmark_1716 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4502 ;
    seer:desc "每次登场首回合自身使用技能无视对手能力提升状态且对手的先制等级最高为3；回合结束后若自身死亡，则反转对手能力提升状态（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>登场效果：\r
<indent=16><sprite=3><indent=32>每次登场首回合自身使用技能<color=#64F9FA>无视</color>对手<b>能力提升状态</b>且对手的<b>先制</b>等级最高为3\r
\r
<indent=0><sprite=0><indent=16>被击败效果：\r
<indent=16><sprite=3><indent=32>自身被击败时<color=#64F9FA>反转</color>对手<b>能力提升状态</b>"""@zh ;
