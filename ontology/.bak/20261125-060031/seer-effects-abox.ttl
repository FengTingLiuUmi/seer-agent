seer:soulmark_1780 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4572 ;
    seer:desc "自身使用攻击技能后抵挡下1次对手的攻击，使用属性技能后60%令对手害怕|回合开始时，对手每处于异常状态、能力下降状态、能力提升状态中的一种，当回合造成的攻击伤害提升50%（伤害提升效果boss有效，其余效果无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>攻击技能效果：\r
<indent=16><sprite=3><indent=32>使用<b>攻击技能</b>后，<color=#64F9FA>抵挡</color>下一次对手的攻击\r
\r
<indent=0><sprite=0><indent=16>属性技能效果：\r
<indent=16><sprite=3><indent=32>使用<b>属性技能</b>后，有60%的概率<color=#64F9FA>令对手害怕</color>\r
\r
<indent=0><sprite=0><indent=16>回合开始效果（boss有效）：\r
<indent=16><sprite=3><indent=32>回合开始时，对手每处于<b>异常状态、能力下降状态或能力提升状态</b>中的一种，当回合造成的<b>攻击伤害</b><color=#64F9FA>提升</color>50%"""@zh ;
