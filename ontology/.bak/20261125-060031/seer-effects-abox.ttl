seer:soulmark_1521 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4298 ;
    seer:desc "回合开始时若自身体力高于对手则自身攻击技能命中后100%令对手随机进入1种异常状态，若自身体力低于对手则当回合自身受到的攻击伤害降低30%；|战斗阶段结束时若自身体力低于最大体力的1/2则恢复200点体力（boss无效）"@zh ;
