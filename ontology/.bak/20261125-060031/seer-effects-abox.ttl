seer:soulmark_1914 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4712 ;
    seer:analyzeDesc "[sprite name=dot4]自身[color=#57c975]登场时[/color]触发[color=#f35555]虐龙古咒[/color]|[sprite name=dot4][color=#57c975]回合开始时[/color]，若自身体力未高于上回合开始，则本回合[color=#57c975]免疫[/color]受到的[color=#52a5f2]异常状态[/color]且[color=#57c975]回合结束后[/color]恢复最大体力的1/3|[sprite name=dot4]战斗开始时自身与龙焉缔结[color=#f35555]冥龙之契[/color]"@zh ;
    seer:desc "自身登场时触发虐龙古咒|回合开始时，若自身体力未高于上回合开始，则本回合免疫受到的异常状态且回合结束后恢复最大体力的1/3|战斗开始时自身与龙焉缔结冥龙之契|（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>登场效果：\r
<indent=16><sprite=3><indent=32>自身登场后触发虐龙古咒：\r
<indent=32><sprite=4><indent=48>奇数次选择的属性技能<color=#64F9FA>附加</color>250点<b>龙系伤害</b>且使用时<color=#64F9FA>消除</color>对手<b>回合类效果</b>\r
<indent=32><sprite=4><indent=48>偶数次选择的属性技能<color=#64F9FA>附加</color>250点<b>邪灵系伤害</b>且使用时<color=#64F9FA>消除</color>对手<b>能力提升状态</b>\r
\r
<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时，若自身体力未高于上回合开始，则本回合<color=#64F9FA>免疫</color>受到的<b>异常状态</b>且回合结束后<color=#64F9FA>恢复</color>1/3最大体力\r
\r
<indent=0><sprite=0><indent=16>战斗开始效果：\r
<indent=16><sprite=3><indent=32>战斗开始时自身与龙焉缔结冥龙之契：龙焉全<b>能力值</b><color=#64F9FA>提升</color>70点且攻击技能<color=#64F9FA>无视</color>对手的<b>护盾效果</b>"""@zh ;
