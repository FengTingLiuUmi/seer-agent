seer:soulmark_1340 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4105 ;
    seer:desc "回合开始时，若自身处于能力提升状态则当回合受到的伤害减少50%，若不处于能力提升状态则当回合自身攻击技能先制+1且附加对手当前体力值25%的固定伤害；|战斗阶段结束时反转自身能力下降状态，反转成功则下回合免疫并反弹异常状态，若自身不处于能力下降状态则下回合造成的伤害随机提升50%-100%（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时：\r
<indent=32><sprite=4><indent=48>若自身处于能力提升状态则当回合受到的<b>攻击伤害</b><color=#64F9FA>减少</color>50%\r
<indent=32><sprite=4><indent=48>若自身不处于能力提升状态则当回合自身攻击技能<b>先制</b>+1且<color=#64F9FA>附加</color>对手当前体力值25%的<b>百分比伤害</b>\r
\r
<indent=0><sprite=0><indent=16>战阶结束效果：\r
<indent=16><sprite=3><indent=32>战斗阶段结束时：\r
<indent=32><sprite=4><indent=48><color=#64F9FA>反转</color>自身能力下降状态\r
<indent=32><sprite=4><sprite=4><indent=64>反转成功则下回合<color=#64F9FA>免疫并反弹</color><b>异常状态</b>\r
<indent=32><sprite=4><indent=48>若自身不处于能力下降状态则下回合造成的<b>攻击伤害</b>随机<color=#64F9FA>提升</color>50%-100%"""@zh ;
