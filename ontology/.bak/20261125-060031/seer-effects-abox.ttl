seer:soulmark_1937 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_3668 ;
    seer:derivedFrom seer:soulmark_954 ;
    seer:desc "自身使用技能时，若自身处于能力提升状态则每有1种能力提升状态本次攻击造成的攻击伤害提高20%，若自身不处于能力提升状态则必定打出致命一击且战斗阶段结束时全属性+1|战斗阶段结束时吸取对手250点体力，若对手未受到固定伤害则对手下回合属性技能命中效果失效，自身体力低于对手时吸取效果提升100点，若对手未受到固定伤害则下回合先制+1|（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>触发效果：\r
<indent=16><sprite=3><indent=32>自身使用技能时：\r
<indent=32><sprite=4><indent=48>若自身处于能力提升状态则每有1种能力提升状态则造成的<b>攻击伤害</b><color=#64F9FA>提升</color>20%\r
<indent=16><sprite=3><indent=32>若自身不处于能力提升状态则必定<color=#64F9FA>打出致命一击</color>且战斗阶段结束时<color=#64F9FA>全属性+1</color>\r
\r
<indent=0><sprite=0><indent=16>战阶结束效果：\r
<indent=16><sprite=3><indent=32>战斗阶段结束时<color=#64F9FA>吸取</color>对手250点<b>体力</b>\r
<indent=32><sprite=4><indent=48>若对手未受到固定伤害则对手下回合<b>属性技能</b><color=#64F9FA>命中效果失效</color>\r
<indent=32><sprite=4><indent=48>自身体力低于对手时吸取效果提升100点\r
<indent=32><sprite=4><sprite=4><indent=64>若对手未受到固定伤害则下回合<b>先制</b>+1 \r
"""@zh ;
