seer:soulmark_1436 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_3932 ;
    seer:derivedFrom seer:soulmark_1197 ;
    seer:desc "每次登场后对手当前在场精灵2回合内属性技能失效且令己方月照星魂在本场战斗中造成的伤害提升10%（最高50%）；|回合开始时，若对手体力低于300则当回合自身攻击技能先制+2且100%打出致命一击，若对手体力高于300则当回合自身攻击命中后{吸取}对手350点{体力}（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>登场效果：\r
<indent=16><sprite=3><indent=32>登场后：\r
<indent=32><sprite=4><indent=48>对手当前在场精灵2回合内<b>属性技能</b><color=#64F9FA>无效</color>\r
