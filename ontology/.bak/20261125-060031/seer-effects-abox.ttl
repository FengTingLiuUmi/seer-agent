seer:soulmark_1747 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4535 ;
    seer:desc "每次登场时消除对手能力提升状态，消除成功则令对手害怕，未触发则令对手束缚，若当回合对方选择主动切换精灵则战斗阶段结束时额外为对手施加1道诡符；|回合开始时若自身不处于能力提升状态则当回合受到的攻击伤害减少50%，战斗阶段结束时若自身处于能力提升状态则恢复自身最大体力的1/3|（诡符下场后保留，每只精灵最多可被施加4道，被施加精灵因扣除体力效果死亡时会残留1点体力，所有特效boss无效）|诡符：被施加精灵受到的致命一击伤害提升15%，主动切换下场前直接扣除50点体力"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>登场效果：\r
<indent=16><sprite=3><indent=32>每次登场时：\r
<indent=32><sprite=4><indent=48><color=#64F9FA>消除</color>对手<b>能力提升状态</b>，消除成功则<color=#64F9FA>令对手害怕</color>\r
<indent=32><sprite=4><sprite=4><indent=64>未触发则<color=#64F9FA>令对手束缚</color>\r
<indent=32><sprite=4><indent=48>若当回合对方选择主动切换精灵则战斗阶段结束时为对手施加1道<color=#FFF779>诡符</color>\r
\r
<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时若自身不处于能力提升状态则当回合受到的<b>攻击伤害</b><color=#64F9FA>减少</color>50%\r
\r
<indent=0><sprite=0><indent=16>战阶结束效果：\r
<indent=16><sprite=3><indent=32>战斗阶段结束时若自身处于能力提升状态则<color=#64F9FA>恢复</color>自身最大体力的1/3\r
\r
<indent=0><sprite=5><indent=15>诡符（上限4道，下场保留）：\r
<indent=16><sprite=6><indent=32>每持有1道：\r
<indent=32><sprite=4><indent=48>受到的<b>致命一击伤害</b>都<color=#64F9FA>提升</color>15%\r
<indent=32><sprite=4><indent=48>主动切换下场前都<color=#64F9FA>直接扣除</color>50点<b>体力</b>，造成致命伤害时<color=#64F9FA>保留</color>1点<b>体力</b>"""@zh ;
