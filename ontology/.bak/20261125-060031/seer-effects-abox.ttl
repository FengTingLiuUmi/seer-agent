seer:soulmark_1814 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4609 ;
    seer:desc "回合开始时，若自身满体力则令对手所有技能PP值-2，若自身未满体力则为自身附加200点护罩，自身体力低于最大体力的1/2时额外附加150点护盾与150点护罩；（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时：\r
<indent=32><sprite=4><indent=48>若自身满体力则令对手所有技能PP值-2\r
<indent=32><sprite=4><indent=48>若自身未满体力则为自身<color=#64F9FA>附加</color>200点<b>护罩</b>\r
<indent=32><sprite=4><sprite=4><indent=64>若自身体力低于最大体力的1/2则额外<color=#64F9FA>获得</color>150点<b>护盾</b>与150点<b>护罩</b>"""@zh ;
