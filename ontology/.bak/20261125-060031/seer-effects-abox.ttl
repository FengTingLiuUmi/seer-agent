seer:soulmark_1018 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_3738 ;
    seer:desc "对手使用攻击技能命中率降低35%；若对手攻击命中则自身战斗阶段结束时恢复自身最大体力的1/3，若对手未命中则战斗阶段结束时令对手随机3项能力值-1（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>常驻效果：\r
<indent=16><sprite=3><indent=32>对手使用攻击技能<b>命中率</b><color=#64F9FA>降低</color>35%\r
\r
<indent=0><sprite=0><indent=16>触发效果：\r
<indent=16><sprite=3><indent=32>对手攻击命中的回合战斗阶段结束时自身<color=#64F9FA>恢复</color>自身最大体力的1/3\r
<indent=16><sprite=3><indent=32>对手未命中的回合战斗阶段结束时令对手随机3项<b>能力等级</b>-1"""@zh ;
    seer:effectAlias "alias_1314_35_3_3_1_1" ;
