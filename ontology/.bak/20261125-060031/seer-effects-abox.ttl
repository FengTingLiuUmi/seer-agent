seer:soulmark_1128 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_3857 ;
    seer:desc "自身攻击技能命中后有自身当前体力百分比的概率令对手烧伤，未触发则有自身当前体力百分比一半的概率令对手焚烬；回合开始时，若对手处于烧伤状态则当回合自身攻击随机附加150-300点固定伤害，若对手不处于烧伤状态则所有技能命中率随机降低30%-50%（boss无效）"@zh ;
