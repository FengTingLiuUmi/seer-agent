    seer:isAdv false ;
    seer:pveEffective false ;
    seer:seerapiId "1947" ;
    seer:soulmarkEffect "{\"effect\": {\"id\": 2360, \"url\": \"https://api.seerapi.com/v1/eid_effect/2360\"}, \"effect_args\": [3, 50, 1, 1, 1, 1, 0, 1]}" ;
    seer:soulmarkTag seer:soulmark_tag_11,
        seer:soulmark_tag_8,
        seer:soulmark_tag_9 ;
    seer:sourceUrl "https://api.seerapi.com/v1/soulmark/1947" .

seer:soulmark_1949 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4746 ;
    seer:desc "自身登场时，若自身体力高于对手则当回合免疫受到的异常状态，若自身体力低于对手则战斗阶段结束时恢复最大体力的1/3；自身受到的攻击伤害减少50%，自身体力每减少10%，效果减少5%|（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>登场效果：\r
