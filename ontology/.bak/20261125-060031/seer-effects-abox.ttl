seer:soulmark_1689 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4479 ;
    seer:desc "回合开始时随机令对手2项能力值-1，然后若对手处于全能力下降状态则消除对手回合类效果并令对手冻伤；|自身攻击技能命中则造成攻击伤害前，若对手处于冻伤状态80%令对手冰封，若对手不处于冻伤状态本次攻击造成的伤害提升50%|（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时随机令对手2项能力值-1\r
<indent=32><sprite=4><indent=48>然后若对手处于全能力下降状态则<color=#64F9FA>消除</color>对手回合类效果并<color=#64F9FA>令对手冻伤</color>\r
