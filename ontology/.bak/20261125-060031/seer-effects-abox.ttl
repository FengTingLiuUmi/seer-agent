seer:soulmark_1970 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4759 ;
    seer:desc "自身每次登场后，下2次使用攻击技能时消除对手能力提升状态，消除成功则令对手全属性-1，对手不处于能力提升状态时自身100%闪避对手的下1次攻击技能|自身使用属性技能时，若自身的登场效果已耗尽，则消耗此技能的全部PP值以重置登场效果|（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>登场效果：\r
<indent=16><sprite=3><indent=32>自身每次登场后，下2次使用攻击技能时：\r
<indent=32><sprite=4><indent=48><color=#64F9FA>消除</color>对手<b>能力提升状态</b>，消除成功则令对手<color=#64F9FA>全属性-1</color>\r
<indent=32><sprite=4><indent=48>对手不处于能力提升状态时自身100%<color=#64F9FA>闪避</color>对手的下1次<b>攻击技能</b>\r
\r
