seer:soulmark_1531 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4309 ;
    seer:desc "战斗阶段结束时，若自身体力高于最大体力的1/3则下回合攻击先制+1，若自身存活且体力低于最大体力的1/3则触发画地为牢：{吸取}对手最大{体力}的1/3，令对手随机2项技能PP值归零，下2回合对手无法主动切换精灵（每场战斗仅触发1次，boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>限定效果：\r
<indent=16><sprite=3><indent=32>战斗阶段结束时：\r
<indent=32><sprite=4><indent=48>若自身体力高于最大体力的1/3则下回合攻击先制+1\r
<indent=32><sprite=4><indent=48>若自身存活且体力低于最大体力的1/3则触发画地为牢, 每场战斗限1次：\r
<indent=32><sprite=4><sprite=4><indent=64>吸取对手最大体力的1/3\r
<indent=32><sprite=4><sprite=4><indent=64>令对手随机2项技能PP值归零\r
<indent=32><sprite=4><sprite=4><indent=64>下2回合对手无法主动切换精灵 """@zh ;
