seer:soulmark_957 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_3672 ;
    seer:desc "每次登场当回合若对手使用属性技能则下回合无法使用攻击技能，若对手使用攻击技能则下回合无法使用属性技能；自身每使用1次攻击技能则本次战斗中造成的伤害提高40%，最高120%；自身每使用1次属性技能则本次战斗中受到的伤害减少20%，最高60%（下场后保留，boss无效)"@zh ;
