seer:soulmark_1934 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4735 ;
    seer:desc "自身使用技能时，若此技能的类型本次登场未使用过则消除对手回合类效果并70%令对手诅咒|回合开始时，若对手处于异常状态，自身所有技能恢复1点PP值且当回合造成的攻击伤害提升70%|（boss无效）"@zh ;
