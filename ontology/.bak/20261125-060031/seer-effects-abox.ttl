seer:soulmark_1748 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4537 ;
    seer:desc "自身受到物理攻击伤害后，抵挡下次受到的物理攻击；|自身受到特殊攻击伤害后，抵挡下次受到的特殊攻击；|自身受到属性伤害后，无效对手下次属性技能；|战斗阶段结束时，若本回合未受到技能伤害则下回合攻击技能先制+1（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>触发效果：\r
<indent=16><sprite=3><indent=32>自身受到物理攻击伤害后，<color=#64F9FA>抵挡</color>下次受到的<b>物理攻击</b>\r
<indent=16><sprite=3><indent=32>自身受到特殊攻击伤害后，<color=#64F9FA>抵挡</color>下次受到的<b>特殊攻击</b>\r
<indent=16><sprite=3><indent=32>自身受到属性伤害后，<color=#64F9FA>无效</color>对手下次<b>属性技能</b>\r
\r
<indent=0><sprite=0><indent=16>战阶结束效果：\r
