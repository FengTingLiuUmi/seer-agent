seer:soulmark_622 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_3291 ;
    seer:analyzeDesc "[sprite name=dot1]自身[color=#57c975]免疫[/color]受到的[color=#52a5f2]固定伤害[/color]、[color=#52a5f2]百分比伤害[/color]、[color=#52a5f2]能力下降状态[/color]且[color=#52a5f2]固定伤害[/color]和[color=#52a5f2]百分比伤害[/color]抗性始终视为100%（[color=#57c975]免疫[/color][color=#52a5f2]能力下降状态[/color]boss有效，其余效果boss无效）|[sprite name=dot1]自身[color=#52a5f2]技能无效[/color]时，若本次技能结束后[color=#52a5f2]对手[/color]体力值高于0，则50%进行一次[color=#52a5f2]额外行动[/color][color=#52a5f2]以[/color]触发[color=#f35555]星皇之怒[/color]|[sprite name=dot1]自身位于出战背包时，[color=#52a5f2]己方[/color]精灵拥有[color=#f35555]星皇之赐[/color]，[color=#52a5f2]己方[/color]精灵首发精灵拥有[color=#f35555]星皇之佑[/color]"@zh ;
    seer:desc "自身免疫受到的固定伤害、百分比伤害、能力下降状态且固定伤害和百分比伤害抗性始终视为100%（免疫能力下降状态boss有效，其余效果boss无效）|自身技能无效时，若本次技能结束后对手体力值高于0，则50%进行一次额外行动以触发星皇之怒|自身位于出战背包时，己方精灵拥有星皇之赐，己方精灵首发精灵拥有星皇之佑|（boss有效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>常驻效果：\r
<indent=16><sprite=3><indent=32><color=#64F9FA>免疫</color>所有<b>固定伤害</b>、<b>百分比伤害</b>\r
<indent=16><sprite=3><indent=32><color=#64F9FA>免疫</color><b>能力下降状态</b>（boss有效）\r
<indent=16><sprite=3><indent=32>在战斗中将固定伤害和百分比伤害抗性始终视为100%\r
\r
<indent=0><sprite=0><indent=16>常驻效果（boss有效）：\r
<indent=16><sprite=3><indent=32>自身位于出战背包时，己方精灵将拥有<color=#FFF779>星皇之赐</color>，己方首发精灵拥有<color=#FFF779>星皇之佑</color>\r
\r
<indent=0><sprite=0><indent=16>触发效果：\r
<indent=16><sprite=3><indent=32>自身技能无效时，若本次技能结束后对手体力值高于0，则50%进行一次额外行动以触发<b>星皇之怒</b>\r
\r
<indent=0><sprite=5><indent=15>星皇之怒：\r
<indent=16><sprite=6><indent=32>瀚宇星皇特定技能中的效果，不随技能的命中而直接生效\r
<indent=16><sprite=6><indent=32>瀚宇星皇进行额外行动以触发星皇之怒时，以所使用技能50%的威力额外进行1次攻击并执行所使用技能的星皇之怒效果\r
<indent=32><sprite=4><indent=48>本次额外攻击<color=#64F9FA>拥有</color>原本技能所有的<b>伤害提升效果</b>且<color=#64F9FA>不会被其他效果响应</color>（boss有效）\r
<indent=32><sprite=4><indent=48>体力因此本次额外攻击归0的对手<color=#64F9FA>无法触发任何效果</color>\r
\r
<indent=0><sprite=5><indent=15>星皇之赐：\r
<indent=16><sprite=6><indent=32>自身每回合行动结束后<color=#64F9FA>恢复</color>最大体力的1/8\r
\r
<indent=0><sprite=5><indent=15>星皇之佑：\r
<indent=16><sprite=6><indent=32>自身3回合内<color=#64F9FA>免疫</color>受到的<b>异常状态</b>和<b>能力下降状态</b>"""@zh ;
    seer:effectAlias "alias_903_50_50_8_3_1" ;
    seer:intensified false ;
    seer:isAdv false ;
    seer:pveEffective true ;
    seer:seerapiId "622" ;
    seer:soulmarkEffect "{\"effect\": {\"id\": 903, \"url\": \"https://api.seerapi.com/v1/eid_effect/903\"}, \"effect_args\": [50, 50, 8, 3, 1]}" ;
