seer:soulmark_753 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_5000 ;
    seer:analyzeDesc "[sprite name=dot4]虚无：自身受到[color=#52a5f2]攻击伤害[/color]后，[color=#57c975]免疫[/color]下1次受到的技能伤害|[sprite name=dot4]元素：[color=#57c975]登场时[/color]，消除[color=#52a5f2]对手[/color][color=#52a5f2]回合类效果[/color]，消除成功则令[color=#52a5f2]对手[/color]下1次[color=#52a5f2]技能无效[/color]|[sprite name=dot1]能量：[color=#57c975]战斗阶段结束时[/color]，附加自身[color=#52a5f2]已损失体力[/color]50%的[color=#52a5f2]百分比伤害[/color]|[sprite name=dot1]生命：[color=#57c975]战斗阶段结束时[/color]，恢复自身最大体力的1/4和随机2个PP值不为满的技能1点PP值|[sprite name=dot4]轮回：自身[color=#52a5f2]首次[/color]于[color=#52a5f2]对手[/color]出手回合受到[color=#52a5f2]致死伤害[/color]时[color=#52a5f2]当回合[/color][color=#52a5f2]保留[/color]，同时[color=#57c975]回合结束后[/color]自身体力、PP值、能力等级返回[color=#52a5f2]当回合[/color]选择操作[color=#52a5f2]之后[/color]的状态|[sprite name=dot4]永恒：[color=#57c975]回合开始时[/color]，若自身体力高于[color=#52a5f2]对手[/color]则[color=#52a5f2]当回合[/color]自身技能必定先手|[sprite name=dot1]圣洁：[color=#57c975]免疫[/color]受到的[color=#52a5f2]异常状态[/color]和[color=#52a5f2]能力下降状态[/color]"@zh ;
    seer:desc "虚无：自身受到攻击伤害后，免疫下1次受到的技能伤害|元素：登场时，消除对手回合类效果，消除成功则令对手下1次技能无效|能量：战斗阶段结束时，附加自身已损失体力50%的百分比伤害（boss有效）|生命：战斗阶段结束时，恢复自身最大体力的1/4和随机2个PP值不为满的技能1点PP值（boss有效）|轮回：自身首次于对手出手回合受到致死伤害时当回合保留，同时回合结束后自身体力、PP值、能力等级返回当回合选择操作之后的状态|永恒：回合开始时，若自身体力高于对手则当回合自身技能必定先手|圣洁：免疫受到的异常状态和能力下降状态（boss有效）|（标注部分boss有效，其余无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>虚无：\r
<indent=16><sprite=3><indent=32>受到攻击伤害时，<color=#64F9FA>抵挡</color>下1次受到的<b>攻击</b>\r
\r
<indent=0><sprite=0><indent=16>元素：\r
<indent=16><sprite=3><indent=32>登场时<color=#64F9FA>消除</color>对手<b>回合类效果</b>\r
<indent=32><sprite=4><indent=48>消除成功则使对手下1次<b>所有技能</b><color=#64F9FA>无效</color>\r
\r
<indent=0><sprite=0><indent=16>能量（boss有效）：\r
<indent=16><sprite=3><indent=32>战斗阶段结束时<color=#64F9FA>附加</color>自身已损失体力50%的<b>百分比伤害</b>\r
\r
<indent=0><sprite=0><indent=16>生命（boss有效）：\r
<indent=16><sprite=3><indent=32>战斗阶段结束时<color=#64F9FA>恢复</color>自身最大体力的1/4和随机2个PP值未满的技能1点<b>PP值</b>\r
\r
<indent=0><sprite=0><indent=16>轮回（每场战斗限1次）：\r
<indent=16><sprite=3><indent=32>对手出手回合若自身受到致命伤害则：\r
<indent=32><sprite=4><indent=48><color=#64F9FA>保留</color>1点<b>体力</b>\r
<indent=32><sprite=4><indent=48>当回合结束后自身<b>体力</b>、<b>PP值</b>、<b>能力等级</b>返回当回合选择操作之后的状态\r
\r
<indent=0><sprite=0><indent=16>永恒：\r
<indent=16><sprite=3><indent=32>回合开始时若自身体力高于对手则当回合自身<color=#64F9FA>必定先手</color>\r
\r
<indent=0><sprite=0><indent=16>圣洁（boss有效）：\r
<indent=16><sprite=3><indent=32>天生<color=#64F9FA>免疫</color>所有<b>异常状态</b>和<b>能力下降状态</b></color></b>"""@zh ;
