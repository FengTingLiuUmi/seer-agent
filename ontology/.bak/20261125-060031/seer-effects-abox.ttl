seer:soulmark_967 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_3685 ;
    seer:desc "回合开始时若自身体力高于最大体力的1/2则当回合所有技能先制+1，若自身体力低于最大体力的1/2则当回合自身攻击技能{吸取}对手最大{体力}的1/4；回合开始时若自身处于能力提升状态则当回合自身造成的攻击伤害提升50%，若自身不处于能力提升状态则当回合自身攻击技能减少对手最大体力的1/3（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时：\r
<indent=32><sprite=4><indent=48>若自身体力高于最大体力的1/2则当回合所有技能<b>先制</b>+1\r
