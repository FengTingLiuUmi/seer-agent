seer:soulmark_1067 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_3791 ;
    seer:desc "使用攻击技能{吸取}对手最大{体力}的20%，每次使用增加5%，最高30%；使用属性技能使自身下回合造成的伤害提升30%，每次使用增加10%，最高50%；自身被击败时消除对手能力提升状态，消除成功则100%令对手害怕，未触发则附加自身最大体力1/3的固定伤害（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>技能额外效果：\r
<indent=16><sprite=3><indent=32>使用攻击技能<color=#64F9FA>吸取</color>对手最大体力的20%，每次使用增加5%，最高30%\r
<indent=16><sprite=3><indent=32>使用属性技能使自身下回合造成的攻击伤害<color=#64F9FA>提升</color>30%，每次使用增加10%，最高50%\r
\r
<indent=0><sprite=0><indent=16>被击败效果：\r
<indent=16><sprite=3><indent=32>自身被击败时<color=#64F9FA>消除</color>对手<b>能力提升状态</b>\r
<indent=32><sprite=4><indent=48>消除成功则100%<color=#64F9FA>令对手害怕</color>\r
<indent=32><sprite=4><sprite=4><indent=64>未触发则<color=#64F9FA>附加</color>自身最大体力1/3的<b>百分比伤害</b>"""@zh ;
