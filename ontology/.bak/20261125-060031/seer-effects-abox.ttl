seer:soulmark_1741 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4528 ;
    seer:desc "战斗阶段结束时双方每处于一项异常状态{吸取}对手200点{体力}，若至少处于一项则下回合自身使用技能后80%令对手睡眠，若双方均不处于异常状态则下回合自身所有技能先制+1|（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>战阶结束效果：\r
