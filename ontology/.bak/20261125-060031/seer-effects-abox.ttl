seer:soulmark_1089 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_3814 ;
    seer:desc "首次登场时消除对手回合类效果，消除成功则令对手随机进入1种异常状态，未触发异常状态则对手当回合技能无效；|回合开始时，若自身体力低于对手则当回合受到攻击后消除对手回合类效果，消除成功则{吸取}对手最大{体力}的1/3；回合开始时，若自身体力高于对手则当回合受到的攻击后100%令对手随机进入1种异常状态，未触发则下回合自身攻击100%令对手随机进入1种异常状态（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>限定效果：\r
