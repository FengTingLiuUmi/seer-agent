seer:soulmark_1282 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4024 ;
    seer:desc "自身所有技能先出手时{吸取}对手最大{体力}的1/3，后出手时恢复自身最大体力的1/3并造成等量百分比伤害；|自身受到攻击伤害后利用大地将其转换为自身的力量：战斗阶段结束时为自身附加所受攻击伤害值50%的等量护盾（最高400点），下回合自身使用攻击技能时附加所受攻击伤害值50%的百分比伤害（最高400点）（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>触发效果：\r
<indent=16><sprite=3><indent=32>自身先出手时<color=#64F9FA>吸取</color>对手最大体力的1/3\r
