        seer:soulmark_tag_13,
        seer:soulmark_tag_2 ;
    seer:sourceUrl "https://api.seerapi.com/v1/soulmark/1702" .

seer:soulmark_1706 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4492 ;
    seer:desc "每次对手主动切换下场后为对方下只出战精灵附加烧伤，未触发则令对手全属性-1；|自身使用攻击技能后，若造成的攻击伤害高于300则100%令对手害怕，未触发则100%令对手烧伤，若当回合开始时对手处于烧伤状态则使用攻击技能后无需造成伤害也可触发后续效果|（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>触发效果：\r
<indent=16><sprite=3><indent=32>每次对手主动切换下场则令对方下只精灵出战时100%烧伤\r
<indent=32><sprite=4><indent=48>未触发则令对手<color=#64F9FA>全属性-1</color>\r
\r
<indent=0><sprite=0><indent=16>攻击技能额外效果：\r
<indent=16><sprite=3><indent=32>自身使用攻击技能后：\r
<indent=32><sprite=4><indent=48>若造成的攻击伤害高于300则100%<color=#64F9FA>令对手害怕</color>\r
<indent=32><sprite=4><sprite=4><indent=64>未触发则100%<color=#64F9FA>令对手烧伤</color>\r
<indent=32><sprite=4><indent=48>若当回合开始时对手处于烧伤状态则使用攻击技能后无需造成伤害也可触发上述效果"""@zh ;
