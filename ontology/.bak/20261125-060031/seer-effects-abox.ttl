seer:soulmark_1782 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4573 ;
    seer:desc "回合开始时若自身处于异常状态，则获得200点护盾、护罩；回合结束后，若本回合自身未使用攻击技能则恢复200点体力且下次攻击造成的伤害提升40%，最多可叠加至提升120%，当叠加至120%时，自身下次使用攻击技能时额外消除对手回合类效果、能力提升状态、护盾、护罩，每消除成功1项附加200点固定伤害（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时若自身处于异常状态，则<color=#64F9FA>获得</color>200点<b>护盾</b>、<b>护罩</b>\r
\r
<indent=0><sprite=0><indent=16>回合结束效果：\r
<indent=16><sprite=3><indent=32>回合结束后，若本回合自身未使用攻击技能则<color=#64F9FA>恢复</color>300点<b>体力</b>且下次攻击造成的<b>攻击伤害<color=#64F9FA></b>提升</color>40%，最多可叠加至提升120%\r
<indent=32><sprite=4><indent=48>当叠加至120%时，自身下次使用攻击技能时额外<color=#64F9FA>消除</color>对手<b>回合类效果</b>、<b>能力提升状态</b>、<b>护盾</b>、<b>护罩</b>，每消除成功1项<color=#64F9FA>附加</color>300点<b>固定伤害</b>"""@zh ;
    seer:effectAlias "alias_2176_200_200_40_120_200_1" ;
    seer:intensified false ;
    seer:isAdv false ;
    seer:pveEffective false ;
    seer:seerapiId "1782" ;
    seer:soulmarkEffect "{\"effect\": {\"id\": 2176, \"url\": \"https://api.seerapi.com/v1/eid_effect/2176\"}, \"effect_args\": [200, 200, 40, 120, 200, 1]}" ;
