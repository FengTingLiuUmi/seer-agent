        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4626 ;
    seer:desc "自身使用攻击技能时攻击、防御、特防等级+1；回合开始时，若自身处于能力提升状态则当回合攻击必定打出致命一击且造成伤害提升50%，若自身不处于能力提升状态则当回合受到的攻击伤害减少200点"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>攻击技能额外效果：\r
<indent=16><sprite=3><indent=32>自身使用攻击技能时自身攻击、防御、特防等级+1\r
\r
\r
<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时：\r
<indent=32><sprite=4><indent=48>若自身处于能力提升状态则当回合<b>攻击技能</b>必定<color=#64F9FA>打出致命一击</color>且造成的<b>攻击伤害<color=#64F9FA></b>提升</color>50%\r
<indent=32><sprite=4><indent=48>若自身不处于能力提升状态则当回合受到的<b>攻击伤害</b><color=#64F9FA>减少</color>200点"""@zh ;
