seer:soulmark_1718 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:advanceOf seer:pet_advance_9 ;
    seer:affectsPet seer:pet_3507 ;
    seer:analyzeDesc "[sprite name=dot4][color=#57c975]回合开始时[/color]，若[color=#52a5f2]对手[/color]不处于[color=#57c975]冰封[/color]状态则[color=#52a5f2]当回合[/color]自身所有技能[color=#52a5f2]先制[/color]+1|[sprite name=dot4]自身技能额外50%令[color=#52a5f2]对手[/color][color=#57c975]冰封[/color]，[color=#52a5f2]未触发[/color]则消除[color=#52a5f2]对手[/color][color=#52a5f2]回合类效果[/color]，[color=#52a5f2]然后[/color]若本次技能为攻击技能则附加[color=#52a5f2]对手[/color]最大体力1/3的[color=#52a5f2]百分比伤害[/color]，[color=#52a5f2]对手[/color]不处于[color=#57c975]冰封[/color]状态时改为[color=#52a5f2]吸取[/color][color=#52a5f2]对手[/color]最大体力的1/3"@zh ;
    seer:derivedFrom seer:soulmark_817 ;
    seer:desc "回合开始时，若对手不处于冰封状态则当回合自身所有技能先制+1|自身技能额外50%令对手冰封，未触发则消除对手回合类效果，然后若本次技能为攻击技能则附加对手最大体力1/3的百分比伤害，对手不处于冰封状态时改为吸取对手最大体力的1/3|（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时若对手不处于冰封状态，则当回合自身所有技能<b>先制</b>+1\r
\r
<indent=0><sprite=0><indent=16>攻击技能额外效果：\r
<indent=16><sprite=3><indent=32>自身使用技能造成伤害前50%<color=#64F9FA>令对手冰封</color>\r
<indent=32><sprite=4><indent=48>未触发则<color=#64F9FA>消除</color>对手<b>回合类效果</b>，然后：\r
<indent=32><sprite=4><sprite=4><indent=64>若对手处于冰封状态且本次技能为攻击技能则<color=#64F9FA>附加</color>对手最大体力1/3的<b>百分比伤害</b>\r
<indent=32><sprite=4><sprite=4><indent=64>若对手不处于冰封状态且本次技能为攻击技能则<color=#64F9FA>吸取</color>对手最大体力的1/3"""@zh ;
