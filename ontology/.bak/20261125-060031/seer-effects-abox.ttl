seer:soulmark_828 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_3516 ;
    seer:analyzeDesc "[sprite name=dot4][color=#57c975]回合开始时[/color]，若自身处于[color=#52a5f2]能力提升状态[/color]则自身获得300点[color=#57c975]护盾[/color]，若自身不处于[color=#52a5f2]能力提升状态[/color]则[color=#57c975]战斗阶段结束时[/color][color=#52a5f2]吸取[/color][color=#52a5f2]对手[/color]最大体力的1/3并获得等量的[color=#57c975]护盾[/color]，最高叠加至400|[sprite name=dot4][color=#52a5f2]对手[/color]击破自身全部[color=#57c975]护盾[/color]时，附加[color=#52a5f2]对手[/color]最大体力1/3的[color=#52a5f2]百分比伤害[/color]且[color=#52a5f2]对手[/color]下1次使用攻击技能时，[color=#52a5f2]当回合[/color]自身受到的[color=#52a5f2]攻击伤害[/color]减少50%"@zh ;
    seer:desc "回合开始时，若自身处于能力提升状态则自身获得300点护盾，若自身不处于能力提升状态则战斗阶段结束时吸取对手最大体力的1/3并获得等量的护盾，最高叠加至400|对手击破自身全部护盾时，附加对手最大体力1/3的百分比伤害且对手下1次使用攻击技能时，当回合自身受到的攻击伤害减少50%|（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时：\r
<indent=32><sprite=4><indent=48>若自身处于能力提升状态则为自身<color=#64F9FA>附加</color>300点<b>护盾</b>\r
<indent=32><sprite=4><indent=48>若自身不处于能力提升状态则战斗阶段结束时<color=#64F9FA>吸取</color>对手最大体力的1/3并为自身<color=#64F9FA>附加</color>等量的<b>护盾</b>，上限400\r
\r
<indent=0><sprite=0><indent=16>触发效果：\r
