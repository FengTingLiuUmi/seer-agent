        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4892 ;
    seer:analyzeDesc "[sprite name=dot4]自身连续3回合使用攻击技能时，重置此计数且[color=#52a5f2]当回合[/color][color=#57c975]战斗阶段结束时[/color]恢复全部体力并附加恢复溢出量的[color=#52a5f2]固定伤害[/color]|[sprite name=dot4]自身连续3回合使用属性技能时，重置此计数且[color=#52a5f2]当回合[/color][color=#57c975]战斗阶段结束时[/color]对自身附加等同于最大体力的[color=#52a5f2]固定伤害[/color]，[color=#52a5f2]然后[/color]若自身体力值高于0则附加等同于自身[color=#52a5f2]已损失体力[/color]的[color=#52a5f2]固定伤害[/color]"@zh ;
