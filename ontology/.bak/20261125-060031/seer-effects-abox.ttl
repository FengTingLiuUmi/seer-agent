seer:soulmark_2072 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:advanceOf seer:pet_advance_24 ;
    seer:affectsPet seer:pet_3711 ;
    seer:analyzeDesc "[sprite name=dot1][color=#57c975]出战时[/color]，自身获得4道[color=#f35555]宁界之律[/color]，[color=#52a5f2]然后[/color]自身消耗对应位置技能的全部PP值并恢复己方上只在场精灵PP值为0的技能全部PP值，触发成功则为其附加1道[color=#f35555]琼华之庇[/color]|[sprite name=dot1]自身拥有[color=#f35555]宁界之律[/color]时，选择使用技能[color=#52a5f2]不受PP值限制[/color]且[color=#57c975]回合结束时[/color]，若对手[color=#52a5f2]当回合(411)[/color]未选择技能则消耗1层并令对手[color=#57c975]沉默[/color]2回合，[color=#52a5f2]未触发[/color]则2回合内自身将对手、对方上只在场精灵的[color=#57c975]最优系别[/color]作为对手系别计算克制系数，自身[color=#f35555]宁界之律[/color]层数达到5时前述所有回合数+1"@zh ;
    seer:desc "出战时，自身获得4道宁界之律，然后自身消耗对应位置技能的全部PP值并恢复己方上只在场精灵PP值为0的技能全部PP值，触发成功则为其附加1道琼华之庇|自身拥有宁界之律时，选择使用技能不受PP值限制且回合结束时，若对手当回合未选择技能则消耗1层并令对手沉默2回合，未触发则2回合内自身将对手、对方上只在场精灵的最优系别作为对手系别计算克制系数，自身宁界之律层数达到5时前述所有回合数+1|（boss有效）"@zh ;
    seer:effectAlias "alias_2492_0_0" ;
    seer:intensified false ;
    seer:isAdv true ;
    seer:pveEffective true ;
