seer:soulmark_2116 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4920 ;
    seer:analyzeDesc "[sprite name=dot1][color=#57c975]回合开始时[/color]，若对手处于能力提升则[color=#52a5f2]当回合[/color]造成的[color=#52a5f2]攻击伤害[/color]提升100%，对手的各项能力等级存在不同时，额外使自身[color=#52a5f2]当回合[/color]必定打出[color=#52a5f2]致命一击[/color]"@zh ;
    seer:desc "回合开始时，若对手处于能力提升则当回合造成的攻击伤害提升100%，对手的各项能力等级存在不同时，额外使自身当回合必定打出致命一击|（boss有效）"@zh ;
    seer:effectAlias "alias_2525_0_0" ;
