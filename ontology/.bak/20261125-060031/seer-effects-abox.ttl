seer:soulmark_1717 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4503 ;
    seer:desc "回合开始时令自身攻击+2、防御+2，战斗阶段结束时若自身不处于能力提升状态则令对手下回合无法主动切换精灵；|双方任意一方使用技能后若自身存在技能PP值为0则100%令对手流血，未触发则恢复自身所有技能PP值且令对手下回合使用的技能附加效果失效|（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时令自身攻击+2、防御+2\r
\r
<indent=0><sprite=0><indent=16>战阶结束效果：\r
<indent=16><sprite=3><indent=32>战斗阶段结束时若自身不处于能力提升状态则令对手下回合<color=#64F9FA>无法主动切换精灵</color>\r
\r
<indent=0><sprite=0><indent=16>触发效果：\r
<indent=16><sprite=3><indent=32>双方任意一方使用技能后若自身存在技能PP值为0则100%<color=#64F9FA>令对手流血</color>\r
<indent=32><sprite=4><indent=48>未触发则<color=#64F9FA>恢复</color>自身所有技能<b>PP值</b>且令对手下回合<b>所有技能</b><color=#64F9FA>命中效果失效</color>"""@zh ;
