        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4599 ;
    seer:analyzeDesc "[sprite name=dot4]战斗开始时自身获得2层[color=#f35555]命起[/color]、2层[color=#f35555]魂落[/color]；自身[color=#57c975]出战时[/color]2回合内[color=#57c975]免疫[/color][color=#52a5f2]己方[/color]上只精灵[color=#57c975]下场时[/color]所处的[color=#52a5f2]异常状态[/color]，所处异常数[color=#52a5f2]达到[/color]4时改为所有[color=#52a5f2]异常状态[/color]|[sprite name=dot4][color=#52a5f2]对手[/color]使用[color=#52a5f2]威力[/color]不高于0的攻击技能时减少1层[color=#f35555]命起[/color]并令[color=#52a5f2]对手[/color][color=#57c975]睡眠[/color]，[color=#52a5f2]未触发[/color]则[color=#57c975]免疫[/color][color=#52a5f2]对手[/color]此次攻击，自身每有1层[color=#f35555]命起[/color][color=#52a5f2]威力[/color]阈值提升40，自身使用[color=#52a5f2]威力[/color]不高于0的攻击技能后减少1层[color=#f35555]魂落[/color]并令[color=#52a5f2]对手[/color][color=#57c975]睡眠[/color]，[color=#52a5f2]未触发[/color]则附加[color=#52a5f2]对手[/color]最大体力1/3的[color=#52a5f2]百分比伤害[/color]，自身每有1层[color=#f35555]魂落[/color][color=#52a5f2]威力[/color]阈值提升40|[sprite name=dot4]自身未[color=#57c975]击败[/color][color=#52a5f2]对手[/color]时，若自身[color=#f35555]命起[/color]层数不低于[color=#f35555]魂落[/color]则恢复最大体力的1/4，[color=#f35555]魂落[/color]层数不低于[color=#f35555]命起[/color]则恢复所有技能1点PP值，层数相等时[color=#52a5f2]己方[/color][color=#57c975]免疫[/color]下次受到的[color=#52a5f2]异常状态[/color]；[color=#57c975]击败[/color][color=#52a5f2]对手[/color]时，[color=#52a5f2]对手[/color][color=#57c975]下场后[/color]所处的[color=#52a5f2]异常状态[/color]、[color=#52a5f2]能力下降状态[/color]转移给下只出战精灵"@zh ;
    seer:desc "战斗开始时自身获得2层命起、2层魂落；自身出战时2回合内免疫己方上只精灵下场时所处的异常状态，所处异常数达到4时改为所有异常状态|对手使用威力不高于0的攻击技能时减少1层命起并令对手睡眠，未触发则免疫对手此次攻击，自身每有1层命起威力阈值提升40，自身使用威力不高于0的攻击技能后减少1层魂落并令对手睡眠，未触发则附加对手最大体力1/3的百分比伤害，自身每有1层魂落威力阈值提升40|自身未击败对手时，若自身命起层数不低于魂落则恢复最大体力的1/4，魂落层数不低于命起则恢复所有技能1点PP值，层数相等时己方免疫下次受到的异常状态；击败对手时，对手下场后所处的异常状态、能力下降状态转移给下只出战精灵|（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>战斗开始效果：\r
<indent=16><sprite=3><indent=32><color=#64F9FA>战斗开始时</color>自身获得2层命起、2层魂落，战斗中二者层数之和<b>恒为</b>4，当其中一项层数增加/减少时，另一项会同步减少/增加\r
\r
<indent=0><sprite=0><indent=16>出战效果：\r
<indent=16><sprite=3><indent=32>自身出战时2回合内<color=#64F9FA>免疫</color>己方上只精灵下场时所处的<b>异常状态</b>\r
<indent=32><sprite=4><indent=48>所处异常数达到4时改为所有异常状态\r
\r
<indent=0><sprite=0><indent=16>触发效果：\r
<indent=16><sprite=3><indent=32>对手使用威力不高于0的攻击技能时减少1层命起并<color=#64F9FA>令对手睡眠</color>\r
<indent=32><sprite=4><indent=48>未触发则<color=#64F9FA>免疫</color>对手此次<b>攻击</b>\r
<indent=32><sprite=4><indent=48>自身每有1层命起威力阈值提升40\r
<indent=16><sprite=3><indent=32>自身使用威力不高于0的攻击技能后减少1层魂落并<color=#64F9FA>令对手睡眠</color>\r
<indent=32><sprite=4><indent=48>未触发则<color=#64F9FA>附加</color>对手最大体力1/3的<b>百分比伤害</b>\r
<indent=32><sprite=4><indent=48>自身每有1层魂落威力阈值提升40\r
\r
<indent=0><sprite=0><indent=16>未击败效果：\r
<indent=16><sprite=3><indent=32>自身未击败对手时：\r
<indent=32><sprite=4><indent=48>若自身命起层数不低于魂落则<color=#64F9FA>恢复最大体力的1/4</color>\r
<indent=32><sprite=4><indent=48>魂落层数不低于命起则<color=#64F9FA>恢复</color>所有技能1点<b>PP值</b>\r
<indent=32><sprite=4><indent=48>层数相等时己方<color=#64F9FA>免疫</color>下次受到的<b>异常状态</b>\r
\r
<indent=0><sprite=0><indent=16>触发效果：\r
<indent=16><sprite=3><indent=32>击败对手时，对手下场后所处的<b>异常状态、能力下降</b>状态<color=#64F9FA>转移</color>给下只出战精灵"""@zh ;
    seer:effectAlias "alias_2193_2_2_4_0_1_40_1" ;
    seer:intensified false ;
