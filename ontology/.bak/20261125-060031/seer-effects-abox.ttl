seer:soulmark_1658 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4442 ;
    seer:desc "自身使用攻击技能会连击2次，若使用后造成的伤害不高于400则之后每次使用连击次数+2（上限为8次），若使用后造成的伤害高于400则重置自身连击次数并附加造成伤害100%的百分比伤害；|在战斗中令自身防御值和特防值中较低的一项每回合开始时提升2级，若自身防御值和特防值相同则造成的攻击伤害提升40%|（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>攻击技能额外效果：\r
<indent=16><sprite=3><indent=32>自身使用攻击技能会<color=#64F9FA>连击</color>2次\r
<indent=32><sprite=4><indent=48>若使用后造成的伤害不高于400则之后每次使用连击次数+2（上限为8次）\r
<indent=32><sprite=4><indent=48>若使用后造成的伤害高于400则重置自身连击次数并<color=#64F9FA>附加</color>造成伤害100%的<b>百分比伤害</b>\r
\r
<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时：\r
