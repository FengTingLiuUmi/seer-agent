seer:soulmark_1856 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4654 ;
    seer:desc "自身登场时、被击败时均为对手附加浪潮聚焦，若对手已处于浪潮聚焦则改为对手1回合内技能命中效果失效|自身使用技能后，若本次技能未打出致命一击则吸取对手最大体力的1/3且下回合先制+1，若打出了致命一击则吸取对手威力最高技能的剩余PP值|浪潮聚焦：天敌精灵或鲸沫对自身的攻击必定打出致命一击，触发致命一击后浪潮聚焦消失，下场保留（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>登场效果：\r
<indent=16><sprite=3><indent=32>鲸沫登场时、被击败时均为对手附加<color=#FFF779>浪潮聚焦</color>\r
<indent=32><sprite=4><indent=48>若对手已处于浪潮聚焦则改为对手1回合内<b>技能<color=#64F9FA></b>命中效果失效</color>\r
\r
<indent=0><sprite=0><indent=16>技能额外效果：\r
<indent=16><sprite=3><indent=32>自身使用技能后：\r
<indent=32><sprite=4><indent=48>若本次技能未打出致命一击则<color=#64F9FA>吸取</color>对手最大体力的1/3且下回合<b>先制</b>+1\r
<indent=32><sprite=4><indent=48>若本次技能打出了致命一击则该技能<color=#64F9FA>吸取</color>对手威力最高技能的剩余<b>PP值</b>\r
\r
<indent=0><sprite=5><indent=15>浪潮聚焦（下场保留）：\r
<indent=16><sprite=6><indent=32>受到天敌精灵或鲸沫的<b>攻击技能</b>100%为致命一击\r
<indent=16><sprite=6><indent=32>受到致命一击后消失"""@zh ;
