seer:soulmark_2136 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4054 ;
    seer:analyzeDesc "[sprite name=dot4][color=#57c975]战斗阶段结束时[/color]，若[color=#52a5f2]当回合[/color]自身受到了[color=#52a5f2]攻击伤害[/color]则使自身全能力等级+1，若[color=#52a5f2]当回合[/color]自身未受到[color=#52a5f2]攻击伤害[/color]则令对手全能力等级-1；[color=#57c975]回合开始时[/color]，若自身处于能力提升状态则[color=#52a5f2]当回合[/color]100%[color=#57c975]闪避[/color]对手攻击，若对手处于能力下降状态则[color=#52a5f2]当回合[/color]攻击命中后100%令对手[color=#57c975]害怕[/color]"@zh ;
    seer:desc "战斗阶段结束时，若当回合自身受到了攻击伤害则使自身全能力等级+1，若当回合自身未受到攻击伤害则令对手全能力等级-1；回合开始时，若自身处于能力提升状态则当回合100%闪避对手攻击，若对手处于能力下降状态则当回合攻击命中后100%令对手害怕（boss无效）"@zh ;
    seer:effectAlias "alias_1642_6_1_6_1_100_100_1" ;
