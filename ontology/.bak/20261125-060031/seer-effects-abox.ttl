seer:soulmark_1675 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4463 ;
    seer:desc "自身攻击打出致命一击后附加对手最大体力15%的百分比伤害；|自身被击败时，为对手附加霜寒封印：3回合内防御、特防能力提升效果失效，无法通过技能恢复体力且每次使用技能后受到最大体力10%的百分比伤害，该百分比伤害最高为斯克鲁恩攻击值的200%|（boss有效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>触发效果：\r
<indent=16><sprite=3><indent=32>自身攻击打出致命一击后<color=#64F9FA>附加</color>对手最大体力15%的<b>百分比伤害</b>\r
\r
<indent=0><sprite=0><indent=16>被击败效果：\r
<indent=16><sprite=3><indent=32>自身被击败后令对手陷入<color=#FFF779>霜寒封印</color>\r
\r
