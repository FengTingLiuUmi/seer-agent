seer:soulmark_1555 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4329 ;
    seer:desc "每次登场首回合若对手处于能力提升状态则自身受到的攻击伤害降低50%且下回合对手属性技能失效，当回合战斗阶段结束时若双方全属性能力差值≥3开启倪克斯结界：下2回合对手攻击技能先制效果失效、下2回合自身攻击必定命中、2回合内每个战斗阶段结束时恢复自身所有技能1点PP值；|战斗阶段结束时若自身体力高于回合开始时则下回合攻击必定打出致命一击，战斗阶段结束时若自身体力等于回合开始时则下回合攻击技能先制+1，战斗阶段结束时若自身体力低于回合开始时则恢复自身最大体力的1/3（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>登场效果：\r
<indent=16><sprite=3><indent=32>每次登场首回合：\r
<indent=32><sprite=4><indent=48>回合开始时，若对手处于能力提升状态则自身受到的<b>攻击伤害</b><color=#64F9FA>减少</color>50%且下回合对手<b>属性技能</b><color=#64F9FA>无效</color>\r
<indent=32><sprite=4><indent=48>战斗阶段结束时，若双方全属性能力差值≥3开启<color=#FFF779>倪克斯结界</color>\r
\r
<indent=0><sprite=0><indent=16>战阶结束效果：\r
<indent=16><sprite=3><indent=32>战斗阶段结束时：\r
<indent=32><sprite=4><indent=48>若自身体力高于回合开始时则下回合攻击必定<color=#64F9FA>打出致命一击</color>\r
<indent=32><sprite=4><indent=48>若自身体力等于回合开始时则下回合攻击技能<b>先制</b>+1\r
<indent=32><sprite=4><indent=48>若自身体力低于回合开始时则<color=#64F9FA>恢复</color>自身最大体力的1/3\r
\r
<indent=0><sprite=5><indent=15>倪克斯结界：\r
<indent=16><sprite=6><indent=32>下2回合对手<b>攻击技能</b><color=#64F9FA>先制效果失效</color>\r
<indent=16><sprite=6><indent=32>下2回合自身攻击<color=#64F9FA>必定命中</color>\r
<indent=16><sprite=6><indent=32>2回合内每个战斗阶段结束时<color=#64F9FA>恢复</color>自身所有技能1点<b>PP值</b>"""@zh ;
