seer:soulmark_1980 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4783 ;
    seer:desc "自身攻击命中时50%令对手束缚，触发成功当回合造成的攻击伤害提升50%|自身受到的攻击伤害高于300时，若自身的体力上限高于600则失去200点体力上限并主动恢复全部体力|自身被击败时，消除对手的能力提升状态并令对手失明|（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>攻击技能额外效果：\r
<indent=16><sprite=3><indent=32>自身攻击命中时50%<color=#64F9FA>令对手束缚</color>\r
<indent=32><sprite=4><indent=48>触发成功当回合造成的<b>攻击伤害</b><color=#64F9FA>提升</color>50%\r
\r
<indent=0><sprite=0><indent=16>触发效果：\r
<indent=16><sprite=3><indent=32>自身受到的攻击伤害高于300时，若自身的体力上限高于600则失去200点<b>体力上限</b>并<color=#64F9FA>主动恢复</color>全部<b>体力</b>\r
\r
<indent=0><sprite=0><indent=16>被击败效果：\r
<indent=16><sprite=3><indent=32>自身被击败时，<color=#64F9FA>消除</color>对手的<b>能力提升状态</b>并<color=#64F9FA>令对手失明</color>"""@zh ;
