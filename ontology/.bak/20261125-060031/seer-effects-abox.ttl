seer:soulmark_740 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_3425 ;
    seer:desc "每次攻击造成伤害的50%恢复自身体力，若恢复的体力低于300则下回合自身造成的攻击伤害提升50%同时恢复百分比翻倍；50%使对手的属性技能失效，未触发则下回合100%令对手的属性技能失效（BOSS无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>触发效果：\r
