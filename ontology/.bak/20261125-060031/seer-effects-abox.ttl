seer:soulmark_2138 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4088 ;
    seer:analyzeDesc "[sprite name=dot4][color=#57c975]回合开始时[/color]，使自身防御+2、特防+2；自身[color=#57c975]受到攻击后[/color]，若双防提升等级总和≥0则[color=#52a5f2]当回合[/color][color=#57c975]战斗阶段结束时[/color]附加自身最大体力值40%的[color=#52a5f2]百分比伤害[/color]|[sprite name=dot4]自身被[color=#57c975]击败[/color]时，[color=#52a5f2]己方[/color]下只精灵出战时恢复最大体力的40%（出战精灵为环小队成员时改为50%），[color=#52a5f2]之后[/color]3回合内每[color=#57c975]回合结束时[/color]此精灵恢复最大体力的20%（出战精灵为环小队成员时改为25%）"@zh ;
    seer:desc "回合开始时，使自身防御+2、特防+2|自身受到攻击后，若双防提升等级总和≥0则当回合战斗阶段结束时附加自身最大体力值40%的百分比伤害|自身被击败时，己方下只精灵出战时恢复最大体力的40%（出战精灵为环小队成员时改为50%），之后3回合内每回合结束时此精灵恢复最大体力的20%（出战精灵为环小队成员时改为25%）（boss无效）"@zh ;
