seer:soulmark_1715 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4501 ;
    seer:desc "自身使用技能后100%令对手沉默，若命中则额外附加对手最大体力1/3的百分比伤害，若未命中则额外降低对手所有技能2点PP值；|战斗阶段结束时若对手不处于沉默状态则消除对手回合类效果，若对手处于沉默状态则为自身附加400点护盾|（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>触发效果：\r
<indent=16><sprite=3><indent=32>自身使用技能后100%令对手沉默\r
<indent=32><sprite=4><indent=48>若该技能命中则额外<color=#64F9FA>附加</color>对手最大体力1/3的<b>百分比伤害</b>\r
<indent=32><sprite=4><indent=48>若该技能未命中则额外<color=#64F9FA>降低</color>对手所有技能2点<b>PP值</b>\r
\r
<indent=0><sprite=0><indent=16>战阶结束效果：\r
<indent=16><sprite=3><indent=32>战斗阶段结束时：\r
<indent=32><sprite=4><indent=48>若对手不处于沉默状态则<color=#64F9FA>消除</color>对手<b>回合类效果</b>\r
<indent=32><sprite=4><indent=48>若对手处于沉默状态则为自身<color=#64F9FA>附加</color>400点<b>护盾</b>"""@zh ;
