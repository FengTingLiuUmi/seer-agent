seer:soulmark_1383 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4156 ;
    seer:desc "回合开始时，若自身体力高于最大体力的1/2则当回合自身攻击造成的伤害提升50%，若自身体力低于最大体力的1/2则当回合自身所有技能先制+1；|每次使用攻击技能都会附带上回合恢复体力值70%的固定伤害，遇到天敌时转变为100%（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>回合开始效果：\r
