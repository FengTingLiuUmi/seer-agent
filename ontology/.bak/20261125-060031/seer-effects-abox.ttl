seer:soulmark_1007 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_3729 ;
    seer:desc "自身使用攻击技能50%的概率打出致命一击，若自身处于能力提升状态下则致命概率翻倍；打出致命一击时随机{吸取}对手150-250{体力}，自身体力低于对手时随机{吸取}200-300点{体力}（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>常驻效果：\r
<indent=16><sprite=3><indent=32>自身使用攻击技能50%的概率<color=#64F9FA>打出致命一击</color>\r
<indent=32><sprite=4><indent=48>若自身处于能力提升状态下则致命概率翻倍\r
\r
<indent=0><sprite=0><indent=16>触发效果：\r
<indent=16><sprite=3><indent=32>打出致命一击时随机<color=#64F9FA>吸取</color>对手150-250点<b>体力</b>\r
<indent=32><sprite=4><indent=48>自身体力低于对手时随机<color=#64F9FA>吸取</color>200-300点<b>体力</b>"""@zh ;
    seer:effectAlias "alias_1305_50_150_250_200_300_1" ;
    seer:intensified false ;
    seer:intensifiedTo seer:soulmark_1900 ;
    seer:isAdv false ;
    seer:pveEffective false ;
    seer:seerapiId "1007" ;
    seer:soulmarkEffect "{\"effect\": {\"id\": 1305, \"url\": \"https://api.seerapi.com/v1/eid_effect/1305\"}, \"effect_args\": [50, 150, 250, 200, 300, 1]}" ;
    seer:soulmarkTag seer:soulmark_tag_15,
        seer:soulmark_tag_2,
        seer:soulmark_tag_6 ;
    seer:sourceUrl "https://api.seerapi.com/v1/soulmark/1007" .

seer:soulmark_1014 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_3740 ;
    seer:analyzeDesc "[sprite name=dot4][color=#52a5f2]登场时[/color]获得400点[color=#57c975]护盾[/color]，自身存在[color=#57c975]护盾[/color]时所有[color=#52a5f2]技能先制[/color]+1|[sprite name=dot4][color=#57c975]战斗阶段结束时[/color]，若[color=#52a5f2]当回合[/color]自身未受到[color=#52a5f2]攻击伤害[/color]则恢复自身250点体力并造成恢复量的[color=#52a5f2]固定伤害[/color]，若受到了[color=#52a5f2]攻击伤害[/color]则自身[color=#57c975]免疫[/color]下1次受到的[color=#52a5f2]攻击伤害[/color]|[sprite name=dot4]自身每次使用攻击技能时本次在场造成的[color=#52a5f2]攻击伤害[/color]提升25%，最高提升100%"@zh ;
    seer:desc "登场时获得400点护盾，自身存在护盾时所有技能先制+1|战斗阶段结束时，若当回合自身未受到攻击伤害则恢复自身250点体力并造成恢复量的固定伤害，若受到了攻击伤害则自身免疫下1次受到的攻击伤害|自身每次使用攻击技能时本次在场造成的攻击伤害提升25%，最高提升100%|（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>登场效果：\r
<indent=16><sprite=3><indent=32>登场时<color=#64F9FA>获得</color>400点<b>护盾</b>\r
\r
<indent=0><sprite=0><indent=16>常驻效果：\r
<indent=16><sprite=3><indent=32>自身存在护盾时所有技能<b>先制</b>+1\r
<indent=16><sprite=3><indent=32>自身每次使用攻击技能则本次在场造成的<b>攻击伤害</b><color=#64F9FA>提升</color>25%，最高提升100%\r
\r
\r
<indent=0><sprite=0><indent=16>战阶结束效果：\r
<indent=16><sprite=3><indent=32>战斗阶段结束时：\r
<indent=32><sprite=4><indent=48>若当回合自身未受到攻击伤害则<color=#64F9FA>恢复</color>自身250点体力并造成等量<b>固定伤害</b>\r
<indent=32><sprite=4><indent=48>若当回合自身受到攻击伤害则<color=#64F9FA>抵挡</color>下1次受到的<b>攻击</b>"""@zh ;
    seer:effectAlias "alias_1316_400_1_250_1_25_25_100_1" ;
    seer:intensified false ;
    seer:intensifiedTo seer:soulmark_1932 ;
    seer:isAdv false ;
    seer:pveEffective false ;
    seer:seerapiId "1014" ;
    seer:soulmarkEffect "{\"effect\": {\"id\": 1316, \"url\": \"https://api.seerapi.com/v1/eid_effect/1316\"}, \"effect_args\": [400, 1, 250, 1, 25, 25, 100, 1]}" ;
    seer:soulmarkTag seer:soulmark_tag_3,
        seer:soulmark_tag_6,
        seer:soulmark_tag_7 ;
    seer:sourceUrl "https://api.seerapi.com/v1/soulmark/1014" .

seer:soulmark_1030 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_3425 ;
    seer:derivedFrom seer:soulmark_740 ;
    seer:desc "每次攻击造成伤害的50%恢复自身体力，若恢复的体力低于300则下回合自身造成的攻击伤害提升100%同时恢复百分比翻倍；50%使对手的属性技能失效，未触发则下一次100%令对手的属性技能失效（BOSS无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>触发效果：\r
<indent=16><sprite=3><indent=32>造成的攻击伤害50%额外<color=#64F9FA>恢复</color>至自身体力\r
<indent=32><sprite=4><indent=48>若未恢复300体力则下回合上述恢复比例翻倍且自身造成的<b>攻击伤害</b><color=#64F9FA>提升</color>100%\r
\r
<indent=0><sprite=0><indent=16>常驻效果：\r
<indent=16><sprite=3><indent=32>50%令对手的<b>属性技能</b><color=#64F9FA>无效</color>，未触发则下次触发时100%令对手的<b>属性技能</b><color=#64F9FA>无效</color>"""@zh ;
    seer:effectAlias "alias_1328_50_300_100_50_100_1" ;
    seer:intensified true ;
    seer:isAdv false ;
    seer:pveEffective false ;
