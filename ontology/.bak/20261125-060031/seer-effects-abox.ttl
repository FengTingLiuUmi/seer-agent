seer:soulmark_1796 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4588 ;
    seer:desc "首次登场时自身获得350点护盾、350点护罩，对手使用攻击技能后令对手中毒，对手使用属性技能后令对手寄生|回合开始时记录双方所处的异常状态，若本次在场自身已记录过中毒、寄生各1次则开启绿茵庇护：5回合内双方在场精灵免疫控制类异常状态（绿茵庇护每场战斗限1次，所有效果boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>登场效果：\r
