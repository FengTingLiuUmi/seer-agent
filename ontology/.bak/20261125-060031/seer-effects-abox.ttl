seer:soulmark_1279 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4021 ;
    seer:desc "每次登场首回合凯瑟琳会积蓄一次爆裂攻击：此次攻击无视伤害限制效果和免疫伤害效果、造成的伤害提升150%且造成伤害值的100%恢复自身体力值，之后每经过3回合积蓄一次，当处于爆裂攻击还在积蓄的回合时自身受到的所有伤害（包括固定伤害和百分比伤害）减少25%（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>登场效果：\r
<indent=16><sprite=3><indent=32>登场首回合凯瑟琳触发<color=#FFF779>爆裂攻击</color>，然后每逢第3回合都触发爆裂攻击\r
\r
<indent=0><sprite=0><indent=16>常驻效果：\r
<indent=16><sprite=3><indent=32>未触发爆裂攻击的回合自身受到的<b>攻击伤害、固定伤害和百分比伤害</b><color=#64F9FA>减少</color>25% \r
\r
<indent=0><sprite=5><indent=15>爆裂攻击：\r
<indent=16><sprite=6><indent=32>使用的攻击技能：\r
<indent=32><sprite=4><indent=48><color=#64F9FA>无视</color><b>伤害限制效果</b>和<b>免疫伤害效果</b>\r
<indent=32><sprite=4><indent=48>造成的<b>攻击伤害</b><color=#64F9FA>提升</color>150%\r
<indent=32><sprite=4><indent=48>造成的攻击伤害100%额外<color=#64F9FA>恢复</color>至自身体力"""@zh ;
