seer:soulmark_2078 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4890 ;
    seer:analyzeDesc "[sprite name=dot4][color=#57c975]回合开始[/color]时，若自身体力高于最大体力的1/2，消耗高出的体力并获得等量[color=#57c975]护盾[/color]，若低于则消耗自身的[color=#57c975]护盾[/color]并恢复等量体力，最多恢复至自身最大体力的1/2|[sprite name=dot4][color=#57c975]回合结束时[/color]，若自身拥有[color=#57c975]护罩[/color]则获得等量[color=#57c975]护盾[/color]，若自身不拥有[color=#57c975]护罩[/color]则[color=#52a5f2]吸取[/color][color=#52a5f2]对手[/color]300点体力"@zh ;
    seer:desc "回合开始时，若自身体力高于最大体力的1/2，消耗高出的体力并获得等量护盾，若低于则消耗自身的护盾并恢复等量体力，最多恢复至自身最大体力的1/2|回合结束时，若自身拥有护罩则获得等量护盾，若自身不拥有护罩则吸取对手300点体力|（boss无效）"@zh ;
    seer:effectAlias "alias_2497_1_0" ;
