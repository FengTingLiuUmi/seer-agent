seer:soulmark_1707 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4493 ;
    seer:desc "每次登场时若对手处于冻伤状态则令对手害怕，若对手不处于冻伤状态则当回合战斗阶段结束时恢复自身最大体力的1/3；|自身每次下场后，己方下1只精灵登场时若对手处于冻伤状态则令登场精灵恢复自身最大体力的1/3，若对手不处于冻伤状态则对手当回合无法使用属性技能|（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>登场效果：\r
<indent=16><sprite=3><indent=32>每次登场时：\r
<indent=32><sprite=4><indent=48>若对手处于冻伤状态则<color=#64F9FA>令对手害怕</color>\r
<indent=32><sprite=4><indent=48>若对手不处于冻伤状态则当回合战斗阶段结束时<color=#64F9FA>恢复</color>自身最大体力的1/3\r
\r
<indent=0><sprite=0><indent=16>下场效果：\r
<indent=16><sprite=3><indent=32>自身每次下场后，己方下1只精灵登场时：\r
<indent=32><sprite=4><indent=48>若对手处于冻伤状态则令登场精灵<color=#64F9FA>恢复</color>自身最大体力的1/3\r
<indent=32><sprite=4><indent=48>若对手不处于冻伤状态则对手当回合<b>属性技能</b><color=#64F9FA>命中效果失效</color>"""@zh ;
