seer:soulmark_1664 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4450 ;
    seer:analyzeDesc "[sprite name=dot4]星解：逐界苍星每次[color=#57c975]登场[/color][color=#52a5f2]之后[/color][color=#52a5f2]对手[/color][color=#52a5f2]首次[/color]使用技能时，若[color=#52a5f2]对手[/color]不存在技能被[color=#f35555]解析[/color]则[color=#f35555]解析[/color]该技能并为自身附加1层[color=#f35555]未来奇点[/color]|[sprite name=dot4]星烁：[color=#57c975]回合开始时[/color]，逐界苍星根据自身[color=#f35555]未来奇点[/color][color=#52a5f2]达到[/color]的层数依次获得以下效果：|[sprite name=dot5]1层：[color=#52a5f2]当回合[/color][color=#52a5f2]对手[/color]的速度[color=#52a5f2]能力提升效果失效[/color]且自身计算[color=#52a5f2]攻击伤害[/color]时获得[color=#52a5f2]本系加成[/color]|[sprite name=dot5]2层：[color=#52a5f2]当回合[/color][color=#52a5f2]对手[/color]的[color=#52a5f2]护盾效果[/color]失效且自身使用技能不会消耗PP值|[sprite name=dot5]3层：[color=#52a5f2]当回合[/color][color=#52a5f2]对手的先制[/color]等级最高为3且自身[color=#57c975]使用技能后[/color]第五技能外所有技能恢复1点PP值|[sprite name=dot4]星辉：[color=#57c975]回合开始时[/color]，若自身速度值高于[color=#52a5f2]对手[/color]则[color=#52a5f2]当回合[/color]自身所有[color=#52a5f2]技能先制[/color]+1，若自身体力值高于[color=#52a5f2]对手[/color]则[color=#52a5f2]当回合[/color][color=#57c975]战斗阶段结束时[/color]自身[color=#52a5f2]全属性[/color]+1|[sprite name=dot4]星别：自身[color=#57c975]下场后[/color]解放所[color=#f35555]解析[/color]的技能，若为攻击技能则恢复自身1/3的最大体力，死亡[color=#57c975]下场时[/color]改为[color=#52a5f2]己方[/color]下只出场精灵体力等于最大体力的100%，若为属性技能则恢复自身所有技能1点PP值，死亡[color=#57c975]下场时[/color]改为[color=#52a5f2]己方[/color]下只出场精灵恢复全部PP值"@zh ;
    seer:desc "星解：逐界苍星每次登场之后对手首次使用技能时，若对手不存在技能被解析则解析该技能并为自身附加1层未来奇点|星烁：回合开始时，逐界苍星根据自身未来奇点达到的层数依次获得以下效果：|1层：当回合对手的速度能力提升效果失效且自身计算攻击伤害时获得本系加成|2层：当回合对手的护盾效果失效且自身使用技能不会消耗PP值|3层：当回合对手的先制等级最高为3且自身使用技能后第五技能外所有技能恢复1点PP值|星辉：回合开始时，若自身速度值高于对手则当回合自身所有技能先制+1，若自身体力值高于对手则当回合战斗阶段结束时自身全属性+1|星别：自身下场后解放所解析的技能，若为攻击技能则恢复自身1/3的最大体力，死亡下场时改为己方下只出场精灵体力等于最大体力的100%，若为属性技能则恢复自身所有技能1点PP值，死亡下场时改为己方下只出场精灵恢复全部PP值|（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>星解：\r
<indent=16><sprite=3><indent=32>逐界苍星每次登场对手首次使用技能命中前，若对手不存在技能被解析则<color=#64F9FA>解析</color>该技能并为自身<color=#64F9FA>附加</color>1层<color=#FFF779>未来奇点</color>\r
<indent=32><sprite=4><indent=48>被解析的技能<color=#64F9FA>无法选择</color>直到逐界苍星下场\r
\r
<indent=0><sprite=0><indent=16>星烁：\r
<indent=16><sprite=3><indent=32>未来奇点可以帮助逐界苍星<color=#64F9FA>免疫</color>所受到的<b>异常状态</b>，每次免疫成功后未来奇点移除1层\r
<indent=32><sprite=4><indent=48>最后1层未来奇点被移除时，<color=#64F9FA>消除</color>对手<b>回合类效果</b>与<b>能力提升状态</b>\r
<indent=16><sprite=3><indent=32>回合开始时逐界苍星根据自身未来奇点的层数获得累计的效果：\r
<indent=32><sprite=4><indent=48>1层：当回合对手的<b>速度</b><color=#64F9FA>能力提升效果失效</color>且自身计算攻击伤害时<color=#64F9FA>获得</color><b>本系属性加成</b>\r
<indent=32><sprite=4><indent=48>2层：当回合对手的<color=#64F9FA>护盾效果失效</color>且自身<color=#64F9FA>使用技能不会消耗PP值</color>\r
<indent=32><sprite=4><indent=48>3层：当回合对手的<b>先制</b>等级最高为3且自身使用技能后<color=#64F9FA>恢复</color>第五技能外所有技能<b>PP值</b>1点\r
\r
<indent=0><sprite=0><indent=16>星辉：\r
<indent=16><sprite=3><indent=32>回合开始时，若自身<b>速度值</b>高于对手则当回合自身所有技能<b>先制</b>+1\r
<indent=16><sprite=3><indent=32>回合开始时，若自身<b>体力值</b>高于对手则当回合战斗阶段结束时自身<color=#64F9FA>全属性+1</color>\r
\r
<indent=0><sprite=0><indent=16>星别：\r
<indent=16><sprite=3><indent=32>自身下场后解放所解析的技能\r
<indent=32><sprite=4><indent=48>若为攻击技能则<color=#64F9FA>恢复</color>自身1/3的最大体力，死亡下场时修改为己方下只出场精灵体力<color=#64F9FA>等于</color>最大体力的100%\r
<indent=32><sprite=4><indent=48>若为属性技能则<color=#64F9FA>恢复</color>自身所有技能1点PP值，死亡下场时修改为己方下只出场精灵<color=#64F9FA>恢复</color>全部<b>PP值</b>\r
\r
<indent=0><sprite=5><indent=15>未来奇点（上限3层，下场保留）：\r
<indent=16><sprite=6><indent=32>逐界苍星用以触发额外效果的条件"""@zh ;
    seer:effectAlias "alias_2041_1_3_1_3_1_1_1" ;
    seer:intensified false ;
    seer:isAdv false ;
    seer:pveEffective false ;
    seer:seerapiId "1664" ;
    seer:soulmarkEffect "{\"effect\": {\"id\": 2041, \"url\": \"https://api.seerapi.com/v1/eid_effect/2041\"}, \"effect_args\": [1, 3, 1, 3, 1, 1, 1]}" ;
    seer:soulmarkTag seer:soulmark_tag_10,
        seer:soulmark_tag_19,
        seer:soulmark_tag_5 ;
    seer:sourceUrl "https://api.seerapi.com/v1/soulmark/1664" .

seer:soulmark_1665 a seer:Soulmark,
