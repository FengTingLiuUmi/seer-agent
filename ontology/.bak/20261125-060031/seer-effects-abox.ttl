seer:soulmark_1767 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4557 ;
    seer:desc "自身选择攻击技能的回合，每次受到固定伤害、百分比伤害后对手随机1个技能PP-2；自身选择属性技能的回合，每次受到固定伤害、百分比伤害后对手随机1项能力等级-1；战斗阶段结束时若自身体力为满则2回合内免疫受到的异常状态，若不为满则下回合所有技能先制+1（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>触发效果：\r
