seer:soulmark_1828 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4621 ;
    seer:desc "回合开始时若自身体力低于对手，则当回合50%闪避对手的攻击且攻击技能先制+1；自身使用攻击技能时，若当回合自身未受到攻击伤害则造成伤害提升100%，若当回合自身受到了攻击伤害则吸取对手最大体力的1/3（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时若自身体力低于对手，则50%<color=#64F9FA>闪避</color>对手的攻击且当回合攻击技能<b>先制</b>+1\r
\r
<indent=0><sprite=0><indent=16>攻击技能额外效果：\r
<indent=16><sprite=3><indent=32>自身使用攻击技能时：\r
<indent=32><sprite=4><indent=48>若当回合自身未受到攻击伤害则造成伤害<color=#64F9FA>提升</color>100%\r
<indent=32><sprite=4><indent=48>若当回合自身受到了攻击伤害则<color=#64F9FA>吸取</color>对手最大体力的1/3"""@zh ;
