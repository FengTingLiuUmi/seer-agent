seer:soulmark_1429 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4210 ;
    seer:desc "自身技能命中后或对手技能命中后均会触发命运之轮，随机获得其中1种命运之轮效果：|己方命运之轮：①随机3项属性+1、②获得200点护盾和200点护罩、③随机恢复200-400点体力值；|敌方命运之轮：①随机3项属性-1、②100%进入失神状态、③随机附加200-400点固定伤害|（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>触发效果：\r
<indent=16><sprite=3><indent=32>自身技能命中后会触发命运之轮，随机获得以下1种效果：\r
