seer:soulmark_1579 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4355 ;
    seer:analyzeDesc "[sprite name=dot4]自身不处于[color=#52a5f2]能力提升状态[/color]时100%[color=#57c975]闪避[/color][color=#52a5f2]对手[/color]攻击且[color=#57c975]战斗阶段结束时[/color]触发[color=#f35555]诫罚之刻[/color]，[color=#52a5f2]对手[/color]使用攻击技能时提前触发|[sprite name=dot4]自身体力低于最大体力的1/2时所有[color=#52a5f2]技能先制[/color]+2且[color=#57c975]战斗阶段结束时[/color]触发[color=#f35555]宽恕之刻[/color]，[color=#52a5f2]对手[/color]攻击技能命中时提前触发"@zh ;
    seer:desc "自身不处于能力提升状态时100%闪避对手攻击且战斗阶段结束时触发诫罚之刻，对手使用攻击技能时提前触发|自身体力低于最大体力的1/2时所有技能先制+2且战斗阶段结束时触发宽恕之刻，对手攻击技能命中时提前触发|（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>常驻效果：\r
<indent=16><sprite=3><indent=32>自身不处于能力提升状态时100%<color=#64F9FA>闪避</color>对手<b>攻击技能</b>且战斗阶段结束时触发<color=#FFF779>诫罚之刻</color>\r
<indent=32><sprite=4><indent=48>对手使用攻击技能时提前触发\r
<indent=16><sprite=3><indent=32>自身体力低于1/2时所有技能<b>先制</b>+2且战斗阶段结束时触发<color=#FFF779>宽恕之刻</color>\r
<indent=32><sprite=4><indent=48>对手攻击技能命中时提前触发\r
\r
<indent=0><sprite=5><indent=15>诫罚之刻：\r
<indent=16><sprite=6><indent=32><color=#64F9FA>消除</color>并获得对手的<b>护盾、护罩</b>\r
<indent=16><sprite=6><indent=32>若对手处于能力提升状态则令对手双防-2，若对手免疫能力下降则<color=#64F9FA>消除</color>对手<b>能力提升状态</b>\r
<indent=32><sprite=4><indent=48>消除成功则1回合内对手攻击、特攻值变为0\r
\r
<indent=0><sprite=5><indent=15>宽恕之刻：\r
<indent=16><sprite=6><indent=32><color=#64F9FA>恢复</color>自身最大体力的1/3\r
<indent=32><sprite=4><indent=48>若自身处于异常状态则恢复效果翻倍且<color=#64F9FA>解除</color>所处的疲惫、害怕状态"""@zh ;
    seer:effectAlias "alias_1940_100_2_2_1" ;
