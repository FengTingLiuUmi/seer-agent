seer:soulmark_694 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_3378 ;
    seer:desc "登场时使对手当回合属性技能失效且下回合攻击技能无效（每场战斗触发2次，首次出场触发1次，再次上场时触发第2次，boss无效）；登场后首回合若对手使用攻击技能则使自身下1次造成的伤害提高100%，若对手使用属性技能则附加对手最大体力1/3的百分比伤害并恢复等量体力，同时每次战斗阶段结束时使自身本场战斗中造成的伤害提高30%，最高提高150%（下场时保留提升效果，boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>限定效果（每场战斗限2次）：\r
<indent=16><sprite=3><indent=32>登场时使对手当回合<b>属性技能</b><color=#64F9FA>无效</color>且下回合<b>攻击技能</b><color=#64F9FA>无效</color>\r
\r
<indent=0><sprite=0><indent=16>登场效果：\r
<indent=16><sprite=3><indent=32>登场后首回合：\r
<indent=32><sprite=4><indent=48>若对手使用攻击技能则使自身下1次造成的伤害<color=#64F9FA>提升</color>100%\r
<indent=32><sprite=4><indent=48>若对手使用属性技能则<color=#64F9FA>附加</color>对手最大体力1/3的<b>百分比伤害</b>并恢复等量体力\r
\r
<indent=0><sprite=0><indent=16>战阶结束效果：\r
<indent=16><sprite=3><indent=32>战斗阶段结束时使自身本场战斗中造成的伤害<color=#64F9FA>提升</color>30%，最高提升150%（下场保留）"""@zh ;
