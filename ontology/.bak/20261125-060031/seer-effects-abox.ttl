        seer:soulmark_tag_13,
        seer:soulmark_tag_4 ;
    seer:sourceUrl "https://api.seerapi.com/v1/soulmark/1946" .

seer:soulmark_1947 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4744 ;
    seer:desc "自身登场的当回合战斗阶段结束时触发一次入梦，之后每间隔3回合战斗阶段结束时额外进行一次入梦：50%令对手睡眠，触发成功则自身下1次使用攻击技能时消除对手能力提升状态效果，下1次使用属性技能时消除对手回合类效果，免疫下1次受到的异常状态，未触发则本次在场此效果的触发间隔减少1回合，并将首条未修改过的触发成功效果修改为每回合开始触发|自身的入梦间隔为0回合时，自身使用技能不受PP值限制且无视攻击免疫效果|（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>登场效果：\r
<indent=16><sprite=3><indent=32>自身登场的当回合战斗阶段结束时触发一次入梦，之后每间隔3回合战斗阶段结束时额外进行一次入梦：50%<color=#64F9FA>令对手睡眠</color>\r
<indent=32><sprite=4><indent=48>触发成功则自身：\r
<indent=32><sprite=4><sprite=4><indent=64>下1次使用攻击技能时<color=#64F9FA>消除</color>对手<b>能力提升状态</b>\r
<indent=32><sprite=4><sprite=4><indent=64>下1次使用属性技能时<color=#64F9FA>消除</color>对手<b>回合类效果</b>\r
<indent=32><sprite=4><sprite=4><indent=64><color=#64F9FA>免疫</color>下1次受到的<b>异常状态</b>\r
<indent=32><sprite=4><indent=48>未触发则自身本次在场：\r
<indent=32><sprite=4><sprite=4><indent=64>入梦的触发间隔减少1回合\r
<indent=32><sprite=4><sprite=4><indent=64>将入梦首条未修改过的触发成功效果修改为每回合开始触发\r
\r
<indent=0><sprite=0><indent=16>触发效果：\r
<indent=16><sprite=3><indent=32>自身的入梦间隔为0回合后，自身技能<color=#64F9FA>不受PP值限制</color>且<color=#64F9FA>无视攻击免疫效果</color>"""@zh ;
    seer:effectAlias "alias_2360_3_50_1_1_1_1_0_1" ;
