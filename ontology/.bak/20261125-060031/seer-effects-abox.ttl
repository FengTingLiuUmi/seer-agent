seer:soulmark_410 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_3056 ;
    seer:analyzeDesc "[sprite name=dot4]自身于战斗阶段内受到[color=#52a5f2]致死伤害[/color]且死亡时，若自身的等级为100级，则附加等同于自身[color=#52a5f2]当回合[/color]所受技能伤害的[color=#52a5f2]真实伤害[/color]，[color=#52a5f2]然后[/color]若[color=#52a5f2]对手[/color]的体力为0则自身主动恢复1点体力|[sprite name=dot1]自身使用技能[color=#52a5f2]之后[/color]，每[color=#57c975]回合结束后[/color]恢复自身最大体力的1/3"@zh ;
    seer:desc "自身于战斗阶段内受到致死伤害且死亡时，若自身的等级为100级，则附加等同于自身当回合所受技能伤害的真实伤害，然后若对手的体力为0则自身主动恢复1点体力|自身使用技能之后，每回合结束后恢复自身最大体力的1/3（boss有效）|（标注部分boss有效，其余无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>限定效果（限100级触发）：\r
<indent=16><sprite=3><indent=32>自身于战斗阶段内死亡时，<color=#64F9FA>附加</color>等同于该伤害数值的<b>真实伤害</b>\r
<indent=32><sprite=4><indent=48>造成致死伤害时，自身<color=#64F9FA>恢复</color>1点<b>体力</b>\r
\r
<indent=0><sprite=0><indent=16>回合结束效果（boss有效）：\r
<indent=16><sprite=3><indent=32>自身出手后，本次在场每回合结束后<color=#64F9FA>恢复</color>自身最大体力的1/3"""@zh ;
    seer:effectAlias "alias_736_1_3" ;
    seer:intensified false ;
    seer:isAdv false ;
    seer:pveEffective true ;
    seer:seerapiId "410" ;
    seer:soulmarkEffect "{\"effect\": {\"id\": 736, \"url\": \"https://api.seerapi.com/v1/eid_effect/736\"}, \"effect_args\": [1, 3]}" ;
    seer:soulmarkTag seer:soulmark_tag_6 ;
    seer:sourceUrl "https://api.seerapi.com/v1/soulmark/410" .

