seer:soulmark_2031 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_3915 ;
    seer:derivedFrom seer:soulmark_1238 ;
    seer:desc "每回合开始时为自身附加350点护盾；战斗阶段结束时，若自身存在护盾则下回合攻击技能必定打出致命一击且吸取对手最大体力的1/3，造成的攻击伤害为0时额外令对手焚烬，若自身不存在护盾则100%令对手焚烬且下回合开始时附加的护盾改为450点（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时为自身<color=#64F9FA>附加</color>350点<b>护盾</b>\r
\r
<indent=0><sprite=0><indent=16>战阶结束效果：\r
<indent=16><sprite=3><indent=32>战斗阶段结束时：\r
<indent=32><sprite=4><indent=48>若自身存在护盾则下回合攻击技能必定<color=#64F9FA>打出致命一击</color>且攻击后<color=#64F9FA>吸取</color>对手最大体力的1/3\r
<indent=32><sprite=4><sprite=4><indent=64>若造成的攻击伤害为0则额外<color=#64F9FA>令对手焚烬</color>\r
<indent=32><sprite=4><indent=48>若自身不存在护盾则100%<color=#64F9FA>令对手焚烬</color>且上述回合开始效果在下回合改为<color=#64F9FA>附加</color>450点<b>护盾</b>"""@zh ;
