seer:soulmark_1956 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4752 ;
    seer:desc "自身使用攻击技能时令对手冻伤，若对手处于冻伤则改为令对手所处冻伤回合数+2；战斗阶段结束时，若对手所处的冻伤回合数达到5，下回合所有技能附加对手最大体力1/1的百分比伤害，若对手所处的冻伤回合数小于5，则恢复自身最大体力的1/3且下回合攻击技能必定打出致命一击（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>攻击技能额外效果：\r
<indent=16><sprite=3><indent=32>自身使用攻击技能时<color=#64F9FA>令对手冻伤</color>\r
<indent=32><sprite=4><indent=48>若对手处于冻伤则改为令对手所处冻伤回合数+2\r
\r
<indent=0><sprite=0><indent=16>战阶结束效果：\r
<indent=16><sprite=3><indent=32>战斗阶段结束时：\r
<indent=32><sprite=4><indent=48>若对手所处的冻伤回合数达到5，下回合<b>所有技能</b><color=#64F9FA>附加</color>对手最大体力1/1的<b>百分比伤害</b>\r
<indent=32><sprite=4><indent=48>若对手所处的冻伤回合数小于5，则<color=#64F9FA>恢复</color>自身最大体力的1/3且下回合<b>攻击技能</b>必定<color=#64F9FA>打出致命一击</color>"""@zh ;
