seer:soulmark_976 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_3697 ;
    seer:desc "所有对于速度的强化同时应用于体力（刻印，学习力）；自身背包内每死亡一只精灵则自身技能先制+1，最高先制+5；回合开始时，若自身体力高于对手则当回合免疫异常状态且50%使对手全属性-1，若自身体力低于对手则当回合受到的伤害减少50%（包括攻击伤害和固定伤害）且100%使对手全属性-1（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>常驻效果：\r
<indent=16><sprite=3><indent=32>刻印、学习力对于速度的强化同时应用于体力\r
<indent=16><sprite=3><indent=32>自身背包内每有一只精灵阵亡则自身技能<b>先制</b>+1，最高先制+5\r
\r
<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时，若自身体力高于对手则当回合<color=#64F9FA>免疫</color>受到的<b>异常状态</b>且50%使对手<color=#64F9FA>全属性-1</color>\r
<indent=16><sprite=3><indent=32>回合开始时，若自身体力低于对手则当回合受到的<b>攻击伤害、固定伤害</b><color=#64F9FA>减少</color>50%且100%使对手<color=#64F9FA>全属性-1</color>"""@zh ;
