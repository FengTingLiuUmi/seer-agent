seer:soulmark_1281 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4023 ;
    seer:desc "回合开始时，若自身未满体力则战斗阶段结束时令自身防御、特防+1；自身当回合使用属性技能则下回合令对手无法通过自身技能恢复体力，自身连续2回合使用属性技能则下回合额外攻击打出致命一击，自身连续3回合以上使用属性技能则下回合额外免疫受到的对手攻击伤害（boss无效）"@zh ;
