seer:soulmark_1582 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4356 ;
    seer:desc "战斗阶段结束时若对手处于异常状态则{吸取}对手300点{体力}，自身处于异常状态时额外{吸取}100点{体力}且令对手随机1个技能PP值归零；|回合开始时若对手不处于异常状态则当回合受到的固定伤害和百分比伤害提升20%，自身体力低于对手时额外提升10%且令自身防御+1、特防+1（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>战阶结束效果：\r
<indent=16><sprite=3><indent=32>战斗阶段结束时若对手处于异常状态则<color=#64F9FA>吸取</color>对手300点<b>体力</b>\r
<indent=32><sprite=4><indent=48>自身处于异常状态时额外吸取100点<b>体力</b>且令对手随机1个技能<b>PP值</b><color=#64F9FA>归零</color>\r
\r
