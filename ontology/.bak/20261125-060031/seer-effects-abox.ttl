        seer:soulmark_tag_5,
        seer:soulmark_tag_6 ;
    seer:sourceUrl "https://api.seerapi.com/v1/soulmark/1847" .

seer:soulmark_1848 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4648 ;
    seer:analyzeDesc "[sprite name=dot1]每次[color=#57c975]登场时[/color]，若自身为[color=#52a5f2]对手[/color]天敌则为[color=#52a5f2]对手[/color]附加3回合的[color=#f35555]星海之浸[/color]；自身每次使用攻击后附加3回合的[color=#f35555]星海之浸[/color]|[sprite name=dot1]自身所有技能必定打出[color=#52a5f2]致命一击[/color]；每场战斗限1次，自身受到[color=#52a5f2]致死伤害[/color]时，若自身的等级为100则消除[color=#52a5f2]对手[/color][color=#52a5f2]能力提升状态[/color]、[color=#52a5f2]回合类效果[/color]并恢复全部体力值、PP值，[color=#52a5f2]然后[/color]获得等同于自身体力值的[color=#57c975]护盾[/color]、[color=#57c975]护罩[/color]"@zh ;
    seer:desc "每次登场时，若自身为对手天敌则为对手附加3回合的星海之浸；自身每次使用攻击后附加3回合的星海之浸|自身所有技能必定打出致命一击；每场战斗限1次，自身受到致死伤害时，若自身的等级为100则消除对手能力提升状态、回合类效果并恢复全部体力值、PP值，然后获得等同于自身体力值的护盾、护罩|（boss有效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>登场效果：\r
<indent=16><sprite=3><indent=32>每次登场时，若自身为对手天敌则为对手附加3回合的<color=#FFF779>星海之浸</color>\r
\r
<indent=0><sprite=0><indent=16>攻击技能额外效果：\r
<indent=16><sprite=3><indent=32>自身每次使用攻击后附加3回合的星海之浸\r
\r
<indent=0><sprite=0><indent=16>常驻效果：\r
<indent=16><sprite=3><indent=32>自身所有技能<color=#64F9FA>必定打出致命一击</color>\r
\r
<indent=0><sprite=0><indent=16>限定效果（限100级触发，每场战斗限1次）：\r
<indent=16><sprite=3><indent=32>自身受到致死伤害时，<color=#64F9FA>消除</color>对手能力提升状态、回合类效果并<color=#64F9FA>恢复</color>全部体力值、PP值，然后<color=#64F9FA>获得</color>等同于自身体力值的<b>护盾、护罩</b>\r
\r
<indent=0><sprite=5><indent=15>星海之浸：\r
<indent=16><sprite=6><indent=32>使用的<b>属性技能</b><color=#64F9FA>无效</color>\r
<indent=16><sprite=6><indent=32>每次受到攻击伤害后，额外受到伤害值50%的百分比伤害\r
<indent=32><sprite=4><indent=48>若对手为草系，星海之浸消失，并额外附加伤害值100%的真实伤害"""@zh ;
