seer:soulmark_1961 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_3887 ;
    seer:derivedFrom seer:soulmark_1156 ;
    seer:desc "回合开始时若对手处于异常状态则当回合自身造成的伤害提升100%；自身使用攻击时有70%几率令对手焚烬，未触发则自身下回合攻击必定致命一击；自身受到攻击时有100%几率令对手烧伤，未触发则战斗阶段结束时附加自身最大体力的1/3的百分比伤害（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时若对手处于异常状态则当回合自身造成的<b>攻击伤害</b><color=#64F9FA>提升</color>100%\r
\r
<indent=0><sprite=0><indent=16>触发效果：\r
<indent=16><sprite=3><indent=32>自身使用攻击时70%<color=#64F9FA>令对手焚烬</color>\r
<indent=32><sprite=4><indent=48>未触发则自身下回合攻击必定<color=#64F9FA>打出致命一击</color>\r
<indent=16><sprite=3><indent=32>自身受到攻击时100%<color=#64F9FA>令对手烧伤</color>\r
<indent=32><sprite=4><indent=48>未触发则战斗阶段结束时<color=#64F9FA>附加</color>自身最大体力的1/3的<b>百分比伤害</b>"""@zh ;
