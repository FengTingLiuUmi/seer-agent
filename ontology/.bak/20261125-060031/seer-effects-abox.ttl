seer:soulmark_2034 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4843 ;
    seer:desc "自身使用物理攻击时2回合内所有技能先制+2，使用特殊攻击时附加对手最大体力1/3的百分比伤害，使用属性技能时1回合内抵挡受到的攻击；击败对手后，自身下1次使用技能时以上效果全部触发（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>触发效果：\r
<indent=16><sprite=3><indent=32>自身使用物理攻击时2回合内所有技能<b>先制</b>+2\r
<indent=16><sprite=3><indent=32>自身使用特殊攻击时<color=#64F9FA>附加</color>对手最大体力1/3的<b>百分比伤害</b>\r
<indent=16><sprite=3><indent=32>自身使用属性技能时1回合内<color=#64F9FA>抵挡</color>受到的<b>攻击</b>\r
\r
<indent=0><sprite=0><indent=16>击败效果：\r
<indent=16><sprite=3><indent=32>击败对手后，自身下1次使用技能时上述触发效果全部触发"""@zh ;
