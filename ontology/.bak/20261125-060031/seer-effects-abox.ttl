seer:soulmark_1852 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4359 ;
    seer:derivedFrom seer:soulmark_1584 ;
    seer:desc "自身每次使用攻击技能则获得等同于对手上1次使用的攻击技能威力的提升，自身每次使用属性技能则令对手下回合无法使用属性技能|回合开始时对手每有1个技能PP值≤3则令自身所有技能额外先制+1，战斗阶段结束时若自身体力低于对手则吸取对手所有技能PP值1点（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>技能额外效果：\r
<indent=16><sprite=3><indent=32>自身每次使用攻击技能则获得等同于对手上1次使用的攻击技能<b>威力</b>的<color=#64F9FA>提升</color>\r
<indent=16><sprite=3><indent=32>自身每次使用属性技能则令对手下回合<b>属性技能<color=#64F9FA></b>命中效果失效</color>\r
