seer:soulmark_1608 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4389 ;
    seer:desc "自身每次出手时若当回合未受到攻击伤害则造成的攻击伤害提升100%，若当回合受到攻击伤害则为自身附加300点护盾（护盾无法叠加），护盾消失时恢复自身最大体力的1/3并造成等量百分比伤害；|战斗阶段结束时若自身体力低于对手则令对手速度-2、命中-2（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>触发效果：\r
<indent=16><sprite=3><indent=32>自身每次出手时：\r
<indent=32><sprite=4><indent=48>若当回合未受到攻击伤害则造成的<b>攻击伤害<color=#64F9FA></b>提升</color>100%\r
<indent=32><sprite=4><indent=48>若当回合受到攻击伤害则<color=#64F9FA>获得</color>300点<b>护盾</b>\r
<indent=32><sprite=4><sprite=4><indent=64>护盾消失时<color=#64F9FA>恢复</color>自身最大体力的1/3并造成等量<b>百分比伤害</b>\r
\r
<indent=0><sprite=0><indent=16>战阶结束效果：\r
<indent=16><sprite=3><indent=32>战斗阶段结束时若自身体力低于对手则令对手速度-2、命中-2"""@zh ;
