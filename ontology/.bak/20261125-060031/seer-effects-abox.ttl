seer:soulmark_1669 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4455 ;
    seer:desc "回合开始时若对手处于全属性下降状态则100%令对手焚烬，未触发则令对手当回合使用的属性技能无效；战斗阶段结束时为自身附加300点护罩，若自身已拥有护罩则额外令对手防御-2、特防-2（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时若对手处于全属性下降状态则100%<color=#64F9FA>令对手焚烬</color>\r
