seer:soulmark_1320 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4075 ;
    seer:desc "自身使用技能后吸取对手能力提升状态，之后将自身相应的能力提升状态赋予给对手相应的能力下降状态，若对手免疫则{吸取}对手最大{体力}1/3且令对手随机1项技能PP值归零；|回合开始时，自身每处于1种能力提升状态则战斗阶段结束时恢复60点体力，对手每处于1种能力下降状态则战斗阶段结束时损失60点体力（boss无效）"@zh ;
