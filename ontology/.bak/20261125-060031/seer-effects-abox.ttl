seer:soulmark_2168 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4969 ;
    seer:analyzeDesc "[sprite name=dot4][color=#57c975]战斗阶段结束时[/color]，若自身体力低于对手，则下回合所有[color=#52a5f2]技能先制[/color]+1，若自身体力高于对手，则100%令对手[color=#57c975]束缚[/color]|[sprite name=dot4]自身每次先出手后，本场战斗造成的[color=#52a5f2]攻击伤害[/color]提升25%，最高叠加至100%；对手每次先出手后，本次在场自身25%[color=#57c975]闪避[/color]对手的攻击，最高叠加至100%|[sprite name=dot4][color=#57c975]回合结束后[/color]，若[color=#52a5f2]当回合[/color]自身未受到[color=#52a5f2]攻击伤害[/color]，则恢复最大体力的1/3|[sprite name=dot4]自身主动下场时，[color=#52a5f2]己方[/color]获得2顶[color=#f35555]帽子[/color]"@zh ;
    seer:desc "战斗阶段结束时，若自身体力低于对手，则下回合所有技能先制+1，若自身体力高于对手，则100%令对手束缚|自身每次先出手后，本场战斗造成的攻击伤害提升25%，最高叠加至100%；对手每次先出手后，本次在场自身25%闪避对手的攻击，最高叠加至100%|回合结束后，若当回合自身未受到攻击伤害，则恢复最大体力的1/3|自身主动下场时，己方获得2顶帽子|（boss无效）"@zh ;
