        owl:NamedIndividual ;
    seer:affectsPet seer:pet_3954 ;
    seer:analyzeDesc "[sprite name=dot4][color=#57c975]回合开始时[/color]，若[color=#52a5f2]对手[/color]不处于[color=#52a5f2]能力提升状态[/color]则[color=#52a5f2]当回合[/color]自身攻击技能必定打出[color=#52a5f2]致命一击[/color]，若[color=#52a5f2]对手[/color]处于[color=#52a5f2]能力提升状态[/color]则消除[color=#52a5f2]对手[/color][color=#52a5f2]能力提升状态[/color]，消除成功则令[color=#52a5f2]对手[/color][color=#57c975]烧伤[/color]|[sprite name=dot4][color=#57c975]战斗阶段结束时[/color]，若双方任意一方处于[color=#52a5f2]异常状态[/color]则减少[color=#52a5f2]对手[/color]所有技能2点PP值"@zh ;
    seer:desc "回合开始时，若对手不处于能力提升状态则当回合自身攻击技能必定打出致命一击，若对手处于能力提升状态则消除对手能力提升状态，消除成功则令对手烧伤|战斗阶段结束时，若双方任意一方处于异常状态则减少对手所有技能2点PP值|（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时：\r
<indent=32><sprite=4><indent=48>若对手处于能力提升状态则<color=#64F9FA>消除</color>对手<b>能力提升状态</b>\r
<indent=32><sprite=4><sprite=4><indent=64>消除成功则100%<color=#64F9FA>令对手烧伤</color>\r
<indent=32><sprite=4><indent=48>若对手不处于能力提升状态则当回合自身攻击100%<color=#64F9FA>打出致命一击</color>\r
\r
<indent=0><sprite=0><indent=16>战阶结束效果：\r
<indent=16><sprite=3><indent=32>战斗阶段结束时，敌我双方任意一方处于异常状态则100%令对手所有技能<b>PP值</b>-2"""@zh ;
