seer:soulmark_1836 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4629 ;
    seer:desc "回合结束后，使自身所有技能的PP值分别随机变化为1~5中的一个值，然后自身PP值唯一最高的技能下回合获得霜棘效果，若没有唯一最高则下回合自身受到的攻击伤害减少25%|自身1号位的技能固有霜棘效果，对手的技能结束时若自身体力为0且1号位的固有霜棘效果存在则保留1点体力，解除自身所处异常状态且直到战斗结束失去1号位的固有霜棘效果|霜棘：先制+1、必定命中且无视攻击免疫效果、伤害限制效果，使用后对手冻伤，未触发则对手束缚，霜棘效果无法叠加（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>回合结束效果：\r
<indent=16><sprite=3><indent=32>回合结束后，使自身所有技能的<b>PP值</b>分别随机<color=#64F9FA>变化</color>为1~5中的一个值\r
<indent=32><sprite=4><indent=48>然后自身PP值<b>唯一最高</b>的技能下回合获得<color=#FFF779>霜棘</color>效果\r
<indent=32><sprite=4><sprite=4><indent=64>若没有唯一最高则下回合自身受到的<b>攻击伤害<color=#64F9FA></b>减少</color>25%,\r
\r
<indent=0><sprite=0><indent=16>限定效果：\r
<indent=16><sprite=3><indent=32>自身1号位的技能固有霜棘效果\r
<indent=16><sprite=3><indent=32>对手的技能结束后，若自身体力为0且1号位的固有霜棘效果仍然存在则：\r
<indent=32><sprite=4><indent=48>失去1号位的固有霜棘效果直到战斗结束\r
<indent=32><sprite=4><indent=48><color=#64F9FA>解除</color>自身所处<b>异常状态</b>并<color=#64F9FA>保留</color>1点<b>体力</b>\r
\r
<indent=0><sprite=5><indent=15>霜棘：\r
<indent=16><sprite=6><indent=32>携带霜棘效果的技能受到以下影响（无法叠加）：\r
<indent=32><sprite=4><indent=48><b>先制</b>+1\r
<indent=32><sprite=4><indent=48><color=#64F9FA>必定命中</color>且<color=#64F9FA>无视</color><b>攻击免疫效果</b>、<b>伤害限制效果</b>\r
<indent=32><sprite=4><indent=48>使用后对手冻伤，未触发则对手束缚"""@zh ;
    seer:effectAlias "alias_2230_1_0" ;
    seer:intensified false ;
    seer:isAdv false ;
    seer:pveEffective false ;
    seer:seerapiId "1836" ;
    seer:soulmarkEffect "{\"effect\": {\"id\": 2230, \"url\": \"https://api.seerapi.com/v1/eid_effect/2230\"}, \"effect_args\": [1, 0]}" ;
    seer:soulmarkTag seer:soulmark_tag_10,
