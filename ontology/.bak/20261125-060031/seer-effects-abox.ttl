seer:soulmark_1974 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4763 ;
    seer:desc "回合开始时，若对手处于异常状态则自身恢复全部PP值并令对手第五技能PP值归0，对手的第五技能PP值为0时额外令对手害怕；自身被击败时100%令对手害怕，未触发则消除对手回合类效果（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时若对手处于异常状态则自身<color=#64F9FA>恢复</color>全部<b>PP值</b>并令对手第五技能<b>PP值</b><color=#64F9FA>归0</color>\r
<indent=32><sprite=4><indent=48>对手的第五技能PP值为0时额外<color=#64F9FA>令对手害怕</color>\r
\r
<indent=0><sprite=0><indent=16>被击败效果：\r
<indent=16><sprite=3><indent=32>自身被击败时100%<color=#64F9FA>令对手害怕</color>\r
<indent=32><sprite=4><indent=48>未触发则<color=#64F9FA>消除</color>对手<b>回合类效果</b>"""@zh ;
    seer:effectAlias "alias_2387_0_100_1" ;
