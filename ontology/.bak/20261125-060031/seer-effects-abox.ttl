seer:soulmark_1391 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4166 ;
    seer:desc "回合开始时，若对手处于冻伤状态则当回合令对手无法进行能力提升且自身攻击命中后{吸取}对手最大{体力}的1/3；自身攻击造成的伤害低于300则下回合攻击造成的伤害进行提升，造成的伤害越低则提升的伤害越高（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时，若对手处于冻伤状态则当回合令对手<color=#64F9FA>无法进行能力提升</color>且自身攻击命中后<color=#64F9FA>吸取</color>对手最大体力的1/3\r
\r
