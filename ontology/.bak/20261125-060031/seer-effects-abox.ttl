seer:soulmark_1006 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_3648 ;
    seer:desc "每回合有50%的概率令自身攻击技能先制+1，未触发则下回合概率翻倍；回合开始时有一定概率令自身当回合免疫异常状态，概率等同自身当前体力百分比；战斗阶段结束时有一定概率令对手害怕，概率等同自身已损失体力的百分比（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>触发效果：\r
<indent=16><sprite=3><indent=32>每回合50%令自身攻击技能<b>先制</b>+1\r
<indent=32><sprite=4><indent=48>未触发则下回合概率翻倍\r
\r
<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时有一定概率令自身当回合<color=#64F9FA>免疫</color>受到的<b>异常状态</b>，概率等同自身当前体力百分比\r
\r
<indent=0><sprite=0><indent=16>战阶结束效果：\r
<indent=16><sprite=3><indent=32>战斗阶段结束时有一定概率<color=#64F9FA>令对手害怕</color>，概率等同自身已损失体力的百分比"""@zh ;
