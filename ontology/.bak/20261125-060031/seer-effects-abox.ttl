    seer:affectsPet seer:pet_4879 ;
    seer:analyzeDesc "[sprite name=dot4]自身[color=#52a5f2]登场[/color][color=#52a5f2]当回合[/color][color=#57c975]受到攻击后[/color]将对手的系别变为虫系，对手本次在场累计造成的[color=#52a5f2]攻击伤害[/color]超过自身体力上限时恢复其系别|[sprite name=dot4]对手使用与其系别相同的攻击技能对自身造成的[color=#52a5f2]攻击伤害[/color]不超过300点，对手使用与其系别不同的攻击技能对自身造成的伤害高于300时消除对手能力提升状态，低于300时消除对手[color=#52a5f2]回合类效果[/color]"@zh ;
