    seer:desc "战斗阶段结束时随机恢复自身150-300点体力；首次登场令自身首回合受到的攻击伤害转化为自身体力（boss有效，每场战斗仅触发1次）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>战阶结束效果：\r
<indent=16><sprite=3><indent=32>战斗阶段结束时随机<color=#64F9FA>恢复</color>自身150-300点<b>体力</b>\r
\r
<indent=0><sprite=0><indent=16>登场效果：\r
<indent=16><sprite=3><indent=32>首次登场时1回合内将自身受到的<b>攻击伤害</b><color=#64F9FA>转化</color>为体力恢复"""@zh ;
    seer:effectAlias "alias_1298_150_300" ;
    seer:intensified false ;
    seer:isAdv false ;
    seer:pveEffective true ;
