seer:soulmark_959 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_3673 ;
    seer:analyzeDesc "[sprite name=dot4]常之罚：自身先出手时[color=#52a5f2]当回合[/color]自身造成的[color=#52a5f2]攻击伤害[/color]提升50%，[color=#52a5f2]对手[/color]先出手时[color=#52a5f2]当回合[/color]自身受到的[color=#52a5f2]攻击伤害[/color]减少50%|[sprite name=dot4]常之劫：[color=#57c975]回合开始时[/color]，若[color=#52a5f2]对手[/color]处于[color=#52a5f2]能力提升状态[/color]则消除[color=#52a5f2]对手[/color][color=#52a5f2]能力提升状态[/color]，消除成功则令[color=#52a5f2]对手[/color][color=#57c975]睡眠[/color]，若[color=#52a5f2]对手[/color]不处于[color=#52a5f2]能力提升状态[/color]则[color=#52a5f2]当回合[/color]自身所有[color=#52a5f2]技能先制[/color]+1；|[sprite name=dot4]常之惩：[color=#57c975]战斗阶段结束时[/color]，若自身体力为0，则消除[color=#52a5f2]对手[/color][color=#52a5f2]回合类效果[/color]和[color=#52a5f2]能力提升状态[/color]，消除任意一项成功则令[color=#52a5f2]对手[/color][color=#57c975]睡眠[/color]"@zh ;
    seer:desc "常之罚：自身先出手时当回合自身造成的攻击伤害提升50%，对手先出手时当回合自身受到的攻击伤害减少50%|常之劫：回合开始时，若对手处于能力提升状态则消除对手能力提升状态，消除成功则令对手睡眠，若对手不处于能力提升状态则当回合自身所有技能先制+1；|常之惩：战斗阶段结束时，若自身体力为0，则消除对手回合类效果和能力提升状态，消除任意一项成功则令对手睡眠|（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>常之罚：\r
<indent=16><sprite=3><indent=32>自身先出手时当回合我方造成的<b>攻击伤害</b><color=#64F9FA>提升</color>50%\r
<indent=16><sprite=3><indent=32>对手先出手时当回合我方受到的<b>攻击伤害</b><color=#64F9FA>减少</color>50%\r
\r
<indent=0><sprite=0><indent=16>常之劫：\r
<indent=16><sprite=3><indent=32>回合开始时：\r
<indent=32><sprite=4><indent=48>若对手不处于能力提升状态则当回合自身所有技能<b>先制</b>+1\r
<indent=32><sprite=4><indent=48>若对手处于能力提升状态则<color=#64F9FA>消除</color>对手<b>能力提升状态</b>\r
<indent=32><sprite=4><sprite=4><indent=64>消除成功则<color=#64F9FA>令对手睡眠</color>\r
\r
<indent=0><sprite=0><indent=16>常之惩：\r
<indent=16><sprite=3><indent=32>战斗阶段结束时：\r
<indent=32><sprite=4><indent=48>若自身体力为0，则<color=#64F9FA>消除</color>对手<b>回合类效果</b>和<b>能力提升状态</b>\r
<indent=32><sprite=4><sprite=4><indent=64>消除任意一项成功则<color=#64F9FA>令对手睡眠</color>"""@zh ;
