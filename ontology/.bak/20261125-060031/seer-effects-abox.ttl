seer:soulmark_1901 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4706 ;
    seer:analyzeDesc "[sprite name=dot4]自身存活于出战背包时，为[color=#52a5f2]己方[/color]提供[color=#f35555]逆命之曦[/color]、[color=#f35555]宿命之护[/color]、[color=#f35555]终命之辉[/color]、[color=#f35555]星命之愿[/color]4种[color=#57c975]支援[/color]且[color=#52a5f2]己方[/color][color=#57c975]免疫[/color][color=#52a5f2]首次[/color]受到的[color=#57c975]秒杀[/color]，[color=#57c975]免疫[/color]成功则在场精灵[color=#57c975]免疫[/color]下2次受到的[color=#52a5f2]异常状态[/color]|[sprite name=dot4]自身每次进行[color=#57c975]支援[/color]后获得1层[color=#f35555]命运晨星[/color]，达到4层时不再进行[color=#57c975]支援[/color]|[sprite name=dot4]每场战斗限1次，自身[color=#57c975]登场时[/color]，若自身为[color=#52a5f2]己方[/color]唯一存活的精灵，则自身恢复全部体力值与PP值，本场战斗自身的第五技能[color=#52a5f2]转化[/color]为与自身系别相同的特殊攻击技能且自身可以对自身进行[color=#57c975]支援[/color]"@zh ;
    seer:desc "自身存活于出战背包时，为己方提供逆命之曦、宿命之护、终命之辉、星命之愿4种支援且己方免疫首次受到的秒杀，免疫成功则在场精灵免疫下2次受到的异常状态|自身每次进行支援后获得1层命运晨星，达到4层时不再进行支援|每场战斗限1次，自身登场时，若自身为己方唯一存活的精灵，则自身恢复全部体力值与PP值，本场战斗自身的第五技能转化为与自身系别相同的特殊攻击技能且自身可以对自身进行支援|（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>常驻效果：\r
<indent=16><sprite=3><indent=32>自身存活于出战背包时：\r
<indent=32><sprite=4><indent=48>己方<color=#64F9FA>免疫</color>首次受到的<b>秒杀效果</b>\r
<indent=32><sprite=4><sprite=4><indent=64>免疫成功则在场精灵<color=#64F9FA>免疫</color>下2次受到的<b>异常状态</b>\r
<indent=32><sprite=4><indent=48>己方在场的其他精灵满足以下条件时，若自身命运晨星的层数低于4则获得1层<color=#FFF779>命运晨星</color>并为在场精灵提供下述支援：\r
<indent=32><sprite=4><sprite=4><indent=64>逆命之曦：攻击技能无效时，自身将使本次攻击造成的<b>攻击伤害</b><color=#64F9FA>无法低于</color>300\r
<indent=32><sprite=4><sprite=4><indent=64>宿命之护：受到异常状态时，自身将为受援者分别<color=#64F9FA>附加</color>100点<b>护盾、护罩</b>\r
<indent=32><sprite=4><sprite=4><indent=64>终命之辉：击败对手后，自身将为受援者<color=#64F9FA>恢复</color>最大体力的30%\r
<indent=32><sprite=4><sprite=4><indent=64>星命之愿：被击败后，自身将<color=#64F9FA>消除</color>对手<b>回合类效果</b>\r
\r
<indent=0><sprite=0><indent=16>限定效果（每场战斗限1次）：\r
<indent=16><sprite=3><indent=32>自身登场时，若自身为己方唯一存活的精灵，则：\r
<indent=32><sprite=4><indent=48>自身<color=#64F9FA>恢复</color>全部<b>体力值与PP值</b>\r
<indent=32><sprite=4><indent=48>直到战斗结束，第五技能转化为与自身系别相同的特殊攻击技能、自身不再获得命运晨星且可以对自身触发支援\r
\r
<indent=0><sprite=5><indent=15>命运晨星（下场保留，上限4层）：\r
<indent=16><sprite=6><indent=32>持有者在场时，每回合减少1层\r
<indent=16><sprite=6><indent=32><color=#64F9FA>免疫</color>受到的控制类<b>异常状态</b>且每有1层：\r
<indent=32><sprite=4><indent=48>造成的<b>攻击、固定、百分比伤害</b><color=#64F9FA>提升</color>10%\r
<indent=32><sprite=4><indent=48>受到的<b>攻击、固定、百分比伤害</b><color=#64F9FA>减少</color>10%"""@zh ;
    seer:effectAlias "alias_2291_1_0" ;
    seer:intensified false ;
    seer:intensifiedTo seer:soulmark_1940 ;
    seer:isAdv false ;
    seer:pveEffective false ;
    seer:seerapiId "1901" ;
    seer:soulmarkEffect "{\"effect\": {\"id\": 2291, \"url\": \"https://api.seerapi.com/v1/eid_effect/2291\"}, \"effect_args\": [1, 0]}" ;
    seer:soulmarkTag seer:soulmark_tag_5 ;
    seer:sourceUrl "https://api.seerapi.com/v1/soulmark/1901" .

seer:soulmark_1902 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4700 ;
    seer:desc "每次受到固定伤害、百分比伤害时自身恢复随机1个技能1点PP值，之后自身受到的固定伤害、百分比伤害减少15%，若减伤比例已叠加至45%则效果改为之后所有技能必定命中|回合结束后，若本回合内自身受到的固定伤害、百分比伤害达到了3次则恢复300点体力且令自身下只精灵出战时恢复300点体力（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>触发效果：\r
<indent=16><sprite=3><indent=32>每次受到固定伤害、百分比伤害时自身<color=#64F9FA>恢复</color>随机1个技能1点<b>PP值</b>\r
<indent=32><sprite=4><indent=48>之后自身受到的<b>固定伤害、百分比伤害<color=#64F9FA></b>减少</color>15%\r
<indent=32><sprite=4><sprite=4><indent=64>若减伤比例已叠加至45%则效果改为之后所有技能<color=#64F9FA>必定命中</color>\r
\r
<indent=0><sprite=0><indent=16>回合结束效果：\r
<indent=16><sprite=3><indent=32>回合结束后，若本回合内自身受到的固定伤害、百分比伤害达到了3次则<color=#64F9FA>恢复</color>300点<b>体力</b>且令己方下只精灵出战时<color=#64F9FA>恢复</color>300点<b>体力</b>"""@zh ;
    seer:effectAlias "alias_2303_1_0" ;
    seer:intensified false ;
    seer:isAdv false ;
    seer:pveEffective false ;
    seer:seerapiId "1902" ;
    seer:soulmarkEffect "{\"effect\": {\"id\": 2303, \"url\": \"https://api.seerapi.com/v1/eid_effect/2303\"}, \"effect_args\": [1, 0]}" ;
    seer:soulmarkTag seer:soulmark_tag_4,
        seer:soulmark_tag_6 ;
