seer:soulmark_1781 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:advanceOf seer:pet_advance_8 ;
    seer:affectsPet seer:pet_3705 ;
    seer:analyzeDesc "[sprite name=dot4]自身先出手时[color=#52a5f2]吸取[/color][color=#52a5f2]对手[/color]等同于自身速度值50%的体力，后出手时下回合所有[color=#52a5f2]技能先制[/color]+2|[sprite name=dot4][color=#57c975]回合开始时[/color]，自身展开[color=#f35555]千灭雷翼[/color]，[color=#52a5f2]己方[/color]每阵亡1只精灵，[color=#f35555]千灭雷翼[/color]的前1条无视触发条件"@zh ;
    seer:derivedFrom seer:soulmark_984 ;
    seer:desc "自身先出手时吸取对手等同于自身速度值50%的体力，后出手时下回合所有技能先制+2|回合开始时，自身展开千灭雷翼，己方每阵亡1只精灵，千灭雷翼的前1条无视触发条件|（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>触发效果：\r
<indent=16><sprite=3><indent=32>先出手时<color=#64F9FA>吸取</color>对手等同于自身速度值50%的<b>体力</b>\r
<indent=16><sprite=3><indent=32>后出手时下回合所有技能<b>先制</b>+2\r
\r
<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时展开千灭雷翼，自身将依次进行如下判断并在满足条件后获得后续效果；己方已有精灵阵亡时千灭雷翼的前n条效果无视触发条件，n为己方已阵亡的精灵数：\r
<indent=32><sprite=4><indent=48>若自身为满体力则本回合攻击必定<color=#64F9FA>打出致命一击</color>\r
<indent=32><sprite=4><indent=48>若自身体力值低于对手则本回合使用技能时<color=#64F9FA>获得</color>300点<b>护盾</b>\r
<indent=32><sprite=4><indent=48>若自身处于能力提升状态则本回合使用技能时令自身<color=#64F9FA>全属性+1</color>\r
<indent=32><sprite=4><indent=48>若对手处于异常状态则本回合使用技能时<color=#64F9FA>令对手全属性-1</color>\r
<indent=32><sprite=4><indent=48>若对手处于能力下降状态则本回合使用技能后100%<color=#64F9FA>使对手害怕</color>"""@zh ;
    seer:effectAlias "alias_2174_50_2_300_1_1_100_1" ;
    seer:intensified false ;
    seer:isAdv true ;
    seer:pveEffective false ;
    seer:seerapiId "1781" ;
    seer:soulmarkEffect "{\"effect\": {\"id\": 2174, \"url\": \"https://api.seerapi.com/v1/eid_effect/2174\"}, \"effect_args\": [50, 2, 300, 1, 1, 100, 1]}" ;
