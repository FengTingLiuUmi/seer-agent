        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4290 ;
    seer:desc "当回合若自身后出手则战斗阶段结束时令自身攻击+1、速度+1；当回合若自身先出手则技能命中后附加对手最大体力1/3的百分比伤害，若自身连续2次出手均为先出手则攻击必定打出致命一击，若自身连续3次出手均为先出手则使用技能时额外令对手疲惫（boss无效）"@zh ;
