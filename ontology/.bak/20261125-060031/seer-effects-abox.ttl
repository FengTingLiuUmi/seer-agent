seer:soulmark_1129 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_3815 ;
    seer:derivedFrom seer:soulmark_1090 ;
    seer:desc "回合开始时，自身体力每损失1%则当回合造成的攻击伤害提升2%，自身体力低于最大体力的1/2时伤害提升效果翻倍；|战斗阶段结束时，自身体力低于最大体力的1/2则开启燃血状态：解除自身异常状态和能力下降状态，下回合所有技能必定先手且造成伤害的50%恢复自身体力（每场战斗仅触发2次，boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时自身体力每损失1%则当回合造成的<b>攻击伤害</b><color=#64F9FA>提升</color>2%，自身体力低于最大体力的1/2时伤害提升效果翻倍\r
