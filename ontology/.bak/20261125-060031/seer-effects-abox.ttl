seer:soulmark_1547 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4321 ;
    seer:analyzeDesc "[sprite name=dot4]裁决：至序圣华[color=#57c975]登场时[/color]，为[color=#52a5f2]对方[/color]场下体力最高的随机1只精灵附加1层[color=#f35555]处决印记[/color]与3回合[color=#f35555]处决[/color]|[sprite name=dot4]圣铸：至序圣华[color=#52a5f2]首次[/color]在场上或场下死亡时，为[color=#52a5f2]己方[/color]附加1柄[color=#f35555]圣剑[/color]且开启[color=#f35555]圣剑重铸[/color]，[color=#52a5f2]之后[/color]本场战斗自身不再为[color=#52a5f2]己方[/color]附加[color=#f35555]圣剑[/color]|[sprite name=dot4]加冕：至序圣华[color=#57c975]出战后[/color]所有技能PP值恢复至1点、[color=#57c975]下场后[/color]为[color=#52a5f2]对手[/color]附加1层[color=#f35555]处决印记[/color]、[color=#57c975]登场时[/color]1回合内[color=#57c975]免疫[/color][color=#52a5f2]异常状态[/color]与[color=#52a5f2]能力下降状态[/color]且PP值[color=#52a5f2]保留[/color]1点，[color=#52a5f2]对手[/color][color=#f35555]处决印记[/color][color=#52a5f2]达到[/color]2层时回合数+1|[sprite name=dot4]秩序：[color=#57c975]战斗阶段结束时[/color]，若[color=#52a5f2]对手[/color]体力高于最大体力的1/2则下回合自身所有[color=#52a5f2]技能先制[/color]+1，若自身体力低于最大体力的1/2则2回合内自身[color=#52a5f2]回合类效果[/color]无法被消除"@zh ;
    seer:desc "裁决：至序圣华登场时，为对方场下体力最高的随机1只精灵附加1层处决印记与3回合处决|圣铸：至序圣华首次在场上或场下死亡时，为己方附加1柄圣剑且开启圣剑重铸，之后本场战斗自身不再为己方附加圣剑|加冕：至序圣华出战后所有技能PP值恢复至1点、下场后为对手附加1层处决印记、登场时1回合内免疫异常状态与能力下降状态且PP值保留1点，对手处决印记达到2层时回合数+1|秩序：战斗阶段结束时，若对手体力高于最大体力的1/2则下回合自身所有技能先制+1，若自身体力低于最大体力的1/2则2回合内自身回合类效果无法被消除|（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>裁决：\r
<indent=16><sprite=3><indent=32>至序圣华登场时，对手场下体力最高的随机1只精灵受到处决：\r
<indent=32><sprite=4><indent=48>被处决者获得1层<color=#FFF779>处决印记</color>\r
<indent=32><sprite=4><indent=48>3回合内，其根据处决印记的层数获得下列效果，直到其登场或至序圣华下场\r
<indent=32><sprite=4><sprite=4><indent=64>1层：回合开始时，自身<color=#64F9FA>受到</color>100点<b>真实伤害</b>\r
<indent=32><sprite=4><sprite=4><indent=64>2层：自身不在场时，<color=#64F9FA>无法恢复体力</color>\r
\r
<indent=0><sprite=0><indent=16>圣铸：\r
<indent=16><sprite=3><indent=32>至序圣华首次在场上或场下死亡时，为己方附加1柄<color=#FFF779>圣剑</color>且开启圣剑重铸：\r
<indent=32><sprite=4><indent=48>己方在场精灵所有技能<b>先制</b>+1且获得已有圣剑序数最高1柄的下列对应效果，且每次使用后将其消耗\r
<indent=32><sprite=4><sprite=4><indent=64>第1柄：使用技能时<color=#64F9FA>附加</color>100点<b>真实伤害</b>\r
<indent=32><sprite=4><sprite=4><indent=64>第2柄：使用技能时<color=#64F9FA>附加</color>150点<b>真实伤害</b>；<color=#64F9FA>无视</color>对手<b>能力提升状态</b>、自身<b>能力下降状态</b>\r
<indent=32><sprite=4><sprite=4><indent=64>第3柄：使用技能时<color=#64F9FA>附加</color>200点<b>真实伤害</b>；<color=#64F9FA>无视</color>对手<b>能力提升状态</b>、自身<b>能力下降状态</b>、<b>攻击免疫效果</b>\r
<indent=32><sprite=4><indent=48>己方击败对方在场精灵时，至序圣华复活且之后不再为己方附加圣剑\r
<indent=32><sprite=4><indent=48>己方失去所有圣剑后，下个回合开始时圣剑重铸结束\r
\r
<indent=0><sprite=0><indent=16>加冕：\r
<indent=16><sprite=3><indent=32>至序圣华出战后所有技能<b>PP值</b><color=#64F9FA>恢复至</color>1点\r
<indent=16><sprite=3><indent=32>至序圣华下场后为对手附加1层处决印记\r
<indent=16><sprite=3><indent=32>至序圣华登场时1回合内<color=#64F9FA>免疫</color><b>异常状态</b>与<b>能力下降状态</b>且<b>PP值</b><color=#64F9FA>保留</color>1点，对手处决印记达到2层时回合数+1\r
\r
<indent=0><sprite=0><indent=16>秩序：\r
<indent=16><sprite=3><indent=32>战斗阶段结束时：\r
<indent=32><sprite=4><indent=48>若对手体力高于最大体力的1/2则下回合自身所有技能<b>先制</b>+1\r
<indent=32><sprite=4><indent=48>若自身体力低于最大体力的1/2则2回合内自身<color=#64F9FA>回合类效果无法被消除</color>\r
\r
<indent=0><sprite=5><indent=15>处决印记（上限2层）：\r
<indent=16><sprite=6><indent=32>至序圣华、圣律剑灵用以触发部分效果的条件\r
\r
<indent=0><sprite=5><indent=15>圣剑（上限3柄）：\r
<indent=16><sprite=6><indent=32>至序圣华、圣律剑灵用以触发部分效果的条件"""@zh ;
    seer:effectAlias "alias_1897_3_100_5_1_2_1_2_1" ;
    seer:intensified false ;
    seer:isAdv false ;
    seer:pveEffective false ;
    seer:seerapiId "1547" ;
    seer:soulmarkEffect "{\"effect\": {\"id\": 1897, \"url\": \"https://api.seerapi.com/v1/eid_effect/1897\"}, \"effect_args\": [3, 100, 5, 1, 2, 1, 2, 1]}" ;
    seer:soulmarkTag seer:soulmark_tag_19,
        seer:soulmark_tag_5,
        seer:soulmark_tag_8 ;
    seer:sourceUrl "https://api.seerapi.com/v1/soulmark/1547" .

seer:soulmark_1549 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4323 ;
    seer:desc "自身每次受到攻击则50%令对手感染，未触发则100%令对手中毒；战斗阶段结束时若自身体力低于最大体力的1/2则恢复自身300点体力且附加等量固定伤害，若低于最大体力的1/3则恢复量和固定伤害翻倍（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>触发效果：\r
<indent=16><sprite=3><indent=32>自身每次受到攻击则50%<color=#64F9FA>令对手感染</color>\r
<indent=32><sprite=4><indent=48>未触发则100%<color=#64F9FA>令对手中毒</color>\r
\r
<indent=0><sprite=0><indent=16>战阶结束效果：\r
