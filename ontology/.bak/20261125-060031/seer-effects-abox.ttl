seer:soulmark_778 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_3465 ;
    seer:desc "对手使用攻击技能后自身有50%概率使对手睡眠，未触发则{吸取}对手最大{体力}的1/3；自身使用攻击技能时有40%概率使对手睡眠，未触发则下回合所有技能先制+2，攻击命中已处于睡眠状态的对手时额外附加自身最大体力1/3的百分比伤害；每个战斗阶段结束时恢复150点体力并造成等量固定伤害，若战斗阶段结束时自身为满体力，则特攻+1、速度+1（boss无效）"@zh ;
