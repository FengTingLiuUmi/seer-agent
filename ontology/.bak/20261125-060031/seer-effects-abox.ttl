seer:soulmark_1090 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_3815 ;
    seer:desc "回合开始时，自身体力每损失1%则当回合造成的攻击伤害提升2%，自身体力低于最大体力的1/3时伤害提升效果翻倍；|战斗阶段结束时，自身体力低于最大体力的1/3则开启燃血状态：解除自身异常状态和能力下降状态，下回合所有技能必定先手且造成伤害的50%恢复自身体力（每场战斗仅触发2次，boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时自身体力每损失1%则当回合造成的<b>攻击伤害</b><color=#64F9FA>提升</color>2%，自身体力低于最大体力的1/3时伤害提升效果翻倍\r
\r
<indent=0><sprite=0><indent=16>限定效果（每场战斗限2次）：\r
<indent=16><sprite=3><indent=32>战斗阶段结束时，自身体力低于最大体力的1/3则开启燃血状态：\r
<indent=32><sprite=4><indent=48><color=#64F9FA>解除</color>自身<b>异常状态</b>和<b>能力下降状态</b>\r
<indent=32><sprite=4><indent=48>下回合所有技能<color=#64F9FA>必定先手</color>且造成的攻击伤害50%额外<color=#64F9FA>恢复</color>至自身体力"""@zh ;
