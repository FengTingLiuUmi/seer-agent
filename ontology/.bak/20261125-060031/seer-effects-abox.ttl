seer:soulmark_1884 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4678 ;
    seer:desc "首次登场起3回合内免疫受到的异常状态与能力下降状态且每回合开始时自身恢复200点体力与所有技能1点PP值，自身使用技能迪拉修姆光流时，2回合内自身所有技能造成的攻击伤害提升100%，自身使用技能兰帕尔特光弹时，2回合内自身使用技能后附加对手最大体力10%的百分比伤害，最高不超过自身速度值的150%（所有效果boss有效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>登场效果：\r
<indent=16><sprite=3><indent=32>迪迦首次登场起3回合内<color=#64F9FA>免疫</color>受到的<b>异常状态</b>与<b>能力下降状态</b> 每回合结束后自身<color=#64F9FA>恢复</color>300点<b>体力</b>与所有技能2点<b>PP值</b>\r
\r
<indent=0><sprite=0><indent=16>技能额外效果：\r
<indent=16><sprite=3><indent=32>迪迦使用技能“迪拉修姆光流”时 2回合内自身所有技能造成的<b>攻击伤害<color=#64F9FA></b>提升</color>100%\r
<indent=16><sprite=3><indent=32>迪迦使用技能“兰帕尔特光弹”时 2回合内自身所有技能<color=#64F9FA>附加</color>对手最大体力10%的<b>百分比伤害</b> 最高不超过自身速度值的200%"""@zh ;
    seer:effectAlias "alias_2265_3_2_100_2_10_150" ;
    seer:intensified false ;
    seer:isAdv false ;
    seer:pveEffective true ;
    seer:seerapiId "1884" ;
    seer:soulmarkEffect "{\"effect\": {\"id\": 2265, \"url\": \"https://api.seerapi.com/v1/eid_effect/2265\"}, \"effect_args\": [3, 2, 100, 2, 10, 150]}" ;
    seer:soulmarkTag seer:soulmark_tag_15,
        seer:soulmark_tag_2 ;
