seer:soulmark_1996 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4803 ;
    seer:desc "回合开始时，若自身处于异常状态则恢复自身全部体力且下1次造成的攻击伤害提升50%，伤害提升效果最高叠加至150%|战斗阶段结束时，若自身为满体力则消除对手回合类效果并令对手全属性-1，若自身不为满体力则附加自身损失体力50%的百分比伤害"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时，若自身处于异常状态则<color=#64F9FA>恢复</color>自身全部<b>体力</b>且下1次造成的<b>攻击伤害</b><color=#64F9FA>提升</color>50%，伤害提升效果最高叠加至150%\r
\r
<indent=0><sprite=0><indent=16>战阶结束效果：\r
<indent=16><sprite=3><indent=32>战斗阶段结束时：\r
<indent=32><sprite=4><indent=48>若自身为满体力则<color=#64F9FA>消除</color>对手<b>回合类效果</b>并令对手<color=#64F9FA>全属性-1</color>\r
<indent=32><sprite=4><indent=48>若自身不为满体力则<color=#64F9FA>附加</color>自身损失体力50%的<b>百分比伤害</b>"""@zh ;
    seer:effectAlias "alias_2421_1_0" ;
    seer:intensified false ;
    seer:isAdv false ;
    seer:pveEffective false ;
    seer:seerapiId "1996" ;
    seer:soulmarkEffect "{\"effect\": {\"id\": 2421, \"url\": \"https://api.seerapi.com/v1/eid_effect/2421\"}, \"effect_args\": [1, 0]}" ;
