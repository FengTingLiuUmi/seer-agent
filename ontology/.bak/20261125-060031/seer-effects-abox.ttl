seer:soulmark_1891 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4689 ;
    seer:desc "回合结束后恢复100点体力，每次触发后本场战斗此效果提升50点，最高不超过自身最大体力的1/2|回合开始时，若自身为满体力则当回合免疫能力下降状态，若自身不为满体力则自身有等同于当前体力百分比的概率使自身当回合免疫受到的异常状态|（boss无效）"@zh ;
