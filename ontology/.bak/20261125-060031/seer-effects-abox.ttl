seer:soulmark_1422 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4200 ;
    seer:desc "当回合若自身先出手则攻击技能50%打出致命一击，未触发则战斗阶段结束时令自身攻击+2、速度+2，当回合若自身后出手则下回合自身所有技能额外先制+1；|回合开始时，若上回合自身受到了当前对手造成的攻击伤害，则该伤害每有自身最大体力的1%，当回合自身造成的攻击伤害提升2%（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>触发效果：\r
<indent=16><sprite=3><indent=32>当回合若自身先出手则攻击技能50%<color=#64F9FA>打出致命一击</color>\r
<indent=32><sprite=4><indent=48>未触发则战斗阶段结束时自身攻击+2、速度+2\r
<indent=16><sprite=3><indent=32>当回合若自身后出手则下回合自身所有技能额外<b>先制</b>+1\r
\r
<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时，若上回合自身受到了当前对手造成的攻击伤害，则该伤害每有自身最大体力的1%，当回合自身造成的<b>攻击伤害<color=#64F9FA></b>提升</color>2%"""@zh ;
