    seer:sourceUrl "https://api.seerapi.com/v1/soulmark/1932" .

seer:soulmark_1985 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:advanceOf seer:pet_advance_14 ;
    seer:affectsPet seer:pet_3516 ;
    seer:analyzeDesc "[sprite name=dot4]自身[color=#57c975]护盾[/color]被击破时，附加[color=#52a5f2]对手[/color]最大体力1/3的[color=#52a5f2]百分比伤害[/color]且下次受到攻击的[color=#57c975]伤害额外减少[/color]50%|[sprite name=dot4]自身能力提升被消除、[color=#52a5f2]吸取[/color]时，自身获得1层[color=#f35555]封邪之嶂[/color]与400点[color=#57c975]护盾[/color]|[sprite name=dot4]自身每次受到高于自身最大体力1/3的[color=#52a5f2]固定伤害[/color]、[color=#52a5f2]百分比伤害[/color]后，恢复等同于[color=#57c975]护盾[/color]值的体力|[sprite name=dot4][color=#57c975]回合开始时[/color]，若自身处于[color=#52a5f2]能力提升状态[/color]则为自身附加400点[color=#57c975]护盾[/color]，若自身不处于[color=#52a5f2]能力提升状态[/color]则[color=#52a5f2]当回合[/color][color=#57c975]战斗阶段结束时[/color][color=#52a5f2]吸取[/color][color=#52a5f2]对手[/color]最大体力的1/3并获得等量[color=#57c975]护盾[/color]，最高叠加至400点|[sprite name=dot4][color=#57c975]战斗阶段结束时[/color]，若自身的[color=#57c975]护盾[/color]值为400的正整数倍则为[color=#52a5f2]对手[/color]种下1只[color=#f35555]留魂之蛊[/color]"@zh ;
    seer:derivedFrom seer:soulmark_828 ;
    seer:desc "自身护盾被击破时，附加对手最大体力1/3的百分比伤害且下次受到攻击的伤害额外减少50%|自身能力提升被消除、吸取时，自身获得1层封邪之嶂与400点护盾|自身每次受到高于自身最大体力1/3的固定伤害、百分比伤害后，恢复等同于护盾值的体力|回合开始时，若自身处于能力提升状态则为自身附加400点护盾，若自身不处于能力提升状态则当回合战斗阶段结束时吸取对手最大体力的1/3并获得等量护盾，最高叠加至400点|战斗阶段结束时，若自身的护盾值为400的正整数倍则为对手种下1只留魂之蛊|（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>触发效果：\r
<indent=16><sprite=3><indent=32>自身护盾被击破时，<color=#64F9FA>附加</color>对手最大体力1/3的<b>百分比伤害</b>且下次受到攻击的<b>攻击伤害</b><color=#64F9FA>额外减少</color>50%\r
<indent=16><sprite=3><indent=32>自身能力提升被消除、吸取时，自身<color=#64F9FA>获得</color>1层<color=#FFF779>封邪之嶂</color>与400点<b>护盾</b>\r
<indent=16><sprite=3><indent=32>自身每次受到高于自身最大体力1/3的固定伤害、百分比伤害后，<color=#64F9FA>恢复</color>等同于护盾值的<b>体力</b>\r
\r
<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时：\r
<indent=32><sprite=4><indent=48>若自身处于能力提升状态则为自身<color=#64F9FA>附加</color>400点<b>护盾</b>\r
<indent=32><sprite=4><indent=48>若自身不处于能力提升状态则当回合战斗阶段结束时<color=#64F9FA>吸取</color>对手最大体力的1/3并<color=#64F9FA>获得</color>等量<b>护盾</b>，上限400点\r
\r
<indent=0><sprite=0><indent=16>战阶结束效果：\r
<indent=16><sprite=3><indent=32>战斗阶段结束时，若自身的护盾值为400的正整数倍则为对手种下1只<color=#FFF779>留魂之蛊</color>\r
\r
<indent=0><sprite=5><indent=15>封邪之嶂（上限4层，下场保留）：\r
<indent=16><sprite=6><indent=32>自身每次受到攻击后，若对手的护盾值高于自身则<color=#64F9FA>消除</color>对手的<b>护盾</b>\r
<indent=16><sprite=6><indent=32>每有1层己方其他精灵的护盾<color=#64F9FA>提升</color>10%的<b>承伤量</b>且被无视时<color=#64F9FA>恢复</color>在场精灵护盾值40%的<b>体力</b>\r
\r
<indent=0><sprite=5><indent=15>留魂之蛊（上限4只，下场保留）：\r
<indent=16><sprite=6><indent=32>每有1只每回合可触发1次，自身恢复体力后留魂之蛊将<color=#64F9FA>汲取</color>自身四十点<b>体力</b>\r
<indent=32><sprite=4><indent=48>莱茵哈特在场时汲取的体力值将恢复至莱茵哈特\r
<indent=32><sprite=4><indent=48>莱茵哈特阵亡时只数-1"""@zh ;
