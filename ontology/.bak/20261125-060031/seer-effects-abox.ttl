seer:soulmark_1992 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4219 ;
    seer:desc "自身登场时获得灼阳之焰，之后自身能力提升状态被消除、吸取时令对手烧伤、焚烬，未触发则自身获得灼阳之焰|战阶结束时，若对手处于烧伤状态则令对手全属性下降至-1（每项至少减少1级）且下回合自身所有技能先制+1，若对手不处于烧伤状态则消除对手回合类效果，未消除成功则恢复自身最大体力的1/3并附加恢复量的百分比伤害，体力未恢复至满时令对手自第五技能起所有技能PP值减少至与第五技能相同（每项至少减少1点）（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>登场效果：\r
<indent=16><sprite=3><indent=32>自身登场时获得<color=#FFF779>灼阳之焰</color>\r
<indent=32><sprite=4><indent=48>之后自身能力提升状态被消除、吸取时<color=#64F9FA>令对手烧伤、焚烬</color>\r
<indent=32><sprite=4><sprite=4><indent=64>未触发则自身获得灼阳之焰\r
\r
<indent=0><sprite=0><indent=16>战阶结束效果：\r
<indent=16><sprite=3><indent=32>战斗阶段结束时：\r
<indent=32><sprite=4><indent=48>若对手处于烧伤状态则令对手<color=#64F9FA>全属性下降至-1</color>且每项至少减少1级，下回合自身所有技能<b>先制</b>+1\r
<indent=32><sprite=4><indent=48>若对手不处于烧伤状态则<color=#64F9FA>消除</color>对手<b>回合类效果</b>\r
<indent=32><sprite=4><sprite=4><indent=64>未消除成功则<color=#64F9FA>恢复</color>自身最大体力的1/3并造成恢复量的<b>百分比伤害</b>\r
<indent=32><sprite=4><sprite=4><sprite=4><indent=80>体力未恢复至满时令对手自第五技能起所有技能<b>PP值</b>减少至与第五技能相同，每个至少减少1点\r
\r
<indent=0><sprite=5><indent=15>灼阳之焰：\r
<indent=16><sprite=6><indent=32>天敌对自身使用攻击技能时，若自身不处于能力提升则<color=#64F9FA>全属性+1</color>\r
<indent=16><sprite=6><indent=32>自身的攻击技能：\r
<indent=32><sprite=4><indent=48><b>先制</b>+1\r
<indent=32><sprite=4><indent=48>必定<color=#64F9FA>打出致命一击</color>\r
<indent=32><sprite=4><indent=48>技能命中时消耗灼阳之焰并<color=#64F9FA>全属性+1</color>"""@zh ;
    seer:effectAlias "alias_2418_1_0" ;
    seer:intensified false ;
    seer:isAdv false ;
    seer:pveEffective false ;
    seer:seerapiId "1992" ;
