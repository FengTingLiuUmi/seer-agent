seer:soulmark_1330 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4088 ;
    seer:analyzeDesc "[sprite name=dot4][color=#57c975]回合开始时[/color]，使自身防御+1、特防+1；自身[color=#57c975]受到攻击后[/color]，若双防提升等级总和≥6则[color=#52a5f2]当回合[/color][color=#57c975]战斗阶段结束时[/color]附加自身最大体力值30%的[color=#52a5f2]百分比伤害[/color]|[sprite name=dot4]自身被[color=#57c975]击败[/color]时，[color=#52a5f2]己方[/color]下只精灵出战时恢复最大体力的40%（出战精灵为环小队成员时改为50%），[color=#52a5f2]之后[/color]3回合内每[color=#57c975]回合结束时[/color]此精灵恢复最大体力的20%（出战精灵为环小队成员时改为25%）"@zh ;
    seer:desc "回合开始时，使自身防御+1、特防+1|自身受到攻击后，若双防提升等级总和≥6则当回合战斗阶段结束时附加自身最大体力值30%的百分比伤害|自身被击败时，己方下只精灵出战时恢复最大体力的40%（出战精灵为环小队成员时改为50%），之后3回合内每回合结束时此精灵恢复最大体力的20%（出战精灵为环小队成员时改为25%）（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时令自身防御+1、特防+1\r
\r
<indent=0><sprite=0><indent=16>触发效果：\r
<indent=16><sprite=3><indent=32>自身受到攻击时若双防提升等级总和≥6则战斗阶段结束时<color=#64F9FA>附加</color>自身最大体力30%的<b>百分比伤害</b>\r
\r
<indent=0><sprite=0><indent=16>被击败效果：\r
<indent=16><sprite=3><indent=32>自身被击败后令己方下只出战精灵立刻<color=#64F9FA>恢复</color>最大体力40%的<b>体力</b>，之后3回合内每回合<color=#64F9FA>恢复</color>最大体力20%的<b>体力</b>\r
<indent=32><sprite=4><indent=48>若下只出战精灵是“环”小队成员，则改为立刻恢复最大体力50%的体力，之后3回合内每回合恢复最大体力25%的体力"""@zh ;
