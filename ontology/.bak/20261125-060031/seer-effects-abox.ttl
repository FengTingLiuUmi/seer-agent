seer:soulmark_2104 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4894 ;
    seer:analyzeDesc "[sprite name=dot4][color=#57c975]战斗阶段结束时[/color]记录对手[color=#52a5f2]当回合(411)[/color]所使用技能的类型，若该类型与上次记录不同则100%令对手[color=#57c975]害怕[/color]3回合，若该类型与上次记录相同则对手该类型技能下回合[color=#52a5f2]先制(339)[/color]-1|[sprite name=dot4]自身[color=#57c975]攻击技能命中后[/color]，若对手处于[color=#57c975]害怕[/color]状态则令对手[color=#57c975]害怕[/color]回合数-1并附加200点[color=#52a5f2]固定伤害[/color]，每生效1次增加100点，最多500点，自身属性技能命中后，若对手处于[color=#57c975]害怕[/color]状态则令对手[color=#57c975]害怕[/color]回合数+1并[color=#52a5f2]吸取[/color]对手最大体力的50%，每生效1次减少10%，最低30%"@zh ;
    seer:desc "战斗阶段结束时记录对手当回合所使用技能的类型，若该类型与上次记录不同则100%令对手害怕3回合，若该类型与上次记录相同则对手该类型技能下回合先制-1|自身攻击技能命中后，若对手处于害怕状态则令对手害怕回合数-1并附加200点固定伤害，每生效1次增加100点，最多500点，自身属性技能命中后，若对手处于害怕状态则令对手害怕回合数+1并吸取对手最大体力的50%，每生效1次减少10%，最低30%|（boss无效）"@zh ;
    seer:effectAlias "alias_2501_100_500_50_30_1" ;
