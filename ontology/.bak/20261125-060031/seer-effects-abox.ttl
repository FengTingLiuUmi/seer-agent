seer:soulmark_1791 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4586 ;
    seer:analyzeDesc "[sprite name=dot4]空元之铭：空元行者1~5号位的技能分别拥有[color=#f35555]仐[/color]、[color=#f35555]叵[/color]、[color=#f35555]乂[/color]、[color=#f35555]卌[/color]、[color=#f35555]卪[/color]铭文效果|[sprite name=dot4][color=#f35555]空元之诗[/color]：空元行者技能中的[color=#f35555]空元之诗[/color]效果不因原本的行动而触发，每次行动结束后，若本回合所选技能的[color=#f35555]空元之诗[/color]效果生效且条件满足，则空元行者会抹除一篇[color=#f35555]空妄诗章[/color]，抹除成功后进行一次[color=#52a5f2]额外行动[/color][color=#52a5f2]以[/color]触发对应的[color=#f35555]空元之诗[/color]|[sprite name=dot4]空元之录：空元行者存活于出战背包时，双方阵亡的不在场精灵会[color=#57c975]消逝[/color][color=#52a5f2]以[/color][color=#52a5f2]转化[/color]为1篇[color=#f35555]空妄诗章[/color]，空元行者获得其因此减少的体力上限的10%，最高不超过空元行者最大体力的10%|[sprite name=dot4]空元之渎：空元行者[color=#52a5f2]首次[/color]受到[color=#52a5f2]致死伤害[/color]时失去所有[color=#f35555]空妄诗章[/color]并解除所处的[color=#52a5f2]异常状态[/color]，[color=#52a5f2]当回合[/color][color=#52a5f2]保留[/color]1点体力并[color=#57c975]免疫[/color]受到的[color=#52a5f2]异常状态[/color]，[color=#52a5f2]之后[/color][color=#52a5f2]执行[/color][color=#f35555]空元之诗[/color]效果不再抹除[color=#f35555]空妄诗章[/color]且不受其限制、每[color=#57c975]回合结束后[/color]减少200点体力上限"@zh ;
    seer:desc "空元之铭：空元行者1~5号位的技能分别拥有仐、叵、乂、卌、卪铭文效果|空元之诗：空元行者技能中的空元之诗效果不因原本的行动而触发，每次行动结束后，若本回合所选技能的空元之诗效果生效且条件满足，则空元行者会抹除一篇空妄诗章，抹除成功后进行一次额外行动以触发对应的空元之诗|空元之录：空元行者存活于出战背包时，双方阵亡的不在场精灵会消逝以转化为1篇空妄诗章，空元行者获得其因此减少的体力上限的10%，最高不超过空元行者最大体力的10%|空元之渎：空元行者首次受到致死伤害时失去所有空妄诗章并解除所处的异常状态，当回合保留1点体力并免疫受到的异常状态，之后执行空元之诗效果不再抹除空妄诗章且不受其限制、每回合结束后减少200点体力上限|（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>空元之铭：\r
<indent=16><sprite=3><indent=32>空元行者的技能在1~5号位时会获得以下额外效果：\r
<indent=32><sprite=4><indent=48>仐：<b>先制</b>+1并<color=#64F9FA>无视</color>对手的<b>能力提升状态</b>和自身的<b>能力下降状态</b>\r
<indent=32><sprite=4><indent=48>叵：<color=#64F9FA>不受PP值限制</color>，命中时<color=#64F9FA>吸取</color>对手所有技能1点PP值\r
<indent=32><sprite=4><indent=48>乂：回合开始时<color=#64F9FA>解除</color>自身的<b>异常状态</b>\r
<indent=32><sprite=4><indent=48>卌：使用后<color=#64F9FA>吸取</color>对手最大体力的40%且<color=#64F9FA>减少</color>对手下次攻击40%的伤害\r
<indent=32><sprite=4><indent=48>卪：击败对手后<color=#64F9FA>减少</color><b>自身体力上限</b>的20%，本场战斗中受到的<b>攻击伤害</b><color=#64F9FA>减少</color>10%，造成的<b>攻击伤害</b><color=#64F9FA>提升</color>10%\r
\r
<indent=0><sprite=0><indent=16>空元之诗：\r
<indent=16><sprite=3><indent=32>空元行者的技能中的空元之诗效果不会仅因原本的行动而触发\r
<indent=16><sprite=3><indent=32>每次行动结束后，如果本回合所选技能的<b>效果生效</b>且空元之诗的<b>条件满足</b>，空元行者会抹除一篇空妄诗章\r
<indent=32><sprite=4><indent=48>抹除成功后，空元行者会进行一次额外行动，触发<b>空元之诗</b>效果\r
\r
<indent=0><sprite=0><indent=16>空元之录：\r
<indent=16><sprite=3><indent=32>空元行者存活于出战背包时，双方阵亡的<b>不在场精灵</b>会<color=#64F9FA>消逝</color>并转化为1篇空妄诗章\r
<indent=32><sprite=4><indent=48>空元行者将<color=#64F9FA>获得</color>其消逝前<b>体力上限</b>的10%（单次上限为空元行者体力上限的10%）\r
\r
<indent=0><sprite=0><indent=16>空元之渎：\r
<indent=16><sprite=3><indent=32>空元行者首次死亡时失去所有空妄诗章并<color=#64F9FA>解除</color>所处的异常状态，触发后：\r
<indent=32><sprite=4><indent=48>当回合<color=#64F9FA>保留</color>1点<b>体力</b>并<color=#64F9FA>免疫</color>受到的<b>异常状态</b>\r
<indent=32><sprite=4><indent=48>触发空元之诗效果不再抹除空妄诗章且不受其限制\r
<indent=32><sprite=4><indent=48>每回合结束后<color=#64F9FA>减少</color>200点<b>体力上限</b>"""@zh ;
    seer:effectAlias "alias_2175_1_1_40_40_3_1" ;
    seer:intensified false ;
    seer:isAdv false ;
    seer:pveEffective false ;
    seer:seerapiId "1791" ;
