seer:soulmark_1243 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_3979 ;
    seer:desc "自身出手后则当回合对手无法通过自身技能恢复体力（该效果为回合类效果），若自身先出手则当回合受到的伤害减少25%（包括固定伤害和百分比伤害），若自身后出手则下回合所有技能先制+1；|回合开始时，若对手处于烧伤状态则自身造成的攻击伤害提升100%，若对手不处于烧伤状态则自身攻击命中后100%令对手烧伤（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>技能额外效果：\r
<indent=16><sprite=3><indent=32>自身使用技能时对手以回合类效果形式1回合内无法通过技能恢复体力，然后：\r
<indent=32><sprite=4><indent=48>若自身为先出手则当回合受到的<b>攻击伤害、固定伤害</b>和<b>百分比伤害</b><color=#64F9FA>减少</color>25%\r
<indent=32><sprite=4><indent=48>若自身为后出手则下回合所有技能<b>先制</b>+1\r
\r
<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时：\r
<indent=32><sprite=4><indent=48>若对手处于烧伤状态则自身造成的<b>攻击伤害</b><color=#64F9FA>提升</color>100%\r
<indent=32><sprite=4><indent=48>若对手不处于烧伤状态则攻击命中后100%<color=#64F9FA>令对手烧伤</color>"""@zh ;
    seer:effectAlias "alias_1579_25_1_100_100_1" ;
