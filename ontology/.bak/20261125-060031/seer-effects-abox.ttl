seer:soulmark_1433 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4215 ;
    seer:desc "每次登场时为自身附加300点护盾和300点护罩且恢复自身最大体力的1/3，若登场时自身为满体力则恢复体力效果转变为令对手全属性-1；登场首战斗阶段结束时，若上述护盾或护罩任意一个消失则使对手进入焚烬；|对手每次使用威力大于120的攻击技能则100%令对手烧伤且自身当回合及下回合攻击必定打出致命一击，未触发烧伤则使对手该攻击技能PP值额外-1（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>登场效果：\r
<indent=16><sprite=3><indent=32>登场时为自身<color=#64F9FA>附加</color>300点<b>护盾</b>和300点<b>护罩</b>且<color=#64F9FA>恢复</color>自身最大体力的1/3\r
<indent=32><sprite=4><indent=48>若登场时自身为满体力则恢复体力效果转变为<color=#64F9FA>令对手全属性-1</color>；\r
<indent=16><sprite=3><indent=32>登场首回合战斗阶段结束时，若上述护盾或护罩任意一个消失则<color=#64F9FA>令对手焚烬</color>\r
\r
<indent=0><sprite=0><indent=16>触发效果：\r
<indent=16><sprite=3><indent=32>对手每次使用威力大于120的攻击技能则：\r
<indent=32><sprite=4><indent=48>2回合内自身攻击<color=#64F9FA>必定打出致命一击</color>\r
<indent=32><sprite=4><indent=48>100%<color=#64F9FA>令对手烧伤</color>\r
<indent=32><sprite=4><sprite=4><indent=64>未触发烧伤则使对手该攻击技能PP值额外-1"""@zh ;
