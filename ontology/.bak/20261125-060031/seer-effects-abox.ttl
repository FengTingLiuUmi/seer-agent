seer:soulmark_1558 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4332 ;
    seer:desc "回合开始时若自身处于异常状态则当回合自身有70%的概率闪避对手攻击技能，若对手命中则自身受到的伤害降低50%；|战斗阶段结束时若自身处于异常状态则100%令对手麻痹，自身不处于异常状态则恢复自身最大体力的1/3（boss无效）"@zh ;
