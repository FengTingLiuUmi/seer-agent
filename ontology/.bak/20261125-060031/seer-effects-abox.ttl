seer:soulmark_2100 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4915 ;
    seer:analyzeDesc "[sprite name=dot4]战斗开始时，自身进入[color=#f35555]事象观测[/color]状态；自身受到[color=#52a5f2]致死伤害[/color]时，退出[color=#f35555]事象观测[/color][color=#52a5f2]以[/color]消除[color=#52a5f2]对手[/color]的[color=#52a5f2]能力提升状态[/color]、[color=#52a5f2]回合类效果[/color]并重生|[sprite name=dot4]自身[color=#52a5f2]登场[/color][color=#52a5f2]之后[/color]，记录[color=#52a5f2]当回合[/color]自身首个进入的[color=#52a5f2]异常状态[/color]和[color=#52a5f2]对手[/color]所使用技能的类型，记录成功则[color=#52a5f2]当回合[/color]结束时解除自身所处的[color=#52a5f2]异常状态[/color]；自身的技能命中时，若类型与自身记录的技能类型相同则附加自身记录的[color=#52a5f2]异常状态[/color]，[color=#52a5f2]未触发[/color]则令自身[color=#57c975]凝滞[/color]|[sprite name=dot4][color=#57c975]战斗阶段结束时[/color]，若[color=#52a5f2]对手[/color]处于[color=#52a5f2]异常状态[/color]则自身特攻、速度+1且下回合[color=#57c975]使用技能时[/color]附加特攻值40%的[color=#52a5f2]百分比伤害[/color]，若[color=#52a5f2]对手[/color]不处于[color=#52a5f2]异常状态[/color]则恢复自身最大体力的1/4"@zh ;
    seer:desc "战斗开始时，自身进入事象观测状态；自身受到致死伤害时，退出事象观测以消除对手的能力提升状态、回合类效果并重生|自身登场之后，记录当回合自身首个进入的异常状态和对手所使用技能的类型，记录成功则当回合结束时解除自身所处的异常状态；自身的技能命中时，若类型与自身记录的技能类型相同则附加自身记录的异常状态，未触发则令自身凝滞|战斗阶段结束时，若对手处于异常状态则自身特攻、速度+1且下回合使用技能时附加特攻值40%的百分比伤害，若对手不处于异常状态则恢复自身最大体力的1/4|（boss无效）"@zh ;
    seer:effectAlias "alias_2520_40_1_4_0_1" ;
    seer:intensified false ;
    seer:isAdv false ;
    seer:pveEffective false ;
    seer:seerapiId "2100" ;
    seer:soulmarkEffect "{\"effect\": {\"id\": 2520, \"url\": \"https://api.seerapi.com/v1/eid_effect/2520\"}, \"effect_args\": [40, 1, 4, 0, 1]}" ;
    seer:soulmarkTag seer:soulmark_tag_11,
        seer:soulmark_tag_15 ;
    seer:sourceUrl "https://api.seerapi.com/v1/soulmark/2100" .

seer:soulmark_2101 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4866 ;
    seer:analyzeDesc "[sprite name=dot4]自身的PP值总和每有[color=#52a5f2]对手[/color]的1倍，自身受到的[color=#52a5f2]固定伤害[/color]、[color=#52a5f2]百分比伤害[/color]减半1次，每次伤害最多减半8次|[sprite name=dot4]每回合前10次受到[color=#52a5f2]固定伤害[/color]、[color=#52a5f2]百分比伤害[/color]时，若自身的PP值总和高于[color=#52a5f2]对手[/color]则恢复[color=#52a5f2]对手[/color]所有技能已损失的PP值且自身所有PP值最高的技能失去等量的PP值，自身技能PP值因此归0时2回合内[color=#52a5f2]对手[/color]无法恢复体力，若自身的PP值总和不高于[color=#52a5f2]对手[/color]则[color=#52a5f2]吸取[/color][color=#52a5f2]对手[/color]所有技能1点PP值恢复至自身PP值最低的[color=#52a5f2]首位技能[/color]且自身[color=#52a5f2]吸取[/color][color=#52a5f2]对手[/color]240点体力，[color=#52a5f2]然后[/color]若[color=#52a5f2]对手[/color]的体力未减少则对其相邻精灵附加等量[color=#52a5f2]真实伤害[/color]"@zh ;
    seer:desc "自身的PP值总和每有对手的1倍，自身受到的固定伤害、百分比伤害减半1次，每次伤害最多减半8次|每回合前10次受到固定伤害、百分比伤害时，若自身的PP值总和高于对手则恢复对手所有技能已损失的PP值且自身所有PP值最高的技能失去等量的PP值，自身技能PP值因此归0时2回合内对手无法恢复体力，若自身的PP值总和不高于对手则吸取对手所有技能1点PP值恢复至自身PP值最低的首位技能且自身吸取对手240点体力，然后若对手的体力未减少则对其相邻精灵附加等量真实伤害|（boss无效）"@zh ;
    seer:effectAlias "alias_2475_1_1_1" ;
    seer:intensified false ;
    seer:isAdv false ;
    seer:pveEffective false ;
    seer:seerapiId "2101" ;
    seer:soulmarkEffect "{\"effect\": {\"id\": 2475, \"url\": \"https://api.seerapi.com/v1/eid_effect/2475\"}, \"effect_args\": [1, 1, 1]}" ;
    seer:soulmarkTag seer:soulmark_tag_4,
        seer:soulmark_tag_6 ;
    seer:sourceUrl "https://api.seerapi.com/v1/soulmark/2101" .

seer:soulmark_2102 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4870 ;
    seer:analyzeDesc "[sprite name=dot4]对手pp值总和每比自身高1倍，自身造成的[color=#52a5f2]攻击伤害[/color]提升40%|[sprite name=dot4][color=#57c975]回合开始时[/color]，若自身存在pp值相等的技能则[color=#52a5f2]当回合[/color]自身技能命中后恢复所有技能1点pp并[color=#52a5f2]吸取[/color]对手400点体力，自身pp值每恢复一点则[color=#52a5f2]吸取[/color]效果减少40点，若不存在pp值相等的技能则[color=#52a5f2]当回合[/color]必定打出[color=#52a5f2]致命一击[/color]|[sprite name=dot4][color=#57c975]战斗阶段结束时[/color]，若自身若不存在pp值相等的技能，则使自身每个技能的pp值尽可能等于所有技能pp值的平均值，技能pp值总和每因此减少1点，下回合所有[color=#52a5f2]技能先制[/color]+1，最高+4"@zh ;
    seer:desc "对手pp值总和每比自身高1倍，自身造成的攻击伤害提升40%|回合开始时，若自身存在pp值相等的技能则当回合自身技能命中后恢复所有技能1点pp并吸取对手400点体力，自身pp值每恢复一点则吸取效果减少40点，若不存在pp值相等的技能则当回合必定打出致命一击|战斗阶段结束时，若自身若不存在pp值相等的技能，则使自身每个技能的pp值尽可能等于所有技能pp值的平均值，技能pp值总和每因此减少1点，下回合所有技能先制+1，最高+4|（boss无效）"@zh ;
    seer:effectAlias "alias_2477_40_400_40_4_1" ;
    seer:intensified false ;
    seer:isAdv false ;
    seer:pveEffective true ;
