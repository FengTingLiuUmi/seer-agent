seer:soulmark_1313 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4067 ;
    seer:desc "回合开始时自身体力每降低10%则当回合闪避概率提升10%；对手攻击未命中则下回合自身攻击技能先制+1，战斗阶段结束时体力高于对手则攻击额外致命一击；对手攻击命中则下回合自身属性技能先制+1，战斗阶段结束时体力低于对手则属性额外{吸取}对手最大{体力}的1/3（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时自身体力每降低10%当回合自身都有10%<color=#64F9FA>闪避</color>对手的<b>攻击</b>\r
\r
<indent=0><sprite=0><indent=16>触发效果：\r
<indent=16><sprite=3><indent=32>对手攻击未命中则下回合令自身攻击技能<b>先制</b>+1\r
<indent=32><sprite=4><indent=48>当回合战斗阶段结束时若体力高于对手则额外令自身下回合攻击技能必定<color=#64F9FA>打出致命一击</color>\r
<indent=16><sprite=3><indent=32>对手攻击命中则下回合令自身属性技能<b>先制</b>+1\r
<indent=32><sprite=4><indent=48>当回合战斗阶段结束时若体力低于对手则额外令自身下回合属性技能<color=#64F9FA>吸取</color>对手最大体力的1/3"""@zh ;
