seer:soulmark_1068 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_3792 ;
    seer:desc "回合开始时，若自身体力高于最大的1/2则攻击命中后使对手攻击-1、特攻-1，若自身体力低于最大的1/2则当回合造成的攻击伤害翻倍；攻击造成的伤害高于300则{吸取}对手最大{体力}的1/3，造成的伤害低于300则特攻+1、速度+1（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时：\r
<indent=32><sprite=4><indent=48>若自身体力高于最大的1/2则攻击命中后使对手攻击-1、特攻-1\r
<indent=32><sprite=4><indent=48>若自身体力低于最大的1/2则当回合造成的<b>攻击伤害</b><color=#64F9FA>翻倍</color>\r
\r
<indent=0><sprite=0><indent=16>触发效果：\r
