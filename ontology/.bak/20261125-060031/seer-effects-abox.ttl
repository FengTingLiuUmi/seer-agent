seer:soulmark_1744 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4531 ;
    seer:desc "自身攻击技能命中时反转对手能力提升，然后若对手处于能力下降则造成伤害提升50%；|战斗阶段结束时，若对手不处于能力提升则1回合内使对手体力恢复效果减少50%，若对手同时处于能力下降则回合数+2|（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>攻击技能额外效果：\r
<indent=16><sprite=3><indent=32>自身攻击技能命中时<color=#64F9FA>反转</color>对手<b>能力提升</b>\r
<indent=32><sprite=4><indent=48>然后若对手处于能力下降则造成的<b>攻击伤害</b><color=#64F9FA>提升</color>50%\r
\r
<indent=0><sprite=0><indent=16>战阶结束效果：\r
<indent=16><sprite=3><indent=32>战斗阶段结束时\r
<indent=32><sprite=4><indent=48>若对手不处于能力提升则1回合内使对手<b>体力恢复效果</b><color=#64F9FA>减少</color>50%\r
<indent=32><sprite=4><sprite=4><indent=64>若对手同时处于能力下降则回合数+2"""@zh ;
