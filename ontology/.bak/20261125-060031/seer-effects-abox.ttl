seer:soulmark_1769 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:advanceOf seer:pet_advance_16 ;
    seer:affectsPet seer:pet_3716 ;
    seer:analyzeDesc "[sprite name=dot4]自身[color=#57c975]免疫[/color]受到的[color=#57c975]石化[/color]状态|[sprite name=dot4]自身[color=#57c975]护盾[/color]值高于[color=#52a5f2]对手[/color]时造成的[color=#52a5f2]攻击伤害[/color]提升50%，自身的[color=#57c975]护盾[/color]值低于[color=#52a5f2]对手[/color]时受到的[color=#52a5f2]攻击伤害[/color]、[color=#52a5f2]固定伤害[/color]、[color=#52a5f2]百分比伤害[/color]减少50%|[sprite name=dot4][color=#57c975]战斗阶段结束时[/color]，若自身体力高于[color=#52a5f2]对手[/color]则获得自身最大体力1/3的[color=#57c975]护盾[/color]，若低于[color=#52a5f2]对手[/color]则恢复最大体力1/3并附加恢复量的[color=#52a5f2]百分比伤害[/color]|[sprite name=dot4]自身[color=#57c975]使用技能后[/color]，若本次技能为攻击技能则开启2回合[color=#f35555]暗影魔盾[/color]，若本次技能为属性技能则开启2回合[color=#f35555]幽冥魔盾[/color]，[color=#52a5f2]然后[/color]若自身拥有[color=#f35555]暗影魔盾[/color]与[color=#f35555]幽冥魔盾[/color]，则触发灵魂干涉"@zh ;
    seer:derivedFrom seer:soulmark_993 ;
    seer:desc "自身免疫受到的石化状态|自身护盾值高于对手时造成的攻击伤害提升50%，自身的护盾值低于对手时受到的攻击伤害、固定伤害、百分比伤害减少50%|战斗阶段结束时，若自身体力高于对手则获得自身最大体力1/3的护盾，若低于对手则恢复最大体力1/3并附加恢复量的百分比伤害|自身使用技能后，若本次技能为攻击技能则开启2回合暗影魔盾，若本次技能为属性技能则开启2回合幽冥魔盾，然后若自身拥有暗影魔盾与幽冥魔盾，则触发灵魂干涉|（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>常驻效果：\r
<indent=16><sprite=3><indent=32>自身天生<color=#64F9FA>免疫<b></color>石化</b>状态\r
<indent=16><sprite=3><indent=32>自身护盾值高于对手时造成的<b>攻击伤害<color=#64F9FA></b>提升</color>50%\r
<indent=16><sprite=3><indent=32>自身的护盾值低于对手时受到的<b>攻击伤害、固定伤害、百分比伤害<color=#64F9FA></b>减少</color>50%\r
\r
<indent=0><sprite=0><indent=16>战阶结束效果：\r
<indent=16><sprite=3><indent=32>战斗阶段结束时：\r
<indent=32><sprite=4><indent=48>若自身体力高于对手则<color=#64F9FA>获得</color>自身最大体力1/3的<b>护盾</b>\r
<indent=32><sprite=4><indent=48>若自身体力低于对手则<color=#64F9FA>恢复</color>最大体力1/3并造成等量<b>百分比伤害</b>\r
\r
<indent=0><sprite=0><indent=16>技能额外效果： \r
<indent=16><sprite=3><indent=32>使用攻击技能后开启暗影护盾：2回合内<color=#64F9FA>闪避</color>对手的<b>物理攻击</b>\r
<indent=16><sprite=3><indent=32>使用属性技能后开启幽冥之盾：2回合内<color=#64F9FA>闪避</color>对手的<b>特殊攻击</b>\r
<indent=16><sprite=3><indent=32>上述效果触发后，若自身同时处于暗影护盾、幽冥之盾则对对手进行灵魂干涉：100%<color=#64F9FA>使对手疲惫</color>"""@zh ;
