seer:soulmark_1869 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4666 ;
    seer:desc "回合开始时自身根据双方速度值之差n触发如下效果：|①.当回合使用技能时附加n点固定伤害|②.恢复n点体力|③.若n≥200则当回合所有技能先制+1|（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时自身根据双方速度值之差n触发如下效果：\r
<indent=32><sprite=4><indent=48>①.当回合使用技能时<color=#64F9FA>附加</color>n点<b>固定伤害</b>\r
<indent=32><sprite=4><indent=48>②.<color=#64F9FA>恢复</color>n点<b>体力</b>\r
<indent=32><sprite=4><indent=48>③.若n≥200则当回合所有技能<b>先制</b>+1"""@zh ;
