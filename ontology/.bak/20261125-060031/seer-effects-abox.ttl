seer:soulmark_1743 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4530 ;
    seer:desc "自身受到攻击伤害后随机恢复100~300点体力，造成攻击伤害后随机附加100~300点固定伤害；|战斗阶段结束时若自身体力低于对手，则下回合自身忽略对手30%的速度值与特防值|（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>触发效果：\r
