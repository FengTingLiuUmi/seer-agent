seer:soulmark_1225 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_3960 ;
    seer:desc "所有攻击无视对手双防能力提升状态；每个月的5日，冠绝火龙之力爆发：攻击值增加200点；每个月的10日，冠绝飞龙之力爆发：速度值增加100点；每个月的15日，冠绝岩龙之力爆发：双防值增加100点；每个月的20日，冠绝冰龙之力爆发：体力值增加400点！（boss有效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>攻击技能额外效果：\r
<indent=16><sprite=3><indent=32>自身所有攻击<color=#64F9FA>无视</color>对手双防<b>能力提升状态</b>\r
\r
<indent=0><sprite=0><indent=16>限定效果：\r
<indent=16><sprite=3><indent=32>根据每月的不同日期，自身获得以下效果：\r
<indent=32><sprite=4><indent=48>每月的5日冠绝火龙之力爆发：自身在战斗中攻击值增加200点\r
<indent=32><sprite=4><indent=48>每月的10日冠绝飞龙之力爆发：自身在战斗中速度值增加100点\r
<indent=32><sprite=4><indent=48>每月的15日冠绝岩龙之力爆发：自身在战斗中双防值增加100点\r
<indent=32><sprite=4><indent=48>每月的20日冠绝冰龙之力爆发：自身在战斗中体力值增加400点"""@zh ;
    seer:effectAlias "alias_1560_5_200_10_100_15_100_20_400" ;
