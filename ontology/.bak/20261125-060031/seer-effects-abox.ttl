    seer:sourceUrl "https://api.seerapi.com/v1/soulmark/1844" .

seer:soulmark_1854 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4652 ;
    seer:desc "自身每次在场首次使用攻击技能之后，本次在场每回合结束后自身恢复携带技能威力之和的体力|自身每次受到攻击伤害后附加给对手200点固定伤害，每次触发提升100，最高400，对手技能微弱自身时效果翻倍|（boss无效）"@zh ;
