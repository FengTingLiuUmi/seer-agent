seer:soulmark_1227 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_3962 ;
    seer:desc "回合开始时，若自身处于异常状态则为自身附加等同于自身最大体力1/3的护盾，若自身不处于异常状态则回合结束使对手随机1个技能的PP值归零；自身受到的攻击伤害低于自身最大体力的1/3则战斗阶段结束时恢复自身最大体力的1/3（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>回合开始效果：\r
