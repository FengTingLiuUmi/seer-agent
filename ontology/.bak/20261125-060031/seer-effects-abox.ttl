seer:soulmark_1972 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4761 ;
    seer:analyzeDesc "[sprite name=dot4]战斗开始时，自身种下[color=#f35555]希望之花[/color]，且除此特性外对方精灵每有一个含有[color=#52a5f2]“秒杀”[/color]的特性，[color=#52a5f2]己方[/color][color=#52a5f2]危机感[/color]+1|[sprite name=dot4]自身[color=#57c975]登场时[/color]1回合内免疫并[color=#57c975]反弹[/color]受到的异常状态，若直到[color=#57c975]战斗阶段结束时[/color]未免疫异常状态则恢复最大体力的1/3|[sprite name=dot4][color=#57c975]回合开始时[/color]，若对手为自身天敌则[color=#52a5f2]当回合[/color]自身受到的[color=#52a5f2]攻击伤害[/color]减少50%，若自身为对手天敌则所有技能恢复1点PP值且[color=#52a5f2]当回合[/color][color=#52a5f2]先制[/color]+1"@zh ;
    seer:desc "战斗开始时，自身种下希望之花，且除此特性外对方精灵每有一个含有“秒杀”的特性，己方危机感+1|自身登场时1回合内免疫并反弹受到的异常状态，若直到战斗阶段结束时未免疫异常状态则恢复最大体力的1/3|回合开始时，若对手为自身天敌则当回合自身受到的攻击伤害减少50%，若自身为对手天敌则所有技能恢复1点PP值且当回合先制+1|（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>战斗开始效果：\r
<indent=16><sprite=3><indent=32>战斗开始时自身为己方种下<color=#FFF779>希望之花</color>，且除此特性外对方精灵每有一个含有“秒杀”的特性，己方<b>危机感</b>+1\r
\r
<indent=0><sprite=0><indent=16>登场效果：\r
<indent=16><sprite=3><indent=32>自身登场时1回合内<color=#64F9FA>免疫并反弹</color>受到的<b>异常状态</b>\r
<indent=32><sprite=4><indent=48>若直到战斗阶段结束时未免疫异常状态则<color=#64F9FA>恢复</color>最大体力的1/3\r
\r
<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时：\r
<indent=32><sprite=4><indent=48>若对手为自身天敌则当回合自身受到的<b>攻击伤害</b><color=#64F9FA>减少</color>50%\r
<indent=32><sprite=4><indent=48>若自身为对手天敌则所有技能<color=#64F9FA>恢复</color>1点<b>PP值</b>且当回合<b>先制</b>+1\r
\r
<indent=0><sprite=5><indent=15>危机感：\r
<indent=16><sprite=6><indent=32>恒常存在的规则值，初始为1\r
\r
<indent=0><sprite=5><indent=15>希望之花（上限100点）：\r
<indent=16><sprite=6><indent=32>回合结束后己方每有1点危机感，希望之花成长2点\r
<indent=16><sprite=6><indent=32>希望之花成长至100点时转化为希望\r
<indent=16><sprite=6><indent=32>己方精灵被秒杀效果击败时对手所有技能<b>PP值</b><color=#64F9FA>归0</color>且希望之花会被摧毁\r
\r
<indent=0><sprite=5><indent=15>希望：\r
<indent=16><sprite=6><indent=32>己方<color=#64F9FA>免疫</color><b>秒杀</b>效果\r
<indent=16><sprite=6><indent=32>己方受到的<b>攻击伤害、固定伤害、百分比伤害</b><color=#64F9FA>额外减少</color>25%\r
<indent=16><sprite=6><indent=32>己方每回合首次进入异常状态时<color=#64F9FA>消除</color>对手<b>回合类效果</b>"""@zh ;
    seer:effectAlias "alias_2386_1_0" ;
    seer:intensified false ;
    seer:isAdv false ;
    seer:pveEffective false ;
    seer:seerapiId "1972" ;
