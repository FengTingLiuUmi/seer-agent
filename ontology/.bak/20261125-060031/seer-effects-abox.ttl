seer:soulmark_1410 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4187 ;
    seer:desc "回合开始时，若自身处于异常状态则吸取对手能力提升状态，若对手不处于能力提升状态则令对手随机进入2种异常状态；|回合开始时，若自身不处于异常状态则当回合自身受到的攻击伤害减少50%，若受到的攻击伤害大于300则使对手进入失明状态（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时：\r
<indent=32><sprite=4><indent=48>若自身处于异常状态则<color=#64F9FA>吸取</color>对手<b>能力提升状态</b>\r
<indent=32><sprite=4><sprite=4><indent=64>对手不处于能力提升状态时改为随机<color=#64F9FA>附加</color>2种<b>异常状态</b>\r
<indent=32><sprite=4><indent=48>若自身不处于异常状态则当回合自身受到的<b>攻击伤害</b><color=#64F9FA>减少</color>50%且受到大于300的攻击伤害时<color=#64F9FA>令对手失明</color>"""@zh ;
