seer:soulmark_1174 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_3907 ;
    seer:desc "自身先出手时附加300点固定伤害，若回合开始时体力高于对手则转变为附加400点固定伤害，自身后出手时下回合受到的伤害减少50%，若回合开始时体力高于对手则转变为减少60%；自身受到的攻击伤害高于300则令对手下次使用的攻击技能失效（boss无效）"@zh ;
