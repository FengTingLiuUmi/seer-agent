seer:soulmark_1357 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4126 ;
    seer:analyzeDesc "[sprite name=dot4][color=#57c975]回合开始时[/color]，若[color=#52a5f2]对手[/color]处于[color=#57c975]麻痹[/color]状态则自身[color=#57c975]攻击技能命中后[/color]附加[color=#52a5f2]对手[/color]最大体力1/3的[color=#52a5f2]百分比伤害[/color]；[color=#57c975]战斗阶段结束时[/color]，若[color=#52a5f2]对手[/color]不处于[color=#57c975]麻痹[/color]状态则使自身下回合所有[color=#52a5f2]技能先制[/color]+1；|[sprite name=dot4]自身[color=#52a5f2]主动切换[/color][color=#57c975]下场时[/color]，使[color=#52a5f2]己方[/color]下1只[color=#57c975]出战[/color]精灵获得[color=#f35555]神王血契[/color]；每次[color=#52a5f2]主动切换[/color]上场时，使自身获得[color=#f35555]神王血盾[/color]；自身死亡切换[color=#57c975]下场时[/color]，[color=#52a5f2]己方[/color]下1只[color=#57c975]出战[/color]精灵同时获得[color=#f35555]神王血契[/color]和[color=#f35555]神王血盾[/color]"@zh ;
    seer:desc "回合开始时，若对手处于麻痹状态则自身攻击技能命中后附加对手最大体力1/3的百分比伤害；战斗阶段结束时，若对手不处于麻痹状态则使自身下回合所有技能先制+1；|自身主动切换下场时，使己方下1只出战精灵获得神王血契；每次主动切换上场时，使自身获得神王血盾；自身死亡切换下场时，己方下1只出战精灵同时获得神王血契和神王血盾|（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时，若对手处于麻痹状态则自身<b>攻击技能</b><color=#64F9FA>附加</color>对手最大体力1/3的<b>百分比伤害</b>\r
\r
<indent=0><sprite=0><indent=16>战阶结束效果：\r
