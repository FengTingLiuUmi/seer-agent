seer:soulmark_1904 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4332 ;
    seer:derivedFrom seer:soulmark_1558 ;
    seer:desc "回合开始时若自身处于异常状态则当回合自身有100%的概率闪避对手攻击技能，若对手命中则自身受到的伤害降低50%|战斗阶段结束时若双方任意一方处于异常状态则100%令对手麻痹，然后若双方任意一方不处于异常状态则恢复自身最大体力的1/3|（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时，若自身处于异常状态则当回合自身有100%的概率<color=#64F9FA>闪避</color>对手<b>攻击技能</b>\r
<indent=32><sprite=4><indent=48>若对手命中则自身受到的<b>攻击伤害<color=#64F9FA></b>降低</color>50%\r
\r
<indent=0><sprite=0><indent=16>战阶结束效果：\r
<indent=16><sprite=3><indent=32>战斗阶段结束时，若双方任意一方处于异常状态则100%<color=#64F9FA>令对手麻痹</color>\r
<indent=32><sprite=4><indent=48>然后若双方任意一方不处于异常状态则<color=#64F9FA>恢复</color>自身最大体力的1/3"""@zh ;
