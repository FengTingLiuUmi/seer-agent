seer:soulmark_1667 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4453 ;
    seer:desc "自身使用攻击技能后若命中则100%令对手冻伤，若未命中则100%令对手冰封；战斗阶段结束时若对手不处于异常状态则下回合自身攻击技能先制+1且必定命中（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>攻击技能额外效果：\r
<indent=16><sprite=3><indent=32>自身使用攻击技能后：\r
