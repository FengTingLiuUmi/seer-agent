seer:soulmark_1792 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4582 ;
    seer:desc "自身登场后首次使用攻击技能时消除对手回合类效果，消除成功则当回合造成的攻击伤害提升100%且此效果延续至下1次攻击；自身登场后首次属性技能使用后100%令对手睡眠，触发成功则附加对手最大体力1/3的百分比伤害且此效果延续至下1次属性技能；上述效果至少有一个存在时，回合结束后自身恢复300点体力，若自身体力值为满则转变为使自身下回合造成的攻击伤害提升50%（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>登场效果：\r
