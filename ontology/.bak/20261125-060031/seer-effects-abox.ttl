seer:soulmark_1969 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4758 ;
    seer:desc "自身使用攻击技能时附加100点固定伤害且造成的攻击伤害提升25%，每回合结束时恢复100点体力，回合开始时若自身处于能力提升、能力下降、异常状态中的任意一种则上述效果翻倍|（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>常驻效果：\r
<indent=16><sprite=3><indent=32>自身造成的<b>攻击伤害</b><color=#64F9FA>提升</color>25%，使用攻击技能时<color=#64F9FA>附加</color>100点<b>固定伤害</b>，每回合结束时<color=#64F9FA>恢复</color>100点<b>体力</b>\r
<indent=32><sprite=4><indent=48>回合开始时若自身处于能力提升、能力下降、异常状态中的任意一种则上述所有效果翻倍"""@zh ;
