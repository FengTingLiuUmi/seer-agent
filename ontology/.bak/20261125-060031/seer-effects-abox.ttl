seer:soulmark_917 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_3623 ;
    seer:analyzeDesc "[sprite name=dot4][color=#57c975]回合开始时[/color]，若自身体力不低于[color=#52a5f2]对手[/color]则[color=#52a5f2]当回合[/color]50%的概率[color=#57c975]闪避[/color][color=#52a5f2]对手[/color]攻击，若自身体力低于[color=#52a5f2]对手[/color]则[color=#57c975]闪避[/color]概率提升至80%，若[color=#52a5f2]对手[/color]攻击命中则自身[color=#52a5f2]当回合[/color]受到的[color=#52a5f2]攻击伤害[/color]减少50%|[sprite name=dot4][color=#57c975]回合开始时[/color]，若[color=#52a5f2]当回合[/color]自身选择了攻击技能则随机令自身2项属性+1，提升的能力中含有特攻时自身额外攻击+2、速度+2，若[color=#52a5f2]当回合[/color]自身选择了属性技能则自身下回合所有[color=#52a5f2]技能先制[/color]+2"@zh ;
    seer:desc "回合开始时，若自身体力不低于对手则当回合50%的概率闪避对手攻击，若自身体力低于对手则闪避概率提升至80%，若对手攻击命中则自身当回合受到的攻击伤害减少50%|回合开始时，若当回合自身选择了攻击技能则随机令自身2项属性+1，提升的能力中含有特攻时自身额外攻击+2、速度+2，若当回合自身选择了属性技能则自身下回合所有技能先制+2|（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>常驻效果：\r
<indent=16><sprite=3><indent=32>50%的概率<color=#64F9FA>闪避</color>对手的<b>攻击技能</b>，自身体力低于对手时概率提升至80%\r
