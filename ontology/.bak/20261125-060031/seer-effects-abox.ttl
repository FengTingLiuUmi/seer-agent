seer:soulmark_1993 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4407 ;
    seer:desc "回合开始时若双方任意一方处于异常状态则当回合自身所有技能额外先制+2；|战斗阶段结束时降低对手所有技能1点PP值并恢复自身所有技能2点PP值，之后若对手的所有技能PP值均为0则下回合自身使用技能后额外消耗对手全部体力|（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时若双方任意一方处于异常状态则当回合自身所有技能额外<b>先制</b>+2\r
\r
<indent=0><sprite=0><indent=16>战阶结束效果：\r
<indent=16><sprite=3><indent=32>战斗阶段结束时<color=#64F9FA>降低</color>对手所有技能1点<b>PP值</b>并<color=#64F9FA>恢复</color>自身所有技能2点<b>PP值</b>\r
<indent=32><sprite=4><indent=48>触发后若对手的所有技能PP值均为0则下回合自身使用的所有技能额外<color=#64F9FA>消耗</color>对手全部<b>体力</b>"""@zh ;
