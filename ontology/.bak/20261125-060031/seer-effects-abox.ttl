seer:soulmark_1841 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4636 ;
    seer:desc "回合开始时反转自身所处的能力下降状态，反转成功恢复自身最大体力的30%，若自身不处于能力下降状态则当回合造成的攻击伤害提升50%，受到的攻击伤害减少25%|自身被击败后消除对手的能力提升状态与回合类效果，己方3回合内攻击必定打出致命一击（boss有效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时<color=#64F9FA>反转</color>自身所处的<b>能力下降状态</b>\r
<indent=32><sprite=4><indent=48>反转成功<color=#64F9FA>恢复</color>自身最大体力的30%\r
<indent=32><sprite=4><indent=48>若自身不处于能力下降状态则当回合造成的<b>攻击伤害</b><color=#64F9FA>提升</color>50%，受到的<b>攻击伤害</b><color=#64F9FA>减少</color>25%\r
\r
<indent=0><sprite=0><indent=16>被击败效果：\r
<indent=16><sprite=3><indent=32>自身被击败后：\r
<indent=32><sprite=4><indent=48><color=#64F9FA>消除</color>对手的<b>能力提升状态</b>与<b>回合类效果</b>\r
<indent=32><sprite=4><indent=48>己方3回合内攻击必定<color=#64F9FA>打出致命一击</color>"""@zh ;
