seer:soulmark_1634 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4417 ;
    seer:desc "每次登场时100%令敌我双方流血2回合，任意一方未触发则2回合内对手所有先制效果失效；|回合开始时若自身处于流血状态，则当回合自身攻击技能命中前每损失1%体力，造成的伤害提升2%；|自身被击败时，若上回合开始自身处于流血状态，则下1次对手受到的攻击伤害提升100%|（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>登场效果：\r
<indent=16><sprite=3><indent=32>每次登场时100%<color=#64F9FA>令双方流血</color>2回合\r
<indent=32><sprite=4><indent=48>若任意一方未触发则2回合内对手使用的技能<color=#64F9FA>先制效果失效</color>\r
\r
<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时若自身处于流血状态，则：\r
<indent=32><sprite=4><indent=48>当回合自身使用攻击技能前每损失1%体力，造成的<b>攻击伤害</b><color=#64F9FA>提升</color>2%\r
<indent=32><sprite=4><indent=48>当回合若自身被击败，则对手下1次受到的<b>攻击伤害</b><color=#64F9FA>提升</color>100%"""@zh ;
