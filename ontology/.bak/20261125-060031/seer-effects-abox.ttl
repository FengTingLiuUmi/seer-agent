seer:soulmark_2039 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4848 ;
    seer:desc "登场时，自身获得数值等同于对手的护盾、护罩之和的护盾、护罩，最高各1000点，若获得的点数合计高于600，则2回合内对手属性技能无效；对手的属性技能处于无效状态时，自身造成的攻击伤害提升100%|（boss无效）"@zh ;
