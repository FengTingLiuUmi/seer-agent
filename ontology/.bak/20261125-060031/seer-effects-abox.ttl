seer:soulmark_1594 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4368 ;
    seer:desc "战斗阶段结束时若自身当前体力低于最大体力的1/2则恢复自身最大体力的1/3且令自身随机3项能力值+1，若自身当前体力高于最大体力的1/2则附加自身最大体力1/3的百分比伤害且令对手随机3项能力值-1；|对手使用攻击技能时若处于能力下降状态则50%进入害怕，未触发则造成的伤害降低50%（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>战阶结束效果：\r
<indent=16><sprite=3><indent=32>战斗阶段结束时：\r
<indent=32><sprite=4><indent=48>若自身当前体力低于最大体力的1/2则<color=#64F9FA>恢复</color>自身最大体力的1/3且令自身随机3项能力值+1\r
<indent=32><sprite=4><indent=48>若自身当前体力高于最大体力的1/2则<color=#64F9FA>附加</color>自身最大体力1/3的<b>百分比伤害</b>且令对手随机3项能力值-1\r
\r
<indent=0><sprite=0><indent=16>攻击技能额外效果：\r
<indent=16><sprite=3><indent=32>对手使用攻击技能时若处于能力下降状态则50%受到害怕\r
<indent=32><sprite=4><indent=48>未触发则造成的<b>攻击伤害</b><color=#64F9FA>降低</color>50%"""@zh ;
