seer:soulmark_1722 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4509 ;
    seer:desc "战斗阶段结束时若对手当前体力百分比高于自身则发动魔祖之渎：{吸取}对手最大{体力}的1/3；|战斗阶段结束时若对手当前存在能力等级高于自身则发动魔祖之嗟：令自身全属性+1、令对手全属性-1；|战斗阶段结束时若对手当回合造成的攻击伤害高于自身则发动魔祖之蛊：随机附加2种异常状态|（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>战阶结束效果：\r
<indent=16><sprite=3><indent=32>战斗阶段结束时：\r
<indent=32><sprite=4><indent=48>若对手当前体力百分比高于自身则发动魔祖之渎：<color=#64F9FA>吸取</color>对手最大体力的1/3\r
<indent=32><sprite=4><indent=48>若对手当前存在能力等级高于自身则发动魔祖之嗟：令自身<color=#64F9FA>全属性+1</color>、令对手<color=#64F9FA>全属性-1</color>\r
<indent=32><sprite=4><indent=48>若对手当回合造成的攻击伤害高于自身则发动魔祖之蛊：随机附加2种<b>异常状态</b>"""@zh ;
    seer:effectAlias "alias_2113_3_1_1_2_1" ;
    seer:intensified false ;
    seer:isAdv false ;
    seer:pveEffective false ;
    seer:seerapiId "1722" ;
