seer:soulmark_722 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_3407 ;
    seer:analyzeDesc "[sprite name=dot4][color=#52a5f2]回合开始时[/color]若自身体力高于[color=#52a5f2]对手[/color]，则[color=#52a5f2]当回合[/color]自身攻击[color=#52a5f2]技能先制[/color]+1且造成的伤害提高50%；[color=#57c975]战斗阶段结束时[/color]若自身体力低于[color=#52a5f2]对手[/color]，则100%使[color=#52a5f2]对手[/color][color=#57c975]麻痹[/color]2回合，[color=#52a5f2]未触发[/color][color=#57c975]麻痹[/color]则自身下2次攻击[color=#52a5f2]技能先制[/color]+2且有80%概率使[color=#52a5f2]对手[/color][color=#57c975]焚烬[/color]，若触发[color=#57c975]麻痹[/color]则令[color=#52a5f2]对手[/color][color=#57c975]烧伤[/color]3回合；[color=#52a5f2]回合开始时[/color]若[color=#52a5f2]对手[/color]处于[color=#52a5f2]异常状态[/color]则[color=#52a5f2]当回合[/color][color=#57c975]战斗阶段结束时[/color]恢复自身最大体力的1/3并附加恢复量的[color=#52a5f2]百分比伤害[/color]"@zh ;
    seer:desc "回合开始时若自身体力高于对手，则当回合自身攻击技能先制+1且造成的伤害提高50%；战斗阶段结束时若自身体力低于对手，则100%使对手麻痹2回合，未触发麻痹则自身下2次攻击技能先制+2且有80%概率使对手焚烬，若触发麻痹则令对手烧伤3回合；回合开始时若对手处于异常状态则当回合战斗阶段结束时恢复自身最大体力的1/3并附加恢复量的百分比伤害|（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时：\r
<indent=32><sprite=4><indent=48>若自身体力高于对手，则当回合自身攻击<b>先制</b>+1且造成的伤害<color=#64F9FA>提升</color>50%\r
<indent=32><sprite=4><indent=48>若对手处于异常状态则当回合战斗阶段结束时<color=#64F9FA>恢复</color>自身最大体力的1/3并造成等量<b>百分比伤害</b>\r
\r
<indent=0><sprite=0><indent=16>战阶结束效果：\r
<indent=16><sprite=3><indent=32>战斗阶段结束时若自身体力低于对手，则100%<color=#64F9FA>使对手麻痹</color>2回合\r
<indent=32><sprite=4><indent=48>未触发麻痹则自身下2次攻击<b>先制</b>+2且有80%概率<color=#64F9FA>使对手焚烬</color>\r
<indent=32><sprite=4><indent=48>若触发麻痹则<color=#64F9FA>使对手烧伤</color>2回合"""@zh ;
    seer:effectAlias "alias_1007_1_50_2_2_2_80_3_1" ;
