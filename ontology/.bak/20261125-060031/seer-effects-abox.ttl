seer:soulmark_782 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_3467 ;
    seer:analyzeDesc "[sprite name=dot4]自身[color=#52a5f2]首次[/color]于[color=#52a5f2]对手[/color]出手回合受到[color=#52a5f2]致死伤害[/color]时[color=#52a5f2]当回合[/color][color=#52a5f2]保留[/color]1点体力，同时消除双方[color=#52a5f2]能力提升状态[/color]和[color=#52a5f2]回合类效果[/color]，并令[color=#52a5f2]对手[/color][color=#57c975]烧伤[/color]2回合|[sprite name=dot4][color=#57c975]回合开始时[/color]若自身体力高于[color=#52a5f2]对手[/color]则[color=#52a5f2]当回合[/color]受到攻击时使[color=#52a5f2]对手[/color][color=#57c975]焚烬[/color]，[color=#52a5f2]未触发[/color]则消除[color=#52a5f2]对手[/color][color=#52a5f2]回合类效果[/color]；[color=#57c975]战斗阶段结束时[/color]若自身体力低于[color=#52a5f2]对手[/color]则恢复自身[color=#52a5f2]已损失体力[/color]的1/2"@zh ;
    seer:desc "自身首次于对手出手回合受到致死伤害时当回合保留1点体力，同时消除双方能力提升状态和回合类效果，并令对手烧伤2回合|回合开始时若自身体力高于对手则当回合受到攻击时使对手焚烬，未触发则消除对手回合类效果；战斗阶段结束时若自身体力低于对手则恢复自身已损失体力的1/2|（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>限定效果（每场战斗限1次）：\r
<indent=16><sprite=3><indent=32><b>对手出手回合</b>若自身受到致命伤害：\r
<indent=32><sprite=4><indent=48><color=#64F9FA>保留</color>1点<b>体力</b>\r
<indent=32><sprite=4><indent=48><color=#64F9FA>消除</color>双方<b>能力提升状态</b>和<b>回合类效果</b>\r
<indent=32><sprite=4><indent=48><color=#64F9FA>使对手烧伤</color>2回合\r
\r
<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时若自身体力高于对手则当回合受到攻击时<color=#64F9FA>使对手焚烬</color>\r
<indent=32><sprite=4><indent=48>未触发焚烬则<color=#64F9FA>消除</color>对手<b>回合类效果</b>\r
\r
<indent=0><sprite=0><indent=16>战阶结束效果：\r
<indent=16><sprite=3><indent=32>战斗阶段结束时若自身体力低于对手则<color=#64F9FA>恢复</color>自身已损失体力的1/2"""@zh ;
