seer:soulmark_1825 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:advanceOf seer:pet_advance_3 ;
    seer:affectsPet seer:pet_3613 ;
    seer:analyzeDesc "[sprite name=dot4][color=#57c975]回合开始时[/color]，若本回合[color=#52a5f2]对手[/color]选择了攻击技能则[color=#52a5f2]对手[/color]随机1个技能PP值归零且[color=#52a5f2]当回合[/color]造成的[color=#52a5f2]攻击伤害[/color]无法超过自身最大体力的1/3，若[color=#52a5f2]对手[/color]选择了属性技能则自身[color=#52a5f2]当回合[/color][color=#57c975]免疫[/color]受到的[color=#52a5f2]异常状态[/color]与[color=#52a5f2]能力下降状态[/color]，若[color=#52a5f2]对手[/color]未选择技能则自身获得1点[color=#f35555]灵茉之芯[/color]|[sprite name=dot1]自身[color=#57c975]被击败后[/color]，使下只精灵获得[color=#f35555]芳馨之祝[/color]"@zh ;
    seer:derivedFrom seer:soulmark_909 ;
    seer:desc "回合开始时，若本回合对手选择了攻击技能则对手随机1个技能PP值归零且当回合造成的攻击伤害无法超过自身最大体力的1/3，若对手选择了属性技能则自身当回合免疫受到的异常状态与能力下降状态，若对手未选择技能则自身获得1点灵茉之芯|自身被击败后，使下只精灵获得芳馨之祝|（boss有效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时：\r
<indent=32><sprite=4><indent=48>若当回合对手选择使用攻击技能，则：\r
<indent=32><sprite=4><sprite=4><indent=64>使对手随机1个技能<b>PP值</b><color=#64F9FA>归零</color>\r
<indent=32><sprite=4><sprite=4><indent=64>当回合自身受到的<b>攻击伤害</b><color=#64F9FA>无法超过</color>最大体力的1/3\r
<indent=32><sprite=4><indent=48>若当回合对手选择使用属性技能，则当回合自身<color=#64F9FA>免疫</color>所有<b>异常状态</b>和<b>能力下降状态</b>\r
<indent=32><sprite=4><indent=48>若当回合对手未选择技能，则自身获得1点<color=#FFF779>灵茉之芯</color>\r
\r
<indent=0><sprite=0><indent=16>被击败效果（boss有效）：\r
<indent=16><sprite=3><indent=32>自身被击败后，使己方下只精灵出战时获得<color=#FFF779>芳馨之祝</color>\r
\r
<indent=0><sprite=5><indent=15>灵茉之芯（上限3点，下场保留）：\r
<indent=16><sprite=6><indent=32>每有1点：\r
<indent=32><sprite=4><indent=48>自身造成的<b>固定伤害、百分比伤害</b><color=#64F9FA>提升</color>10%\r
<indent=32><sprite=4><indent=48>所获得芳馨之祝内的回合计数效果，持续回合+1\r
\r
<indent=0><sprite=5><indent=15>芳馨之祝：\r
<indent=16><sprite=6><indent=32><color=#64F9FA>获得</color>500点<b>护盾</b>和500点<b>护罩</b>\r
<indent=16><sprite=6><indent=32>1回合内<color=#64F9FA>免疫</color>受到的<b>异常状态</b>且<color=#64F9FA>获得</color>500点<b>临时体力上限</b>（下场保留）"""@zh ;
