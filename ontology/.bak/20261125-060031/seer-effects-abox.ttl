seer:soulmark_2012 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4820 ;
    seer:desc "对手使用攻击技能时，若对手不处于异常状态则受到伤害减少20%且受到攻击后令对手烧伤，若对手处于烧伤状态则受到攻击后50%令对手害怕，未触发则恢复300点体力，自身处于烧伤状态时改为抵挡本次攻击且受到攻击后令对手害怕"@zh ;
