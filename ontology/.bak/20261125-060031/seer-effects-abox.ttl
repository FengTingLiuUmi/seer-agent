seer:soulmark_1000 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_3726 ;
    seer:desc "自身攻击造成的伤害低于300则下回合攻击必定打出致命一击，自身攻击造成的伤害高于300则自身全属性+1（boss有效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>攻击技能额外效果：\r
<indent=16><sprite=3><indent=32>自身攻击造成的攻击伤害低于300则下回合攻击必定<color=#64F9FA>打出致命一击</color>\r
<indent=16><sprite=3><indent=32>自身攻击造成的攻击伤害高于300则自身<color=#64F9FA>全属性+1</color>"""@zh ;
