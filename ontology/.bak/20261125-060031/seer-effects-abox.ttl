seer:soulmark_1246 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_3986 ;
    seer:analyzeDesc "[sprite name=dot4]神殇：[color=#57c975]回合开始时[/color]创造一个[color=#f35555]神秘结界[/color]|[sprite name=dot4][color=#f35555]神印[/color]：自身在出战背包时，[color=#52a5f2]对方[/color][color=#52a5f2]主动切换[/color]精灵[color=#57c975]登场时[/color]自身为其附加1层[color=#f35555]神印[/color]|[sprite name=dot4]神谕：自身在出战背包时，[color=#52a5f2]己方[/color]不在场精灵体力低于最大体力的1/2时不会下降|[sprite name=dot1]神照：自身在出战背包时，[color=#52a5f2]己方[/color]首发精灵[color=#52a5f2]首次[/color][color=#57c975]登场时[/color]获得一个等同于自身最大体力值30%的[color=#57c975]护盾[/color]|[sprite name=dot1]神启：[color=#57c975]回合开始时[/color]，若自身体力高于最大体力的1/2则[color=#52a5f2]当回合[/color]自身[color=#57c975]免疫[/color]受到的[color=#52a5f2]异常状态[/color]和[color=#52a5f2]能力下降状态[/color]，若自身体力低于最大体力的1/2则自身获得等同于最大体力值30%的[color=#57c975]护盾[/color]"@zh ;
    seer:desc "神殇：回合开始时创造一个神秘结界|神印：自身在出战背包时，对方主动切换精灵登场时自身为其附加1层神印|神谕：自身在出战背包时，己方不在场精灵体力低于最大体力的1/2时不会下降|神照：自身在出战背包时，己方首发精灵首次登场时获得一个等同于自身最大体力值30%的护盾（boss有效）|神启：回合开始时，若自身体力高于最大体力的1/2则当回合自身免疫受到的异常状态和能力下降状态，若自身体力低于最大体力的1/2则自身获得等同于最大体力值30%的护盾（boss有效）|（标注部分boss有效，其余无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>神殇：\r
<indent=16><sprite=3><indent=32>每回合开始时100%创造出一个神秘结界：随机放逐对手的不在场精灵，使其<color=#64F9FA>不能主动切换</color>上场进行战斗\r
<indent=32><sprite=4><indent=48>对手存活精灵≥5个时随机放逐1-3个，对手存活精灵＜5个时随机放逐1-2个\r
<indent=32><sprite=4><indent=48>阵亡的精灵无法被放逐，放逐的精灵数上限为对手当前存活精灵个数-2\r
\r
<indent=0><sprite=0><indent=16>神印：\r
<indent=16><sprite=3><indent=32>自身在出战背包时，每次对方<color=#64F9FA>主动切换</color>精灵登场都会为该精灵附加1层<color=#FFF779>神圣印记</color>\r
\r
<indent=0><sprite=0><indent=16>神谕：\r
<indent=16><sprite=3><indent=32>自身在出战背包时，己方所有体力低于最大体力的1/2的<b>不在场精灵</b><color=#64F9FA>不受削减体力的影响</color>\r
\r
<indent=0><sprite=0><indent=16>神照（boss有效）：\r
<indent=16><sprite=3><indent=32>自身在出战背包时，<b>己方首发精灵</b>登场后获得一个等同于启灵元神最大体力值30%的<b>护盾</b>\r
\r
<indent=0><sprite=0><indent=16>神启：\r
<indent=16><sprite=3><indent=32>回合开始时：\r
<indent=32><sprite=4><indent=48>若自身体力高于最大体力的1/2则<color=#64F9FA>免疫</color>所有<b>异常状态</b>和<b>能力下降状态</b>\r
<indent=32><sprite=4><indent=48>若自身体力低于最大体力的1/2则为自身<color=#64F9FA>附加</color>一个等同于自身最大体力值30%的<b>护盾</b>\r
\r
<indent=0><sprite=5><indent=15>神圣印记（上限3层，下场保留）：\r
<indent=16><sprite=6><indent=32>持有精灵主动切换登场的首战斗阶段结束时，依照层数受到<b>对应</b>的影响：\r
<indent=32><sprite=4><indent=48>1层：受到对方启灵元神最大体力1/8的真实伤害\r
<indent=32><sprite=4><indent=48>2层：受到对方启灵元神最大体力1/6的真实伤害\r
<indent=32><sprite=4><indent=48>3层：受到对方启灵元神最大体力1/4的真实伤害"""@zh ;
    seer:effectAlias "alias_1581_100_8_6_4_2_30_2_30" ;
    seer:intensified false ;
    seer:isAdv false ;
    seer:pveEffective true ;
    seer:seerapiId "1246" ;
