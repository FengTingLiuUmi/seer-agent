seer:soulmark_1592 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4366 ;
    seer:desc "自身使用攻击技能时若自身存在护盾则额外附加自身当前护盾量100%的百分比伤害，若自身不存在护盾则恢复自身最大体力的1/3并造成等量百分比伤害；|回合开始时若自身满体力则当回合造成的攻击伤害提升100%，若自身未满体力则为自身附加300点护盾（护盾无法叠加，boss无效）"@zh ;
