        seer:soulmark_tag_13,
        seer:soulmark_tag_9 ;
    seer:sourceUrl "https://api.seerapi.com/v1/soulmark/1583" .

seer:soulmark_1584 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4359 ;
    seer:desc "自身每次使用攻击技能则获得等同于对手上1次使用的攻击技能威力的提升，自身每次使用属性技能则令对手下回合无法使用属性技能；|回合开始时对手每有1个技能PP值≤2则令自身所有技能额外先制+1，战斗阶段结束时若自身体力低于对手则令对手所有技能PP值-1（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>技能额外效果：\r
<indent=16><sprite=3><indent=32>自身每次使用攻击技能则获得等同于对手上1次使用的攻击技能<b>威力</b>的<color=#64F9FA>提升</color>\r
<indent=16><sprite=3><indent=32>自身每次使用属性技能则令对手下回合<b>属性技能<color=#64F9FA></b>命中效果失效</color>\r
\r
<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时对手每有1个技能PP值≤2则令自身所有技能额外<b>先制</b>+1\r
\r
<indent=0><sprite=0><indent=16>战阶结束效果：\r
<indent=16><sprite=3><indent=32>战斗阶段结束时若自身体力低于对手则令对手所有技能PP值-1"""@zh ;
