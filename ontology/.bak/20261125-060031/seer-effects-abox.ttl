seer:soulmark_2063 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4876 ;
    seer:analyzeDesc "[sprite name=dot4]自身1号、3号位技能命中后自身获得200点[color=#57c975]护盾[/color]并令对手随机3项能力等级-1；自身2号、4号位技能命中后为自身恢复200点体力并令自身随机3项能力等级+1|[sprite name=dot4][color=#57c975]回合开始时[/color]，若双方能力提升等级之和不小于能力下降等级之和，为双方附加双方能力提升等级之和*15的[color=#57c975]护盾[/color]；若双方能力提升等级之和不大于能力下降等级之和，为双方附加双方能力下降等级之和*15的[color=#57c975]护罩[/color]"@zh ;
