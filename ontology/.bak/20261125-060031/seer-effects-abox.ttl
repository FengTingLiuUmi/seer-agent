seer:soulmark_2132 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4937 ;
    seer:analyzeDesc "[sprite name=dot4]双方[color=#57c975]使用技能时[/color]，令对手攻击、特攻-1，[color=#52a5f2]未触发[/color]则自身解除所处的异常状态且本场战斗自身造成的[color=#52a5f2]攻击伤害[/color]提升30%，最高150%|[sprite name=dot4][color=#57c975]战斗阶段结束时[/color]，若对手处于能力下降状态则令对手下回合属性[color=#52a5f2]技能无效[/color]，若对手不处于能力下降状态则恢复自身最大体力的1/3，每溢出10点自身下回合受到的[color=#52a5f2]攻击伤害[/color]减少1%且获得10点[color=#57c975]护盾[/color]，[color=#57c975]护盾[/color]存在期间自身每次[color=#57c975]受到攻击后[/color]消除对手能力提升状态"@zh ;
    seer:desc "双方使用技能时，令对手攻击、特攻-1，未触发则自身解除所处的异常状态且本场战斗自身造成的攻击伤害提升30%，最高150%|战斗阶段结束时，若对手处于能力下降状态则令对手下回合属性技能无效，若对手不处于能力下降状态则恢复自身最大体力的1/3，每溢出10点自身下回合受到的攻击伤害减少1%且获得10点护盾，护盾存在期间自身每次受到攻击后消除对手能力提升状态|（boss无效）"@zh ;
    seer:effectAlias "alias_2544_1_0" ;
