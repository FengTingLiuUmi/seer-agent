seer:soulmark_1855 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4653 ;
    seer:desc "自身每次使用攻击技能后，对手造成的攻击伤害、固定伤害、百分比伤害减少20%直到下场，最多可叠加3次；自身受到的攻击伤害低于300时恢复自身最大体力的1/3，若恢复至满则全属性+1且下次攻击造成的伤害提升100%（boss无效）"@zh ;
