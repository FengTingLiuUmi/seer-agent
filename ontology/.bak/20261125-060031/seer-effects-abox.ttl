seer:soulmark_1404 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4179 ;
    seer:desc "回合开始时，若自身拥有护盾状态则使用技能不消耗PP值，若自身未拥有护盾状态则对手使用技能消耗PP值翻倍；|战斗阶段结束时，若自身当回合受到攻击伤害则下回合免疫受到的攻击伤害且战斗阶段结束时{吸取}对手最大{体力}的1/3（boss无效）"@zh ;
