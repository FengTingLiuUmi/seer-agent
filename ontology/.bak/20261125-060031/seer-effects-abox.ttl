seer:soulmark_1292 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4037 ;
    seer:desc "回合开始时，若自身体力高于对手则令自身全属性+1，每次触发该效果后则当回合自身攻击先制+1，最多+3（先制效果切换下场后重新叠加）；本场战斗中自身攻击先出手时掌控啸风：40%的概率造成的攻击伤害翻倍，每次触发则概率增加10%，最高概率100%（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>回合开始效果：\r
