seer:soulmark_881 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_3577 ;
    seer:analyzeDesc "[sprite name=dot4]战斗开始时进入[color=#f35555]光之惩戒形态[/color]|[sprite name=dot4]自身[color=#57c975]攻击结束时[/color]，若本次攻击造成的伤害高于280则附加[color=#52a5f2]对手[/color]最大体力1/3的[color=#52a5f2]百分比伤害[/color]且令[color=#52a5f2]对手[/color]下回合使用的属性[color=#52a5f2]技能无效[/color]，若本次攻击造成的伤害低于280则[color=#52a5f2]吸取[/color][color=#52a5f2]对手[/color]最大体力的1/3且令自身下回合攻击技能必定打出[color=#52a5f2]致命一击[/color]|[sprite name=dot4]自身[color=#52a5f2]首次[/color]受到[color=#52a5f2]致死伤害[/color]时获得[color=#f35555]圣光祝福[/color]"@zh ;
