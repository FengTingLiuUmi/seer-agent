seer:soulmark_1605 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4386 ;
    seer:analyzeDesc "[sprite name=dot4]自身存活于[color=#52a5f2]己方[/color]出战背包时，每10回合触发1次[color=#f35555]幻境浪潮[/color]|[sprite name=dot4][color=#57c975]回合开始时[/color]，[color=#52a5f2]对手[/color]根据[color=#f35555]缔结印记[/color]达到的层数，获得以下效果|[sprite name=dot5]    1层：以[color=#52a5f2]回合类效果[/color]的形式，[color=#52a5f2]对手[/color]使用技能消耗的PP值翻倍；|[sprite name=dot5]    3层：造成的攻击[color=#52a5f2]伤害额外减少[/color]30%；|[sprite name=dot5]    5层：造成的[color=#52a5f2]固定伤害[/color]、百分比[color=#52a5f2]伤害额外减少[/color]30%；|[sprite name=dot5]    7层：[color=#57c975]无法通过其技能恢复体力[/color]且受到原本恢复量1/3的[color=#52a5f2]真实伤害[/color]|[sprite name=dot4][color=#57c975]回合开始时[/color]若自身体力为满则[color=#52a5f2]当回合[/color][color=#57c975]免疫[/color]受到的[color=#52a5f2]异常状态[/color]，若自身体力不为满则[color=#52a5f2]当回合[/color]使用技能无视[color=#52a5f2]对手[/color]双防[color=#52a5f2]能力提升状态[/color]；|[sprite name=dot4][color=#57c975]战斗阶段结束时[/color]若[color=#52a5f2]对手[/color]当前体力不高于[color=#57c975]回合开始时[/color]则下回合自身所有[color=#52a5f2]技能先制[/color]+1，若[color=#52a5f2]对手[/color]当前体力不低于[color=#57c975]回合开始时[/color]则恢复自身最大体力的1/3"@zh ;
    seer:desc "自身存活于己方出战背包时，每10回合触发1次幻境浪潮|回合开始时，对手根据缔结印记达到的层数，获得以下效果|    1层：以回合类效果的形式，对手使用技能消耗的PP值翻倍；|    3层：造成的攻击伤害额外减少30%；|    5层：造成的固定伤害、百分比伤害额外减少30%；|    7层：无法通过其技能恢复体力且受到原本恢复量1/3的真实伤害|回合开始时若自身体力为满则当回合免疫受到的异常状态，若自身体力不为满则当回合使用技能无视对手双防能力提升状态；|战斗阶段结束时若对手当前体力不高于回合开始时则下回合自身所有技能先制+1，若对手当前体力不低于回合开始时则恢复自身最大体力的1/3|（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>常驻效果：\r
<indent=16><sprite=3><indent=32>缔笙存活于出战背包时，战斗每经过10回合都会开启1次幻境浪潮：\r
<indent=32><sprite=4><indent=48>该10回合内对手的每个精灵<color=#64F9FA>每在场过1回合</color>都会被附加1层<b>缔结印记</b>，缔结印记持续10回合\r
<indent=16><sprite=3><indent=32>缔笙在场时，根据对手当前精灵缔结印记层数触发<b>累计</b>的效果：\r
<indent=32><sprite=4><indent=48>1层：每回合，对手都以回合类效果形式1回合内释放技能所消耗的PP值翻倍\r
<indent=32><sprite=4><indent=48>3层：对手造成的<b>攻击伤害</b><color=#64F9FA>降低</color>30%\r
<indent=32><sprite=4><indent=48>5层：对手造成的<b>固定伤害、百分比伤害</b><color=#64F9FA>降低</color>30%\r
<indent=32><sprite=4><indent=48>7层：对手无法通过自身技能恢复体力并<color=#64F9FA>受到</color>恢复量1/3的<b>真实伤害</b>；\r
\r
<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时：\r
<indent=32><sprite=4><indent=48>若自身满体力则当回合自身<color=#64F9FA>免疫</color>受到的<b>异常状态</b>\r
<indent=32><sprite=4><indent=48>若自身未满体力则当回合自身技能<color=#64F9FA>无视</color>对手<b>防御以及特防能力提升</b>状态\r
\r
<indent=0><sprite=0><indent=16>战阶结束效果：\r
<indent=16><sprite=3><indent=32>战斗阶段结束时：\r
<indent=32><sprite=4><indent=48>若对手当前体力<color=#64F9FA>不高于</color>回合开始时则下回合自身所有技能<b>先制</b>+1\r
<indent=32><sprite=4><indent=48>若对手当前体力<color=#64F9FA>不低于</color>回合开始时则<color=#64F9FA>恢复</color>自身最大体力的1/3,"""@zh ;
    seer:effectAlias "alias_1963_1_3_1" ;
    seer:intensified false ;
    seer:isAdv false ;
    seer:pveEffective false ;
    seer:seerapiId "1605" ;
    seer:soulmarkEffect "{\"effect\": {\"id\": 1963, \"url\": \"https://api.seerapi.com/v1/eid_effect/1963\"}, \"effect_args\": [1, 3, 1]}" ;
