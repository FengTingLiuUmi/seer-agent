seer:soulmark_1186 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_3921 ;
    seer:desc "每次出场后汲取自然界的力量：第1回合开始时为自身附加400点护盾，第2回合使用攻击50%打出致命一击，第3战斗阶段结束时恢复自身最大体力的1/2，第4战斗阶段结束时恢复自身所有技能PP值，第5回合开始时为自身附加400点护罩（之后回合循环上述效果，boss无效）"@zh ;
