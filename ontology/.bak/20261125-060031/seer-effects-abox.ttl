seer:soulmark_1389 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4163 ;
    seer:desc "自身能力提升状态被消除或吸取则100%令对手石化，未触发则消除对手回合类效果且为自身附加一个等同于自身最大体力值1/3的护盾；|自身使用攻击技能附加自身能力提升等级总段数x25的固定伤害，自身处于护盾状态时转变为自身能力提升等级总段数x30的固定伤害且50%令对手石化，未触发石化则令自身全属性+1（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>触发效果：\r
<indent=16><sprite=3><indent=32>自身能力提升状态被消除或吸取则100%<color=#64F9FA>令对手石化</color>\r
<indent=32><sprite=4><indent=48>未触发则<color=#64F9FA>消除</color>对手<b>回合类效果</b>且为自身<color=#64F9FA>附加</color>一个等同于自身最大体力值1/3的<b>护盾</b>\r
\r
<indent=0><sprite=0><indent=16>攻击技能额外效果：\r
<indent=16><sprite=3><indent=32>自身使用攻击技能<color=#64F9FA>附加</color>自身能力提升等级总段数*25的<b>固定伤害</b>\r
<indent=32><sprite=4><indent=48>自身处于护盾状态时转变为自身能力提升等级总段数*30的固定伤害且50%<color=#64F9FA>令对手石化</color>\r
<indent=32><sprite=4><sprite=4><indent=64>未触发石化则令自身<color=#64F9FA>全属性+1</color>"""@zh ;
