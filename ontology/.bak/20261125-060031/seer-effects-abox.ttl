        owl:NamedIndividual ;
    seer:affectsPet seer:pet_3749 ;
    seer:desc "自身先出手时{吸取}对手最大{体力}的1/4，自身体力低于最大体力的1/2时转变为{吸取}对手最大{体力}的1/3；自身后出手40%的概率免疫当回合受到的攻击伤害，自身体力低于最大体力的1/2时额外恢复等量体力（boss无效）"@zh ;
