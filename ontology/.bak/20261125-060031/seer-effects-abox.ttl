seer:soulmark_728 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_3414 ;
    seer:analyzeDesc "[sprite name=dot4][color=#57c975]登场时[/color]，消除[color=#52a5f2]对手[/color][color=#52a5f2]能力提升状态[/color]，消除成功则以[color=#57c975]回合类效果[/color]的形式令[color=#52a5f2]对手[/color]2回合内无法处于[color=#52a5f2]能力提升状态[/color]且令[color=#52a5f2]对手[/color]下1次使用的属性[color=#57c975]技能无效[/color]|[sprite name=dot4]每回合开始至[color=#57c975]战斗阶段结束时[/color]，若[color=#52a5f2]对手[/color]存在高于自身的能力等级，则令[color=#52a5f2]对手[/color]该能力等级变为与自身相同|[sprite name=dot1][color=#57c975]回合开始时[/color]，若自身不处于[color=#52a5f2]能力提升状态[/color]，则50%使自身[color=#57c975]免疫[/color][color=#52a5f2]对手[/color]下次使用的技能造成的[color=#52a5f2]攻击伤害[/color]，[color=#57c975]未触发[/color]则[color=#57c975]当回合[/color]受到的[color=#52a5f2]攻击伤害[/color]减少50%|[sprite name=dot1][color=#57c975]战斗阶段结束时[/color]若自身处于[color=#52a5f2]能力提升状态[/color]，则恢复自身最大体力的1/3并附加等量的[color=#57c975]百分比伤害[/color]，恢复量与附加量最高为自身当前已损失体力值"@zh ;
    seer:desc "登场时，消除对手能力提升状态，消除成功则以回合类效果的形式令对手2回合内无法处于能力提升状态且令对手下1次使用的属性技能无效|每回合开始至战斗阶段结束时，若对手存在高于自身的能力等级，则令对手该能力等级变为与自身相同|回合开始时，若自身不处于能力提升状态，则50%使自身免疫对手下次使用的技能造成的攻击伤害，未触发则当回合受到的攻击伤害减少50%|战斗阶段结束时若自身处于能力提升状态，则恢复自身最大体力的1/3并附加等量的百分比伤害，恢复量与附加量最高为自身当前已损失体力值（boss有效）|（标注部分boss有效，其余无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>登场效果：\r
<indent=16><sprite=3><indent=32>登场时<color=#64F9FA>消除</color>对手<b>能力提升状态</b>，消除成功则：\r
<indent=32><sprite=4><indent=48>以回合类效果形式令对手2回合内<color=#64F9FA>无法处于能力提升状态</color>\r
<indent=32><sprite=4><indent=48>令对手下1次使用的<b>属性技能</b><color=#64F9FA>无效</color>\r
\r
<indent=0><sprite=0><indent=16>常驻效果：\r
<indent=16><sprite=3><indent=32>每回合开始至战斗阶段结束时，若对手有高于自身的能力等级，则使对手该能力等级<color=#64F9FA>变为与自身相同</color>\r
\r
<indent=0><sprite=0><indent=16>回合开始效果（boss有效）：\r
<indent=16><sprite=3><indent=32>回合开始时若自身不处于能力提升状态，则当回合50%<color=#64F9FA>抵挡</color>对手的下1次<b>攻击</b>\r
<indent=32><sprite=4><indent=48>未触发则受到的<b>攻击伤害</b><color=#64F9FA>减少</color>50%\r
\r
<indent=0><sprite=0><indent=16>战阶结束效果（boss有效）：\r
<indent=16><sprite=3><indent=32>战斗阶段结束时若自身处于能力提升状态，则<color=#64F9FA>恢复</color>自身最大体力的1/3并造成等量<b>百分比伤害</b>"""@zh ;
