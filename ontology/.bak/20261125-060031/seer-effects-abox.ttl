seer:soulmark_1948 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4745 ;
    seer:analyzeDesc "[sprite name=dot4]自身拥有[color=#52a5f2]己方[/color]其他精灵专属特性中的[color=#57c975]击败[/color]类效果，自身[color=#57c975]登场时[/color]每拥有1种其他精灵的[color=#57c975]击败[/color]类效果获得1层[color=#f35555]狩杀之魂[/color]，若[color=#52a5f2]对方[/color]不存在[color=#f35555]狩杀之的[/color]则将存活的[color=#52a5f2]对手[/color]标记为[color=#f35555]狩杀之的[/color]|[sprite name=dot4]自身拥有[color=#f35555]狩杀之魂[/color]的[color=#57c975]回合开始时[/color]，若[color=#52a5f2]对手[/color]的体力不低于[color=#f35555]狩杀之的[/color]的体力则[color=#52a5f2]当回合[/color]自身使用攻击技能时消耗1层[color=#f35555]狩杀之魂[/color]并为[color=#52a5f2]对手[/color]与[color=#f35555]狩杀之的[/color]附加等同于[color=#52a5f2]威力[/color]值的[color=#52a5f2]真实伤害[/color]，若[color=#52a5f2]对手[/color]的体力不高于[color=#f35555]狩杀之的[/color]的体力则[color=#52a5f2]当回合[/color]自身使用攻击技能时消耗1层[color=#f35555]狩杀之魂[/color]并令自身[color=#52a5f2]当回合[/color]造成的[color=#52a5f2]固定伤害[/color]、[color=#52a5f2]百分比伤害[/color]提升40%，同时满足时，上述效果的触发无需消耗[color=#f35555]狩杀之魂[/color]"@zh ;
    seer:desc "自身拥有己方其他精灵专属特性中的击败类效果，自身登场时每拥有1种其他精灵的击败类效果获得1层狩杀之魂，若对方不存在狩杀之的则将存活的对手标记为狩杀之的|自身拥有狩杀之魂的回合开始时，若对手的体力不低于狩杀之的的体力则当回合自身使用攻击技能时消耗1层狩杀之魂并为对手与狩杀之的附加等同于威力值的真实伤害，若对手的体力不高于狩杀之的的体力则当回合自身使用攻击技能时消耗1层狩杀之魂并令自身当回合造成的固定伤害、百分比伤害提升40%，同时满足时，上述效果的触发无需消耗狩杀之魂|（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>常驻效果：\r
<indent=16><sprite=3><indent=32>自身<color=#64F9FA>拥有</color>己方其他精灵专属特性中的<b>击败类效果</b>\r
\r
<indent=0><sprite=0><indent=16>登场效果：\r
<indent=16><sprite=3><indent=32>自身登场时：\r
<indent=32><sprite=4><indent=48>每拥有一只其他精灵的击败类效果获得1层<color=#FFF779>狩杀之魂</color>\r
<indent=32><sprite=4><indent=48>若对方不存在狩杀之的则将存活的对手标记为<color=#FFF779>狩杀之的</color>\r
\r
<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>自身拥有狩杀之魂时，每回合开始时：\r
<indent=32><sprite=4><indent=48>若对手的体力不低于狩杀之的的体力则当回合自身使用攻击技能时消耗1层狩杀之魂并为对手与狩杀之的<color=#64F9FA>附加</color>等同于威力值的<b>真实伤害</b>，对场下精灵造成致死伤害时其<color=#64F9FA>保留</color>1点<b>体力</b>\r
<indent=32><sprite=4><indent=48>若对手的体力不高于狩杀之的的体力则当回合自身使用攻击技能时消耗1层狩杀之魂并令自身当回合造成的<b>固定伤害、百分比伤害</b><color=#64F9FA>提升</color>40%\r
<indent=32><sprite=4><indent=48>同时满足时，上述效果的触发无需消耗狩杀之魂\r
\r
<indent=0><sprite=5><indent=15>狩杀之魂：\r
<indent=16><sprite=6><indent=32>阿尔忒弥斯用以触发部分效果的条件\r
\r
<indent=0><sprite=5><indent=15>狩杀之的：\r
<indent=16><sprite=6><indent=32>在场的精灵被标记为狩杀之的时<b>体力上限</b><color=#64F9FA>减少</color>60%直到当回合结束 \r
<indent=32><sprite=4><indent=48>然后<color=#64F9FA>获得</color>等同于体力值的护盾、护罩，此护盾、护罩同时存在时狩杀之的无法对阿尔忒弥斯附加<b>异常状态</b>\r
<indent=16><sprite=6><indent=32>新的精灵被标记为狩杀之的时，解除原本的标记"""@zh ;
    seer:effectAlias "alias_2354_40_50_1" ;
    seer:intensified false ;
    seer:isAdv false ;
    seer:pveEffective false ;
    seer:seerapiId "1948" ;
