        seer:soulmark_tag_2,
        seer:soulmark_tag_5 ;
    seer:sourceUrl "https://api.seerapi.com/v1/soulmark/1061" .

seer:soulmark_1062 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_3786 ;
    seer:desc "里奥斯每次登场后100%令对手进入易燃状态，同时给对手周围布置一层密集火网：处于烧伤状态下则无法处于能力提升状态；攻击技能命中对手后50%的概率令对手烧伤，未触发则为自身附加300点护盾或给对手造成300点固定伤害（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>登场效果：\r
<indent=16><sprite=3><indent=32>里奥斯每次登场后100%<color=#64F9FA>令对手易燃</color>且给对手周围布置密集火网：处于烧伤状态下则无法处于能力提升状态\r
\r
<indent=0><sprite=0><indent=16>攻击技能额外效果：\r
<indent=16><sprite=3><indent=32>攻击技能命中对手后50%<color=#64F9FA>令对手烧伤</color>\r
<indent=32><sprite=4><indent=48>未触发则随机触发下列效果的一个：\r
<indent=32><sprite=4><sprite=4><indent=64><color=#64F9FA>获得</color>300点<b>护盾</b>\r
<indent=32><sprite=4><sprite=4><indent=64><color=#64F9FA>附加</color>300点<b>固定伤害</b>"""@zh ;
