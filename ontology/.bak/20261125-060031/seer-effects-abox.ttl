        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4294 ;
    seer:desc "回合开始时若自身满体力则自身使用技能50%令对手害怕，未触发则消除对手回合类效果；|战斗阶段结束时若自身满体力则为自身附加一个300点的护盾（不可叠加），若自身未满体力则{吸取}对手300点{体力}（boss无效）"@zh ;
