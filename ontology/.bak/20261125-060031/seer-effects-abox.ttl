seer:soulmark_1944 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4741 ;
    seer:desc "双方任意一方使用技能时若对手处于回合类效果，则对手2回合内受到的攻击伤害提升50%且造成的攻击伤害减少25%|对手的回合类效果被消除时，2回合内技能无法附加异常状态|（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>触发效果：\r
<indent=16><sprite=3><indent=32>双方任意一方使用技能时若对手处于回合类效果，则对手2回合内受到的<b>攻击伤害</b><color=#64F9FA>提升</color>50%且造成的<b>攻击伤害</b><color=#64F9FA>减少</color>25%\r
<indent=16><sprite=3><indent=32>对手的回合类效果被消除时，对手2回合内技能<color=#64F9FA>无法附加</color><b>异常状态</b>"""@zh ;
