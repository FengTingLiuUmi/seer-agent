seer:soulmark_1683 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4474 ;
    seer:desc "回合开始时若对手不处于能力提升状态则令双方全属性+1，若对手处于能力提升状态则当回合自身造成的攻击伤害提升100%；|对手技能命中前若处于全属性提升状态则自身100%闪避，自身技能命中前若处于全属性提升状态则消除对手能力提升状态|（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时：\r
<indent=32><sprite=4><indent=48>若对手不处于能力提升状态则<color=#64F9FA>令双方全属性+1</color>\r
<indent=32><sprite=4><indent=48>若对手处于能力提升状态则当回合自身造成的<b>攻击伤害</b><color=#64F9FA>提升</color>100%\r
\r
<indent=0><sprite=0><indent=16>触发效果：\r
<indent=16><sprite=3><indent=32>对手使用技能时若处于全属性提升状态则自身100%将其<color=#64F9FA>闪避</color>\r
<indent=16><sprite=3><indent=32>自身使用技能时若处于全属性提升状态则<color=#64F9FA>消除</color>对手<b>能力提升状态</b>"""@zh ;
