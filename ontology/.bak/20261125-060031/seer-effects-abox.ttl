seer:soulmark_1857 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4655 ;
    seer:desc "登场后获得50%的攻击伤害、固定伤害、百分比伤害减免，自身每次使用属性技能时依次使三种伤害减免中的一种转变为对应的造成伤害增加|对手使用技能后，若本次在场未触发过转变则自身所处异常状态回合数-1；回合结束后，若本次在场触发过转变则恢复200点体力；被击败后，若本次在场已触发全部转变则令对手瘫痪（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>常驻效果：\r
<indent=16><sprite=3><indent=32>登场后<color=#64F9FA>减少</color>50%受到的<b>攻击伤害、固定伤害、百分比伤害</b>\r
<indent=32><sprite=4><indent=48>每次使用属性技能时使三种受到伤害减免中的前一种<color=#64F9FA>转变</color>为对应的<b>造成伤害增加</b>\r
\r
<indent=0><sprite=0><indent=16>触发效果：\r
<indent=16><sprite=3><indent=32>对手使用技能后，若本次在场未触发过转变则自身所处异常状态<b>回合数<color=#64F9FA></b>-1</color>\r
\r
<indent=0><sprite=0><indent=16>回合结束效果：\r
<indent=16><sprite=3><indent=32>回合结束后，若本次在场触发过转变则<color=#64F9FA>恢复</color>200点<b>体力</b>\r
\r
<indent=0><sprite=0><indent=16>被击败效果：\r
<indent=16><sprite=3><indent=32>自身被击败后，若本次在场已触发全部转变则<color=#64F9FA>令对手瘫痪</color>"""@zh ;
