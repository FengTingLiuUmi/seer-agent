seer:soulmark_1397 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4173 ;
    seer:desc "自身每次攻击命中造成的伤害提升（提升值等同于自身当前体力百分比）且50%令对手烧伤，自身体力低于最大体力的1/3则造成攻击伤害的100%恢复自身体力；|战斗阶段结束时，自身体力低于最大体力的1/3进入箭魂状态：下回合自身所有技能先制+3且造成的攻击伤害提升150%(每场战斗仅触发1次，boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>常驻效果：\r
<indent=16><sprite=3><indent=32>自身每次攻击命中造成的伤害提升且50%<color=#64F9FA>令对手烧伤</color>，提升值等同于自身当前体力百分比\r
\r
<indent=0><sprite=0><indent=16>战阶结束效果：\r
<indent=16><sprite=3><indent=32>战斗阶段结束时：\r
<indent=32><sprite=4><indent=48>自身体力低于最大体力的1/3则造成攻击伤害的100%<color=#64F9FA>恢复</color>自身<b>体力</b>\r
<indent=32><sprite=4><indent=48>自身体力低于最大体力的1/3进入箭魂状态（每场战斗限1次）：\r
<indent=32><sprite=4><sprite=4><indent=64>下回合自身所有技能<b>先制</b>+3且造成的<b>攻击伤害</b><color=#64F9FA>提升</color>150%"""@zh ;
