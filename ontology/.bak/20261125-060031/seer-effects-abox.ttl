seer:soulmark_1607 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4388 ;
    seer:desc "每次登场时若对手不处于能力提升状态则消除对手护盾类效果，消除成功则对手2回合内无法使用属性技能且战斗阶段结束时自身恢复等同于消除护盾数值的体力；|战斗阶段结束时若对手仅攻击、速度处于能力提升状态则消除对手回合类效果，消除成功则100%令对手瘫痪；|自身每次下场后，己方下1只精灵登场时若对手处于瘫痪状态，则登场精灵攻击、速度+1（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>登场效果：\r
<indent=16><sprite=3><indent=32>登场时若对手不处于能力提升状态则<color=#64F9FA>消除</color>对手<b>护盾类效果</b>\r
<indent=32><sprite=4><indent=48>消除成功则：\r
<indent=32><sprite=4><sprite=4><indent=64>对手2回合内<b>属性技能<color=#64F9FA></b>命中效果失效</color>\r
<indent=32><sprite=4><sprite=4><indent=64>当回合战斗阶段结束时自身<color=#64F9FA>恢复</color>等同于消除护盾数值的<b>体力</b>\r
\r
<indent=0><sprite=0><indent=16>战阶结束效果：\r
<indent=16><sprite=3><indent=32>战斗阶段结束时若对手仅攻击、速度处于能力提升状态则<color=#64F9FA>消除</color>对手<b>回合类效果</b>\r
<indent=32><sprite=4><indent=48>消除成功则100%<color=#64F9FA>令对手瘫痪</color>\r
\r
<indent=0><sprite=0><indent=16>下场效果：\r
<indent=16><sprite=3><indent=32>自身每次下场后，己方下1只精灵登场时若对手处于瘫痪状态，则登场精灵攻击、速度+1"""@zh ;
