seer:soulmark_1804 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4598 ;
    seer:desc "每次登场之后记录首次受到的攻击伤害，直到下场自身每回合结束后恢复此记录值的体力，最高不超过自身的体力值；|每次登场之后记录首次造成的攻击伤害，直到下场自身使用攻击技能后附加此记录值的固定伤害，最高不超过自身的特攻值（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>触发效果：\r
<indent=16><sprite=3><indent=32>每次登场之后记录首次受到的攻击伤害，直到下场自身每回合结束后<color=#64F9FA>恢复</color>此记录值的<b>体力</b>，最高不超过自身的体力值\r
<indent=16><sprite=3><indent=32>每次登场之后记录首次造成的攻击伤害，直到下场自身使用攻击技能后<color=#64F9FA>附加</color>此记录值的<b>固定伤害</b>，最高不超过自身的特攻值"""@zh ;
