seer:soulmark_951 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_3665 ;
    seer:desc "若自身满体力则当回合受到攻击时自身下回合先制+3，若自身未满体力则当回合受到攻击时恢复自身最大体力的1/3；出场时自身造成的伤害提升20%、受到的伤害降低20%且攻击技能命中对手时有15%的概率秒杀对手，自身每击败一只精灵则自身造成的伤害提升10%、受到的伤害降低10%且秒杀概率提升3%（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>常驻效果：\r
<indent=16><sprite=3><indent=32>自身天生持有：\r
<indent=32><sprite=4><indent=48>造成的攻击伤害<color=#64F9FA>提升</color>20%\r
<indent=32><sprite=4><indent=48>受到的攻击伤害<color=#64F9FA>降低</color>20%\r
<indent=32><sprite=4><indent=48>攻击技能命中对手时有15%的概率<color=#64F9FA>秒杀</color>对手\r
<indent=16><sprite=3><indent=32>自身每次<b>击败对手</b>后，本场战斗内上述效果分别提升10%、10%、3%\r
\r
<indent=0><sprite=0><indent=16>受击额外效果：\r
<indent=16><sprite=3><indent=32>受到攻击时：\r
<indent=32><sprite=4><indent=48>若自身满体力则下回合<b>先制</b>+3\r
<indent=32><sprite=4><indent=48>若自身未满体力则<color=#64F9FA>恢复</color>自身最大体力的1/3"""@zh ;
