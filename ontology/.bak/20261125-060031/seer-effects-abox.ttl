seer:soulmark_1604 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4385 ;
    seer:desc "回合开始时若自身处于异常状态则当回合自身受到的攻击伤害降低300点，且当回合自身若未受到攻击伤害则战斗阶段结束时解除自身异常状态且下回合自身所有技能先制+1；|回合开始时若对手处于异常状态则自身使用攻击技能100%令对手疲惫，若对手不处于异常状态则自身攻击必定打出致命一击（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时若自身处于异常状态则当回合：\r
