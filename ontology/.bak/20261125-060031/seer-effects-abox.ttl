seer:soulmark_1402 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4177 ;
    seer:desc "回合开始时自身处于能力提升状态则当回合攻击50%打出致命一击，若先出手则致命一击概率转变为100%；|回合开始时自身不处于能力提升状态则战斗阶段结束时吸取对手能力提升状态，若对手不处于能力提升状态则令自身特攻+1、速度+1（boss有效）"@zh ;
