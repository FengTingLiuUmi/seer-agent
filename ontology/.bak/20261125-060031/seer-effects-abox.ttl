seer:soulmark_990 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_3646 ;
    seer:desc "登场后自身首回合受到致命攻击则100%的概率残留1点体力，之后每回合概率降低30%，自身死亡时50%令对手冰封；若对手处于异常状态则自身攻击技能附加对手最大体力1/3的固定伤害，若对手不处于异常状态则自身所有技能先制+1（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>登场效果：\r
<indent=16><sprite=3><indent=32>首次登场之后每回合都有100%的概率令自身1回合内每次死亡时<color=#64F9FA>保留</color>1点<b>体力</b>，每在场1回合概率降低30%\r
\r
<indent=0><sprite=0><indent=16>被击败效果：\r
<indent=16><sprite=3><indent=32>自身被击败时50%<color=#64F9FA>令对手冰封</color>\r
\r
<indent=0><sprite=0><indent=16>技能额外效果：\r
<indent=16><sprite=3><indent=32>对手处于异常状态则自身攻击技能使用时<color=#64F9FA>附加</color>对手最大体力1/3的<b>百分比伤害</b>\r
<indent=16><sprite=3><indent=32>对手不处于异常状态则自身所有技能<b>先制</b>+1"""@zh ;
