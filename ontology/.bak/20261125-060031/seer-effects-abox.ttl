seer:soulmark_1507 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4286 ;
    seer:desc "古渊灵鱼登场后每回合由火灵和冰灵交替主导，触发不同的效果（boss无效）：|火灵：受到的物理伤害减少50%，受到的特殊伤害增加50%，攻击命中后50%令对手焚烬，未触发则令对手全属性-1|冰灵：受到的特殊伤害减少50%，受到的物理伤害增加50%，攻击命中后50%令对手冰封，未触发则令自身全属性+1"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>常驻效果：\r
<indent=16><sprite=3><indent=32>古渊灵鱼登场后每回合由火灵和冰灵交替主导，触发不同的效果：\r
<indent=32><sprite=4><indent=48>火灵：受到的<b>物理伤害</b><color=#64F9FA>减少</color>50%，受到的<b>特殊伤害</b><color=#64F9FA>增加</color>50%，攻击命中后50%<color=#64F9FA>令对手焚烬</color>，未触发则令对手<color=#64F9FA>全属性-1</color>\r
<indent=32><sprite=4><indent=48>水灵：受到的<b>特殊伤害</b><color=#64F9FA>减少</color>50%，受到的<b>物理伤害</b><color=#64F9FA>增加</color>50%，攻击命中后50%<color=#64F9FA>令对手冰封</color>，未触发则令自身<color=#64F9FA>全属性+1</color>"""@zh ;
