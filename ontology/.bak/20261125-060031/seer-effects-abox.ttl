seer:soulmark_1701 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4490 ;
    seer:desc "自身位于己方出战背包时，己方卡娜使用攻击技能必定打出奇数伤害，且每次造成奇数伤害时获得的增伤效果会提升至40%（最高200%）；|若对手使用的攻击技能威力为偶数则自身受到的伤害会减少40%，若自身使用的攻击技能威力为偶数则对手受到的伤害会提升40%；|对手使用攻击技能后，若造成的攻击伤害高于300则下1次对手使用的属性技能无效，若造成的攻击伤害低于300则50%令对手瘫痪，未触发则当回合战斗阶段结束时恢复自身最大体力的1/3并造成等量百分比伤害|（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>常驻效果：\r
<indent=16><sprite=3><indent=32>自身位于己方出战背包时，己方卡娜使用攻击技能必定<color=#64F9FA>打出奇数伤害</color>，且每次造成奇数伤害时获得的增伤效果会提升至40%，最高200%\r
\r
<indent=0><sprite=0><indent=16>触发效果：\r
<indent=16><sprite=3><indent=32>若对手使用的攻击技能威力为偶数则自身受到的<b>攻击伤害</b>会<color=#64F9FA>减少</color>40%\r
<indent=16><sprite=3><indent=32>若自身使用的攻击技能威力为偶数则对手受到的<b>攻击伤害</b>会<color=#64F9FA>提升</color>40%\r
<indent=16><sprite=3><indent=32>对手使用攻击技能后：\r
<indent=32><sprite=4><indent=48>若造成的攻击伤害高于300则下1次对手使用的<b>属性技能</b><color=#64F9FA>无效</color>\r
<indent=32><sprite=4><indent=48>若造成的攻击伤害低于300则50%<color=#64F9FA>令对手瘫痪</color>\r
<indent=32><sprite=4><sprite=4><indent=64>未触发则战斗阶段结束时<color=#64F9FA>恢复</color>自身最大体力的1/3并造成等量的<b>百分比伤害</b>"""@zh ;
    seer:effectAlias "alias_2089_40_40_300_1_300_50_3_1" ;
    seer:intensified false ;
    seer:isAdv false ;
    seer:pveEffective false ;
    seer:seerapiId "1701" ;
    seer:soulmarkEffect "{\"effect\": {\"id\": 2089, \"url\": \"https://api.seerapi.com/v1/eid_effect/2089\"}, \"effect_args\": [40, 40, 300, 1, 300, 50, 3, 1]}" ;
    seer:soulmarkTag seer:soulmark_tag_11,
        seer:soulmark_tag_14,
        seer:soulmark_tag_5 ;
