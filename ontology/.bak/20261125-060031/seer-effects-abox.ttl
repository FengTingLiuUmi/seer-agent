seer:soulmark_1568 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4343 ;
    seer:desc "自身使用攻击技能后若为连续2次使用则100%令对手冰封，自身使用属性技能后若不为连续2次使用则恢复自身所有技能1点PP值；|自身先出手则当回合对手无法通过自身技能恢复体力（该效果为回合类效果），对手先出手则当回合战斗阶段结束时恢复自身最大体力的1/3并造成等量百分比伤害（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>技能额外效果：\r
<indent=16><sprite=3><indent=32>自身使用攻击技能时若为连续2次使用则100%<color=#64F9FA>令对手冰封</color>\r
<indent=16><sprite=3><indent=32>自身使用属性技能时若不为连续2次使用则<color=#64F9FA>恢复</color>自身所有技能1点<b>PP值</b>\r
\r
<indent=0><sprite=0><indent=16>触发效果：\r
<indent=16><sprite=3><indent=32>自身先出手则对手以回合类效果形式1回合内<color=#64F9FA>无法通过自身技能恢复体力</color>\r
<indent=16><sprite=3><indent=32>对手先出手则战斗阶段结束时<color=#64F9FA>恢复</color>自身最大体力的1/3并造成等量<b>百分比伤害</b>"""@zh ;
