seer:soulmark_1577 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4353 ;
    seer:desc "对手每次先出手则下回合选择使用攻击技能时所有先制效果失效；|自身每次先出手则当回合造成的攻击伤害提升100%；|自身每次先出手且技能命中前对手当前体力高于最大体力的1/2，则{吸取}对手最大{体力}的1/3；|战斗阶段结束时若自身当前体力低于对手则令自身全属性+1且下回合所有技能先制+1|（boss无效）"@zh ;
