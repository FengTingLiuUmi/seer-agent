seer:soulmark_1570 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4345 ;
    seer:desc "当回合对手使用攻击技能则战斗阶段结束时给自身附加最大体力1/3的护盾（护盾无法叠加）并恢复等量体力且令自身下回合属性技能先制+2；|当回合对手未使用攻击技能则战斗阶段结束时给自身附加对手最大体力1/3的护盾（护盾无法叠加）并使自身防御+1、特防+1，且令对手下回合属性技能失效；|自身每次主动切换下场时，若当前拥有的护盾量高于600，则将自身的能力提升状态附加给己方下只出场精灵（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>常驻效果：\r
<indent=16><sprite=3><indent=32>当回合对手使用攻击技能则：\r
<indent=32><sprite=4><indent=48>战斗阶段结束时给自身<color=#64F9FA>附加</color>最大体力1/3的<b>护盾</b>（护盾无法叠加）并<color=#64F9FA>恢复</color>等量体力\r
<indent=32><sprite=4><indent=48>令自身下回合属性技能<b>先制</b>+2\r
<indent=16><sprite=3><indent=32>当回合对手未使用攻击技能则：\r
<indent=32><sprite=4><indent=48>战斗阶段结束时给自身<color=#64F9FA>附加</color>对手最大体力1/3的<b>护盾</b>（护盾无法叠加）并使自身防御+1、特防+1\r
<indent=32><sprite=4><indent=48>令对手下回合<b>属性技能</b><color=#64F9FA>失效</color>\r
\r
<indent=0><sprite=0><indent=16>触发效果：\r
<indent=16><sprite=3><indent=32>自身每次主动切换下场时，若当前拥有的护盾量高于600，则将自身的<b>能力提升状态</b><color=#64F9FA>附加</color>给己方下只出场精灵"""@zh ;
