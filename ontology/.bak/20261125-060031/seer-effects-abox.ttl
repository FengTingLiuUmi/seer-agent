        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4912 ;
    seer:analyzeDesc "[sprite name=dot4]自身每次在场[color=#52a5f2]首次[/color]使用攻击技能时获得1层[color=#f35555]渐烬[/color]并[color=#52a5f2]吸取[/color][color=#52a5f2]对手[/color]最大体力的1/3，若[color=#52a5f2]对手[/color][color=#57c975]免疫[/color]受到的[color=#52a5f2]固定伤害[/color]、[color=#52a5f2]百分比伤害[/color]则本场战斗此效果无视时点条件|[sprite name=dot4]自身每次在场[color=#52a5f2]对手[/color][color=#52a5f2]首次[/color]使用攻击技能时[color=#52a5f2]当回合[/color]自身受到的[color=#52a5f2]攻击伤害[/color]减少50%，若[color=#52a5f2]对手[/color]当次攻击微弱自身则[color=#52a5f2]对手[/color]下次属性[color=#52a5f2]技能无效[/color]|[sprite name=dot4]自身受到[color=#52a5f2]致死伤害[/color]时，消耗自身的[color=#f35555]渐烬[/color][color=#52a5f2]以[/color]主动恢复全部体力，恢复成功自身解除所处的[color=#52a5f2]异常状态[/color]、[color=#52a5f2]能力下降状态[/color]，[color=#57c975]免疫[/color]下1次受到的攻击，每消耗1层[color=#f35555]渐烬[/color]，[color=#52a5f2]己方[/color]获得1层[color=#f35555]天烬海[/color]，[color=#52a5f2]之后[/color]本场战斗自身[color=#f35555]渐烬[/color]的上限视为0"@zh ;
    seer:desc "自身每次在场首次使用攻击技能时获得1层渐烬并吸取对手最大体力的1/3，若对手免疫受到的固定伤害、百分比伤害则本场战斗此效果无视时点条件|自身每次在场对手首次使用攻击技能时当回合自身受到的攻击伤害减少50%，若对手当次攻击微弱自身则对手下次属性技能无效|自身受到致死伤害时，消耗自身的渐烬以主动恢复全部体力，恢复成功自身解除所处的异常状态、能力下降状态，免疫下1次受到的攻击，每消耗1层渐烬，己方获得1层天烬海，之后本场战斗自身渐烬的上限视为0|（boss无效）"@zh ;
    seer:effectAlias "alias_2519_1_0" ;
