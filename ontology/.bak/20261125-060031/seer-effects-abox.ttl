seer:soulmark_1182 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_3915 ;
    seer:desc "每回合开始时为自身附加350点护盾；战斗阶段结束时，若自身存在护盾则下回合攻击技能50%的概率打出致命一击，未触发则附加对手最大体力1/3的固定伤害，若自身不存在护盾则50%令对手焚烬，未触发则下回合开始时转变为附加450点护盾（boss无效）"@zh ;
