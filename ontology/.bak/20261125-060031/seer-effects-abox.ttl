seer:soulmark_1870 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4667 ;
    seer:desc "自身每次登场时，己方存活精灵每比对方多一只自身获得100点护盾；自身使用攻击技能时，若自身拥有护盾则造成的攻击伤害提升50%，自身每有100点护盾再额外提升10%；自身击败对手时，自身提升等同于护盾值10%的体力上限（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>登场效果：\r
<indent=16><sprite=3><indent=32>自身每次登场时，己方存活精灵每比对方多一只自身<color=#64F9FA>获得</color>100点<b>护盾</b>\r
\r
<indent=0><sprite=0><indent=16>攻击技能额外效果：\r
<indent=16><sprite=3><indent=32>自身使用攻击技能时，若自身拥有护盾则造成的<b>攻击伤害<color=#64F9FA></b>提升</color>50%，自身每有50点护盾再额外提升10%\r
\r
<indent=0><sprite=0><indent=16>击败效果：\r
<indent=16><sprite=3><indent=32>自身击败对手时，自身<color=#64F9FA>提升</color>等同于护盾值10%的<b>体力上限</b>"""@zh ;
