seer:soulmark_1613 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4395 ;
    seer:desc "回合开始时，若自身满体力则当回合攻击技能必定打出致命一击，且当次攻击造成的伤害若高于400则100%使对手冰封；|战斗阶段结束时，若自身满体力则下回合自身所有技能先制+1，若自身未满体力则恢复自身最大体力的1/3并造成等量百分比伤害（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时，若自身满体力则：\r
<indent=32><sprite=4><indent=48>当回合攻击技能<color=#64F9FA>必定打出致命一击</color>\r
<indent=32><sprite=4><indent=48>当次攻击造成的伤害若高于400则100%<color=#64F9FA>使对手冰封</color>\r
\r
<indent=0><sprite=0><indent=16>战阶结束效果：\r
<indent=16><sprite=3><indent=32>战斗阶段结束时：\r
<indent=32><sprite=4><indent=48>若自身满体力则下回合自身所有技能<b>先制</b>+1\r
<indent=32><sprite=4><indent=48>若自身未满体力则<color=#64F9FA>恢复</color>自身最大体力的1/3并造成等量<b>百分比伤害</b>"""@zh ;
