        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4498 ;
    seer:desc "每次登场时为对手附加挫折预言与迷失预言，之后每个战斗阶段结束时若对手当前精灵所持有的两种预言都已通过使用技能消耗，则为自身附加凯旋预言；|回合开始时若自身体力高于最大体力的50%，则下回合开始时解除自身所处的异常状态与能力下降状态，解除成功任意一项则当回合自身所有技能先制+1；|战斗阶段结束时若自身体力低于最大体力的50%，则与己方场下体力最高的首位精灵交换体力并恢复自身所有技能1点PP值|挫折预言：下次攻击技能不计算属性克制倍数与本系属性加成且使用后受到150点真实伤害|迷失预言：下次属性技能消耗的PP值翻倍且使用后受到3回合混乱|凯旋预言：下次击败对手时恢复自身全部体力和所有技能PP值，下场保留|（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>登场效果：\r
<indent=16><sprite=3><indent=32>每次登场时为对手附加<color=#FFF779>挫折预言</color>与<color=#FFF779>迷失预言</color>\r
<indent=32><sprite=4><indent=48>之后每个战斗阶段结束时若本回合对手的两种预言都已消耗，则为自身附加<color=#FFF779>凯旋预言</color>\r
\r
<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时若自身体力高于最大体力的50%，则下回合开始时<color=#64F9FA>解除</color>自身所处的<b>异常状态</b>与<b>能力下降状态</b>\r
<indent=32><sprite=4><indent=48>解除成功任意一项则当回合自身所有技能<b>先制</b>+1\r
\r
<indent=0><sprite=0><indent=16>战阶结束效果：\r
<indent=16><sprite=3><indent=32>战斗阶段结束时若自身体力低于最大体力的50%，则与己方场下体力最高的精灵<color=#64F9FA>交换</color><b>体力值</b>并<color=#64F9FA>恢复</color>自身所有技能1点<b>PP值</b>\r
\r
<indent=0><sprite=5><indent=15>挫折预言：\r
<indent=16><sprite=6><indent=32>下次使用的攻击技能<color=#64F9FA>不计算</color><b>属性克制倍数</b>与<b>本系加成</b>且使用后受到150点<b>真实伤害</b>\r
\r
<indent=0><sprite=5><indent=15>迷失预言：\r
<indent=16><sprite=6><indent=32>下次使用的属性技能消耗的<b>PP值</b>翻倍且使用后受到3回合混乱\r
\r
<indent=0><sprite=5><indent=15>凯旋预言（下场保留）：\r
<indent=16><sprite=6><indent=32>下次击败对手时<color=#64F9FA>恢复</color>自身全部<b>体力</b>和所有技能<b>PP值</b> """@zh ;
    seer:effectAlias "alias_2098_1_0" ;
    seer:intensified false ;
    seer:isAdv false ;
    seer:pveEffective false ;
    seer:seerapiId "1713" ;
