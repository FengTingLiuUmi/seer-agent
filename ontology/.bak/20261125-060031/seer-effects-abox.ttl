seer:soulmark_1192 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_3927 ;
    seer:desc "回合开始时，若对手不处于能力提升状态则当回合自身受到攻击时100%令对手焚烬，若对手处于能力提升状态则当回合自身攻击100%打出致命一击；自身攻击附加造成伤害值25%的固定伤害，若回合开始时对手处于异常状态则恢复等量体力（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时：\r
