seer:soulmark_1837 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4631 ;
    seer:desc "回合开始时令对手防御、特防、速度等级-1，未触发则自身防御、特防、速度等级+1，对手为自身天敌时所有效果翻倍|对手每次使用技能后若自身双防能力等级之和高于对手则令对手石化，未触发则恢复自身最大体力的1/3并获得等量护盾|自身每次使用技能后若自身双防能力等级之和高于对手则令对手流血，附加成功则吸取对手最大体力1/3|（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时令对手防御、特防、速度等级-1，对手为自身天敌时效果翻倍\r
<indent=32><sprite=4><indent=48>未触发则自身防御、特防、速度等级+1，对手为自身天敌时效果翻倍\r
\r
<indent=0><sprite=0><indent=16>技能额外效果：\r
<indent=16><sprite=3><indent=32>自身双防能力等级之和高于对手时：\r
<indent=32><sprite=4><indent=48>对手每次使用技能后<color=#64F9FA>令对手石化</color>，未触发则<color=#64F9FA>恢复</color>自身最大体力的1/3并<color=#64F9FA>获得</color>等量<b>护盾</b>\r
<indent=32><sprite=4><indent=48>自身每次使用技能后<color=#64F9FA>令对手流血</color>，附加成功则<color=#64F9FA>吸取</color>对手最大体力1/3"""@zh ;
