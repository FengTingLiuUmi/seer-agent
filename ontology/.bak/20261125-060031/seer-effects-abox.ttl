seer:soulmark_1506 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4285 ;
    seer:desc "回合开始时，若自身满体力则自身攻击命中有50%的概率打出致命一击，未触发则100%令对手冰封；|战斗阶段结束时，若自身满体力则下回合自身攻击技能先制+1，若自身未满体力则恢复自身最大体力的1/3并附加等量固定伤害（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时，若自身满体力则自身攻击50%<color=#64F9FA>打出致命一击</color>\r
<indent=32><sprite=4><indent=48>未触发则100%<color=#64F9FA>令对手冰封</color>\r
\r
