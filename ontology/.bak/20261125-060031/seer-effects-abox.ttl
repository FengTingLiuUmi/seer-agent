seer:soulmark_1387 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4161 ;
    seer:desc "自身每次使用攻击技能则战斗阶段结束时附加对手最大体力30%的固定伤害，对手每次使用攻击技能则战斗阶段结束时恢复自身最大体力的30%；|自身被对手击败时100%令对手进入感染状态，未触发则令对手全属性-1且下回合先制-1（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>触发效果：\r
