seer:soulmark_1061 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_3788 ;
    seer:analyzeDesc "[sprite name=dot4]自身作为首发精灵[color=#52a5f2]首次[/color][color=#57c975]出战时[/color]，令[color=#52a5f2]对手[/color][color=#52a5f2]当回合[/color]无法[color=#52a5f2]主动切换[/color]精灵且50%[color=#52a5f2]驱逐[/color][color=#52a5f2]对手[/color]|[sprite name=dot1]自身[color=#52a5f2]首次[/color][color=#57c975]出战后[/color]召唤[color=#f35555]辛[/color]，[color=#f35555]辛[/color]的初始体力等同于自身的最大体力|[sprite name=dot1][color=#57c975]回合开始时[/color]，若[color=#f35555]辛[/color]存活则自身依次[color=#52a5f2]执行[/color]以下效果：|[sprite name=dot1]    [color=#f35555]辛[/color]每损失20%的体力[color=#52a5f2]当回合[/color]自身造成的[color=#52a5f2]攻击伤害[/color]提升10%|[sprite name=dot5]    若自身处于[color=#52a5f2]异常状态[/color]，则令[color=#52a5f2]对手[/color]随机1个技能PP值归零|[sprite name=dot5]    若自身处于[color=#52a5f2]能力下降状态[/color]，则[color=#52a5f2]当回合[/color][color=#57c975]战斗阶段结束时[/color]附加[color=#52a5f2]对手[/color]最大体力1/4的[color=#52a5f2]百分比伤害[/color]|[sprite name=dot1]自身[color=#57c975]被击败[/color]后，[color=#52a5f2]己方[/color]获得3回合的[color=#f35555]辛之印记[/color]|[sprite name=dot4][color=#52a5f2]己方[/color]每阵亡1只精灵自身6%[color=#57c975]闪避[/color][color=#52a5f2]对手[/color]的技能，[color=#52a5f2]对手[/color]为[color=#f35555]英雄圣殿成员[/color]时[color=#57c975]闪避[/color]率翻倍"@zh ;
    seer:desc "自身作为首发精灵首次出战时，令对手当回合无法主动切换精灵且50%驱逐对手|自身首次出战后召唤辛，辛的初始体力等同于自身的最大体力|回合开始时，若辛存活则自身依次执行以下效果：|    辛每损失20%的体力当回合自身造成的攻击伤害提升10%（boss有效）|    若自身处于异常状态，则令对手随机1个技能PP值归零|    若自身处于能力下降状态，则当回合战斗阶段结束时附加对手最大体力1/4的百分比伤害|自身被击败后，己方获得3回合的辛之印记|己方每阵亡1只精灵自身6%闪避对手的技能，对手为英雄圣殿成员时闪避率翻倍|（标注部分boss有效，其余无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>登场效果：\r
<indent=16><sprite=3><indent=32>自身作为首发精灵时，登场首回合令对手<color=#64F9FA>无法主动切换精灵</color>且50%驱逐对手\r
\r
<indent=0><sprite=0><indent=16>辛之契约（boss有效）：\r
<indent=16><sprite=3><indent=32>自身首次出战时召唤初始体力等同于自身的最大体力的“辛”，“辛”将<color=#64F9FA>代替自身承受</color>60%受到的<b>攻击伤害</b>、<b>固定伤害</b>、<b>百分比伤害</b>，“辛”体力为0或自身死亡时，“辛”死亡\r
\r
<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时若“辛”死亡，则不再代替自身承受伤害，若“辛”存活，则自身获得如下效果：\r
<indent=32><sprite=4><indent=48>“辛”每损失20%的体力，当回合自身造成的<b>攻击伤害</b><color=#64F9FA>提升</color>10%（boss有效）\r
<indent=32><sprite=4><indent=48>自身处于异常状态，则令对手随机1个技能PP值<color=#64F9FA>归零</color>\r
<indent=32><sprite=4><indent=48>自身处于能力下降状态，则当回合战斗阶段结束时<color=#64F9FA>附加</color>对手最大体力1/4的<b>百分比伤害</b>\r
\r
<indent=0><sprite=0><indent=16>荒神融合：\r
<indent=16><sprite=3><indent=32>“辛”死亡时，本场战斗自身自当回合结束后起：\r
<indent=32><sprite=4><indent=48><color=#64F9FA>免疫</color>所有<b>固定伤害</b>、<b>百分比伤害</b>\r
<indent=32><sprite=4><indent=48><color=#64F9FA>免疫</color>所有<b>能力下降状态</b>\r
<indent=32><sprite=4><indent=48>在战斗中将固定伤害和百分比伤害抗性视为100%\r
<indent=16><sprite=3><indent=32>“辛”死亡时，下回合自身100%驱逐对手\r
\r
<indent=0><sprite=0><indent=16>被击败效果（boss有效）：\r
<indent=16><sprite=3><indent=32>自身被击败后，为己方加持<color=#FFF779>辛之印记</color>\r
\r
<indent=0><sprite=0><indent=16>常驻效果：\r
<indent=16><sprite=3><indent=32>己方每有一只精灵阵亡则当回合自身有6%的概率<color=#64F9FA>闪避</color>对手技能\r
<indent=32><sprite=4><indent=48>若对手为<b>英雄圣殿成员</b>则概率翻倍\r
\r
<indent=0><sprite=5><indent=15>辛之印记：\r
<indent=16><sprite=6><indent=32>每场战斗限1次\r
<indent=16><sprite=6><indent=32>下3回合期间<b>己方精灵</b>：\r
<indent=32><sprite=4><indent=48><color=#64F9FA>免疫</color>所有<b>异常状态</b>\r
<indent=32><sprite=4><indent=48><color=#64F9FA>免疫</color>所有<b>固定伤害</b>、<b>百分比伤害</b>\r
<indent=32><sprite=4><indent=48><color=#64F9FA>免疫</color>所有<b>能力下降状态</b>\r
<indent=32><sprite=4><indent=48>将固定伤害和百分比伤害抗性视为100%\r
<indent=32><sprite=4><indent=48>攻击技能<color=#64F9FA>必定致命一击</b>"""@zh ;
    seer:effectAlias "alias_1357_50_100_60_20_4_100_3_6" ;
    seer:intensified false ;
    seer:isAdv false ;
    seer:pveEffective true ;
    seer:seerapiId "1061" ;
    seer:soulmarkEffect "{\"effect\": {\"id\": 1357, \"url\": \"https://api.seerapi.com/v1/eid_effect/1357\"}, \"effect_args\": [50, 100, 60, 20, 4, 100, 3, 6]}" ;
