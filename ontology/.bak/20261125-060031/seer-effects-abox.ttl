seer:soulmark_1286 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4030 ;
    seer:desc "回合开始时若自身体力高于对手则触发海洋的震怒：当回合受到的攻击伤害高于300回合结束为自身附加300点护盾；战斗阶段结束时受到海洋的庇护：随机附加200-300点固定伤害并为自己恢复等量体力，随机使自身3项能力值+1，若自身体力低于最大体力的1/2则触发的海洋的庇护效果翻倍（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时若自身体力高于对手则触发海洋的震怒：当回合受到的攻击伤害高于300则战斗阶段结束时<color=#64F9FA>获得</color>300点<b>护盾</b>\r
\r
<indent=0><sprite=0><indent=16>战阶结束效果：\r
<indent=16><sprite=3><indent=32>战斗阶段结束时受到海洋的庇护：随机<color=#64F9FA>附加</color>200~300点<b>固定伤害</b>并为自己<color=#64F9FA>恢复</color>等量<b>体力</b>且随机使自身3项能力值+1\r
<indent=32><sprite=4><indent=48>若自身体力低于最大体力的1/2则上述效果翻倍"""@zh ;
