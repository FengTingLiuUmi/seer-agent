        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4561 ;
    seer:desc "登场时为对手附加1道天霆之律，自身受到异常状态时若对手拥有天霆之律则移除一层，然后自身免疫此次受到的异常状态；|回合开始时若对手拥有天霆之律则本回合自身攻击必定命中，必定致命、若没有则本回合攻击后吸取对手最大体力的1/3|（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>登场效果：\r
<indent=16><sprite=3><indent=32>登场时为对手<color=#64F9FA>附加</color>1道<color=#FFF779>天霆之律</color>\r
\r
