seer:soulmark_1924 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4721 ;
    seer:desc "自身造成攻击伤害后吸取对手伤害值50%的体力，然后对手每剩余2%的体力，下回合自身受到的攻击伤害减少1%|自身被击败时，消除对手能力提升状态，之后己方2回合内受到的攻击伤害、固定伤害、百分比伤害额外减少50%，若消除能力提升状态成功则延长1回合|（boss有效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>触发效果：\r
<indent=16><sprite=3><indent=32>自身造成攻击伤害后<color=#64F9FA>吸取</color>对手伤害值50%的<b>体力</b>\r
<indent=32><sprite=4><indent=48>然后对手每剩余2%的体力，下回合自身受到的<b>攻击伤害</b><color=#64F9FA>减少</color>1%\r
\r
<indent=0><sprite=0><indent=16>被击败效果：\r
<indent=16><sprite=3><indent=32>自身被击败时：\r
<indent=32><sprite=4><indent=48>己方2回合内受到的<b>攻击伤害、固定伤害、百分比伤害</b>额外<color=#64F9FA>减少</color>50%\r
<indent=32><sprite=4><indent=48><color=#64F9FA>消除</color>对手<b>能力提升状态</b>\r
<indent=32><sprite=4><sprite=4><indent=64>消除成功则上述效果延长1回合"""@zh ;
