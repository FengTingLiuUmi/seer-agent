seer:soulmark_987 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_3711 ;
    seer:analyzeDesc "[sprite name=dot1][color=#52a5f2]首次[/color][color=#52a5f2]出战[/color][color=#57c975]登场时[/color]获得4层[color=#f35555]自然祝福[/color]，[color=#52a5f2]之后[/color]每次[color=#57c975]登场时[/color]获得2层[color=#f35555]自然祝福[/color]|[sprite name=dot1][color=#57c975]战斗阶段结束时[/color]，若[color=#52a5f2]当回合[/color]自身使用了技能则消耗1层[color=#f35555]自然祝福[/color]，若[color=#52a5f2]当回合[/color]自身未使用技能则获得1层[color=#f35555]自然祝福[/color]"@zh ;
    seer:desc "首次出战登场时获得4层自然祝福，之后每次登场时获得2层自然祝福|战斗阶段结束时，若当回合自身使用了技能则消耗1层自然祝福，若当回合自身未使用技能则获得1层自然祝福|（boss有效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>登场效果：\r
<indent=16><sprite=3><indent=32>首次登场时获得4层<color=#FFF779>自然祝福</color>\r
<indent=16><sprite=3><indent=32>非首次登场时获得2层自然祝福\r
\r
<indent=0><sprite=0><indent=16>战阶结束效果：\r
<indent=16><sprite=3><indent=32>战斗阶段结束时：\r
<indent=32><sprite=4><indent=48>若当回合自身使用了技能则消耗1层自然祝福\r
<indent=32><sprite=4><indent=48>若当回合自身未使用技能则获得1层自然祝福\r
\r
<indent=0><sprite=5><indent=16>触发效果：\r
<indent=16><sprite=3><indent=32>每持有1层自然祝福，莫妮卡：\r
<indent=32><sprite=4><indent=48>25%概率<color=#64F9FA>免疫</color>受到的<b>异常状态</b>\r
<indent=32><sprite=4><indent=48>攻击技能<b>先制</b>+1\r
<indent=32><sprite=4><indent=48>受到的<b>攻击伤害</b><color=#64F9FA>减少</color>8%\r
\r
<indent=0><sprite=5><indent=15>自然祝福（上限4层）：\r
<indent=16><sprite=6><indent=32>莫妮卡用以触发部分效果的条件"""@zh ;
