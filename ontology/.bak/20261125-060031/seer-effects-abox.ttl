seer:soulmark_752 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_3437 ;
    seer:desc "[进攻效果]:|自身使用技能时造成的攻击伤害提高50%，若使用技能时自身体力低于对手则造成的攻击伤害额外提高25%，同时{吸取}对手200点{体力}（boss有效）；|[固伤效果]:|自身若使用攻击技能则当回合无视对手能力提升状态（该效果为回合类效果）且有50%概率附加造成攻击伤害50%的百分比伤害（boss有效）"@zh ;
