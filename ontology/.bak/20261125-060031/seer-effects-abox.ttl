seer:soulmark_2040 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4850 ;
    seer:desc "回合开始时自身每有1回合流血，当回合攻击技能造成的伤害提高15%，最高90%；自身处于流血时免疫受到的异常状态，触发成功自身流血回合数+1|自身攻击技能造成的伤害超过300时令敌我双方流血，若对手处于流血状态则改为令自身全属性+1|战斗阶段结束时，若己方存在西忒蕾妃且自身不处于异常状态，下回合开始时使自身流血1回合|（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时自身每有1回合流血，当回合攻击技能造成的<b>攻击伤害</b><color=#64F9FA>提升</color>15%，最高90%\r
\r
<indent=0><sprite=0><indent=16>常驻效果：\r
<indent=16><sprite=3><indent=32>自身处于流血时<color=#64F9FA>免疫</color>受到的<b>异常状态</b>，触发成功自身流血回合数+1\r
\r
<indent=0><sprite=0><indent=16>触发效果：\r
<indent=16><sprite=3><indent=32>自身攻击技能造成的伤害超过300时<color=#64F9FA>令双方流血</color>，若对手处于流血状态则改为令自身<color=#64F9FA>全属性+1</color>\r
\r
<indent=0><sprite=0><indent=16>回合结束效果：\r
<indent=16><sprite=3><indent=32>回合结束时，若西忒蕾妃位于出战背包且自身不处于异常状态，则下回合开始时<color=#64F9FA>令自身流血</color>1回合"""@zh ;
