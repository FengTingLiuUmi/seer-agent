seer:soulmark_1932 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:advanceOf seer:pet_advance_7 ;
    seer:affectsPet seer:pet_3740 ;
    seer:analyzeDesc "[sprite name=dot4][color=#52a5f2]登场时[/color]获得400点[color=#57c975]护盾[/color]，此[color=#57c975]护盾[/color]存在时自身受到的[color=#52a5f2]固定伤害[/color]、[color=#52a5f2]百分比伤害[/color]不超过此[color=#57c975]护盾[/color]的数值，[color=#52a5f2]之后[/color]自身处于[color=#57c975]护盾[/color]状态时所有[color=#52a5f2]技能先制[/color]+1且攻击技能使用时获得1道[color=#f35555]永恒之水[/color]，自身不处于[color=#57c975]护盾[/color]状态时所有技能不消耗PP值且攻击后附加1滴[color=#f35555]蚀砚之泪[/color]|[sprite name=dot4][color=#57c975]战斗阶段结束时[/color]，若[color=#52a5f2]当回合[/color]自身受到了[color=#52a5f2]攻击伤害[/color]则抵挡[color=#52a5f2]对手[/color]下1次攻击，若未受到[color=#52a5f2]攻击伤害[/color]则恢复自身最大体力的25%并造成恢复量等量[color=#52a5f2]百分比伤害[/color]，若场上存在[color=#f35555]永恒之水[/color]与[color=#f35555]蚀砚之泪[/color]则2回合内[color=#52a5f2]对手[/color]无法解除、[color=#52a5f2]反转[/color][color=#52a5f2]能力下降状态[/color]"@zh ;
    seer:derivedFrom seer:soulmark_1014 ;
    seer:desc "登场时获得400点护盾，此护盾存在时自身受到的固定伤害、百分比伤害不超过此护盾的数值，之后自身处于护盾状态时所有技能先制+1且攻击技能使用时获得1道永恒之水，自身不处于护盾状态时所有技能不消耗PP值且攻击后附加1滴蚀砚之泪|战斗阶段结束时，若当回合自身受到了攻击伤害则抵挡对手下1次攻击，若未受到攻击伤害则恢复自身最大体力的25%并造成恢复量等量百分比伤害，若场上存在永恒之水与蚀砚之泪则2回合内对手无法解除、反转能力下降状态|（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>登场效果：\r
<indent=16><sprite=3><indent=32>登场时<color=#64F9FA>获得</color>400点<b>护盾</b>\r
<indent=32><sprite=4><indent=48>此护盾存在时自身受到的<b>固定伤害</b>、<b>百分比伤害</b><color=#64F9FA>无法超过</color>此护盾的数值，之后：\r
<indent=32><sprite=4><sprite=4><indent=64>自身处于护盾状态时所有技能<b>先制</b>+1且攻击技能使用时获得1道<color=#FFF779>永恒之水</color>\r
<indent=32><sprite=4><sprite=4><indent=64>自身不处于护盾状态时所有技能<color=#64F9FA>不消耗PP值</color>且攻击后为对手附加1滴<color=#FFF779>蚀砚之泪</color>\r
\r
<indent=0><sprite=0><indent=16>战阶结束效果：\r
<indent=16><sprite=3><indent=32>战斗阶段结束时：\r
<indent=32><sprite=4><indent=48>若当回合自身受到了攻击伤害则<color=#64F9FA>抵挡</color>对手下1次<b>攻击</b>\r
<indent=32><sprite=4><indent=48>若当回合自身未受到攻击伤害则<color=#64F9FA>恢复</color>自身最大体力的25%并造成恢复量等量<b>百分比伤害</b>\r
<indent=32><sprite=4><indent=48>若场上存在永恒之水与蚀砚之泪则2回合内对手<color=#64F9FA>无法解除、反转</color><b>能力下降状态</b>\r
\r
<indent=0><sprite=5><indent=15>永恒之水（上限8道）：\r
<indent=16><sprite=6><indent=32>每有1道自身造成的<b>攻击伤害</b><color=#64F9FA>提升</color>25%\r
<indent=16><sprite=6><indent=32>达到8道后本场战斗永恒之水的道数下场保留\r
\r
<indent=0><sprite=5><indent=15>蚀砚之泪（上限4滴，下场保留）：\r
<indent=16><sprite=6><indent=32>达到3滴后自身<color=#64F9FA>护盾效果失效</color>\r
<indent=16><sprite=6><indent=32>达到4滴后自身的受到的攻击、攻击伤害<color=#64F9FA>无法被免疫与转化</color>\r
<indent=16><sprite=6><indent=32>沧岚被击败后消失"""@zh ;
    seer:effectAlias "alias_2343_1_1_1" ;
    seer:intensified false ;
    seer:isAdv true ;
    seer:pveEffective false ;
    seer:seerapiId "1932" ;
    seer:soulmarkEffect "{\"effect\": {\"id\": 2343, \"url\": \"https://api.seerapi.com/v1/eid_effect/2343\"}, \"effect_args\": [1, 1, 1]}" ;
    seer:soulmarkTag seer:soulmark_tag_2,
