seer:soulmark_1197 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_3932 ;
    seer:desc "每次登场后对手当前在场精灵2回合内属性技能失效且令己方月照星魂在本场战斗中造成的伤害提升10%（最高50%）；|回合开始时，若对手体力低于300则当回合自身攻击技能先制+1且100%打出致命一击，若对手体力高于300则当回合自身攻击命中后{吸取}对手300点{体力}（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>登场效果：\r
<indent=16><sprite=3><indent=32>登场后：\r
<indent=32><sprite=4><indent=48>对手当前在场精灵2回合内<b>属性技能</b><color=#64F9FA>无效</color>\r
<indent=32><sprite=4><indent=48>令己方<b>月照星魂</b>在本场战斗中造成的伤害<color=#64F9FA>提升</color>10%（最高50%）\r
\r
<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时：\r
<indent=32><sprite=4><indent=48>若对手体力低于300则当回合自身攻击技能<b>先制</b>+1且<color=#64F9FA>100%打出致命一击</color>\r
<indent=32><sprite=4><indent=48>若对手体力高于300则当回合自身攻击命中后<color=#64F9FA>吸取</color>对手300点体力"""@zh ;
