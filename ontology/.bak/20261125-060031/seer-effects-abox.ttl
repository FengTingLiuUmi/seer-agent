seer:soulmark_1541 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4037 ;
    seer:derivedFrom seer:soulmark_1292 ;
    seer:desc "回合开始时，若自身体力高于对手则令自身全属性+1，每次触发该效果后则当回合自身攻击先制+1，最多+3（先制效果切换下场后重新叠加）；本场战斗中自身攻击先出手时掌控啸风：40%的概率造成的攻击伤害翻倍，每次触发则概率增加20%，最高概率100%（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时若自身体力高于对手则令自身<color=#64F9FA>全属性+1</color>\r
<indent=32><sprite=4><indent=48>触发成功则当回合自身攻击技能<b>先制</b>+1且直到自身下场该效果额外+1，最多额外+2\r
\r
<indent=0><sprite=0><indent=16>触发效果：\r
<indent=16><sprite=3><indent=32>自身攻击先出手时掌控啸风：40%的概率造成的<b>攻击伤害</b>翻倍\r
<indent=32><sprite=4><indent=48>触发成功则上述概率增加20%，最高增加至100%"""@zh ;
