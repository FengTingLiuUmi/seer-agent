seer:soulmark_2142 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4943 ;
    seer:analyzeDesc "[sprite name=dot4]自身[color=#57c975]免疫[/color]受到的[color=#57c975]秒杀[/color]；[color=#52a5f2]对手[/color][color=#52a5f2]执行[/color][color=#57c975]秒杀[/color]效果时，消除[color=#52a5f2]对手[/color]的[color=#52a5f2]回合类效果[/color]并令[color=#52a5f2]对手[/color][color=#57c975]石化[/color]；[color=#57c975]战斗阶段结束时[/color]，获得等同于[color=#52a5f2]对手[/color]的[color=#57c975]护盾[/color]、[color=#57c975]护罩[/color]，若[color=#52a5f2]对手[/color]的[color=#57c975]护盾[/color]、[color=#57c975]护罩[/color]相等，则额外消除[color=#52a5f2]对手[/color]的[color=#57c975]护盾[/color]、[color=#57c975]护罩[/color]并附加等量的[color=#52a5f2]固定伤害[/color]、消除量100%的[color=#52a5f2]百分比伤害[/color]"@zh ;
    seer:desc "自身免疫受到的秒杀；对手执行秒杀效果时，消除对手的回合类效果并令对手石化；战斗阶段结束时，获得等同于对手的护盾、护罩，若对手的护盾、护罩相等，则额外消除对手的护盾、护罩并附加等量的固定伤害、消除量100%的百分比伤害|（boss无效）"@zh ;
    seer:effectAlias "alias_2550_1_0" ;
