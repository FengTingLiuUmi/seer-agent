seer:soulmark_1966 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4765 ;
    seer:analyzeDesc "[sprite name=dot4]自身的1~4号位技能分别对应[color=#f35555]雷辰[/color]·东、[color=#f35555]雷辰[/color]·南、[color=#f35555]雷辰[/color]·西、[color=#f35555]雷辰[/color]·北，自身每次使用以“雷”冠名的技能时点亮对应的未被点亮的[color=#f35555]雷辰[/color]，点亮后令[color=#52a5f2]对手[/color][color=#57c975]麻痹[/color]且自身恢复所有技能1点PP值|[sprite name=dot4][color=#57c975]回合开始时[/color]，若自身处于[color=#57c975]麻痹[/color]状态，则解除自身所处的[color=#57c975]麻痹[/color]状态且[color=#52a5f2]当回合[/color]所有[color=#52a5f2]技能先制[/color]+1"@zh ;
    seer:desc "自身的1~4号位技能分别对应雷辰·东、雷辰·南、雷辰·西、雷辰·北，自身每次使用以“雷”冠名的技能时点亮对应的未被点亮的雷辰，点亮后令对手麻痹且自身恢复所有技能1点PP值|回合开始时，若自身处于麻痹状态，则解除自身所处的麻痹状态且当回合所有技能先制+1|（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>雷辰：\r
<indent=16><sprite=3><indent=32>自身登场后：\r
<indent=32><sprite=4><indent=48>1~4号位技能分别对应雷辰·东、雷辰·南、雷辰·西、雷辰·北，自身每次使用以“雷”冠名的技能时点亮对应的未被点亮的雷辰\r
<indent=32><sprite=4><indent=48>雷辰每次点亮后将与上一颗被点亮的雷辰连接并<color=#64F9FA>令对手麻痹</color>且所有技能<color=#64F9FA>恢复</color>1点<b>PP值</b>\r
<indent=32><sprite=4><indent=48>当自身点亮四颗雷辰时，若连接的雷辰呈“ㄣ”形则当回合结束后自身<color=#64F9FA>解除</color>所处的<b>异常状态</b>与<b>能力下降状态</b>并进入3回合的<color=#FFF779>觉醒</color>状态\r
<indent=32><sprite=4><sprite=4><indent=64>否则<color=#64F9FA>恢复</color>自身全部<b>体力</b>并重置自身的雷辰进度\r
\r
<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时若自身处于麻痹状态，则<color=#64F9FA>解除</color>自身所处的麻痹状态且当回合所有技能<b>先制</b>+1\r
\r
<indent=0><sprite=5><indent=15>觉醒：\r
<indent=16><sprite=6><indent=32>自身<color=#64F9FA>免疫</color>受到的<b>异常状态</b>与<b>能力下降状态</b>\r
<indent=16><sprite=6><indent=32>所有技能<b>先制</b>+1\r
<indent=16><sprite=6><indent=32><color=#64F9FA>无视对手先制等级</color>\r
<indent=16><sprite=6><indent=32>必定<color=#64F9FA>打出致命一击</color>\r
<indent=16><sprite=6><indent=32>造成的技能伤害额外<color=#64F9FA>恢复</color>至自身体力\r
<indent=16><sprite=6><indent=32>使用<color=#64F9FA>技能不受PP值限制</color>\r
<indent=16><sprite=6><indent=32>技能<color=#64F9FA>必定命中且命中效果强制生效</color>\r
<indent=16><sprite=6><indent=32>效果结束时重置自身的雷辰进度"""@zh ;
    seer:effectAlias "alias_2376_3_1_1" ;
    seer:intensified false ;
    seer:isAdv false ;
    seer:pveEffective false ;
    seer:seerapiId "1966" ;
    seer:soulmarkEffect "{\"effect\": {\"id\": 2376, \"url\": \"https://api.seerapi.com/v1/eid_effect/2376\"}, \"effect_args\": [3, 1, 1]}" ;
