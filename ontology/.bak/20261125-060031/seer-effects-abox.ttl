seer:soulmark_1818 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4611 ;
    seer:desc "对手使用技能后令对手流血，若本回合自身已受到了攻击伤害则额外使下回合自身受到的攻击伤害减少50%，若本回合自身已受到了固定伤害则额外附加对手最大体力1/3的百分比伤害，若本回合自身已受到了百分比伤害则额外恢复自身最大体力的1/3；|回合开始时，若自身处于异常状态则自身攻击技能先制+1且造成伤害提升100%，若为控制类异常状态则额外令对手当回合属性技能无效（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>触发效果：\r
<indent=16><sprite=3><indent=32>对手使用技能后<color=#64F9FA>令对手流血</color>\r
<indent=32><sprite=4><indent=48>若本回合自身已受到了攻击伤害则额外使下回合自身受到的<b>攻击伤害<color=#64F9FA></b>减少</color>50%\r
<indent=32><sprite=4><indent=48>若本回合自身已受到了固定伤害则额外<color=#64F9FA>附加</color>对手最大体力1/3的<b>百分比伤害</b>\r
<indent=32><sprite=4><indent=48>若本回合自身已受到了百分比伤害则额外<color=#64F9FA>恢复</color>自身最大体力的1/3\r
\r
<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时，若自身处于异常状态则自身攻击技能<b>先制</b>+1且造成的<b>攻击伤害</b><color=#64F9FA>提升</color>100%\r
<indent=32><sprite=4><indent=48>若为控制类异常状态则额外令对手当回合<b>属性技能<color=#64F9FA></b>无效</color>"""@zh ;
    seer:effectAlias "alias_2207_50_3_3_1_100_1" ;
    seer:intensified false ;
    seer:isAdv false ;
    seer:pveEffective false ;
