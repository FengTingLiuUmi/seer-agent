        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4853 ;
    seer:analyzeDesc "[sprite name=dot4]永沐：自身位于出战背包时，若[color=#52a5f2]对方[/color]精灵[color=#52a5f2]执行[/color]概率不高于50%的[color=#52a5f2]异常状态附加效果[/color]则为[color=#52a5f2]对手[/color]附加[color=#f35555]曝[/color]|[sprite name=dot4]朝曦：自身[color=#52a5f2]主动切换[/color]时自身选择[color=#52a5f2]1号位技能[/color]并获得1句技能对应的[color=#f35555]唱词[/color]，自身[color=#57c975]登场时[/color]若[color=#52a5f2]对手[/color]拥有[color=#f35555]曝[/color]则恢复自身全部体力与PP值且[color=#52a5f2]当回合[/color][color=#57c975]免疫[/color]并[color=#52a5f2]反弹[/color]受到的[color=#52a5f2]异常状态[/color]|[sprite name=dot4]眷颂：自身使用技能的[color=#57c975]回合结束后[/color]，若自身[color=#52a5f2]当回合[/color]没有此法[color=#52a5f2]以[/color]外的方式获得过[color=#f35555]唱词[/color]且[color=#52a5f2]当回合[/color][color=#52a5f2]对手[/color]没有使用技能，则自身获得1句所使用技能对应的[color=#f35555]唱词[/color]|[sprite name=dot4]炽耀：[color=#57c975]回合开始时[/color]，自身每有1句[color=#f35555]唱词[/color]，自身受到的[color=#52a5f2]攻击伤害[/color]减少15%，自身[color=#57c975]行动阶段[/color]结束后，若自身的[color=#f35555]唱词[/color][color=#52a5f2]达到[/color]了4句，则进行一次[color=#52a5f2]额外行动[/color][color=#52a5f2]以[/color]触发[color=#f35555]破黯穿穹[/color]|[sprite name=dot4]余晖：自身[color=#57c975]下场时[/color]，若[color=#52a5f2]对手[/color]拥有[color=#f35555]曝[/color]，[color=#52a5f2]己方[/color]下只精灵[color=#57c975]登场时[/color]1回合内[color=#57c975]免疫[/color]并[color=#52a5f2]反弹[/color]受到的[color=#52a5f2]异常状态[/color]"@zh ;
    seer:desc "永沐：自身位于出战背包时，若对方精灵执行概率不高于50%的异常状态附加效果则为对手附加曝|朝曦：自身主动切换时自身选择1号位技能并获得1句技能对应的唱词，自身登场时若对手拥有曝则恢复自身全部体力与PP值且当回合免疫并反弹受到的异常状态|眷颂：自身使用技能的回合结束后，若自身当回合没有此法以外的方式获得过唱词且当回合对手没有使用技能，则自身获得1句所使用技能对应的唱词|炽耀：回合开始时，自身每有1句唱词，自身受到的攻击伤害减少15%，自身行动阶段结束后，若自身的唱词达到了4句，则进行一次额外行动以触发破黯穿穹|余晖：自身下场时，若对手拥有曝，己方下只精灵登场时1回合内免疫并反弹受到的异常状态|（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>永沐：\r
<indent=16><sprite=3><indent=32>自身位于出战背包时，若对方精灵执行概率不高于50%的异常状态附加效果则为对手附加<color=#FFF779>曝</color>\r
\r
<indent=0><sprite=0><indent=16>朝曦：\r
<indent=16><sprite=3><indent=32>自身主动切换时选择并使用自身的1号位技能，且当回合结束后获得1句技能对应的<color=#FFF779>唱词</color>\r
<indent=32><sprite=4><indent=48>若对手拥有曝则登场时<color=#64F9FA>恢复</color>全部<b>体力值</b>与<b>PP值</b>且当回合<color=#64F9FA>免疫并反弹</color>受到的<b>异常状态</b>\r
\r
<indent=0><sprite=0><indent=16>眷颂：\r
<indent=16><sprite=3><indent=32>自身使用技能的当回合结束时，若自身本回合没有获得过唱词且当回合对手没有使用技能，则自身获得1句所使用技能对应的唱词\r
\r
<indent=0><sprite=0><indent=16>炽耀：\r
<indent=16><sprite=3><indent=32>回合开始时，自身每有1句唱词，当回合自身受到的<b>攻击伤害</b><color=#64F9FA>减少</color>15%\r
<indent=16><sprite=3><indent=32>自身行动阶段结束后，若自身的唱词达到了4句，则进行一次额外行动以触发破黯穿穹：\r
<indent=32><sprite=4><indent=48>消耗所有唱词，每消耗一句不同的唱词附加50点远古·光系伤害，每消耗一句与别句相同的唱词，己方不在场精灵<color=#64F9FA>恢复</color>50点<b>体力</b>\r
<indent=32><sprite=4><indent=48>为对手附加曝，若对手拥有曝则获得自身4号位技能对应的唱词\r
\r
<indent=0><sprite=0><indent=16>余晖：\r
<indent=16><sprite=3><indent=32>自身下场时，若对手拥有曝，己方下只精灵登场之后1回合内<color=#64F9FA>免疫并反弹</color>受到的<b>异常状态</b>\r
\r
<indent=0><sprite=5><indent=16>曝:\r
<indent=16><sprite=6><indent=32>所有不高于50%的<b>异常状态抗性</b><color=#64F9FA>减少</color>20%\r
<indent=16><sprite=6><indent=32>自身无法触发被击败效果且被击败时消逝\r
\r
<indent=0><sprite=5><indent=16>唱词：\r
<indent=16><sprite=6><indent=32>拥有唱词时，自身额外获得唱词对应的效果\r
<indent=16><sprite=6><indent=32>相同的唱词效果叠加\r
<indent=16><sprite=6><indent=32>不同的唱词效果之间共享触发时点、触发条件"""@zh ;
