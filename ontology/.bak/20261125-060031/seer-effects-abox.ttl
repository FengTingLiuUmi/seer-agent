seer:soulmark_1806 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4600 ;
    seer:analyzeDesc "[sprite name=dot4]战斗开始时，斯布林蒂会为[color=#52a5f2]己方[/color]所有其他精灵附加3级[color=#f35555]未来链接[/color]，[color=#f35555]未来链接[/color]同时也[color=#f35555]视为未来奇点、未来指令参与[/color]效果的结算|[sprite name=dot4]斯布林蒂主动[color=#57c975]下场后[/color]，根据下只出战精灵[color=#f35555]未来链接[/color]达到的等级，依次触发以下效果：|[sprite name=dot5]    3级：将自身的体力上限值同步给下只精灵|[sprite name=dot5]    2级：将自身的体力值同步给下只精灵|[sprite name=dot5]    1级：将自身的PP值同步给下只精灵|[sprite name=dot4][color=#52a5f2]己方[/color]其他精灵[color=#57c975]被击败[/color]时失去全部[color=#f35555]未来链接[/color]，斯布林蒂[color=#57c975]被击败[/color]时消除[color=#52a5f2]己方[/color]所有[color=#f35555]未来链接[/color]，每消除1级对应的精灵恢复300点体力与所有技能1点PP值"@zh ;
    seer:desc "战斗开始时，斯布林蒂会为己方所有其他精灵附加3级未来链接，未来链接同时也视为未来奇点、未来指令参与效果的结算|斯布林蒂主动下场后，根据下只出战精灵未来链接达到的等级，依次触发以下效果：|    3级：将自身的体力上限值同步给下只精灵|    2级：将自身的体力值同步给下只精灵|    1级：将自身的PP值同步给下只精灵|己方其他精灵被击败时失去全部未来链接，斯布林蒂被击败时消除己方所有未来链接，每消除1级对应的精灵恢复300点体力与所有技能1点PP值|（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>战斗开始效果：\r
<indent=16><sprite=3><indent=32>战斗开始时，斯布林蒂会使己方所有其他精灵获得<color=#FFF779>未来链接</color>，未来链接初始为3级\r
\r
<indent=0><sprite=0><indent=16>下场效果：\r
<indent=16><sprite=3><indent=32>斯布林蒂主动下场后，根据下只出战精灵的未来链接等级，<b>依次</b>触发以下效果：\r
<indent=32><sprite=4><indent=48>3级：将自身的<b>体力上限值</b><color=#64F9FA>同步</color>给下只精灵\r
<indent=32><sprite=4><indent=48>2级：将自身的<b>体力值</b><color=#64F9FA>同步</color>给下只精灵\r
<indent=32><sprite=4><indent=48>1级：将自身的<b>PP值</b><color=#64F9FA>同步</color>给下只精灵\r
\r
<indent=0><sprite=0><indent=16>被击败效果：\r
<indent=16><sprite=3><indent=32>己方其他精灵被击败时失去<color=#64F9FA>持有的</color><b>未来链接</b>\r
<indent=16><sprite=3><indent=32>斯布林蒂被击败时消除己方<color=#64F9FA>所有的</color><b>未来链接</b>\r
<indent=32><sprite=4><indent=48>每消除1级对应的精灵<color=#64F9FA>恢复</color>300点体力与所有技能1点PP值\r
\r
<indent=0><sprite=5><indent=15>未来链接：\r
<indent=16><sprite=6><indent=32>斯布林蒂存活于出战背包时：\r
<indent=32><sprite=4><indent=48>己方处于未来链接的精灵在计算受到的<b>攻击伤害</b>时不计算<b>克制倍数</b>，并乘以己方处于未来链接的精灵中受克制最低者的<b>被克制系数</b>\r
<indent=32><sprite=4><sprite=4><indent=64>触发后对应此被克制系数的精灵<color=#64F9FA>减少</color>1级未来链接\r
<indent=16><sprite=6><indent=32>未来链接同时也视为<b>未来奇点、未来指令</b>参与<b>层数、道数</b>的计算(不占用原有上限与触发原有效果)"""@zh ;
    seer:effectAlias "alias_2197_1_0" ;
    seer:intensified false ;
    seer:isAdv false ;
    seer:pveEffective false ;
    seer:seerapiId "1806" ;
    seer:soulmarkEffect "{\"effect\": {\"id\": 2197, \"url\": \"https://api.seerapi.com/v1/eid_effect/2197\"}, \"effect_args\": [1, 0]}" ;
    seer:soulmarkTag seer:soulmark_tag_5,
        seer:soulmark_tag_6 ;
    seer:sourceUrl "https://api.seerapi.com/v1/soulmark/1806" .

