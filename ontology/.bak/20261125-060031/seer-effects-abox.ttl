seer:soulmark_1574 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4350 ;
    seer:desc "回合开始时自身每项能力值都有50%的概率+1，若当回合提升的能力值数量＞3项则为自身附加当回合提升的能力值数量*60点的护盾（不可叠加），若提升的能力值数量≤3项则自身技能命中后{吸取}对手300点{体力}；|战斗阶段结束时若自身不处于能力提升状态则下回合自身受到的攻击伤害降低50%（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时自身每项能力等级都有50%的概率+1\r
<indent=32><sprite=4><indent=48>若提升的能力等级＞3项则为自身<color=#64F9FA>附加</color>当回合提升的能力等级项数*60点的<b>护盾</b>\r
<indent=32><sprite=4><indent=48>若提升的能力等级≤3项则自身技能命中后<color=#64F9FA>吸取</color>对手300点<b>体力</b>\r
\r
<indent=0><sprite=0><indent=16>战阶结束效果：\r
