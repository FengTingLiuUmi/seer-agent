seer:soulmark_1864 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4589 ;
    seer:derivedFrom seer:soulmark_1797 ;
    seer:desc "自身登场时若对手体力为满则令对手烧伤1回合，对手每有1个技能PP值为满烧伤的回合数+1，对手处于烧伤状态时无法消除、吸取自身的能力提升状态，自身处于烧伤状态时抵挡对手的攻击，若自身的体力低于对手则恢复等同于伤害量的体力|自身使用攻击技能后令对手烧伤，若对手已处于烧伤则改为失明，若本次攻击未造成伤害或自身处于烧伤状态则额外令对手焚烬，然后对手每处于1种异常状态，自身吸取对手200点体力（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>登场效果：\r
<indent=16><sprite=3><indent=32>自身登场时若对手体力为满则<color=#64F9FA>令对手烧伤</color>1回合，对手每有1个技能PP值为满烧伤的回合数+1\r
\r
<indent=0><sprite=0><indent=16>常驻效果：\r
<indent=16><sprite=3><indent=32>对手处于烧伤状态时<color=#64F9FA>无法消除、吸取</color>自身的<b>能力提升状态</b>\r
<indent=16><sprite=3><indent=32>自身处于烧伤状态时<color=#64F9FA>抵挡</color>对手的攻击，若自身的体力低于对手则<color=#64F9FA>主动恢复</color>等同于伤害量的<b>体力</b>\r
\r
<indent=0><sprite=0><indent=16>攻击技能额外效果：\r
<indent=16><sprite=3><indent=32>自身使用攻击技能后<color=#64F9FA>令对手烧伤</color>\r
<indent=32><sprite=4><indent=48>若对手已处于烧伤则改为失明\r
<indent=32><sprite=4><indent=48>若本次攻击未造成伤害或自身处于烧伤状态则额外<color=#64F9FA>令对手焚烬</color>\r
<indent=32><sprite=4><sprite=4><indent=64>然后对手每处于1种异常状态，自身<color=#64F9FA>吸取</color>对手200点<b>体力</b> """@zh ;
