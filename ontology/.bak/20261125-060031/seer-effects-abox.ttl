seer:soulmark_1567 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4342 ;
    seer:desc "自身攻击技能50%打出致命一击，若触发则令自身攻击+1、速度+1，若未触发则下回合自身攻击技能先制+1且概率提升至100%；|战斗阶段结束时恢复自身已损失体力的50%，若自身处于能力提升状态则附加等量百分比伤害（boss有效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>常驻效果：\r
<indent=16><sprite=3><indent=32>自身攻击技能50%<color=#64F9FA>打出致命一击</color>\r
<indent=32><sprite=4><indent=48>若触发则令自身攻击+1、速度+1\r
<indent=32><sprite=4><indent=48>若未触发则下回合自身攻击技能<b>先制</b>+1且概率提升至100%\r
\r
<indent=0><sprite=0><indent=16>战阶结束效果：\r
<indent=16><sprite=3><indent=32>战斗阶段结束时<color=#64F9FA>恢复</color>自身已损失体力的50%\r
<indent=32><sprite=4><indent=48>若自身处于能力提升状态则<color=#64F9FA>附加</color>等量<b>百分比伤害</b>"""@zh ;
