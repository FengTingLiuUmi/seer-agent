seer:soulmark_1742 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4529 ;
    seer:desc "自身攻击技能命中前若处于能力提升状态则当次攻击无视对手双防能力提升状态，若不处于能力提升状态则100%令对手冰封；|战斗阶段结束时若对手不处于冻伤状态则令自身全属性+1，若对手处于冻伤状态则30%令对手凝滞2回合，未触发则对手下回合使用的属性技能无效|（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>攻击技能额外效果：\r
<indent=16><sprite=3><indent=32>自身使用攻击技能时：\r
