seer:soulmark_1238 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_3975 ;
    seer:desc "自身使用属性技能则下1次攻击100%打出致命一击，自身使用攻击技能造成的伤害低于300则下1次攻击100%打出致命一击；若攻击打出致命一击则50%令对手焚烬，未触发则附加对手最大体力1/3的固定伤害（boss无效）"@zh ;
