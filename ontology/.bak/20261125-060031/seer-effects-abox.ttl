seer:soulmark_1999 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4808 ;
    seer:analyzeDesc "[sprite name=dot4][color=#57c975]登场[/color][color=#52a5f2]之后[/color]自身攻击[color=#52a5f2]技能先制[/color]+3且使用后[color=#52a5f2]吸取[/color][color=#52a5f2]对手[/color]最大体力的50%，[color=#57c975]回合结束后[/color]上述[color=#52a5f2]先制[/color]效果-1、[color=#52a5f2]吸取[/color]效果减少10%[color=#52a5f2]以[/color]恢复自身240点体力，最多减少3次，减少3次之前，自身使用攻击技能时消除[color=#52a5f2]对手[/color][color=#52a5f2]回合类效果[/color]，消除成功令[color=#52a5f2]对手[/color][color=#57c975]流血[/color]|[sprite name=dot4][color=#57c975]回合开始时[/color]，若自身体力低于[color=#52a5f2]对手[/color]则[color=#52a5f2]当回合[/color]自身属性[color=#52a5f2]技能先制[/color]+1且[color=#57c975]回合结束后[/color]恢复所有技能1点PP值，[color=#52a5f2]对手[/color]每携带一个属性技能效果提升1点，若自身体力高于[color=#52a5f2]对手[/color]则[color=#52a5f2]当回合[/color]自身攻击[color=#52a5f2]技能先制[/color]+1且造成的[color=#52a5f2]攻击伤害[/color]提升20%，[color=#52a5f2]对手[/color]每携带一个攻击技能效果提升20%|[sprite name=dot4]未[color=#57c975]击败[/color][color=#52a5f2]对手[/color]时，若[color=#52a5f2]对手[/color]处于[color=#57c975]流血[/color]则为[color=#52a5f2]对手[/color]附加[color=#f35555]入魅[/color]，否则下回合所有技能[color=#52a5f2]必定命中[/color]"@zh ;
    seer:desc "登场之后自身攻击技能先制+3且使用后吸取对手最大体力的50%，回合结束后上述先制效果-1、吸取效果减少10%以恢复自身240点体力，最多减少3次，减少3次之前，自身使用攻击技能时消除对手回合类效果，消除成功令对手流血|回合开始时，若自身体力低于对手则当回合自身属性技能先制+1且回合结束后恢复所有技能1点PP值，对手每携带一个属性技能效果提升1点，若自身体力高于对手则当回合自身攻击技能先制+1且造成的攻击伤害提升20%，对手每携带一个攻击技能效果提升20%|未击败对手时，若对手处于流血则为对手附加入魅，否则下回合所有技能必定命中|（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>登场效果：\r
<indent=16><sprite=3><indent=32>登场之后自身攻击<b>先制</b>+3且使用后<color=#64F9FA>吸取</color>对手最大体力的50%\r
<indent=32><sprite=4><indent=48>每回合结束后上述先制效果-1、吸取效果减少10%以<color=#64F9FA>恢复</color>自身240点<b>体力</b>，最多减少3次\r
<indent=32><sprite=4><sprite=4><indent=64>减少3次之前，自身使用攻击技能时<color=#64F9FA>消除</color>对手<b>回合类效果</b>，消除成功<color=#64F9FA>令对手流血</color>\r
\r
<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时：\r
<indent=32><sprite=4><indent=48>若自身体力低于对手则当回合自身属性技能<b>先制</b>+1且回合结束后<color=#64F9FA>恢复</color>所有技能1点<b>PP值</b>，对手每携带一个属性技能效果提升1点\r
<indent=32><sprite=4><indent=48>若自身体力高于对手则当回合自身攻击技能<b>先制</b>+1且造成的<b>攻击伤害</b><color=#64F9FA>提升</color>20%，对手每携带一个攻击技能效果提升20%\r
\r
<indent=0><sprite=0><indent=16>未击败效果：\r
<indent=16><sprite=3><indent=32>未击败对手时，若对手处于流血则为对手附加<color=#FFF779>入魅</color>\r
<indent=32><sprite=4><indent=48>否则下回合所有技能<color=#64F9FA>必定命中</color>\r
\r
<indent=0><sprite=5><indent=15>入魅：\r
<indent=16><sprite=6><indent=32>米修莉在场时，自身所有技能转化为摸摸（物理攻击；0威力；<color=#64F9FA>恢复</color>88~331点<b>体力</b>）\r
<indent=16><sprite=6><indent=32>每次使用摸摸后消失"""@zh ;
    seer:effectAlias "alias_2425_1_0" ;
    seer:intensified false ;
    seer:isAdv false ;
    seer:pveEffective false ;
    seer:seerapiId "1999" ;
    seer:soulmarkEffect "{\"effect\": {\"id\": 2425, \"url\": \"https://api.seerapi.com/v1/eid_effect/2425\"}, \"effect_args\": [1, 0]}" ;
    seer:soulmarkTag seer:soulmark_tag_10,
