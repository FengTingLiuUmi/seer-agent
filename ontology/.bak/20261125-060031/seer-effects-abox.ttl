seer:soulmark_1504 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4283 ;
    seer:desc "自身受到攻击则随机吸取对手2项属性-1，并将该属性附加给自己；回合开始时，若自身处于能力提升状态则当回合40%的概率闪避对手攻击，若对手处于能力下降状态则闪避概率翻倍（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>触发效果：\r
<indent=16><sprite=3><indent=32>自身受到攻击则令对手随机2项属性-1\r
\r
<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时若自身处于能力提升状态则当回合40%的概率<color=#64F9FA>闪避</color>对手攻击，若对手处于能力下降状态则闪避概率翻倍"""@zh ;
