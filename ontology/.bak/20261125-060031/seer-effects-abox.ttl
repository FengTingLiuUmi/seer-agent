seer:soulmark_1543 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4050 ;
    seer:derivedFrom seer:soulmark_1299 ;
    seer:desc "自身受到的攻击伤害≥自身当前体力值时触发时空跃迁：免疫本次受到的攻击伤害且解除自身异常状态，下3回合起自身闪避率提升至100%（每场战斗触发2次）；|回合开始时，若自身体力高于最大体力的1/2则当回合攻击必定打出致命一击且随机令对手1个技能PP值归零，若自身体力低于最大体力的1/2则当回合所有技能先制+1且{吸取}对手最大{体力}的1/3（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>限定效果（每场战斗限2次）：\r
<indent=16><sprite=3><indent=32>自身受到的攻击伤害≥自身当前体力值时触发时空跃迁：\r
<indent=32><sprite=4><indent=48><color=#64F9FA>免疫</color>本次受到的<b>攻击伤害</b>且<color=#64F9FA>解除</color>自身<b>异常状态</b>\r
<indent=32><sprite=4><indent=48>下3回合自身<b>闪避率</b>提升至100%\r
\r
<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时：\r
<indent=32><sprite=4><indent=48>若自身体力高于最大体力的1/2则当回合攻击必定<color=#64F9FA>打出致命一击</color>且随机令对手1个技能<b>PP值</b><color=#64F9FA>归零</color>\r
<indent=32><sprite=4><indent=48>若自身体力低于最大体力的1/2则当回合所有技能<b>先制</b>+1且<color=#64F9FA>吸取</color>对手最大体力的1/3"""@zh ;
