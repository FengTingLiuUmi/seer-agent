seer:soulmark_1653 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4434 ;
    seer:desc "在战斗中增加自身30点攻击、防御、特攻、特防、速度、体力上限值；|自身技能命中时从以下效果中随机触发2项：|①.附加给对手250点固定伤害；|②.恢复自身250点体力；|③.本回合自身造成的攻击伤害提升50%|（boss无效）"@zh ;
