seer:soulmark_1868 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4665 ;
    seer:desc "自身造成的攻击伤害低于300时，对手2回合内属性技能无效，自身造成的攻击伤害高于300时，2回合内自身免疫对手的攻击|回合开始，若对手上回合使用的技能无效，则为自身附加狂暴；自身处于狂暴状态时造成的攻击伤害提升50%|（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>触发效果：\r
<indent=16><sprite=3><indent=32>自身造成的攻击伤害低于300时，对手2回合内<b>属性技能<color=#64F9FA></b>无效</color>\r
<indent=16><sprite=3><indent=32>自身造成的攻击伤害高于300时，2回合内自身<color=#64F9FA>免疫</color>对手的<b>攻击</b>\r
\r
