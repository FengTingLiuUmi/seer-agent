seer:soulmark_1936 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_3797 ;
    seer:derivedFrom seer:soulmark_1073 ;
    seer:desc "自身受到技能伤害后吸取对手300点体力，战斗阶段结束时若自身未受到技能伤害则50%令对手诅咒|自身先出手时当回合100%闪避对手的攻击，若对手未攻击则战斗阶段结束时吸取对手最大体力的1/3，对手先出手时自身下回合先制+1且当回合100%打出致命一击|（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>触发效果：\r
<indent=16><sprite=3><indent=32>自身受到技能伤害后<color=#64F9FA>吸取</color>对手300点<b>体力</b>\r
