seer:soulmark_1172 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_3905 ;
    seer:desc "首次登场首回合，若自身体力高于对手则攻击附加自身最大体力1/2的固定伤害，若自身体力低于对手则当回合免疫受到的伤害（包括固定伤害和百分比伤害）；自身每次受到攻击则40%的概率令对手感染，未触发则下次触发概率提升20%（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>登场效果：\r
<indent=16><sprite=3><indent=32>首次登场之后当回合开始：\r
<indent=32><sprite=4><indent=48>若自身体力高于对手则当回合攻击<color=#64F9FA>附加</color>自身最大体力1/2的<b>百分比伤害</b>\r
<indent=32><sprite=4><indent=48>若自身体力低于对手则当回合<color=#64F9FA>免疫</color>受到的<b>攻击伤害、固定伤害、百分比伤害</b>\r
\r
<indent=0><sprite=0><indent=16>触发效果：\r
<indent=16><sprite=3><indent=32>自身每次受到攻击则40%<color=#64F9FA>令对手感染</color>，未触发则下次触发概率提升20%"""@zh ;
