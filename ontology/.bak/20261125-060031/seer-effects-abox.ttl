seer:soulmark_2109 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4916 ;
    seer:analyzeDesc "[sprite name=dot4][color=#57c975]战斗阶段结束时[/color]，自身[color=#52a5f2]当回合[/color]每有1级[color=#52a5f2]先制[/color]，下回合[color=#52a5f2]技能先制[/color]+1，最高+3；自身的[color=#52a5f2]先制[/color]高于[color=#52a5f2]对手[/color]时，自身使用攻击技能后70%令[color=#52a5f2]对手[/color][color=#57c975]冰封[/color]，若自身的[color=#52a5f2]先制[/color][color=#52a5f2]达到[/color][color=#52a5f2]对手[/color]的2倍，则改为100%且[color=#52a5f2]未触发[/color]时附加[color=#52a5f2]当回合[/color]所造成[color=#52a5f2]攻击伤害[/color]100%的[color=#52a5f2]百分比伤害[/color]"@zh ;
    seer:desc "战斗阶段结束时，自身当回合每有1级先制，下回合技能先制+1，最高+3；自身的先制高于对手时，自身使用攻击技能后70%令对手冰封，若自身的先制达到对手的2倍，则改为100%且未触发时附加当回合所造成攻击伤害100%的百分比伤害|（boss无效）"@zh ;
    seer:effectAlias "alias_2521_1_0" ;
