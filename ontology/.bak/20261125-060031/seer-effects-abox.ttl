seer:soulmark_1600 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4376 ;
    seer:desc "在风神的庇护下，自身天生免疫能力下降状态且释放技能不消耗PP值(PP值为0时无法释放技能)，在圣光的庇护下，自身天生免疫受到的非本系攻击伤害且自身所有攻击伤害获得本系属性加成；|自身连续使用攻击技能则100%令对手睡眠,未触发则消除对手回合类效果且{吸取}对手300点{体力}，自身连续使用属性技能则下回合受到的攻击伤害、固定伤害和百分比伤害减少50%且所有技能先制+1，当回合自身使用技能且以上条件均未触发则战斗阶段结束时附加100点真实伤害（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>常驻效果：\r
<indent=16><sprite=3><indent=32>在风神的庇护下，自身天生<color=#64F9FA>免疫</color><b>能力下降状态</b>且<color=#64F9FA>释放技能不消耗PP值</color>\r
<indent=16><sprite=3><indent=32>在圣光的庇护下，自身天生<color=#64F9FA>抵挡</color>受到的<b>非本系攻击</b>且自身所有攻击获得<b>本系属性加成</b>\r
\r
<indent=0><sprite=0><indent=16>触发效果：\r
<indent=16><sprite=3><indent=32>自身连续使用攻击技能则100%<color=#64F9FA>令对手睡眠</color>\r
<indent=32><sprite=4><indent=48>未触发则<color=#64F9FA>消除</color>对手<b>回合类效果</b>且<color=#64F9FA>吸取</color>对手300点<b>体力</b>\r
<indent=16><sprite=3><indent=32>自身连续使用属性技能则下回合受到的<b>攻击伤害、固定伤害和百分比伤害</b><color=#64F9FA>减少</color>50%且所有技能先制+1\r
<indent=16><sprite=3><indent=32>当回合自身使用技能且以上条件均未满足则战斗阶段结束时<color=#64F9FA>附加</color>100点<b>真实伤害</b>"""@zh ;
    seer:effectAlias "alias_1961_100_300_50_1_100_1" ;
    seer:intensified false ;
    seer:isAdv false ;
    seer:pveEffective false ;
    seer:seerapiId "1600" ;
    seer:soulmarkEffect "{\"effect\": {\"id\": 1961, \"url\": \"https://api.seerapi.com/v1/eid_effect/1961\"}, \"effect_args\": [100, 300, 50, 1, 100, 1]}" ;
