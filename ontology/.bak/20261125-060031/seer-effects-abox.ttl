seer:soulmark_1835 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4628 ;
    seer:desc "自身每次使用属性技能时令自身流血3回合；自身处于流血状态时免疫受到的异常状态且每回合开始获得300点护盾；对手处于流血状态时，自身使用攻击技能后额外吸取对手等同于造成伤害值100%的体力（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>属性技能额外效果：\r
<indent=16><sprite=3><indent=32>自身每次使用属性技能时<color=#64F9FA>令自身流血</color>3回合\r
\r
<indent=0><sprite=0><indent=16>常驻效果：\r
<indent=16><sprite=3><indent=32>自身处于流血状态时<color=#64F9FA>免疫</color>受到的<b>异常状态</b>且每回合开始<color=#64F9FA>获得</color>300点<b>护盾</b>\r
\r
<indent=0><sprite=0><indent=16>攻击技能额外效果：\r
<indent=16><sprite=3><indent=32>对手处于流血状态时，自身使用攻击技能后额外<color=#64F9FA>吸取</color>对手等同于造成伤害值100%的<b>体力</b>"""@zh ;
