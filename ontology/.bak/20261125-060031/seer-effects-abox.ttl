seer:soulmark_1774 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4564 ;
    seer:desc "对手每携带一个必中技能自身受到的攻击伤害减少10%、造成的攻击伤害提升10%，对手每携带一个非必中技能自身使用技能后吸取对手最大体力的15%；|对手使用属性技能后下1回合自身先制+1，对手使用攻击技能后下1回合自身造成的攻击伤害提升50%，上述效果触发时若对手使用的技能为必中技能则持续回合+1"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>常驻效果：\r
<indent=16><sprite=3><indent=32>对手每携带一个必中技能自身受到的<b>攻击伤害</b><color=#64F9FA>减少</color>10%，造成的<b>攻击伤害</b><color=#64F9FA>提升</color>15%\r
<indent=16><sprite=3><indent=32>对手每携带一个非必中技能自身使用技能后<color=#64F9FA>吸取</color>对手最大体力的15%\r
\r
<indent=0><sprite=0><indent=16>触发效果：\r
<indent=16><sprite=3><indent=32>对手使用属性技能后下1回合自身<b>先制</b>+1 \r
<indent=32><sprite=4><indent=48>若为必中技能，则持续回合+1\r
<indent=16><sprite=3><indent=32>对手使用攻击技能后下1回合自身造成的<b>攻击伤害<color=#64F9FA></b>提升</color>50%\r
<indent=32><sprite=4><indent=48>若为必中技能，则持续回合+1"""@zh ;
