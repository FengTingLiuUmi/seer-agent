seer:soulmark_1614 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4396 ;
    seer:desc "自身使用攻击技能时100%令对手流血，未触发则{吸取}对手1/3最大{体力}；回合开始时，若对手处于异常状态则本回合额外先制+1，若对手不处于异常状态则自身攻击100%打出致命一击（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>攻击技能额外效果：\r
<indent=16><sprite=3><indent=32>自身使用攻击技能时100%<color=#64F9FA>令对手流血</color>\r
<indent=32><sprite=4><indent=48>未触发则<color=#64F9FA>吸取</color>对手1/3最大体力\r
\r
<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时：\r
<indent=32><sprite=4><indent=48>若对手处于异常状态则本回合额外<b>先制</b>+1\r
<indent=32><sprite=4><indent=48>若对手不处于异常状态则自身攻击100%<color=#64F9FA>打出致命一击</color>"""@zh ;
    seer:effectAlias "alias_2002_100_3_1_100_1" ;
