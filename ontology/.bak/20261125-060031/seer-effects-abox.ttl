seer:soulmark_1895 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4693 ;
    seer:desc "首次登场时，自身免疫下次对手的攻击，对手使用火系攻击时此效果失效；回合开始时，对手每处于1种异常状态当回合自身受到的攻击伤害减少33%，自身每处于1种异常状态则为对手附加中毒、寄生、感染中的1种异常状态，未触发则增加100点体力上限，最多1000点|（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>登场效果：\r
<indent=16><sprite=3><indent=32>首次登场时，自身<color=#64F9FA>免疫</color>下次对手的<b>攻击</b>，对手使用<b>火系攻击</b>时此效果失效\r
\r
