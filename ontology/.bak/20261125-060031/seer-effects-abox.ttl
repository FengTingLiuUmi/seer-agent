seer:soulmark_1524 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4301 ;
    seer:desc "回合开始时，若对手处于异常状态时自身造成的攻击伤害提升50%，若对手不处于异常状态则自身受到的攻击伤害降低50%；|战斗阶段结束时，若对手当回合未受到攻击伤害则50%令对手睡眠，未触发则下回合触发概率翻倍（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时：\r
<indent=32><sprite=4><indent=48>若对手处于异常状态时自身造成的<b>攻击伤害</b><color=#64F9FA>提升</color>50%\r
<indent=32><sprite=4><indent=48>若对手不处于异常状态则自身受到的<b>攻击伤害</b><color=#64F9FA>降低</color>50%\r
\r
<indent=0><sprite=0><indent=16>战阶结束效果：\r
<indent=16><sprite=3><indent=32>战斗阶段结束时，若对手当回合未受到攻击伤害则50%<color=#64F9FA>令对手睡眠</color>\r
<indent=32><sprite=4><indent=48>未触发则下回合触发概率翻倍"""@zh ;
    seer:effectAlias "alias_1887_50_50_50_1" ;
