seer:soulmark_1252 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_3992 ;
    seer:desc "自身当回合受到的攻击伤害低于300则战斗阶段结束时令对手受到300点固定伤害，受到的攻击伤害高于300则为自身附加1个300点的护盾；回合开始时若自身存在护盾则当回合造成伤害的50%恢复自身体力（boss有效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>触发效果：\r
<indent=16><sprite=3><indent=32>自身受到了低于300的攻击伤害则当回合战斗阶段结束时令对手<color=#64F9FA>受到</color>300点<b>固定伤害</b>\r
<indent=16><sprite=3><indent=32>自身受到了高于300的攻击伤害则为自身<color=#64F9FA>附加</color>300点<b>护盾</b>\r
\r
<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时若自身存在护盾则当回合造成的攻击伤害50%额外<color=#64F9FA>恢复</color>至自身体力"""@zh ;
