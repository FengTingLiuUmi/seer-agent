seer:soulmark_1612 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4394 ;
    seer:desc "回合开始时若自身满体力则当回合自身免疫所有受到的异常状态且自身造成的攻击伤害提升100%；|战斗阶段结束时若自身处于异常状态则{吸取}对手最大{体力}的1/3且令对手下回合属性技能失效，若自身不处于异常状态则附加自身最大体力1/3的百分比伤害（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时：\r
<indent=32><sprite=4><indent=48>若自身满体力则当回合自身<color=#64F9FA>免疫</color>所有受到的<b>异常状态</b>\r
<indent=32><sprite=4><indent=48>自身造成的<b>攻击伤害</b><color=#64F9FA>提升</color>100%\r
\r
<indent=0><sprite=0><indent=16>战阶结束效果：\r
<indent=16><sprite=3><indent=32>战斗阶段结束时：\r
<indent=32><sprite=4><indent=48>若自身处于异常状态则<color=#64F9FA>吸取</color>对手最大体力的1/3且令对手下回合<b>属性技能</b><color=#64F9FA>失效</color>\r
<indent=32><sprite=4><indent=48>若自身不处于异常状态则<color=#64F9FA>附加</color>自身最大体力1/3的<b>百分比伤害</b>"""@zh ;
    seer:effectAlias "alias_1998_100_3_3_1" ;
