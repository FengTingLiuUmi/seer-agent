seer:soulmark_1990 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4801 ;
    seer:desc "先出手时令对手1回合内属性技能无效，后出手时造成的攻击伤害提升50%|自身受到攻击伤害后，本场战斗受到的攻击伤害额外减少15%，当效果叠加至75%时，重置此效果，自身所有能力值提升50点且3回合内自身免疫异常状态、能力下降状态、造成的攻击伤害提升50%（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>触发效果：\r
<indent=16><sprite=3><indent=32>先出手时令对手1回合内<b>属性技能</b><color=#64F9FA>无效</color>\r
<indent=16><sprite=3><indent=32>后出手时造成的<b>攻击伤害</b><color=#64F9FA>提升</color>50%\r
\r
<indent=0><sprite=0><indent=16>触发效果：\r
<indent=16><sprite=3><indent=32>自身每次受到攻击伤害后本场战斗受到的<b>攻击伤害</b><color=#64F9FA>减少</color>15%，当效果叠加至75%时：\r
<indent=32><sprite=4><indent=48>重置此效果\r
<indent=32><sprite=4><indent=48>自身所有能力值提升50点且3回合内自身<color=#64F9FA>免疫</color>受到的<b>异常状态</b>、<b>能力下降状态</b>，造成的<b>攻击伤害</b><color=#64F9FA>提升</color>50%"""@zh ;
    seer:effectAlias "alias_2417_1_0" ;
    seer:intensified false ;
    seer:isAdv false ;
    seer:pveEffective false ;
    seer:seerapiId "1990" ;
    seer:soulmarkEffect "{\"effect\": {\"id\": 2417, \"url\": \"https://api.seerapi.com/v1/eid_effect/2417\"}, \"effect_args\": [1, 0]}" ;
