seer:soulmark_1711 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4496 ;
    seer:desc "每次自身受到≥300的攻击伤害则会触发哀霆之声：免疫下1次受到的固定伤害、百分比伤害且附加对手最大体力1/3的百分比伤害；|每次自身受到≥300的固定伤害、百分比伤害则会触发悲龙之鸣：免疫下1次受到的攻击伤害且恢复自身最大体力的1/3；|战斗阶段结束时，若当回合自身均未受到攻击伤害、固定伤害、百分比伤害，则消除对手回合类效果和能力提升状态，消除任意一项成功则随机附加麻痹或害怕中的1种异常状态|（哀霆之声与悲龙之鸣在自身体力为0时不会触发，所有特效boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>触发效果：\r
<indent=16><sprite=3><indent=32>每次自身受到≥300的攻击伤害时会触发哀霆之声：<color=#64F9FA>免疫</color>下1次受到的<b>固定伤害、百分比伤害</b>且<color=#64F9FA>附加</color>对手最大体力1/3的<b>百分比伤害</b>，体力为0时不触发\r
<indent=16><sprite=3><indent=32>每次自身受到≥300的固定伤害、百分比伤害时会触发悲龙之鸣：<color=#64F9FA>抵挡</color>下1次受到的<b>攻击</b>且<color=#64F9FA>恢复</color>自身最大体力的1/3，体力为0时不触发\r
\r
<indent=0><sprite=0><indent=16>战阶结束效果：\r
<indent=16><sprite=3><indent=32>战斗阶段结束时，若当回合自身均未受到攻击伤害、固定伤害、百分比伤害，则<color=#64F9FA>消除</color>对手<b>回合类效果</b>和<b>能力提升状态</b>\r
<indent=32><sprite=4><indent=48>消除任意一项成功则随机附加麻痹或害怕中的1种<b>异常状态</b>"""@zh ;
    seer:effectAlias "alias_2099_300_1_3_300_1_3_1" ;
    seer:intensified false ;
    seer:isAdv false ;
    seer:pveEffective false ;
    seer:seerapiId "1711" ;
    seer:soulmarkEffect "{\"effect\": {\"id\": 2099, \"url\": \"https://api.seerapi.com/v1/eid_effect/2099\"}, \"effect_args\": [300, 1, 3, 300, 1, 3, 1]}" ;
