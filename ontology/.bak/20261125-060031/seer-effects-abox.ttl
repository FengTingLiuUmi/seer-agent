seer:soulmark_1620 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_3847 ;
    seer:derivedFrom seer:soulmark_1120 ;
    seer:desc "回合开始时，若对手处于异常状态则当回合自身攻击命中后{吸取}对手最大{体力}的1/3；|对手使用攻击技能后，若自身受到的伤害高于300则消除对手回合类效果并反弹给对手自身受到攻击伤害100%的百分比伤害且100%令对手疲惫，若自身受到的伤害低于300则下回合自身先制+1且造成的攻击伤害提升100%（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>回合开始效果：\r
