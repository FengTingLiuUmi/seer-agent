seer:soulmark_1646 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:advanceOf seer:pet_advance_15 ;
    seer:affectsPet seer:pet_3514 ;
    seer:analyzeDesc "[sprite name=dot4]自身使用攻击技能后获得1支[color=#f35555]灭神之箭[/color]|[sprite name=dot4][color=#57c975]回合开始时[/color]，若自身体力高于[color=#52a5f2]对手[/color]则自身[color=#52a5f2]当回合[/color][color=#52a5f2]技能先制[/color]+1且直到本场战斗自身的下个[color=#57c975]回合开始[/color]，自身[color=#57c975]免疫[/color]受到的[color=#52a5f2]异常状态[/color]|[sprite name=dot4][color=#57c975]战斗阶段结束时[/color]，若自身体力低于[color=#52a5f2]对手[/color]则[color=#52a5f2]吸取[/color][color=#52a5f2]对手[/color]最大体力的1/3"@zh ;
    seer:derivedFrom seer:soulmark_822 ;
    seer:desc "自身使用攻击技能后获得1支灭神之箭|回合开始时，若自身体力高于对手则自身当回合技能先制+1且直到本场战斗自身的下个回合开始，自身免疫受到的异常状态|战斗阶段结束时，若自身体力低于对手则吸取对手最大体力的1/3|（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>攻击技能额外效果：\r
<indent=16><sprite=3><indent=32>自身使用攻击技能会获得1支<color=#FFF779>灭神之箭</color>\r
\r
<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时若自身体力高于对手则：\r
<indent=32><sprite=4><indent=48>当回合所有技能先制+1\r
<indent=32><sprite=4><indent=48>直至下回合开始时<color=#64F9FA>免疫</color>所有<b>异常状态</b>（下场后保留）\r
\r
<indent=0><sprite=0><indent=16>战阶结束效果：\r
<indent=16><sprite=3><indent=32>战斗阶段结束时若自身体力低于对手则<color=#64F9FA>吸取</color>对手最大体力的1/3\r
\r
<indent=0><sprite=5><indent=15>灭神之箭（上限5支，下场保留）\r
<indent=16><sprite=6><indent=32>每持有1支，则使用攻击技能时：\r
<indent=32><sprite=4><indent=48><color=#64F9FA>忽略</color>对手<b>双防值</b>的8%\r
<indent=32><sprite=4><indent=48>造成伤害前<color=#64F9FA>附加</color>40点<b>固定伤害</b>"""@zh ;
    seer:effectAlias "alias_2032_1_3_5_8_40_0_1" ;
    seer:intensified false ;
    seer:isAdv true ;
    seer:pveEffective false ;
    seer:seerapiId "1646" ;
    seer:soulmarkEffect "{\"effect\": {\"id\": 2032, \"url\": \"https://api.seerapi.com/v1/eid_effect/2032\"}, \"effect_args\": [1, 3, 5, 8, 40, 0, 1]}" ;
    seer:soulmarkTag seer:soulmark_tag_10,
        seer:soulmark_tag_2,
        seer:soulmark_tag_8 ;
    seer:sourceUrl "https://api.seerapi.com/v1/soulmark/1646" .

seer:soulmark_1666 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:advanceOf seer:pet_advance_13 ;
    seer:affectsPet seer:pet_3704 ;
    seer:analyzeDesc "[sprite name=dot4][color=#57c975]战斗阶段结束时[/color]，若[color=#52a5f2]对手[/color]不处于[color=#52a5f2]能力提升状态[/color]则[color=#52a5f2]吸取[/color][color=#52a5f2]对手[/color]最大体力的1/3且下回合自身造成的[color=#52a5f2]攻击伤害[/color]提升50%，[color=#52a5f2]对手[/color][color=#57c975]免疫[/color][color=#52a5f2]百分比伤害[/color]时增伤效果提升至100%，若[color=#52a5f2]对手[/color]处于[color=#52a5f2]能力提升状态[/color]则100%令[color=#52a5f2]对手[/color][color=#57c975]害怕[/color]，[color=#52a5f2]未触发[/color]则恢复自身最大体力的1/3并附加等量[color=#52a5f2]百分比伤害[/color]，恢复量与[color=#52a5f2]百分比伤害[/color]最高为自身[color=#52a5f2]已损失体力值[/color]"@zh ;
    seer:derivedFrom seer:soulmark_985 ;
    seer:desc "战斗阶段结束时，若对手不处于能力提升状态则吸取对手最大体力的1/3且下回合自身造成的攻击伤害提升50%，对手免疫百分比伤害时增伤效果提升至100%，若对手处于能力提升状态则100%令对手害怕，未触发则恢复自身最大体力的1/3并附加等量百分比伤害，恢复量与百分比伤害最高为自身已损失体力值|（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>战阶结束效果：\r
<indent=16><sprite=3><indent=32>战斗阶段结束时：\r
<indent=32><sprite=4><indent=48>若对手不处于能力提升状态则<color=#64F9FA>吸取</color>对手最大体力的1/3且下回合自身造成的<b>攻击伤害</b><color=#64F9FA>提升</color>50%\r
<indent=32><sprite=4><sprite=4><indent=64>若对手免疫百分比伤害则增伤效果提升至100%\r
<indent=32><sprite=4><indent=48>若对手处于能力提升状态则100%<color=#64F9FA>令对手害怕</color>\r
<indent=32><sprite=4><sprite=4><indent=64>若害怕未触发则<color=#64F9FA>恢复</color>自身最大体力的1/3并造成等量<b>百分比伤害</b>"""@zh ;
    seer:effectAlias "alias_2049_3_50_100_100_3_1" ;
    seer:intensified false ;
    seer:isAdv true ;
