seer:soulmark_1840 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4634 ;
    seer:desc "自身每次登场首次攻击技能必定打出致命一击，之后每次攻击60%打出致命一击|自身使用技能后，若本次技能打出了致命一击则吸取对手300点体力，若未打出致命一击则60%令对手害怕|（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>登场效果：\r
<indent=16><sprite=3><indent=32>自身每次登场首次<b>攻击技能</b>必定<color=#64F9FA>打出致命一击</color>，之后每次攻击60%打出致命一击\r
\r
<indent=0><sprite=0><indent=16>技能额外效果：\r
<indent=16><sprite=3><indent=32>自身使用技能后：\r
<indent=32><sprite=4><indent=48>若本次技能打出了致命一击则<color=#64F9FA>吸取</color>对手300点<b>体力</b>\r
<indent=32><sprite=4><indent=48>若未打出致命一击则60%<color=#64F9FA>令对手害怕</color>"""@zh ;
