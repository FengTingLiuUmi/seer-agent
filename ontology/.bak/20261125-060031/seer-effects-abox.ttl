seer:soulmark_1678 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4468 ;
    seer:analyzeDesc "[sprite name=dot4]自身[color=#57c975]免疫[/color][color=#57c975]臣服[/color]且[color=#52a5f2]首次[/color][color=#57c975]登场时[/color]100%令[color=#52a5f2]对手[/color][color=#57c975]臣服[/color]|[sprite name=dot4]自身每次[color=#57c975]登场时[/color]获得2方[color=#f35555]永昌玺[/color]，若[color=#57c975]登场[/color]上回合[color=#52a5f2]对方[/color]进行了[color=#52a5f2]主动切换[/color]则额外获得2方[color=#f35555]永昌玺[/color]|[sprite name=dot4][color=#57c975]战斗阶段结束时[/color]，若[color=#52a5f2]当回合[/color][color=#52a5f2]对手[/color]使用了技能则消耗1方[color=#f35555]永昌玺[/color]，若[color=#52a5f2]当回合[/color][color=#52a5f2]对手[/color]未使用技能则获得1方[color=#f35555]永昌玺[/color]|[sprite name=dot5]每[color=#57c975]回合开始时[/color]根据自身[color=#f35555]永昌玺[/color]达到的方数依次获得以下效果|[sprite name=dot5]1方：每拥有1方[color=#f35555]永昌玺[/color]，则[color=#52a5f2]当回合[/color]造成的[color=#52a5f2]攻击伤害[/color]提升11%|[sprite name=dot5]2方：每拥有1方[color=#f35555]永昌玺[/color]，则[color=#52a5f2]当回合[/color]使用攻击技能后附加37点[color=#52a5f2]固定伤害[/color]|[sprite name=dot5]3方：[color=#52a5f2]当回合[/color][color=#57c975]战斗阶段结束时[/color]自身恢复221点体力且所有技能PP值恢复至1|[sprite name=dot5]4方：[color=#52a5f2]当回合[/color][color=#57c975]免疫[/color]受到的控制类[color=#52a5f2]异常状态[/color]|[sprite name=dot5]5方：[color=#52a5f2]当回合[/color]令[color=#52a5f2]对手[/color]的[color=#52a5f2]先制[/color]等级无法高于自身|[sprite name=dot5]6方：下回合令[color=#52a5f2]对手[/color]无法[color=#52a5f2]主动切换[/color]精灵"@zh ;
    seer:desc "自身免疫臣服且首次登场时100%令对手臣服|自身每次登场时获得2方永昌玺，若登场上回合对方进行了主动切换则额外获得2方永昌玺|战斗阶段结束时，若当回合对手使用了技能则消耗1方永昌玺，若当回合对手未使用技能则获得1方永昌玺|每回合开始时根据自身永昌玺达到的方数依次获得以下效果|1方：每拥有1方永昌玺，则当回合造成的攻击伤害提升11%|2方：每拥有1方永昌玺，则当回合使用攻击技能后附加37点固定伤害|3方：当回合战斗阶段结束时自身恢复221点体力且所有技能PP值恢复至1|4方：当回合免疫受到的控制类异常状态|5方：当回合令对手的先制等级无法高于自身|6方：下回合令对手无法主动切换精灵|（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>常驻效果：\r
<indent=16><sprite=3><indent=32>天生<color=#64F9FA>免疫</color>臣服异常状态\r
\r
<indent=0><sprite=0><indent=16>登场效果：\r
<indent=16><sprite=3><indent=32>首次登场时100%<color=#64F9FA>令对手臣服</color>\r
<indent=16><sprite=3><indent=32>每次登场时获得2方<color=#FFF779>永昌玺</color>\r
<indent=32><sprite=4><indent=48>若登场上回合对方选择主动切换精灵则额外获得2方永昌玺\r
\r
<indent=0><sprite=0><indent=16>战阶结束效果：\r
<indent=16><sprite=3><indent=32>战斗阶段结束时：\r
<indent=32><sprite=4><indent=48>若当回合对手使用了技能则失去1方永昌玺\r
<indent=32><sprite=4><indent=48>若当回合对手未使用技能则获得1方永昌玺\r
\r
<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时：\r
<indent=32><sprite=4><indent=48>根据当前持有的永昌玺数量，当回合自身获得累计的效果：\r
<indent=32><sprite=4><sprite=4><indent=64>1方：每持有1方永昌玺，则自身造成的<b>攻击伤害</b><color=#64F9FA>提升</color>11%\r
<indent=32><sprite=4><sprite=4><indent=64>2方：每持有1方永昌玺，则自身使用攻击技能后<color=#64F9FA>附加</color>37点<b>固定伤害</b>\r
<indent=32><sprite=4><sprite=4><indent=64>3方：战斗阶段结束时<color=#64F9FA>恢复</color>自身221点<b>体力</b>和所有PP值为0的技能1点<b>PP值</b>\r
<indent=32><sprite=4><sprite=4><indent=64>4方：<color=#64F9FA>免疫</color>受到的<b>控制类异常状态</b>\r
<indent=32><sprite=4><sprite=4><indent=64>5方：对手的先制等级无法高于自身\r
<indent=32><sprite=4><sprite=4><indent=64>6方：下回合对手<color=#64F9FA>无法主动切换精灵</color>\r
<indent=32><sprite=4><indent=48>若自身当前持有6方永昌玺，则自身触发君临天下（每次在场限1次）\r
\r
<indent=0><sprite=5><indent=15>永昌玺（上限6方）：\r
<indent=16><sprite=6><indent=32>嬴政用以触发部分效果的条件\r
<indent=16><sprite=6><indent=32>击败对手后清空\r
\r
<indent=0><sprite=5><indent=15>君临天下：\r
<indent=16><sprite=6><indent=32>6回合内自身所有攻击技能<color=#64F9FA>必定致命、必定命中</color>，且使用后将额外<color=#64F9FA>附加</color>221点<b>真实伤害</b>\r
<indent=16><sprite=6><indent=32>效果结束后：\r
<indent=32><sprite=4><indent=48>清空自身所有技能PP值\r
<indent=32><sprite=4><indent=48>将自身体力值降为1点\r
<indent=32><sprite=4><indent=48>自身下回合自身<color=#64F9FA>无法主动切换精灵</color>"""@zh ;
    seer:effectAlias "alias_2057_11_37_221_1_221_1" ;
    seer:intensified false ;
    seer:isAdv false ;
    seer:pveEffective false ;
    seer:seerapiId "1678" ;
