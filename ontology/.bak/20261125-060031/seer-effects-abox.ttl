seer:soulmark_2106 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4905 ;
    seer:analyzeDesc "[sprite name=dot4]自身[color=#57c975]使用技能时[/color]，随机触发下列效果种的2项并使本次在场的触发项数+1：|[sprite name=dot5]2回合内自身攻击必定打出[color=#52a5f2]致命一击[/color]|[sprite name=dot5]2回合内对手内[color=#57c975]无法通过自身技能恢复体力[/color]|[sprite name=dot5]2回合内自身攻击技能无视对手能力提升状态|[sprite name=dot5]2回合内自身能力提升状态无法被消除|[sprite name=dot5]2回合内受到的[color=#52a5f2]攻击伤害[/color]减少50%|[sprite name=dot5]2回合内每回合[color=#57c975]战斗阶段结束时[/color]恢复自身400点体力"@zh ;
    seer:desc "自身使用技能时，随机触发下列效果种的2项并使本次在场的触发项数+1：|2回合内自身攻击必定打出致命一击|2回合内对手内无法通过自身技能恢复体力|2回合内自身攻击技能无视对手能力提升状态|2回合内自身能力提升状态无法被消除|2回合内受到的攻击伤害减少50%|2回合内每回合战斗阶段结束时恢复自身400点体力|（boss无效）"@zh ;
    seer:effectAlias "alias_2514_2_1_50_400_1" ;
