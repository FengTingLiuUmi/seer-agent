seer:soulmark_1671 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4458 ;
    seer:desc "回合开始时令自身随机3项能力值+1，若自身不处于能力提升状态则效果转变为全属性+1且当回合自身免疫受到的异常状态；战斗阶段结束时若自身不处于能力提升状态则100%令对手冰封，未触发则恢复自身最大体力的1/3（boss无效）"@zh ;
