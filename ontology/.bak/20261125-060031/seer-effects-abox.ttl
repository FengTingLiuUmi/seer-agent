seer:soulmark_1542 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4048 ;
    seer:derivedFrom seer:soulmark_1298 ;
    seer:desc "自身受到的固定伤害或百分比伤害≥自身当前体力值时触发群星逆转：免疫本次受到的伤害并将其150%转化为自身体力值，下3回合起自身致命率提升至100%（每场战斗仅触发1次）；|自身在本场战斗中攻击技能命中后{吸取}对手最大{体力}的25%，每次叠加5%，最高40%；自身在本场战斗中属性技能命中后下回合受到的攻击伤害减少25%，每次叠加5%，最高40%（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>限定效果（每场战斗限1次）：\r
<indent=16><sprite=3><indent=32>自身受到的固定伤害或百分比伤害≥自身当前体力值时触发群星逆转：\r
<indent=32><sprite=4><indent=48><color=#64F9FA>免疫</color>本次受到的伤害并将其150%<color=#64F9FA>转化</color>为自身<b>体力</b>值\r
<indent=32><sprite=4><indent=48>下3回合自身<b>致命一击率</b>提升至100%\r
\r
<indent=0><sprite=0><indent=16>技能额外效果：\r
<indent=16><sprite=3><indent=32>自身攻击技能命中后<color=#64F9FA>吸取</color>对手最大体力的25%\r
<indent=32><sprite=4><indent=48>每次使用攻击技能后本场战斗中上述效果提升5%，最高40%\r
<indent=16><sprite=3><indent=32>自身属性技能命中后下回合受到的<b>攻击伤害</b><color=#64F9FA>减少</color>25%\r
<indent=32><sprite=4><indent=48>每次使用属性技能后本场战斗中上述效果提升5%，最高40%"""@zh ;
    seer:effectAlias "alias_1638_150_3_25_5_40_25_5_40" ;
    seer:intensified false ;
    seer:isAdv false ;
    seer:pveEffective false ;
    seer:seerapiId "1542" ;
