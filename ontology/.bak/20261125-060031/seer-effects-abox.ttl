seer:soulmark_1587 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4362 ;
    seer:desc "每次登场时若对手所有技能PP值均消耗3点及以上或PP值消耗至0则消除对手回合类效果，消除成功则100%令对手感染；|回合开始时若对手处于异常状态则当回合令对手受到的固定伤害和百分比伤害提升100%，战斗阶段结束时若对手不处于异常状态则100%令对手中毒，未触发中毒则{吸取}对手最大{体力}的1/3（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>登场效果：\r
<indent=16><sprite=3><indent=32>登场时若对手所有技能PP值均已消耗3点及以上或为0则<color=#64F9FA>消除</color>对手<b>回合类效果</b>\r
<indent=32><sprite=4><indent=48>消除成功则100%<color=#64F9FA>令对手感染</color>\r
\r
<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时若对手处于异常状态则当回合令对手受到的<b>固定伤害</b>和<b>百分比伤害</b><color=#64F9FA>提升</color>100%\r
\r
<indent=0><sprite=0><indent=16>战阶结束效果：\r
<indent=16><sprite=3><indent=32>战斗阶段结束时若对手不处于异常状态则100%<color=#64F9FA>令对手中毒</color>\r
<indent=32><sprite=4><indent=48>未触发中毒则<color=#64F9FA>吸取</color>对手最大体力的1/3"""@zh ;
