seer:soulmark_2088 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4901 ;
    seer:analyzeDesc "[sprite name=dot4]自身攻击技能造成的伤害提升100%，若打出[color=#52a5f2]致命一击[/color]则额外提升100%且自身下回合选择使用技能不受pp限制、且使用的技能[color=#52a5f2]必定命中[/color]|[sprite name=dot4][color=#57c975]回合结束时[/color]，若[color=#52a5f2]对手[/color]体力为满则自身下回合所有[color=#52a5f2]技能先制[/color]+1，若不为满则恢复自身300点体力"@zh ;
    seer:desc "自身攻击技能造成的伤害提升100%，若打出致命一击则额外提升100%且自身下回合选择使用技能不受pp限制、且使用的技能必定命中|回合结束时，若对手体力为满则自身下回合所有技能先制+1，若不为满则恢复自身300点体力|（boss无效）"@zh ;
