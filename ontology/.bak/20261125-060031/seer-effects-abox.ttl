seer:soulmark_1008 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_3734 ;
    seer:desc "所有对于速度的强化同时应用于体力（刻印，学习力）对手背包内每死亡一只精灵则自身技能先制+1，最高先制+5 自身攻击技能造成的伤害超过300则自身50%全属性+1且80%令对手害怕，自身攻击技能造成的伤害低于300则自身100%全属性+1且下回合自身攻击威力翻倍（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>常驻效果：\r
<indent=16><sprite=3><indent=32>战斗开始时，自身<color=#64F9FA>增加</color>刻印、学习力提升的速度值等额的<b>体力上限</b>\r
\r
<indent=0><sprite=0><indent=16>触发效果：\r
<indent=16><sprite=3><indent=32>对方背包内每阵亡一只精灵则自身技能<b>先制</b>+1，最高先制+5\r
\r
<indent=0><sprite=0><indent=16>攻击技能额外效果：\r
<indent=16><sprite=3><indent=32>自身攻击技能造成的攻击伤害高于300则自身50%<color=#64F9FA>全属性+1</color>且80%<color=#64F9FA>令对手害怕</color>\r
<indent=16><sprite=3><indent=32>自身攻击技能造成的攻击伤害低于300则自身100%<color=#64F9FA>全属性+1</color>且下回合自身攻击<b>威力</b><color=#64F9FA>翻倍</color>"""@zh ;
    seer:effectAlias "alias_1309_1_300_50_1_80_100_1_1" ;
    seer:intensified false ;
    seer:isAdv false ;
    seer:pveEffective false ;
    seer:seerapiId "1008" ;
