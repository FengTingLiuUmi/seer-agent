seer:soulmark_1935 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_3667 ;
    seer:derivedFrom seer:soulmark_955 ;
    seer:desc "对手使用攻击技能后，若对手造成的攻击伤害不高于300则吸取对手所有技能1点PP值且下1次造成的攻击伤害提升100%，若对手造成的攻击伤害高于300则吸取对手所有技能2点PP值且下次所受攻击的伤害减少50%|自身使用技能后，50%令对手睡眠，触发成功则此效果的触发概率减少至0%，未触发则此效果的触发概率提升至100%|（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>触发效果：\r
<indent=16><sprite=3><indent=32>对手使用攻击技能后：\r
<indent=32><sprite=4><indent=48>若对手造成的攻击伤害不高于300则<color=#64F9FA>吸取</color>对手所有技能1点<b>PP值</b>且下1次造成的<b>攻击伤害</b><color=#64F9FA>提升</color>100%\r
<indent=32><sprite=4><indent=48>若对手造成的攻击伤害高于300则<color=#64F9FA>吸取</color>对手所有技能2点<b>PP值</b>且下次所受攻击的<b>攻击伤害</b><color=#64F9FA>减少</color>50%\r
\r
<indent=0><sprite=0><indent=16>技能额外效果：\r
<indent=16><sprite=3><indent=32>自身使用技能后，50%<color=#64F9FA>令对手睡眠</color>\r
<indent=32><sprite=4><indent=48>触发成功则此效果的触发概率减少至0%\r
<indent=32><sprite=4><indent=48>未触发则此效果的触发概率提升至100%\r
"""@zh ;
