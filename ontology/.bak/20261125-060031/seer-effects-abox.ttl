seer:soulmark_2011 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4818 ;
    seer:desc "回合开始时，若当回合双方选择的技能威力相等或双方均未选择技能则1回合内免疫受到的异常状态，每触发1次本次在场自身使用技能时吸取对手最大体力的1/3，最多叠加3次|回合结束时，若当回合双方选择的技能威力不相等或仅有一方未选择技能则恢复自身最大体力的1/3，且重置上述吸取体力效果|（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时，若当回合双方选择的技能威力相等或双方均未选择技能则1回合内<color=#64F9FA>免疫</color>受到的<b>异常状态</b>\r
<indent=32><sprite=4><indent=48>每触发1次本次在场自身使用技能时<color=#64F9FA>吸取</color>对手最大体力的1/3，最多叠加3次\r
\r
<indent=0><sprite=0><indent=16>回合结束效果：\r
<indent=16><sprite=3><indent=32>回合结束时，若当回合双方选择的技能威力不相等或仅有一方未选择技能则<color=#64F9FA>恢复</color>自身最大体力的1/3，且重置上述吸取体力效果"""@zh ;
