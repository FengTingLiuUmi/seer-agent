seer:soulmark_1156 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_3887 ;
    seer:desc "回合开始时若对手处于异常状态则受到的伤害提升50%；自身使用攻击时有50%概率令对手焚烬，未触发则自身下回合攻击必定致命一击；自身受到攻击时有100%概率令对手烧伤，未触发则战斗阶段结束时附加自身最大体力的1/3的百分比伤害（boss无效）"@zh ;
