        seer:soulmark_tag_2 ;
    seer:sourceUrl "https://api.seerapi.com/v1/soulmark/1966" .

seer:soulmark_1967 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4766 ;
    seer:analyzeDesc "[sprite name=dot4][color=#57c975]登场时[/color]自身开启[color=#f35555]武道[/color]，初始为[color=#f35555]血之道[/color]，[color=#f35555]武道[/color]会以[color=#f35555]血之道[/color]、[color=#f35555]邪之道[/color]、[color=#f35555]天之道[/color]、[color=#f35555]血之道[/color]的[color=#f35555]轨迹[/color]进行衍化，每完成一次完成[color=#f35555]轨迹[/color]的衍化，自身恢复全部PP值|[sprite name=dot4][color=#57c975]战斗阶段结束时[/color]自身恢复最大体力的1/6，自身处于[color=#f35555]血之道[/color]时效果翻倍；自身使用技能时附加[color=#52a5f2]对手[/color]最大体力1/6的[color=#52a5f2]百分比伤害[/color]，自身处于[color=#f35555]邪之道[/color]时效果翻倍；自身造成的[color=#52a5f2]攻击伤害[/color]提升50%，自身处于[color=#f35555]天之道[/color]时效果翻倍"@zh ;
    seer:desc "登场时自身开启武道，初始为血之道，武道会以血之道、邪之道、天之道、血之道的轨迹进行衍化，每完成一次完成轨迹的衍化，自身恢复全部PP值|战斗阶段结束时自身恢复最大体力的1/6，自身处于血之道时效果翻倍；自身使用技能时附加对手最大体力1/6的百分比伤害，自身处于邪之道时效果翻倍；自身造成的攻击伤害提升50%，自身处于天之道时效果翻倍|（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>武道：\r
<indent=16><sprite=3><indent=32>登场时盖亚开启武道，初始为<color=#FFF779>血之道</color>，武道会以血、邪、天、血的轨迹进行衍化\r
<indent=32><sprite=4><indent=48>每完成一次完整轨迹的衍化，自身<color=#64F9FA>恢复</color>全部<b>PP值</b>\r
\r
<indent=0><sprite=0><indent=16>常驻效果：\r
<indent=16><sprite=3><indent=32>回合结束时自身<color=#64F9FA>恢复</color>最大体力的1/6，自身处于血之道时效果翻倍\r
<indent=16><sprite=3><indent=32>自身使用技能时<color=#64F9FA>附加</color>对手最大体力1/6的<b>百分比伤害</b>，自身处于邪之道时效果翻倍\r
<indent=16><sprite=3><indent=32>自身造成的<b>攻击伤害</b><color=#64F9FA>提升</color>50%，自身处于天之道时效果翻倍\r
\r
<indent=0><sprite=5><indent=15>血之道：\r
<indent=16><sprite=6><indent=32>自身<color=#64F9FA>抵挡</color>本场战斗自身在场的前10回合受到的攻击，触发后衍化\r
\r
<indent=0><sprite=5><indent=15>邪之道：\r
<indent=16><sprite=6><indent=32>自身<color=#64F9FA>抵挡</color>本次在场超过2回合的精灵的<b>攻击</b>，触发后衍化\r
\r
<indent=0><sprite=5><indent=15>天之道：\r
<indent=16><sprite=6><indent=32>自身<color=#64F9FA>抵挡</color>非致命一击，触发后衍化\r
\r
<indent=0><sprite=5><indent=15>逆转轨迹：\r
<indent=16><sprite=6><indent=32>武道中的抵挡攻击效果改为以百分比伤害形式<color=#64F9FA>反弹</color>受到的<b>攻击伤害</b>"""@zh ;
    seer:effectAlias "alias_2377_6_6_50_1" ;
    seer:intensified false ;
    seer:isAdv false ;
    seer:pveEffective false ;
    seer:seerapiId "1967" ;
    seer:soulmarkEffect "{\"effect\": {\"id\": 2377, \"url\": \"https://api.seerapi.com/v1/eid_effect/2377\"}, \"effect_args\": [6, 6, 50, 1]}" ;
