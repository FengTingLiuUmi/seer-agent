seer:soulmark_1503 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4279 ;
    seer:desc "回合开始时为自身附加200点护盾，自身体力低于最大体力1/2时额外附加200点护盾（无法叠加）；|战斗阶段结束时，若自身存在护盾则令自身防御+1、特防+1，若自身不存在护盾则恢复自身最大体力的1/3（boss有效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时为自身<color=#64F9FA>附加</color>200点<b>护盾</b>，自身体力低于最大体力1/2时额外附加200点护盾\r
\r
<indent=0><sprite=0><indent=16>战阶结束效果：\r
<indent=16><sprite=3><indent=32>战斗阶段结束时：\r
<indent=32><sprite=4><indent=48>若自身存在护盾则令自身防御+1、特防+1\r
<indent=32><sprite=4><indent=48>若自身不存在护盾则<color=#64F9FA>恢复</color>自身最大体力的1/3"""@zh ;
