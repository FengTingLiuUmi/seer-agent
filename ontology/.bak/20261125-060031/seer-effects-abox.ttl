seer:soulmark_1905 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4358 ;
    seer:derivedFrom seer:soulmark_1583 ;
    seer:desc "自身为对手天敌时，自身受到的伤害除以m（m＝自身对对手的克制倍数，最高不超过2），对手为自身天敌时，自身造成的伤害乘n（n＝对手对自身的克制倍数，最高不超过2）|回合开始时，若自身体力值与速度值之和低于对手则令对手速度、命中-1，若自身攻击值与特攻值之和低于对手则令对手攻击、特攻-1，若自身防御值与特防值之和低于对手则令对手防御、特防-1；以上效果若至少1项未满足条件或未触发则每有1项当回合战斗阶段结束时恢复自身最大体力的20%，若至少2项未满足条件或未触发则每有1项当回合自身所有技能先制+1，若3项均未满足条件或未触发则消除对手回合类效果并吸取对手所有技能1点PP值|（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>常驻效果：\r
<indent=16><sprite=3><indent=32>自身为对手天敌时，自身受到的<b>攻击伤害</b>除以m，m＝自身对对手的克制倍数，最高不超过2\r
<indent=16><sprite=3><indent=32>对手为自身天敌时，自身造成的<b>攻击伤害</b>乘n，n＝对手对自身的克制倍数，最高不超过2\r
\r
<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时：\r
<indent=32><sprite=4><indent=48>根据比较双方的部分数值，触发以下效果：\r
<indent=32><sprite=4><sprite=4><indent=64>若自身体力值与速度值之和低于对手则令对手速度、命中-1\r
<indent=32><sprite=4><sprite=4><indent=64>若自身攻击值与特攻值之和低于对手则令对手攻击、特攻-1\r
<indent=32><sprite=4><sprite=4><indent=64>若自身防御值与特防值之和低于对手则令对手防御、特防-1\r
<indent=32><sprite=4><indent=48>根据以上效果的触发情况，触发以下效果：\r
<indent=32><sprite=4><sprite=4><indent=64>若至少1项未满足条件或未触发则每有1项当回合战斗阶段结束时<color=#64F9FA>恢复</color>自身最大体力的20%\r
<indent=32><sprite=4><sprite=4><indent=64>若至少2项未满足条件或未触发则每有1项当回合自身所有技能<b>先制</b>+1\r
<indent=32><sprite=4><sprite=4><indent=64>若3项均未满足条件或未触发则<color=#64F9FA>消除</color>对手<b>回合类效果</b>并<color=#64F9FA>吸取</color>对手所有技能1点<b>PP值</b>"""@zh ;
    seer:effectAlias "alias_2304_1_20_2_1_3_1_1" ;
    seer:intensified false ;
    seer:isAdv false ;
    seer:pveEffective false ;
    seer:seerapiId "1905" ;
    seer:soulmarkEffect "{\"effect\": {\"id\": 2304, \"url\": \"https://api.seerapi.com/v1/eid_effect/2304\"}, \"effect_args\": [1, 20, 2, 1, 3, 1, 1]}" ;
    seer:soulmarkTag seer:soulmark_tag_2,
        seer:soulmark_tag_4,
        seer:soulmark_tag_6 ;
    seer:sourceUrl "https://api.seerapi.com/v1/soulmark/1905" .

seer:soulmark_1918 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:advanceOf seer:pet_advance_4 ;
    seer:affectsPet seer:pet_3171 ;
    seer:derivedFrom seer:soulmark_500 ;
    seer:desc "对手攻击后50%令对手冰封，未触发则50%令对手麻痹，若均未触发则令对手冻伤且回合结束后恢复最大体力的1/3|回合开始时，若对手处于异常状态则令对手当回合先制效果失效且自身当回合造成的攻击伤害提升50%（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>触发效果：\r
<indent=16><sprite=3><indent=32>受到攻击时50%<color=#64F9FA>令对手冰封</color>\r
<indent=32><sprite=4><indent=48>未触发则50%<color=#64F9FA>令对手麻痹</color>\r
<indent=32><sprite=4><sprite=4><indent=64>未触发则<color=#64F9FA>令对手冻伤</color>且回合结束后<color=#64F9FA>恢复</color>最大体力的1/3\r
\r
<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时，若对手处于异常状态则令对手当回合<color=#64F9FA>先制效果失效</color>且自身当回合造成的<b>攻击伤害</b><color=#64F9FA>提升</color>50%"""@zh ;
