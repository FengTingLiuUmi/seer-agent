seer:soulmark_1595 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4370 ;
    seer:desc "回合开始时若自身防御值高于对手则50%令对手害怕，未触发则当回合自身所有技能先制+1，若自身防御值低于对手则当回合自身受到的攻击伤害降低50%；当回合自身未受到攻击伤害则令对手下回合攻击技能先制效果失效（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时：\r
<indent=32><sprite=4><indent=48>若自身防御值高于对手则50%<color=#64F9FA>令对手害怕</color>\r
<indent=32><sprite=4><sprite=4><indent=64>未触发则当回合自身所有技能<b>先制</b>+1\r
<indent=32><sprite=4><indent=48>若自身防御值低于对手则当回合自身受到的<b>攻击伤害</b><color=#64F9FA>降低</color>50%\r
\r
<indent=0><sprite=0><indent=16>常驻效果：\r
<indent=16><sprite=3><indent=32>每回合若自身未受到攻击伤害则令对手下回合<b>攻击技能</b><color=#64F9FA>先制效果失效</color>"""@zh ;
