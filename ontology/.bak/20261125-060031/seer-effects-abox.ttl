seer:soulmark_1434 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4216 ;
    seer:desc "自身使用攻击技能则20%令对手中毒、20%令对手烧伤、20%令对手冻伤、20%令对手麻痹、20%令对手睡眠、20%令对手害怕，未触发则令自身全属性+1且随机为自身附加中毒、烧伤、冻伤中的1种异常状态；战斗阶段结束时，若自身处于异常状态则下回合开始时解除自身异常状态且当回合攻击必定打出致命一击（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>攻击技能额外效果：\r
<indent=16><sprite=3><indent=32>自身使用攻击技能则20%令对手中毒、20%令对手烧伤、20%令对手冻伤、20%令对手麻痹、20%令对手睡眠、20%令对手害怕\r
<indent=32><sprite=4><indent=48>未触发则令自身<color=#64F9FA>全属性+1</color>且随机为自身附加中毒、烧伤、冻伤中的1种<b>异常状态</b>\r
\r
<indent=0><sprite=0><indent=16>战阶结束效果：\r
<indent=16><sprite=3><indent=32>战斗阶段结束时，若自身处于异常状态则下回合开始时<color=#64F9FA>解除</color>自身<b>异常状态</b>且当回合攻击必定<color=#64F9FA>打出致命一击</color>"""@zh ;
    seer:effectAlias "alias_1805_20_20_20_20_20_20_1_1" ;
