    seer:sourceUrl "https://api.seerapi.com/v1/soulmark/1001" .

seer:soulmark_1002 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_3725 ;
    seer:desc "自身先出手时，令对手当回合攻击技能必定MISS；使用攻击技能则有100%的概率令对手随机进入烧伤、冻伤、疲惫、害怕中的一种异常状态，未触发则随机附加150-300点固定伤害（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>触发效果：\r
<indent=16><sprite=3><indent=32>自身先出手时，令对手当回合攻击技能<color=#64F9FA>必定MISS</color>\r
\r
<indent=0><sprite=0><indent=16>攻击技能额外效果：\r
<indent=16><sprite=3><indent=32>使用攻击技能则有100%随机<color=#64F9FA>附加</color>烧伤、冻伤、疲惫、害怕中的1种<b>异常状态</b>\r
<indent=32><sprite=4><indent=48>未触发则随机<color=#64F9FA>附加</color>150-300点<b>固定伤害</b>"""@zh ;
