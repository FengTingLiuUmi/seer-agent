seer:soulmark_1544 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4075 ;
    seer:derivedFrom seer:soulmark_1320 ;
    seer:desc "自身使用技能后吸取对手能力提升状态，之后将自身相应的能力提升状态赋予给对手相应的能力下降状态，若对手免疫则{吸取}对手最大{体力}1/3且令对手随机2项技能PP值归零；|回合开始时，自身每处于1种能力提升状态则战斗阶段结束时恢复70点体力，对手每处于1种能力下降状态则战斗阶段结束时损失70点体力（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>技能额外效果：\r
<indent=16><sprite=3><indent=32>自身使用技能后<color=#64F9FA>吸取</color>对手<b>能力提升状态</b>\r
<indent=32><sprite=4><indent=48>然后将自身相应的能力提升状态赋予给对手相应的<b>能力下降状态</b>\r
<indent=32><sprite=4><sprite=4><indent=64>若对手免疫弱化则<color=#64F9FA>吸取</color>对手最大体力1/3且令对手随机2项技能<b>PP值</b><color=#64F9FA>归零</color>\r
\r
<indent=0><sprite=0><indent=16>回合开始效果：\r
<indent=16><sprite=3><indent=32>回合开始时：\r
<indent=32><sprite=4><indent=48>自身每处于1种能力提升状态则当回合战斗阶段结束时<color=#64F9FA>恢复</color>70点<b>体力</b>\r
<indent=32><sprite=4><indent=48>对手每处于1种能力下降状态则当回合战斗阶段结束时<color=#64F9FA>受到</color>70点<b>固定伤害</b>"""@zh ;
