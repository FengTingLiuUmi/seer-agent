seer:soulmark_1759 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4552 ;
    seer:desc "对手使用威力最高的技能时自身受到的攻击伤害减少25%，对手使用威力最低的技能时当回合结束恢复自身最大体力的25%；|自身使用技能后为获得已损失体力值50%的护盾与护罩，然后若自身护盾、护罩合计超过对手的体力上限，消耗自身所有护盾、护罩并附加等量的固定伤害（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>常驻效果：\r
<indent=16><sprite=3><indent=32>对手使用威力最高的技能时自身受到的<b>攻击伤害<color=#64F9FA></b>减少</color>25%\r
<indent=16><sprite=3><indent=32>对手使用威力最低的技能时当回合战斗阶段结束时<color=#64F9FA>吸取</color>对手最大体力的25%\r
\r
<indent=0><sprite=0><indent=16>技能额外效果：\r
<indent=16><sprite=3><indent=32>自身使用技能后为自身<color=#64F9FA>附加</color>已损失体力值50%的<b>护盾</b>与<b>护罩</b>，可叠加\r
<indent=32><sprite=4><indent=48>然后若自身护盾、护罩合计超过对手的体力上限，消耗自身所有护盾、护罩并<color=#64F9FA>附加</color>等量的<b>固定伤害</b>"""@zh ;
