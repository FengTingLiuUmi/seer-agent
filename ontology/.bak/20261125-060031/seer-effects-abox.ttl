seer:soulmark_1963 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4755 ;
    seer:desc "自身使用攻击技能时，若自身处于能力提升状态则本次攻击必定打出致命一击，若对手处于异常状态则本次攻击造成伤害提升100%|战斗阶段结束时，自身每损失1%的体力，附加5点固定伤害，然后若对手的体力低于自身，则自身恢复全部体力（boss无效）"@zh ;
    seer:descFormattingAdjustment """<indent=0><sprite=0><indent=16>攻击技能额外效果：\r
<indent=16><sprite=3><indent=32>自身使用攻击技能时：\r
<indent=32><sprite=4><indent=48>若自身处于能力提升状态则本次攻击必定<color=#64F9FA>打出致命一击</color>\r
<indent=32><sprite=4><indent=48>若对手处于异常状态则本次攻击造成的<b>攻击伤害</b><color=#64F9FA>提升</color>100%\r
\r
<indent=0><sprite=0><indent=16>战阶结束效果：\r
<indent=16><sprite=3><indent=32>战斗阶段结束时，自身每损失1%的体力<color=#64F9FA>附加</color>5点<b>固定伤害</b>\r
<indent=32><sprite=4><indent=48>然后若对手的体力低于自身，则自身<color=#64F9FA>恢复</color>全部<b>体力</b>"""@zh ;
