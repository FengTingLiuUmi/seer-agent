seer:soulmark_1432 a seer:Soulmark,
        owl:NamedIndividual ;
    seer:affectsPet seer:pet_4214 ;
    seer:desc "回合开始时，若自身体力高于对手则当回合50%闪避对手的攻击技能，若自身为满体力时闪避概率额外提升25%；|若当回合对手攻击技能MISS则使对手随机1个技能PP值清零，若当回合对手攻击技能命中则战斗阶段结束时随机{吸取}对手150-300点{体力}（boss无效）"@zh ;
